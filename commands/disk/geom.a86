; BPB-based DOS geometry detection, conservative 8/9 fallback and safe DMA.
; A credible 40-cylinder FAT12 BPB may identify eight-sector media. Otherwise
; successful sector-nine I/O proves nine; a failed probe alone proves nothing.
; [8]/[9] are explicit geometry selections, never permission to ignore I/O.
        cseg
geometry_reset:
        mov geometry_known,0
        ret
geometry_detect:
        push ax ! push bx ! push cx ! push dx
        push si ! push di ! push bp ! push es
        mov geometry_hint,0
        mov geometry_cylinders,40
        mov geometry_candidate_cylinders,40
        mov es,verify_segment
        mov cl,1
        call geometry_sector
        jnc geometry_boot_read
        mov dx,offset msg_geometry_read
        jmp geometry_stop
geometry_boot_read:
        cmp es:word ptr .11,512
        je geometry_sector_size_valid
        jmp geometry_try_nine
geometry_sector_size_valid:
        cmp es:word ptr .14,1
        je geometry_reserved_valid
        jmp geometry_try_nine
geometry_reserved_valid:
        cmp es:byte ptr .16,2
        je geometry_fat_count_valid
        jmp geometry_try_nine
geometry_fat_count_valid:
        mov ax,es:word ptr .24
        cmp ax,8
        je geometry_bpb_spt
        cmp ax,9
        je geometry_bpb_spt
        cmp ax,15
        je geometry_bpb_spt
        cmp ax,18
        je geometry_spt_supported
        jmp geometry_try_nine
geometry_spt_supported:
geometry_bpb_spt:
        mov bp,ax
        mov bx,es:word ptr .26
        cmp bx,1
        jae geometry_bpb_fallback_check_1
        jmp geometry_try_nine
geometry_bpb_fallback_check_1:
        cmp bx,2
        jbe geometry_bpb_fallback_check_2
        jmp geometry_try_nine
geometry_bpb_fallback_check_2:
        push dx              ; preserve the selected source/target drive
        mul bx
        mov bx,ax
        mov ax,es:word ptr .19
        xor dx,dx
        div bx
        or dx,dx
        pop dx
        jz geometry_bpb_fallback_check_3
        jmp geometry_try_nine
geometry_bpb_fallback_check_3:
        cmp ax,40
        je geometry_bpb_cylinders
        cmp ax,80
        je geometry_cylinders_supported
        jmp geometry_try_nine
geometry_cylinders_supported:
        cmp es:word ptr .26,2
        je geometry_double_sided_80
        jmp geometry_try_nine
geometry_double_sided_80:
geometry_bpb_cylinders:
        mov geometry_candidate_cylinders,al
        cmp es:word ptr .22,1
        jae geometry_bpb_fallback_check_4
        jmp geometry_try_nine
geometry_bpb_fallback_check_4:
        cmp es:word ptr .22,9
        jbe geometry_bpb_fallback_check_5
        jmp geometry_try_nine
geometry_bpb_fallback_check_5:
        cmp es:byte ptr .21,0f0h
        je geometry_bpb_media
        cmp es:byte ptr .21,0f9h
        jae geometry_bpb_fallback_check_6
        jmp geometry_try_nine
geometry_bpb_fallback_check_6:
geometry_bpb_media:
        cmp es:word ptr .17,16
        jae geometry_bpb_fallback_check_7
        jmp geometry_try_nine
geometry_bpb_fallback_check_7:
        cmp es:word ptr .17,224
        jbe geometry_bpb_fallback_check_8
        jmp geometry_try_nine
geometry_bpb_fallback_check_8:
        cmp es:byte ptr .13,1
        je geometry_cluster_valid
        cmp es:byte ptr .13,2
        je geometry_cluster_supported
        jmp geometry_try_nine
geometry_cluster_supported:
geometry_cluster_valid:
; A recognised 80-cylinder BPB must describe one exact supported FAT12 shape.
; Do not retain an 80-cylinder hint from a rejected/partial BPB.
        cmp geometry_candidate_cylinders,80
        jne geometry_commit_bpb
        cmp es:word ptr .24,9
        jne geometry_bpb_high_density
        cmp es:byte ptr .13,2
        jne geometry_bad_large_bpb
        cmp es:word ptr .17,112
        jne geometry_bad_large_bpb
        cmp es:word ptr .22,3
        jne geometry_bad_large_bpb
        cmp es:byte ptr .21,0f9h
        jne geometry_bad_large_bpb
        jmp geometry_commit_bpb
geometry_bpb_high_density:
        cmp es:byte ptr .13,1
        jne geometry_bad_large_bpb
        cmp es:word ptr .17,224
        jne geometry_bad_large_bpb
        cmp es:word ptr .24,15
        jne geometry_bpb_1440
        cmp es:word ptr .22,7
        jne geometry_bad_large_bpb
        cmp es:byte ptr .21,0f9h
        jne geometry_bad_large_bpb
        jmp geometry_commit_bpb
geometry_bpb_1440:
        cmp es:word ptr .24,18
        jne geometry_bad_large_bpb
        cmp es:word ptr .22,9
        jne geometry_bad_large_bpb
        cmp es:byte ptr .21,0f0h
        je geometry_commit_bpb
geometry_bad_large_bpb:
        jmp geometry_conflict
geometry_commit_bpb:
        mov al,geometry_candidate_cylinders
        mov geometry_cylinders,al
        mov al,es:byte ptr .24
        mov geometry_hint,al
geometry_try_nine:
        cmp geometry_candidate_cylinders,80
        jne geometry_fallback_allowed
        cmp geometry_hint,0
        jne geometry_fallback_allowed
        jmp geometry_conflict
geometry_fallback_allowed:
        cmp geometry_hint,15
        je geometry_large_bpb
        cmp geometry_hint,18
        jne geometry_old_probe
geometry_large_bpb:
        cmp geometry_cylinders,80
        je geometry_large_cylinders_valid
        jmp geometry_conflict
geometry_large_cylinders_valid:
        cmp sector_override,0
        je geometry_large_no_override
        jmp geometry_conflict
geometry_large_no_override:
        cmp os_mode,2
        je geometry_large_driver_ready
        jmp geometry_unsupported
geometry_large_driver_ready:
        mov al,geometry_hint
        jmp geometry_selected
geometry_old_probe:
        cmp sector_override,8
        jne geometry_native_capability
        cmp geometry_hint,9
        jne geometry_eight_override_valid
        jmp geometry_conflict
geometry_eight_override_valid:
        mov al,8
        jmp geometry_selected
geometry_native_capability:
        cmp os_mode,1
        jne geometry_nine_probe
        cmp geometry_hint,8
        je geometry_eight
        mov dx,offset msg_need_raw_xios
        jmp geometry_stop
geometry_nine_probe:
        mov cl,9
        call geometry_sector
        jnc geometry_nine
        cmp geometry_hint,8
        je geometry_eight_hint_present
        jmp geometry_ambiguous
geometry_eight_hint_present:
        cmp sector_override,9
        jne geometry_no_nine_override
        jmp geometry_ambiguous
geometry_no_nine_override:
geometry_eight:
        mov al,8
        jmps geometry_selected
geometry_nine:
        cmp geometry_hint,8
        jne geometry_nine_probe_consistent
        jmp geometry_conflict
geometry_nine_probe_consistent:
        mov al,9
geometry_selected:
        cmp sector_override,0
        je geometry_compare
        cmp al,sector_override
        je geometry_override_matches
        jmp geometry_conflict
geometry_override_matches:
geometry_compare:
        cmp geometry_cylinders,80
        jne geometry_compare_known
        cmp os_mode,2
        je geometry_80_driver_ready
        jmp geometry_unsupported
geometry_80_driver_ready:
geometry_compare_known:
        cmp geometry_known,0
        je geometry_first
        cmp al,track_sectors
        je geometry_sector_counts_match
        jmp geometry_conflict
geometry_sector_counts_match:
        mov ah,geometry_cylinders
        cmp ah,cylinder_limit
        je geometry_cylinder_counts_match
        jmp geometry_conflict
geometry_cylinder_counts_match:
        jmps geometry_return
geometry_first:
        mov track_sectors,al
        mov disk_table+4,al
        mov native_gap_fill,0f650h
        mov disk_table+7,50h
        cmp al,15
        jne geometry_format_not_1200
        mov native_gap_fill,0f654h
        mov disk_table+7,54h
geometry_format_not_1200:
        cmp al,18
        jne geometry_format_gap_ready
        mov native_gap_fill,0f66ch
        mov disk_table+7,6ch
geometry_format_gap_ready:
        mov ah,geometry_cylinders
        mov cylinder_limit,ah
        call geometry_buffer_size
        mov geometry_known,1
        mov dx,offset msg_eight
        cmp al,8
        je geometry_show
        mov dx,offset msg_nine
        cmp al,9
        je geometry_show
        mov dx,offset msg_large
geometry_show:
        call puts
geometry_return:
        pop es ! pop bp ! pop di ! pop si
        pop dx ! pop cx ! pop bx ! pop ax
        ret
geometry_unsupported:
        mov dx,offset msg_large_unsupported
        jmp geometry_stop
geometry_ambiguous:
        mov dx,offset msg_geometry_unknown
        jmps geometry_stop
geometry_conflict:
        mov dx,offset msg_geometry_mismatch
geometry_stop:
        mov exit_status,2
        call puts
        jmp cleanup

; Preserve the drive and sector for all retries. Separate scratch sectors
; keep the BPB intact. Raw native access uses caller-owned, aligned storage.
geometry_sector:
        mov geometry_retry,4
geometry_sector_again:
        xor ch,ch
        xor dh,dh
        xor bx,bx
        cmp cl,1
        je geometry_sector_buffer
        mov bx,512
geometry_sector_buffer:
        mov ax,0201h
        call disk_io
        jnc geometry_sector_done
        push ax
        xor ax,ax
        call disk_io
        pop ax
        dec geometry_retry
        jnz geometry_sector_again
        stc
geometry_sector_done:
        ret

; Keep the bulk base 16 KiB aligned, then use the smallest power-of-two
; slot that fits one head. Each slot remains inside a physical 64 KiB page.
; Recompute once for every disk pair, after validated geometry detection.
geometry_buffer_size:
        push ax ! push bx ! push cx
        mov slot_paragraphs,100h
        mov slot_bytes,1000h
        mov cl,8
        cmp track_sectors,8
        je geometry_slots_ready
        mov slot_paragraphs,200h
        mov slot_bytes,2000h
        mov cl,9
        cmp track_sectors,16
        jbe geometry_slots_ready
        mov slot_paragraphs,400h
        mov slot_bytes,4000h
        mov cl,10
geometry_slots_ready:
        mov ax,bulk_paragraphs
        shr ax,cl
        xor bx,bx
        mov bl,cylinder_limit
        shl bx,1
        cmp ax,bx
        jbe geometry_slots_capped
        mov ax,bx
geometry_slots_capped:
; Even counts allow DCOMP's pairs of head slots and unknown side count.
        and al,0feh
        cmp ax,2
        jae geometry_slots_valid
        jmp memory_error
geometry_slots_valid:
        mov cylinders_per_buffer,al
        pop cx ! pop bx ! pop ax
        ret

; Clear only disk data, retaining deterministic bytes after failed reads.
; Padding is never copied or compared.
clear_track_slot:
        push ax ! push cx ! push di
        xor ax,ax
        xor di,di
        xor cx,cx
        mov ch,track_sectors
        rep stosw
        pop di ! pop cx ! pop ax
        ret

; Install a private 512-byte, eighteen-sector BIOS parameter table under the
; already-acquired disk lock (or single-user CP/M). Restore the exact vector
; on every exit. CDOS direct XIOS services also consult this INT 1Eh table.
disk_setup:
        push ax ! push bx ! push es
        mov ax,offset verify_space
        add ax,15
        mov cl,4
        shr ax,cl
        mov bx,ds
        add ax,bx
        add ax,3ffh
        and ax,0fc00h
        mov verify_segment,ax
        xor ax,ax
        mov es,ax
        mov ax,es:word ptr .78h
        mov old_disk_table,ax
        mov ax,es:word ptr .7ah
        mov old_disk_table+2,ax
        pushf
        cli
        mov es:word ptr .78h,offset disk_table
        mov es:word ptr .7ah,ds
        popf
        mov disk_table_held,1
        pop es ! pop bx ! pop ax
        ret
disk_restore:
        cmp disk_table_held,0
        je disk_restore_done
        push ax ! push es
        xor ax,ax
        mov es,ax
        pushf
        cli
        mov ax,old_disk_table
        mov es:word ptr .78h,ax
        mov ax,old_disk_table+2
        mov es:word ptr .7ah,ax
        popf
        mov disk_table_held,0
        pop es ! pop ax
disk_restore_done:
        ret
        dseg
bulk_paragraphs dw 0
slot_paragraphs dw 400h
slot_bytes dw 4000h
cylinder_limit db 40
geometry_candidate_cylinders db 40
geometry_cylinders db 40
track_sectors db 8
sector_override db 0
geometry_known db 0
geometry_hint db 0
geometry_retry db 0
disk_table_held db 0
old_disk_table dw 0,0
disk_table db 0cfh,2,25h,2,18,2ah,0ffh,50h,0f6h,19h,4
msg_large db '80-cylinder DOS FAT12 media.',13,10,'$'
msg_large_unsupported db '80-cylinder media requires the extended CDOS floppy driver.',13,10,'$'
msg_eight db '8 sectors per track.',13,10,'$'
msg_nine db '9 sectors per track.',13,10,'$'
msg_geometry_unknown db 'Cannot determine 8/9-sector geometry; use [8] for known eight-sector media or [9] for nine.',13,10,'$'
msg_geometry_mismatch db 'Incompatible or conflicting 8/9-sector geometry.',13,10,'$'
msg_geometry_read db 'Cannot read the disk boot sector; no copy or comparison performed.',13,10,'$'
msg_need_raw_xios db 'Nine-sector/probe support needs the updated CCP/M XIOS; use [8] only for known eight-sector media.',13,10,'$'
        cseg
