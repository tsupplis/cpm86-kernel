;*****************************************************************************
;
;	CONFIG - CP/M-86 serial port configuration for the IBM PC
;	Copyright (C) 1983, Digital Research
;
;	Reconstructed from the shipped binary; assembles byte-identical.
;
;	Build:	make
;	Check:	make check
;
;	Usage:	CONFIG				full screen menu
;		CONFIG P0 1200 7 ODD 2		set one port from the command line
;
;	The settings live in the XIOS, in a table with one byte per port in
;	the format of BIOS int 14h: baud rate in bits 7..5, parity in 4..3,
;	stop bits in 2 and word length in 1..0.  BDOS 31h gives the XIOS
;	segment and the table's offset is kept at 2552h in its pointer block.
;
;	The number of serial adapters comes from the equipment word (int 11h).
;	One adapter has five menu entries, otherwise there are ten and the
;	second port has its own column.  The screen is driven as in DSKMAINT.
;
;*****************************************************************************

; Bounds for tools/a86tool.py: where the data starts and the image ends.
data_org	equ	049eh
image_end	equ	09a0h

; ---- addresses outside this image ----
tailbuf	equ	0080h		; base page: command tail, length byte first
xiosser	equ	2552h		; SER1 pointer in the XIOS pointer block

; One group so the CMD has a single CODE descriptor (the 8080 model),
; but the data keeps its own segment.
cgroup	group	code,data

	cseg
	org	100h

start:
	jmps	begin

copyright:
	db	'Copyright (C) 1983, Digital Research'

;-----------------------------------------------------------------------------
; Entry.  Discard anything typed ahead, find the XIOS serial table and count
; the serial adapters; none ends the program.  A command tail selects the
; command line mode, otherwise the screen is run.
;-----------------------------------------------------------------------------
begin:
	mov	ax,cs
	mov	ds,ax
	mov	ss,ax
	mov	sp,0994h
	cld
	call	flushkb
	mov	cl,31h
	int	0e0h
	mov	word ptr xiosseg,es
	mov	ax,es:.xiosser
	mov	xiosptr,ax
	int	11h
	and	ax,0e00h
	jnz	serialok
	mov	si,offset noportmsg
	call	puts
	jmp	terminate

; ah is twice the adapter count: 02h is one adapter, anything else is two.
serialok:
	mov	byte ptr nports,01h
	mov	word ptr nitems,05h
	cmp	ah,02h
	jz	chkarg
	mov	byte ptr nports,02h
	mov	word ptr nitems,0ah

chkarg:
	test	byte ptr .tailbuf,0ffh
	jnz	cmdline
	call	drawscreen
	call	drawmenu
	call	getsettings

screenloop:
	call	showvals
	call	getchoice
	call	word ptr fntable[bx]
	jmp	screenloop

cmdline:
	call	getsettings
	mov	si,tailbuf
	lodsb
	mov	tailptr,si
	mov	ah,00h
	add	si,ax
	mov	word ptr [si],20h

argloop:
	call	nexttoken
	jc	argdone
	call	applytoken
	jmps	argloop

argdone:
	jmp	writeall

badarg:
	mov	si,tailbuf+1
	call	puts
	mov	al,0dh
	call	conout
	mov	al,0ah
	call	conout
	mov	cx,tailptr
	sub	cx,tailbuf
	jz	showhelp

padloop:
	mov	al,20h
	call	conout
	loop	padloop

showhelp:
	mov	si,offset helpmsg
	call	puts
	jmp	terminate

baud1:
	inc	dx

baud0:
	mov	si,offset baudval
	mov	ah,07h
	jmps	cycle

wlen1:
	inc	dx

wlen0:
	mov	si,offset wlenval
	mov	ah,03h
	jmps	cycle

par1:
	inc	dx

par0:
	mov	si,offset parval
	mov	ah,03h
	call	cycle
	cmp	al,02h
	jz	cycleval
	ret

stop1:
	inc	dx

stop0:
	mov	si,offset stopval
	mov	ah,01h

cycle:
	add	si,dx

cycleval:
	mov	al,[si]
	inc	al
	and	al,ah
	mov	[si],al
	ret

showvals:
	mov	al,nports
	mov	portsleft,al
	mov	al,72h
	call	escout
	mov	dx,090eh
	sub	bx,bx

showport:
	mov	si,offset baudtxt
	mov	al,baudval[bx]
	call	showone
	mov	si,offset wlentxt
	mov	al,wlenval[bx]
	call	showone
	mov	si,offset partxt
	mov	al,parval[bx]
	call	showone
	mov	si,offset stoptxt
	mov	al,stopval[bx]
	call	showone
	mov	dx,093dh
	inc	bx
	dec	byte ptr portsleft
	jnz	showport
	mov	al,75h
	jmp	escout

showone:
	push	dx
	mov	ah,00h
	add	ax,ax
	add	ax,ax
	add	si,ax
	call	gotoxy
	mov	cx,04h

showloop:
	lodsb
	call	conout
	loop	showloop
	pop	dx
	add	dh,03h
	ret

doexit:
	mov	si,offset scrnrest
	call	puts

writeall:
	sub	bx,bx
	call	setport
	inc	bx
	call	setport

terminate:
	mov	cl,00h
	mov	dl,00h
	int	0e0h

getsettings:
	les	bx,dword ptr xiosptr
	mov	ax,es:[bx]
	mov	si,offset wlenval
	mov	cx,0302h
	call	unpack
	mov	si,offset stopval
	mov	cx,0101h
	call	unpack
	mov	si,offset parval
	mov	cx,0302h
	call	unpack
	mov	si,offset baudval
	mov	cx,0701h

unpack:
	push	ax
	and	al,ch
	and	ah,ch
	mov	[si],ax
	pop	ax
	ror	ax,cl
	ret

setport:
	mov	al,baudval[bx]
	mov	cl,02h
	shl	ax,cl
	or	al,parval[bx]
	shl	ax,1
	or	al,stopval[bx]
	mov	cl,02h
	shl	ax,cl
	or	al,wlenval[bx]
	les	si,dword ptr xiosptr
	mov	es:[bx+si],al
	mov	ah,00h
	mov	dx,bx
	int	14h
	ret

drawscreen:
	mov	si,offset scrninit
	call	puts
	mov	cx,4eh
	mov	dx,01h
	mov	bl,0c4h
	call	hline
	mov	dx,0201h
	mov	bl,0cdh
	call	hline
	mov	dx,1701h
	mov	bl,0c4h
	call	hline
	mov	cx,16h
	mov	dx,0100h
	mov	bl,0b3h
	call	vline
	mov	dx,014fh
	mov	bl,0b3h
	call	vline
	mov	si,offset corners
	mov	cx,06h

cellloop:
	mov	al,59h
	call	escout
	lodsb
	add	al,20h
	call	conout
	lodsb
	add	al,20h
	call	conout
	lodsb
	call	conout
	loop	cellloop
	mov	si,offset titlestr
	mov	dh,01h
	call	putcent
	mov	si,offset helpline
	mov	dx,0416h
	call	putat
	mov	si,offset port0title
	mov	dx,060eh
	call	putat
	cmp	byte ptr nports,01h
	jnz	port1hdr
	ret

port1hdr:
	mov	si,offset port1title
	mov	dx,0634h
	jmp	putat

hline:
	push	cx
	call	gotoxy

hlloop:
	mov	al,bl
	call	conout
	loop	hlloop
	pop	cx
	ret

vline:
	push	cx

vlloop:
	push	dx
	call	gotoxy
	mov	al,bl
	call	conout
	pop	dx
	inc	dh
	loop	vlloop
	pop	cx
	ret

nexttoken:
	push	ds
	pop	es
	mov	si,tailptr

skipsp:
	inc	si
	cmp	byte ptr [si],20h
	jz	skipsp
	cmp	byte ptr [si],00h
	stc
	jz	tokenret
	mov	di,si
	mov	al,20h
	mov	cx,05h
	repne	scasb
	jz	padtoken
	jmp	badarg

padtoken:
	mov	dx,cx
	mov	di,offset tokbuf
	jcxz	copytoken
	rep	stosb

copytoken:
	mov	cx,04h
	sub	cx,dx
	rep	movsb
	mov	tokend,si
	clc

tokenret:
	ret

applytoken:
	mov	si,offset tokens
	mov	cx,14h
	call	findtoken
	add	si,50h
	lodsw
	mov	bx,ax
	lodsw
	cmp	bx,0620h
	jz	storeval
	add	bx,curport

storeval:
	mov	[bx],al
	ret

findtoken:
	push	ds
	pop	es

findloop:
	push	cx
	push	si
	mov	di,offset tokbuf
	mov	cx,04h
	repe	cmpsb
	pop	si
	pop	cx
	jz	foundtoken
	add	si,04h
	loop	findloop
	jmp	badarg

foundtoken:
	mov	ax,tokend
	mov	tailptr,ax
	ret

drawmenu:
	mov	si,offset menuitems
	mov	cx,nitems

menuloop:
	push	cx
	lodsb
	mov	dh,al
	lodsb
	mov	dl,al
	push	dx
	call	gotoxy
	pop	dx
	inc	dh
	push	si
	mov	si,offset itemfrm
	call	puts
	pop	si
	lodsb
	call	conout
	lodsb
	call	conout
	lodsb
	test	al,al
	jz	menunext
	dec	si
	call	putcent

menunext:
	pop	cx
	loop	menuloop
	ret

putcent:
	push	ds
	pop	es
	mov	di,si
	mov	al,00h
	mov	cx,50h
	repne	scasb
	shr	cx,1
	mov	dl,cl

putat:
	call	gotoxy

puts:
	lodsb

putsloop:
	call	conout
	lodsb
	test	al,al
	jnz	putsloop
	ret

gotoxy:
	mov	al,59h
	call	escout
	add	dx,2020h
	mov	al,dh
	call	conout
	mov	al,dl
	jmp	conout

getchoice:
	mov	di,offset keylist
	mov	cx,nitems

chooseloop:
	push	cx
	push	di
	push	ds
	pop	es
	call	getraw
	mov	al,ah
	sub	al,3ah
	repne	scasb
	pop	di
	pop	cx
	jz	gotchoice
	mov	al,07h
	call	conout
	jmps	chooseloop

gotchoice:
	mov	bl,al
	mov	bh,00h
	dec	bx
	add	bx,bx
	sub	dx,dx
	ret

flushkb:
	mov	cl,0bh
	int	0e0h
	test	al,al
	jz	flushend
	mov	cl,01h
	int	0e0h
	jmps	flushkb

flushend:
	ret

escout:
	push	ax
	mov	al,1bh
	call	conout
	pop	ax

conout:
	push	bx
	push	cx
	push	dx
	push	si
	push	di
	push	es
	mov	dl,al
	mov	cl,06h
	int	0e0h
	cld
	pop	es
	pop	di
	pop	si
	pop	dx
	pop	cx
	pop	bx
	ret

kbhit:
	mov	ah,01h
	int	16h
	ret

getraw:
	mov	ah,00h
	int	16h
	ret

l049e:

; ---- data ----
	dseg
noportmsg	db	'No Serial Communication options instal','led.'
	db	00h
scrninit	db	1bh,45h,1bh,77h,1bh,6eh,1bh,71h,1bh,74h,1bh,75h
	db	00h
scrnrest	db	1bh,45h,1bh,76h,1bh,6dh,00h
corners	db	00h,00h,0dah,00h,4fh,0bfh,02h,00h,0c6h,02h,4fh
	db	0b5h,17h,00h,0c0h,17h,4fh,0d9h
titlestr	db	'CP/M-86 Serial Port Configuration for th'
	db	'e IBM PC   version 1.0',00h
helpline	db	1bh
	db	'rPress function key to advance value.',1bh,75h
	db	00h
port0title	db	'Serial Port 0',00h
port1title	db	'Serial Port 1',00h
itemfrm	db	0dah,0c4h,0c4h,0c4h,0c4h,0bfh,0ah,08h,0b3h,08h
	db	08h,08h,08h,46h,08h,08h,08h,0b3h,0ah,08h,0c0h
	db	0c4h,0c4h,0c4h,0c4h,0d9h,1bh,41h,08h,08h,08h,00h
menuitems	db	08h,15h
	db	'1 Baud Rate',00h
	db	0bh,15h
	db	'3 Word Length',00h
	db	0eh,15h
	db	'5 Parity',00h
	db	11h,15h
	db	'7 Stop Bits',00h
	db	14h,15h
	db	'9 Configure and Exit',00h
	db	08h,34h,32h,20h,00h,0bh,34h,34h,20h,00h,0eh
	db	34h,36h,20h,00h,11h,34h,38h,20h,00h,14h
	db	34h,31h,30h,00h
nports	db	00h
portsleft	db	00h
nitems	dw	00h
xiosptr	dw	00h
xiosseg	dw	00h
keylist	db	01h,03h,05h,07h,09h,02h,04h,06h,08h,0ah
fntable	dw	baud0,baud1,wlen0,wlen1,par0,par1,stop0,stop1,doexit,doexit
curport	dw	00h
baudval	db	00h,00h
wlenval	db	00h,00h
parval	db	00h,00h
stopval	db	00h,00h
tokens	db	'  P0  P1'
baudtxt	db	' 110 150 300 6001200240048009600'
wlentxt	db	'   5   6   7   8'
partxt	db	'NONE ODD????EVEN'
stoptxt	db	'   1   2'
tokvals	dw	offset curport,0,offset curport,1
	dw	offset baudval,0,offset baudval,1,offset baudval,2,offset baudval,3
	dw	offset baudval,4,offset baudval,5,offset baudval,6,offset baudval,7
	dw	offset wlenval,0,offset wlenval,1,offset wlenval,2,offset wlenval,3
	dw	offset parval,0,offset parval,1,offset parval,2,offset parval,3
	dw	offset stopval,0,offset stopval,1
tailptr	dw	00h
tokend	dw	00h
tokbuf	db	00h,00h,00h,00h
helpmsg	db	3fh,0dh,0ah
	db	'Question mark is under the invalid identifier in the command tail.',0dh,0ah,0ah
	db	'Absence of a command tail invokes the sc'
	db	'reen mode.',0dh,0ah
	db	'If a command tail is present, all argume'
	db	'nts must be separated by spaces.',0dh,0ah,0ah
	db	'Valid port identifiers are:          P','0 P1'
	db	0dh,0ah
	db	'Valid speed identifiers are:         110'
	db	' 150 300 600 1200 2400 4800 9600',0dh,0ah
	db	'Valid word length identifiers are:   5 6',' 7 8'
	db	0dh,0ah
	db	'Valid parity identifiers are:        NON'
	db	'E ODD EVEN',0dh,0ah
	db	'Valid stop bit identifiers are:      1 2',0dh
	db	0ah,0ah
	db	'The following example sets Serial Port 0',' to:'
	db	0dh,0ah
	db	'1200 baud, 7 bit odd parity, with 2 stop'
	db	' bits.',0dh,0ah,0ah,'CONFIG P0 1200 7 ODD 2',0dh
	db	0ah,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h

	end
