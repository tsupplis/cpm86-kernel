;-----------------------------------------------------------------------------
; HDMAINT 1.1 - Hard Disk Maintenance for Concurrent CP/M-86 and CP/M-86.
; Copyright (C) 1983 Digital Research.
;
; Reconstructed from base/hdmaint.cmd. hdmtorg.a86 is the invariant copy;
; hdmaint.a86 is the maintained source. make check compares the complete CMD.
; The CP/M and Concurrent repositories currently contain identical originals.
;
; Accepted systems: CP/M-86 2.2 (0022h) and Concurrent CP/M-86 3.1 (1431h).
; Main functions: partition display/create/delete, boot partition selection,
; CP/M volume verification, directory size and write-verification options.
;
; CODE starts at zero. DATA contains the loader base page, two disk records,
; a selected-record copy, serialized boot payloads, a private stack and menus.
; EXTRA has no file bytes but requests 800h paragraphs. Startup aligns its DMA
; segment to a 16K boundary within this 32K allocation, for BIOS transfers.
;
; All host program instructions use mnemonics. Embedded disk sectors are DATA
; payloads: generated includes hold images from mbr.a86, bootsect.a86 and
; loader.a86. Their instruction sources retain the original disk-image layout.
; They are written to the target disk, not executed by the utility. The menu
; streams below use FFh + a near CODE callback, with symbolic DATA operands.
; Original behavior and unused helpers are retained. Verification compares
; bytes without executing the destructive partition/creation operations.
;-----------------------------------------------------------------------------

; Absolute BIOS reset target; no bytes are emitted in this segment.
	cseg	0ffffh
	org	0
bios_reset:

	cseg
	org	0

bios_warm_boot	equ	72h
bios_disk_control	equ	476h
int13_vector	equ	4ch
cpm_key_vector	equ	380h
cpm_key_offset	equ	254eh
ccpm_console_table	equ	0c14h
pd_uda	equ	10h
record_size	equ	4a7h
mbr_partition_offset	equ	1beh
cpm_partition_type	equ	0dbh
sector_signature	equ	0aa55h
f_reset	equ	0h
f_rawio	equ	6h
f_print	equ	9h
f_version	equ	0ch
f_queue_open	equ	87h
f_queue_read	equ	89h
f_queue_write	equ	8bh
f_console	equ	99h
f_sysdata	equ	9ah
f_process	equ	9ch
i_bdos	equ	0e0h
i_xios	equ	0e6h

; Preserve the original redundant CS prefix on the indirect callback CALL.
	codemacro cs_prefix operand:mb
	segfix operand
	endm

entry:
	jmps	start
	db	'Copyright (C) 1983 Digital Research'

;-----------------------------------------------------------------------------
; Set SS:SP to the private DATA stack; align the EXTRA buffer. Preserve flags
; across the stack switch, then dispatch on the exact BDOS version word.
;-----------------------------------------------------------------------------
start:
	pushf
	pop	bx
	cli
	mov	ax,ds
	mov	ss,ax
	mov	sp,offset stack_top
	push	bx
	popf
	mov	ax,es
	add	ax,3ffh
	and	ax,0fc00h
	mov	es,ax
	mov	dma_segment,ax
	mov	cl,f_version
	int	i_bdos
	cmp	ax,1431h
	jz	init_concurrent
	cmp	ax,22h
	jnz	wrong_version
	jmp	init_cpm
wrong_version:
	mov	dx,offset msg_version
	mov	cl,f_print
	int	i_bdos
	jmp	reset_process

;-----------------------------------------------------------------------------
; Concurrent path: reject remote consoles (number >=4), initialize disk access,
; claim the dynamic console and MXdisk queue, and reject open files.
;-----------------------------------------------------------------------------
init_concurrent:
	mov	cl,f_console
	int	i_bdos
	cmp	ax,4h
	jc	check_concurrent_disk
	mov	dx,offset msg_remote_console
	mov	cl,f_print
	int	i_bdos
	jmp	reset_process
check_concurrent_disk:
	mov	al,1h
	mov	concurrent_os,al
	call	initialize_disk_gateway
	or	al,al
	jnz	wrong_version
	call	get_disk_count
	mov	disk_count,al
	or	al,al
	jnz	lock_console_and_disk
no_hard_disk:
	mov	dx,offset msg_no_disk
	mov	cl,f_print
	int	i_bdos
early_exit:
	jmp	reset_process
lock_console_and_disk:
	call	claim_console
	or	al,al
	jnz	early_exit
	mov	cl,f_process
	int	i_bdos
	mov	ax,es:pd_uda[bx]
	mov	uda_segment,ax
	mov	cl,87h
	mov	dx,offset disk_queue
	int	i_bdos
	mov	cl,89h
	mov	dx,offset disk_queue
	int	i_bdos
	call	xios_inhibit_abort
	call	disable_disk_polling
	call	check_open_files
	or	al,al
	jz	lock_console_and_disk_at_00cd
	mov	cl,8bh
	mov	dx,offset disk_queue
	int	i_bdos
	call	restore_console
	mov	dx,offset msg_open_files
	mov	cl,f_print
	int	i_bdos
	jmp	reset_process
lock_console_and_disk_at_00cd:
	mov	al,20h
	int	i_xios
	mov	floppy_count,al
	jmp	install_function_keys

;-----------------------------------------------------------------------------
; Claim the console mutex, find its CCB and require dynamic mode. Save its
; status and function-key pointer, then inhibit console switching.
;-----------------------------------------------------------------------------
claim_console:
	mov	cl,f_console
	int	i_bdos
	mov	console_number,ax
	add	al,30h
	mov	console_queue_digit,al
	mov	cl,87h
	mov	dx,offset console_queue
	int	i_bdos
	mov	cl,89h
	mov	dx,offset console_queue
	int	i_bdos
	mov	cl,f_sysdata
	int	i_bdos
	mov	si,ccpm_console_table
	mov	si,es:[si]
	mov	ax,console_number
	mov	ah,2ch
	mul	ah
	add	ax,si
	add	ax,0eh
	mov	si,ax
	mov	ax,es:[si]
	and	ax,0f000h
	jz	claim_console_at_011b
	mov	dx,offset msg_static_console
	mov	cl,f_print
	int	i_bdos
	mov	al,0ffh
	ret
claim_console_at_011b:
	mov	word ptr console_status_segment,es
	mov	console_status_offset,si
	mov	ax,es:[si]
	mov	saved_console_status,ax
	mov	es:word ptr [si],8h
	mov	si,offset concurrent_console_setup
	call	print_template
	mov	cx,console_number
	mov	al,1fh
	int	i_xios
	mov	key_table_offset,bx
	mov	word ptr key_table_segment,es
	xor	al,al
	ret

;-----------------------------------------------------------------------------
; CP/M 2.2 path: initialize the BIOS disk gateway and obtain the XIOS key-table
; pointer through the INT E0h vector segment and fixed offset 254Eh.
;-----------------------------------------------------------------------------
init_cpm:
	xor	al,al
	mov	concurrent_os,al
	call	initialize_disk_gateway
	or	al,al
	jz	check_cpm_disk
	jmp	wrong_version
check_cpm_disk:
	call	get_disk_count
	mov	disk_count,al
	or	al,al
	jnz	locate_cpm_keys
	jmp	no_hard_disk
locate_cpm_keys:
	mov	si,offset cpm_console_setup
	call	print_template
	mov	ax,0h
	mov	es,ax
	mov	bp,cpm_key_vector
	mov	ax,es:2h[bp]
	mov	key_table_segment,ax
	mov	es,ax
	mov	bp,cpm_key_offset
	mov	ax,es:0h[bp]
	mov	key_table_offset,ax

;-----------------------------------------------------------------------------
; Save ten 20-byte function-key definitions and install the utility key map.
; Build one 4A7h-byte descriptor for each detected hard disk.
;-----------------------------------------------------------------------------
install_function_keys:
	mov	es,word ptr key_table_segment
	mov	bx,key_table_offset
	mov	ax,ds
	mov	es,ax
	mov	di,offset saved_key_definitions
	lds	si,dword ptr key_table_offset
	mov	cx,64h
	rep	movsw
	mov	ax,es
	mov	ds,ax
	mov	si,offset utility_key_definitions
	les	di,dword ptr key_table_offset
	mov	cx,64h
	rep	movsw
	mov	al,disk_count
	xor	ah,ah
	mov	cx,ax
scan_disk:
	push	cx
	mov	al,disk_count
	xor	ah,ah
	sub	al,cl
	push	ax
	mov	bx,4a7h
	mul	bx
	add	ax,offset first_disk
	mov	bx,ax
	pop	ax
	mov	[bx],al
	add	al,floppy_count
	inc	ax
	add	al,41h
	mov	1h[bx],al
	push	bx
	xor	dh,dh
	mov	dl,[bx]
	add	bx,9fh
	push	bx
	mov	ax,ds
	mov	es,ax
	call	get_geometry
	pop	bx
	or	al,al
	jz	disk_geometry_ready
	mov	byte ptr [bx],0h
	dec	byte ptr disk_count
	mov	al,disk_count
	or	al,al
	jnz	scan_disk_at_0201
	mov	cl,9h
	mov	dx,offset msg_no_disk
	int	i_bdos
	jmp	restore_and_exit
scan_disk_at_0201:
	jmp	next_disk

;-----------------------------------------------------------------------------
; Decode BIOS geometry, draw the initial frame, then read the disk MBR.
; An invalid AA55h signature produces an empty table in the in-memory copy.
;-----------------------------------------------------------------------------
disk_geometry_ready:
	mov	al,[bx]
	inc	al
	mul	byte ptr 1h[bx]
	mov	bp,sp
	xchg	bx,0h[bp]
	mov	4h[bx],ax
	xchg	bx,0h[bp]
	mov	ax,2h[bx]
	inc	ax
	pop	bx
	push	bx
	mov	0eh[bx],ax
	cmp	byte ptr frame_drawn,0h
	jnz	read_disk_partitions
	call	draw_frame
	mov	byte ptr frame_drawn,0ffh
read_disk_partitions:
	pop	bx
	push	bx
	xor	dh,dh
	mov	dl,[bx]
	add	bx,0a7h
	mov	ax,ds
	mov	es,ax
	call	read_mbr
	pop	bx
	or	al,al
	jz	check_mbr_signature
	mov	byte ptr error_number,1h
	jmp	fatal_error
check_mbr_signature:
	push	bx
	add	bx,2a5h
	mov	ax,0aa55h
	cmp	ax,[bx]
	jz	decode_partitions
	mov	cx,40h
	mov	si,265h
check_mbr_signature_at_025e:
	pop	bx
	push	bx
	mov	byte ptr [bx+si],0h
	inc	si
	loop	check_mbr_signature_at_025e
	mov	word ptr 2a5h[bx],0aa55h

;-----------------------------------------------------------------------------
; Sort the four partition entries and unpack their 10-bit cylinder limits.
;-----------------------------------------------------------------------------
decode_partitions:
	pop	bx
	push	bx
	mov	byte ptr 2h[bx],0ffh
	call	sort_partitions
	mov	al,268h[bx]
	mov	ah,267h[bx]
	rol	ah,1
	rol	ah,1
	and	ah,3h
	mov	18h[bx],ax
	mov	al,26ch[bx]
	mov	ah,26bh[bx]
	rol	ah,1
	rol	ah,1
	and	ah,3h
	mov	1ah[bx],ax
	mov	al,278h[bx]
	mov	ah,277h[bx]
	rol	ah,1
	rol	ah,1
	and	ah,3h
	mov	1ch[bx],ax
	mov	al,27ch[bx]
	mov	ah,27bh[bx]
	rol	ah,1
	rol	ah,1
	and	ah,3h
	mov	1eh[bx],ax
	mov	al,288h[bx]
	mov	ah,287h[bx]
	rol	ah,1
	rol	ah,1
	and	ah,3h
	mov	20h[bx],ax
	mov	al,28ch[bx]
	mov	ah,28bh[bx]
	rol	ah,1
	rol	ah,1
	and	ah,3h
	mov	22h[bx],ax
	mov	al,298h[bx]
	mov	ah,297h[bx]
	rol	ah,1
	rol	ah,1
	and	ah,3h
	mov	24h[bx],ax
	mov	al,29ch[bx]
	mov	ah,29bh[bx]
	rol	ah,1
	rol	ah,1
	and	ah,3h
	mov	26h[bx],ax

;-----------------------------------------------------------------------------
; Build free cylinder intervals, leaving a minimum ten-cylinder candidate.
; Identify CP/M type DBh and remember its partition-entry offset.
;-----------------------------------------------------------------------------
build_free_extents:
	pop	bx
	push	bx
	mov	di,28h
	add	di,bx
	mov	cx,ds
	mov	es,cx
	mov	cx,0ah
	mov	ax,0ffffh
	rep	stosw
	mov	word ptr 0ch[bx],0h
	mov	byte ptr 3h[bx],0h
	mov	byte ptr 15h[bx],0h
	mov	si,265h
	mov	di,28h
	mov	dx,0h
scan_partition_entry:
	mov	al,4h[bx+si]
	or	al,al
	jz	scan_partition_entry_at_0388
	mov	al,3h[bx+si]
	mov	ah,2h[bx+si]
	rol	ah,1
	rol	ah,1
	and	ah,3h
	mov	cx,ax
	mov	al,7h[bx+si]
	mov	ah,6h[bx+si]
	rol	ah,1
	rol	ah,1
	and	ah,3h
	push	ax
	sub	ax,cx
	inc	ax
	add	ax,0ch[bx]
	mov	0ch[bx],ax
	pop	ax
	cmp	byte ptr 4h[bx+si],0dbh
	jnz	scan_partition_entry_at_0373
	mov	16h[bx],si
	mov	10h[bx],ax
	mov	2c8h[bx],cx
	mov	byte ptr 3h[bx],0ffh
	jmp	scan_partition_entry_at_0388
scan_partition_entry_at_0373:
	sub	cx,0ah
	cmp	cx,dx
	jl	scan_partition_entry_at_0385
	add	cx,9h
	mov	[bx+di],dx
	mov	2h[bx+di],cx
	add	di,4h
scan_partition_entry_at_0385:
	inc	ax
	mov	dx,ax
scan_partition_entry_at_0388:
	add	si,10h
	cmp	si,2a5h
	jnz	scan_partition_entry
check_last_extent:
	mov	cx,0eh[bx]
	sub	cx,0ah
	cmp	cx,dx
	jl	check_last_extent_at_03a6
	add	cx,9h
	mov	[bx+di],dx
	mov	2h[bx+di],cx
	add	di,4h
check_last_extent_at_03a6:
	mov	byte ptr 12h[bx],0h
	cmp	di,28h
	jz	initialize_bad_cylinders
	cmp	byte ptr 3h[bx],0h
	jnz	check_last_extent_at_03c1
	cmp	byte ptr 299h[bx],0h
	jnz	initialize_bad_cylinders
	mov	word ptr 16h[bx],295h
check_last_extent_at_03c1:
	mov	byte ptr 12h[bx],0ffh

;-----------------------------------------------------------------------------
; Initialize the bad-cylinder list, then validate any existing CP/M label
; using its checksum and the default 31-byte identity string.
;-----------------------------------------------------------------------------
initialize_bad_cylinders:
	mov	di,3ch
	add	di,bx
	mov	ax,ds
	mov	es,ax
	mov	ax,0ffffh
	mov	cx,30h
	rep	stosw
	cmp	byte ptr 3h[bx],0h
	jz	use_default_label
read_existing_label:
	pop	bx
	push	bx
	mov	dl,[bx]
	xor	dh,dh
	add	bx,2a7h
	mov	cx,21h[bx]
	mov	ax,ds
	mov	es,ax
	call	read_label
	or	al,al
	jz	validate_existing_label
	pop	bx
	push	bx
	jmp	invalid_existing_label
validate_existing_label:
	pop	bx
	push	bx
	call	label_checksum
	cmp	ax,2a7h[bx]
	jnz	invalid_existing_label
	mov	ax,ds
	mov	es,ax
	mov	si,bx
	add	si,2a9h
	mov	di,offset default_identity
	mov	cx,1fh
	repe	cmpsb
	jz	valid_existing_label
invalid_existing_label:
	mov	byte ptr 15h[bx],0h
	jmp	use_default_label
valid_existing_label:
	mov	byte ptr 15h[bx],0ffh
	inc	byte ptr cpm_volume_count
	call	decode_label
	jmp	next_disk

;-----------------------------------------------------------------------------
; Use a pristine CP/M label when the existing system area is not valid.
;-----------------------------------------------------------------------------
use_default_label:
	mov	di,2a7h
	mov	si,offset default_label
	mov	cx,200h
use_default_label_at_0436:
	mov	al,[si]
	mov	[bx+di],al
	inc	si
	inc	di
	loop	use_default_label_at_0436
next_disk:
	pop	bx
	pop	cx
	dec	cx
	jz	main_menu
	jmp	scan_disk

;-----------------------------------------------------------------------------
; Main menu. Enable verify/options only when a valid CP/M volume exists.
; Menu targets reset SP where needed to discard the previous interaction stack.
;-----------------------------------------------------------------------------
main_menu:
	mov	sp,offset stack_top
main_menu_at_0449:
	call	clear_work_area
	mov	si,offset main_screen
	call	print_template
	mov	ax,101h
	mov	cl,cpm_volume_count
	or	cl,cl
	jz	main_menu_at_0460
	or	ax,44h
main_menu_at_0460:
	mov	bx,offset main_actions
	call	dispatch_menu
	jmps	main_menu_at_0449

;-----------------------------------------------------------------------------
; Choose a physical disk if two are present, then copy its full descriptor
; into selected_disk before displaying the partition operations.
;-----------------------------------------------------------------------------
select_partition_disk:
	mov	sp,offset stack_top
	mov	al,disk_count
	cmp	al,1h
	jz	select_partition_disk_at_0481
	call	clear_work_area
	mov	si,offset partition_disk_title
	call	print_template
	call	choose_disk
	jmp	partition_menu
select_partition_disk_at_0481:
	mov	al,disk1_geometry
	or	al,al
	jz	select_partition_disk_at_048e
	call	select_first_disk
	jmp	partition_menu
select_partition_disk_at_048e:
	call	select_second_disk
	jmp	partition_menu
partition_menu:
	mov	sp,offset stack_top
	call	clear_work_area
	call	display_partitions
	mov	si,offset partition_screen
	call	print_template
	mov	ax,200h
	mov	cl,selected_has_cpm
	or	cl,cl
	jz	partition_menu_at_04b1
	or	ax,2h
partition_menu_at_04b1:
	mov	cl,can_create
	or	cl,cl
	jz	partition_menu_at_04bc
	or	ax,20h
partition_menu_at_04bc:
	mov	cl,selected_disk
	or	cl,cl
	jnz	partition_menu_at_04c7
	or	ax,8h
partition_menu_at_04c7:
	mov	bx,offset partition_actions
	call	dispatch_menu
partition_menu_at_04cd:
	jmp	main_menu

;-----------------------------------------------------------------------------
; Create/replace a CP/M partition. Confirm deletion if a CP/M partition exists,
; then obtain an acceptable starting cylinder and partition length.
;-----------------------------------------------------------------------------
create_partition:
	mov	sp,offset stack_top
	mov	al,selected_has_cpm
	or	al,al
	jz	initialize_new_partition
	call	warn_delete
	mov	ax,140h
	mov	bx,offset replace_actions
	call	dispatch_menu
create_partition_at_04e6:
	call	clear_work_area
	call	display_partitions
initialize_new_partition:
	call	default_partition
	jmp	choose_start_cylinder

;-----------------------------------------------------------------------------
; Starting cylinder must leave at least ten cylinders inside a free extent.
; The no-input F10 result is FFFFh and accepts the proposed value.
;-----------------------------------------------------------------------------
choose_start_cylinder:
	call	clear_partition_display
edit_start_cylinder:
	mov	sp,offset stack_top
	call	limit_default_size
	call	calculate_dpb
	call	display_partitions
	mov	si,offset start_screen
	call	print_template
	call	read_number
	push	ax
	cmp	ax,0ffffh
	jnz	edit_start_cylinder_at_0513
	mov	ax,partition_start
edit_start_cylinder_at_0513:
	mov	bx,offset free_extents
edit_start_cylinder_at_0516:
	cmp	ax,[bx]
	jl	edit_start_cylinder_at_0543
	add	ax,9h
	cmp	ax,2h[bx]
	jg	edit_start_cylinder_at_0537
	sub	ax,9h
	mov	partition_start,ax
	mov	ax,2h[bx]
	mov	maximum_end_cylinder,ax
	pop	ax
	cmp	ax,0ffffh
	jz	edit_start_cylinder_at_054d
	jmp	edit_start_cylinder
edit_start_cylinder_at_0537:
	sub	ax,9h
	add	bx,4h
	cmp	bx,0a93h
	jnz	edit_start_cylinder_at_0516
edit_start_cylinder_at_0543:
	mov	ax,partition_start
	call	beep
	pop	ax
	jmp	edit_start_cylinder
edit_start_cylinder_at_054d:
	call	cursor_off
	jmp	choose_partition_size
beep:
	mov	al,7h
	call	console_out
	ret

;-----------------------------------------------------------------------------
; Choose partition size, constrained to the selected free extent. Display the
; CP/M-86 8 MB compatibility limit, then calculate the volume parameters.
;-----------------------------------------------------------------------------
choose_partition_size:
	call	limit_default_size
	call	clear_partition_display
	mov	byte ptr editing_size,0ffh
edit_partition_size:
	call	calculate_dpb
	call	display_partitions
	mov	si,offset size_screen
	call	print_template
	call	read_number
	cmp	ax,0ffffh
	jz	accept_partition_size
	cmp	ax,0ah
	jl	edit_partition_size_at_0596
	add	ax,partition_start
	dec	ax
	cmp	ax,maximum_end_cylinder
	jg	edit_partition_size_at_0596
	mov	partition_end,ax
	inc	ax
	sub	ax,partition_start
	mov	partition_cylinders_count,ax
	jmp	edit_partition_size
edit_partition_size_at_0596:
	call	beep
	jmp	edit_partition_size
accept_partition_size:
	call	cursor_off
	call	calculate_dpb
	mov	byte ptr editing_size,0h
	call	create_options
	jmp	create_volume

;-----------------------------------------------------------------------------
; Prepare the default label and select the largest free extent. Preserve the
; original free-extent scan and its error handling rather than repairing it.
;-----------------------------------------------------------------------------
default_partition:
	cld
	mov	ax,ds
	mov	es,ax
	mov	si,offset default_label
	mov	di,offset volume_label
	mov	cx,200h
	rep	movsb
	mov	bx,cpm_partition_offset
	add	bx,offset selected_disk
	mov	byte ptr [bx],0h
	mov	byte ptr 4h[bx],0dbh
	sub	bx,0cbch
	mov	ax,bx
	mov	bl,10h
	div	bl
	shl	ax,1
	shl	ax,1
	add	ax,offset partition_cylinders
	mov	current_extent_pointer,ax
	cmp	byte ptr selected_has_cpm,0h
	jz	default_partition_at_05f8
	mov	bx,ax
	mov	ax,2h[bx]
	sub	ax,[bx]
	inc	ax
	sub	ax,assigned_cylinders
	neg	ax
	mov	other_assigned_cylinders,ax
default_partition_at_05f8:
	mov	word ptr [bx],0h
	mov	word ptr 2h[bx],0h
	mov	dx,0h
	mov	bp,0a7fh
default_partition_at_0607:
	mov	ax,2h[bp]
	cmp	ax,0ffffh
	jz	default_partition_at_0630
	sub	ax,0h[bp]
	cmp	ax,dx
	jng	default_partition_at_062c
	mov	dx,ax
	mov	ax,0h[bp]
	mov	[bx],ax
	mov	partition_start,ax
	mov	ax,2h[bp]
	mov	2h[bx],ax
	mov	maximum_end_cylinder,ax
	mov	partition_end,ax
default_partition_at_062c:
	inc	bp
	inc	bp
	jmps	default_partition_at_0607
default_partition_at_0630:
	mov	partition_cylinders_count,dx
	mov	byte ptr volume_flags,0h
	cmp	dx,0ah
	jnl	default_partition_at_0646
	mov	byte ptr error_number,5h
	jmp	fatal_error
default_partition_at_0646:
	mov	ax,4007h
	xor	dx,dx
	mov	bl,last_head
	inc	bl
	xor	bh,bh
	div	bx
	mov	bx,11h
	xor	dx,dx
	div	bx
	add	ax,2h
	mov	maximum_cpm22_cylinders,ax
	mov	byte ptr label_valid,0ffh
	ret

;-----------------------------------------------------------------------------
; Clamp the initial size to the CP/M 2.2 limit and the free-extent endpoint.
;-----------------------------------------------------------------------------
limit_default_size:
	mov	ax,partition_start
	add	ax,maximum_cpm22_cylinders
	dec	ax
	cmp	ax,maximum_end_cylinder
	jng	limit_default_size_at_0679
	mov	ax,maximum_end_cylinder
limit_default_size_at_0679:
	mov	partition_end,ax
	sub	ax,partition_start
	inc	ax
	mov	partition_cylinders_count,ax
	ret

;-----------------------------------------------------------------------------
; Derive CP/M DPB fields from geometry and volume size: block shift/mask,
; extent mask, DSM, DRM, allocation bitmap and reserved-track offset. Also
; calculate directory bounds, spare blocks and the bad-block table parameters.
;-----------------------------------------------------------------------------
calculate_dpb:
	mov	al,last_head
	inc	al
	mov	head_count,al
	mov	al,sectors_per_track
	mov	physical_spt,al
	mov	byte ptr records_per_sector,4h
	mul	byte ptr records_per_sector
	mov	dpb_spt,ax
	mov	ax,partition_cylinders_count
	sub	ax,2h
	xor	dx,dx
	mov	bx,sectors_per_cylinder
	shr	bx,1
	mul	bx
	mov	allocation_records,ax
	cmp	ax,400h
	jng	calculate_dpb_at_06cf
	mov	word ptr directory_size_kb,9h
	mov	byte ptr dpb_bsh,5h
	mov	byte ptr dpb_blm,1fh
	mov	byte ptr dpb_exm,1h
	jmp	calculate_dpb_at_06e4
calculate_dpb_at_06cf:
	mov	word ptr directory_size_kb,2h
	mov	byte ptr dpb_bsh,4h
	mov	byte ptr dpb_blm,0fh
	mov	byte ptr dpb_exm,0h
calculate_dpb_at_06e4:
	mov	al,dpb_blm
	shr	al,1
	shr	al,1
	shr	al,1
	xor	ah,ah
	not	ax
	mov	bx,ax
	and	ax,allocation_records
	mov	allocation_records,ax
calculate_dpb_at_06fa:
	shr	bx,1
	jc	calculate_dpb_at_0702
	shr	ax,1
	jmps	calculate_dpb_at_06fa
calculate_dpb_at_0702:
	dec	ax
	mov	dpb_dsm,ax
	or	ah,ah
	jnz	calculate_dpb_at_0714
	mov	al,dpb_exm
	shl	al,1
	or	al,1h
	mov	dpb_exm,al
calculate_dpb_at_0714:
	mov	ax,allocation_records
	shr	ax,1
	shr	ax,1
	shr	ax,1
	mov	bl,dpb_blm
	xor	bh,bh
	shl	bx,1
	shl	bx,1
	or	bx,3h
	push	bx
	add	ax,bx
	not	bx
	and	ax,bx
	cmp	ax,400h
	jng	calculate_dpb_at_073a
	mov	ax,400h
calculate_dpb_at_073a:
	mov	directory_entries,ax
	shl	ax,1
	mov	maximum_directory_entries,ax
	mov	byte ptr directory_expanded,0h
	pop	cx
	inc	cx
	xor	dx,dx
	div	cx
	mov	cx,ax
	xor	ax,ax
calculate_dpb_at_0751:
	shr	ax,1
	or	ax,8000h
	loop	calculate_dpb_at_0751
	mov	dpb_al0,ah
	mov	dpb_al1,al
	mov	ax,directory_entries
	dec	ax
	mov	dpb_drm,ax
	mov	word ptr dpb_cks,8000h
	mov	al,head_count
	xor	ah,ah
	xor	dx,dx
	mov	cx,partition_start
	inc	cx
	mul	cx
	mov	dpb_off,ax
	mov	bx,current_extent_pointer
	mov	ax,partition_start
	mov	[bx],ax
	mov	ax,partition_end
	mov	2h[bx],ax
	mov	byte ptr large_volume,0h
	mov	ax,partition_cylinders_count
	cmp	ax,maximum_cpm22_cylinders
	jng	calculate_dpb_at_079f
	mov	byte ptr large_volume,0ffh
calculate_dpb_at_079f:
	mov	ax,partition_cylinders_count
	add	ax,other_assigned_cylinders
	mov	assigned_cylinders,ax
	mov	word ptr logical_block_records,10h
	mov	word ptr remap_table_entries,0dch
	mov	word ptr bad_block_count,0h
	mov	ax,partition_cylinders_count
	dec	ax
	mov	bl,physical_spt
	xor	bh,bh
	xor	dx,dx
	mul	bx
	mov	bl,head_count
	mul	bx
	shr	ax,1
	shr	ax,1
	mov	last_spare_block,ax
	mov	ax,maximum_directory_entries
	mov	cl,6h
	shr	ax,cl
	dec	ax
	mov	last_directory_block,ax
	ret

;-----------------------------------------------------------------------------
; Create the volume: remove its old partition entry, write the system track,
; initialize directory blocks, destructively test data blocks, then write the
; checksummed label and MBR. The prompts and confirmations are original.
;-----------------------------------------------------------------------------
create_volume:
	call	clear_work_area
	mov	si,offset create_screen
	call	print_template
	call	poll_create_abort
	mov	al,selected_has_cpm
	or	al,al
	jz	create_volume_at_07fe
	mov	si,offset delete_progress
	call	print_template
	call	delete_cpm_entry
create_volume_at_07fe:
	call	encode_partition
	call	calculate_bad_block_capacity
	call	poll_create_abort
	mov	si,offset create_progress
	call	print_template
	mov	ax,partition_start
	mov	create_cylinder,ax
	call	write_system_track
	or	al,al
	jz	create_directory
	jmp	bad_system_cylinder
create_directory:
	inc	word ptr create_cylinder
	mov	word ptr create_block,0h
create_directory_at_0827:
	call	poll_create_abort
	call	test_block
	or	al,al
	jz	create_directory_at_0834
	jmp	bad_system_cylinder
create_directory_at_0834:
	mov	ax,create_block
	cmp	ax,last_directory_block
	jz	test_data_area
	inc	word ptr create_block
	jmp	create_directory_at_0827
test_data_area:
	call	calculate_bad_block_capacity
	mov	word ptr create_bad_count,0h
	mov	si,offset test_progress
	call	print_template
	mov	ax,partition_start
	inc	ax
	mov	create_cylinder,ax
test_data_area_at_085a:
	mov	si,offset cylinder_progress
	call	print_template
	call	test_cylinder
	mov	ax,create_cylinder
	cmp	ax,partition_end
	jz	commit_volume
	inc	word ptr create_cylinder
	jmps	test_data_area_at_085a
commit_volume:
	call	finalize_bad_blocks
	mov	si,offset enable_progress
	call	print_template
	mov	bx,offset selected_disk
	call	label_checksum
	mov	volume_label,ax
	call	poll_create_abort
	call	write_label
	or	al,al
	jz	commit_volume_at_0896
	mov	byte ptr error_number,4h
	jmp	fatal_error
commit_volume_at_0896:
	call	poll_create_abort
	call	write_mbr
	or	al,al
	jz	commit_volume_at_08a8
	mov	byte ptr error_number,2h
	jmp	fatal_error
commit_volume_at_08a8:
	mov	si,offset create_complete
	call	print_template
	mov	ax,100h
	mov	bx,offset create_actions
	call	dispatch_menu
commit_volume_at_08b7:
	jmp	request_reboot

;-----------------------------------------------------------------------------
; Test each logical block belonging to the current cylinder.
;-----------------------------------------------------------------------------
test_cylinder:
	call	poll_create_abort
	mov	ax,create_cylinder
	call	cylinder_to_blocks
	mov	create_block,ax
test_cylinder_at_08c6:
	push	cx
	call	test_block
	inc	word ptr create_block
	pop	cx
	loop	test_cylinder_at_08c6
	ret

;-----------------------------------------------------------------------------
; Write/read-compare a B66Dh pattern, then E5E5h. Record failures for later
; replacement-block mapping, bounded by the reserved bad-block capacity.
;-----------------------------------------------------------------------------
test_block:
	mov	es,word ptr dma_segment
	mov	di,0h
	mov	cx,400h
	mov	ax,0b66dh
	rep	stosw
	mov	bx,0h
	mov	dl,selected_disk
	xor	dh,dh
	mov	cx,offset volume_label
	mov	ax,create_block
	call	write_block
	or	al,al
	jnz	record_bad_block
	mov	es,word ptr dma_segment
	mov	di,0h
	mov	cx,400h
	mov	ax,0e5e5h
	rep	stosw
	mov	bx,0h
	mov	dl,selected_disk
	xor	dh,dh
	mov	cx,offset volume_label
	mov	ax,create_block
	call	write_block
	or	al,al
	jz	record_bad_block_at_0967
record_bad_block:
	inc	word ptr create_bad_count
	mov	si,offset bad_block_progress
	call	print_template
	mov	si,bad_block_count
	cmp	si,bad_block_capacity
	jz	too_many_bad_blocks
	add	si,si
	mov	bx,offset bad_block_table
	mov	ax,create_block
	mov	[bx+si],ax
	inc	word ptr bad_block_count
	dec	word ptr last_spare_block
	cmp	ax,last_spare_block
	jl	record_bad_block_at_0965
	mov	bx,offset bad_block_table
	mov	si,original_spare_base
	sub	si,create_block
	dec	si
	add	si,si
	mov	di,bad_block_count
	dec	di
	add	di,di
	mov	ax,[bx+si]
	mov	[bx+di],ax
	mov	word ptr [bx+si],0ffffh
record_bad_block_at_0965:
	mov	al,0ffh
record_bad_block_at_0967:
	ret
too_many_bad_blocks:
	mov	byte ptr error_number,5h
	jmp	fatal_error

;-----------------------------------------------------------------------------
; Encode start/end CHS and sector counts into the CP/M partition entry.
; Cylinder zero skips the MBR sector. Retain the AA55h signature.
;-----------------------------------------------------------------------------
encode_partition:
	mov	bx,cpm_partition_offset
	add	bx,offset selected_disk
	mov	byte ptr [bx],0h
	mov	ax,partition_start
	ror	ah,1
	ror	ah,1
	or	ax,ax
	jnz	encode_partition_at_0988
	inc	ah
encode_partition_at_0988:
	inc	ah
	xor	dl,dl
	mov	1h[bx],dl
	mov	2h[bx],ah
	mov	3h[bx],al
	mov	byte ptr 4h[bx],0dbh
	mov	ax,partition_end
	ror	ah,1
	ror	ah,1
	add	ah,physical_spt
	mov	dl,last_head
	mov	5h[bx],dl
	mov	6h[bx],ah
	mov	7h[bx],al
	mov	bp,bx
	mov	ax,partition_start
	mov	bl,head_count
	xor	bh,bh
	xor	dx,dx
	mul	bx
	push	bx
	mov	bl,physical_spt
	xor	bh,bh
	mul	bx
	xor	cx,cx
	or	ax,ax
	jnz	encode_partition_at_09d1
	inc	cx
	inc	ax
encode_partition_at_09d1:
	mov	ds:8h[bp],ax
	mov	ax,partition_cylinders_count
	xor	dx,dx
	mul	bx
	pop	bx
	mul	bx
	sub	ax,cx
	mov	ds:0ch[bp],ax
	mov	word ptr mbr_signature,0aa55h
	ret

;-----------------------------------------------------------------------------
; Calculate how many bad-block entries fit the reserved replacement area.
;-----------------------------------------------------------------------------
calculate_bad_block_capacity:
	mov	ax,last_spare_block
	mov	original_spare_base,ax
	mov	al,dpb_bsh
	cmp	al,4h
	jz	calculate_bad_block_capacity_at_09fe
	mov	ax,8h
	jmps	calculate_bad_block_capacity_at_0a01
calculate_bad_block_capacity_at_09fe:
	mov	ax,1h
calculate_bad_block_capacity_at_0a01:
	xor	dx,dx
	mov	bl,head_count
	xor	bh,bh
	mul	bx
	mov	bl,sectors_per_track
	mul	bx
	mov	bx,logical_block_records
	shr	bx,1
	shr	bx,1
	div	bx
	mov	bad_block_capacity,ax
	ret

;-----------------------------------------------------------------------------
; Finalize remap-table size, replacement mapping and the allocation limit.
;-----------------------------------------------------------------------------
finalize_bad_blocks:
	mov	al,physical_spt
	xor	ah,ah
	mul	byte ptr head_count
	shr	ax,1
	shr	ax,1
	add	ax,bad_block_count
	mov	remap_table_entries,ax
	mov	ax,original_spare_base
	dec	ax
	mov	last_spare_block,ax
	mov	ax,bad_block_count
	cmp	byte ptr dpb_bsh,4h
	jz	finalize_bad_blocks_at_0a47
	inc	ax
	shr	ax,1
finalize_bad_blocks_at_0a47:
	sub	ax,dpb_dsm
	neg	ax
	mov	dpb_dsm,ax
	ret

;-----------------------------------------------------------------------------
; During creation, key X offers a continue/stop confirmation; other keys beep.
;-----------------------------------------------------------------------------
poll_create_abort:
	mov	cl,6h
	mov	dl,0ffh
	int	i_bdos
	or	al,al
	jz	poll_create_abort_at_0a62
	cmp	al,58h
	jnz	poll_create_abort_at_0a63
	call	confirm_create_abort
poll_create_abort_at_0a62:
	ret
poll_create_abort_at_0a63:
	mov	al,7h
	call	console_out
	jmps	poll_create_abort_at_0a62
confirm_create_abort:
	mov	si,offset create_abort_screen
	call	print_template
	mov	ax,140h
	mov	bx,offset create_abort_actions
	call	dispatch_menu
	ret
resume_create:
	mov	si,offset create_resume_screen
	call	print_template
	ret
stop_create:
	jmp	request_reboot

;-----------------------------------------------------------------------------
; A bad system cylinder cannot be remapped. Record it and offer a different
; starting cylinder or stop the creation operation.
;-----------------------------------------------------------------------------
bad_system_cylinder:
	mov	bx,offset bad_cylinders
	mov	cx,30h
bad_system_cylinder_at_0a8a:
	mov	ax,[bx]
	cmp	ax,0ffffh
	jz	bad_system_cylinder_at_0a9d
	inc	bx
