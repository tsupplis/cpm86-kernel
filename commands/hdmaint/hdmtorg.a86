	mov	si,offset next_row_escape
	call	print_template
	loop	clear_partition_display_at_0b96
	ret

;-----------------------------------------------------------------------------
; Render each occupied partition through its display template. Clear unused
; rows and show whether the CP/M system label passed validation.
;-----------------------------------------------------------------------------
display_partitions:
	mov	si,offset partition_header
	call	print_template
	mov	byte ptr partition_display_row,24h
	mov	al,partition1_type
	or	al,al
	jz	display_partitions_at_0bbe
	mov	si,offset partition1_line
	call	print_template
