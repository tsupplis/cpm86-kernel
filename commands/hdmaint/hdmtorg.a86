	jnc	read_digit_at_12e7
	clc
	ret
read_digit_at_12e7:
	mov	al,7h
	call	console_out
	jmp	read_digit
read_digit_at_12ef:
	stc
	ret

;-----------------------------------------------------------------------------
; Draw the initial frame using the shared display-stream interpreter.
;-----------------------------------------------------------------------------
draw_frame:
	mov	si,offset frame_template
	call	print_template
	ret
frame_down:
	push	si
	mov	cx,16h
frame_down_at_12fc:
	mov	si,offset frame_down_escape
	call	print_template
	loop	frame_down_at_12fc
	pop	si
	ret
frame_up:
	push	si
	mov	cx,16h
frame_up_at_130a:
	mov	si,offset frame_up_escape
	call	print_template
	loop	frame_up_at_130a
	pop	si
	ret

;-----------------------------------------------------------------------------
; BIOS function 8 on drive 80h returns the available hard-disk count.
;-----------------------------------------------------------------------------
get_disk_count:
	mov	ah,8h
	mov	dl,80h
	pushf
	callf	dword ptr disk_gateway
	mov	al,dl
	jnc	get_disk_count_at_1323
	mov	al,0h
get_disk_count_at_1323:
	ret

;-----------------------------------------------------------------------------
; Query and unpack maximum head, sectors per track and maximum cylinder.
; Retain the shipped failure path, including its original stack handling.
;-----------------------------------------------------------------------------
get_geometry:
	cld
	push	bx
	xor	ax,ax
	mov	di,bx
	stosw
	stosw
	mov	ah,8h
	or	dl,80h
	pushf
	callf	dword ptr disk_gateway
	jc	get_geometry_at_1350
	pop	di
	cld
	mov	al,dh
	stosb
	mov	al,cl
	and	al,3fh
	stosb
	mov	ah,cl
	mov	al,ch
	rol	ah,1
	rol	ah,1
	and	ah,3h
	stosw
	xor	al,al
get_geometry_at_1350:
	ret

;-----------------------------------------------------------------------------
; Concurrent-only XIOS query rejects open files before disk maintenance.
;-----------------------------------------------------------------------------
check_open_files:
	xor	ax,ax
	test	byte ptr gateway_is_xios,1h
	jz	check_open_files_at_135e
	mov	al,1dh
	int	i_xios
check_open_files_at_135e:
	ret

;-----------------------------------------------------------------------------
; Disk wrappers select 12-byte BIOS request blocks: function, status, drive,
; head, cylinder WORD, sector, count, buffer offset WORD and segment WORD.
;-----------------------------------------------------------------------------
read_mbr_sectors:
	mov	ax,bx
	mov	bx,offset mbr_read_request
	jmp	setup_and_read
write_mbr_sectors:
	mov	ax,bx
	mov	bx,offset mbr_write_request
	call	setup_io_request
	jmp	write_and_compare
read_label_sector:
	mov	ax,bx
	mov	bx,offset label_read_request
	mov	4h[bx],cx
	jmp	setup_and_read
write_label_sector:
	mov	ax,bx
	mov	bx,offset label_write_request
	mov	4h[bx],cx
	call	setup_io_request
	jmp	write_and_compare
read_block:
	mov	si,cx
	push	ax
	mov	ax,bx
	mov	bx,offset block_read_request
	call	setup_io_request
	pop	ax
	call	block_to_chs
	jmp	disk_io
write_block:
	mov	si,cx
	push	ax
	mov	ax,bx
	mov	bx,offset block_write_request
	call	setup_io_request
	pop	ax
	call	block_to_chs
	jmp	write_and_compare
write_boot_sectors:
	mov	ax,bx
	mov	bx,offset boot_write_request
	mov	4h[bx],cx
	mov	byte ptr 7h[bx],10h
	mov	byte ptr 6h[bx],1h
	cmp	cx,0h
	jnz	write_boot_sectors_at_13cd
	add	ax,200h
	inc	byte ptr 6h[bx]
	dec	byte ptr 7h[bx]
write_boot_sectors_at_13cd:
	call	setup_io_request
	jmp	write_and_compare
read_boot_sectors:
	mov	ax,bx
	mov	bx,offset boot_read_request
	mov	4h[bx],cx
	mov	byte ptr 7h[bx],10h
	mov	byte ptr 6h[bx],1h
	cmp	cx,0h
	jnz	read_boot_sectors_at_13f1
	add	ax,200h
	inc	byte ptr 6h[bx]
	dec	byte ptr 7h[bx]
read_boot_sectors_at_13f1:
	jmp	setup_and_read
setup_io_request:
	mov	2h[bx],dl
	mov	8h[bx],ax
	mov	word ptr 0ah[bx],es
	ret
setup_and_read:
	call	setup_io_request
	jmp	disk_io

;-----------------------------------------------------------------------------
; Translate a logical block through the label bad-block map and geometry
; to BIOS CHS, then set transfer length and position in the request block.
;-----------------------------------------------------------------------------
block_to_chs:
	mov	cx,44h[si]
	jcxz	block_to_chs_at_141e
	cld
	lea	di,48h[si]
	push	es
	push	ds
	pop	es
	repne	scasw
	pop	es
	jnz	block_to_chs_at_141e
	inc	cx
	sub	cx,44h[si]
	mov	ax,46h[si]
	add	ax,cx
block_to_chs_at_141e:
	mul	word ptr 40h[si]
	mov	cl,28h[si]
	xor	ch,ch
	div	cx
	mov	cl,26h[si]
	xor	dx,dx
	div	cx
	inc	dl
	mov	6h[bx],dl
	add	ax,36h[si]
	mov	cl,25h[si]
	xor	dx,dx
	div	cx
	mov	4h[bx],ax
	mov	3h[bx],dl
	mov	ax,40h[si]
	shr	ax,1
	shr	ax,1
	mov	7h[bx],al
	ret

;-----------------------------------------------------------------------------
; Write, read back into EXTRA offset 2000h, and compare the sector words.
;-----------------------------------------------------------------------------
write_and_compare:
	mov	byte ptr [bx],3h
	call	disk_io
	or	al,al
	jnz	write_and_compare_at_148a
	push	word ptr 8h[bx]
	mov	word ptr 8h[bx],2000h
	mov	byte ptr [bx],2h
	call	disk_io
	pop	word ptr 8h[bx]
	or	al,al
	jnz	write_and_compare_at_148a
	push	ds
	push	es
	les	di,dword ptr 8h[bx]
	mov	si,2000h
	mov	ch,7h[bx]
	mov	ax,es
	mov	ds,ax
	xor	cl,cl
	cld
	repe	cmpsw
	pop	es
	pop	ds
	mov	al,0h
	jz	write_and_compare_at_148a
	mov	al,0ffh
write_and_compare_at_148a:
	ret

;-----------------------------------------------------------------------------
; Issue BIOS requests through the saved far gateway with PUSHF. Retry up
; to three times, resetting the controller between attempts; error 0Bh stops.
;-----------------------------------------------------------------------------
disk_io:
	push	es
	push	si
	mov	cx,3h
disk_retry:
	push	cx
	push	bx
	mov	ah,[bx]
	mov	al,7h[bx]
	mov	dh,3h[bx]
	mov	dl,2h[bx]
	or	dl,80h
	mov	cx,4h[bx]
	xchg	ch,cl
	ror	cl,1
	ror	cl,1
	and	cl,0c0h
	or	cl,6h[bx]
	les	bx,dword ptr 8h[bx]
	pushf
	callf	dword ptr disk_gateway
	pop	bx
	pop	cx
	mov	1h[bx],ah
	mov	al,0h
	jnc	disk_retry_at_14d5
	cmp	byte ptr 1h[bx],0bh
	jz	disk_retry_at_14d3
	push	cx
	push	bx
	mov	ah,0dh
	pushf
	callf	dword ptr disk_gateway
	pop	bx
	pop	cx
	loop	disk_retry
disk_retry_at_14d3:
	mov	al,0ffh
disk_retry_at_14d5:
	pop	si
	pop	es
	ret

;-----------------------------------------------------------------------------
; Save the BIOS hard-disk controller option byte and mask its low three bits.
; Concurrent obtains the disk gateway via XIOS 1Dh; CP/M uses INT 13h vector.
;-----------------------------------------------------------------------------
initialize_disk_gateway:
	or	al,al
	jz	initialize_disk_gateway_at_14de
	mov	al,0ffh
initialize_disk_gateway_at_14de:
	mov	gateway_is_xios,al
	push	es
	xor	ax,ax
	mov	es,ax
	mov	al,es:.bios_disk_control
	mov	saved_bios_disk_control,al
	and	al,0f8h
	mov	es:.bios_disk_control,al
	test	byte ptr gateway_is_xios,1h
	jz	initialize_disk_gateway_at_150c
	mov	al,1dh
	xor	dx,dx
	mov	cx,dx
	int	i_xios
	mov	ax,dx
	or	ax,cx
	mov	al,0ffh
	jz	initialize_disk_gateway_at_151d
	jmps	initialize_disk_gateway_at_1513
initialize_disk_gateway_at_150c:
	les	cx,es:dword ptr .int13_vector
	mov	dx,es
initialize_disk_gateway_at_1513:
	mov	disk_gateway,cx
	mov	disk_gateway_segment,dx
	xor	al,al
initialize_disk_gateway_at_151d:
	pop	es
	ret

;-----------------------------------------------------------------------------
; Restore the BIOS controller option byte and reset the hard-disk controller.
;-----------------------------------------------------------------------------
restore_disk_gateway:
	push	es
	xor	ax,ax
	mov	es,ax
	mov	al,saved_bios_disk_control
	mov	es:.bios_disk_control,al
	pop	es
	mov	ah,0dh
	mov	dl,80h
	pushf
	callf	dword ptr disk_gateway
	ret

;-----------------------------------------------------------------------------
; Status display uses Concurrent XIOS calls or CP/M escape sequences.
;-----------------------------------------------------------------------------
show_status_message:
	mov	al,concurrent_os
	or	al,al
	jz	show_status_message_at_1548
	push	si
	call	xios_prepare_status
	pop	si
	mov	cx,ds
	call	xios_write_status
	ret
show_status_message_at_1548:
	push	si
	mov	si,offset status_escape
	call	print_template
	pop	si
	inc	si
	call	print_template
	ret
clear_status_message:
	mov	al,concurrent_os
	or	al,al
	jz	clear_status_message_at_1560
	call	xios_clear_status
	ret
clear_status_message_at_1560:
	mov	si,offset status_clear_escape
	call	print_template
	ret

;-----------------------------------------------------------------------------
; Concurrent XIOS wrappers; ES is restored to the saved UDA segment.
;-----------------------------------------------------------------------------
xios_clear_status:
	mov	al,12h
	jmps	xios_call
xios_prepare_status:
	mov	al,13h
	jmps	xios_call
xios_write_status:
	mov	al,15h
	jmps	xios_call
xios_inhibit_abort:
	mov	al,18h
	jmps	xios_call
disable_disk_polling:
	mov	ah,0h
	jmps	xios_disk_polling
enable_disk_polling:
	mov	ah,0ffh
xios_disk_polling:
	mov	al,21h
	jmps	xios_call
xios_call:
	mov	es,word ptr uda_segment
	int	i_xios
	ret

