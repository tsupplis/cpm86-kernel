read_number_at_129b:
	mov	al,7h
	call	console_out
	jmp	read_number_at_128b
read_number_at_12a3:
	push	ax
	call	console_out
	mov	al,20h
	call	console_out
	mov	al,20h
	call	console_out
	mov	al,8h
	call	console_out
	mov	al,8h
	call	console_out
	pop	ax
	sub	al,30h
	mov	cl,al
	mov	ax,number_value
	mov	bx,0ah
	mul	bx
	xor	ch,ch
	add	ax,cx
