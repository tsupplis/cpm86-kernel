	jnz	cycle_boot_partition_at_0b87
	loop	cycle_boot_partition_at_0b78
	jmp	boot_partition_menu_at_0b35
cycle_boot_partition_at_0b87:
	mov	byte ptr [bx],80h
	jmp	boot_partition_menu_at_0b35

;-----------------------------------------------------------------------------
; Clear the partition information area before redrawing.
