	loop	bad_system_cylinder_at_0a8a
	mov	byte ptr error_number,5h
	jmp	fatal_error
bad_system_cylinder_at_0a9d:
	mov	ax,create_cylinder
	mov	[bx],ax
	mov	si,offset bad_system_screen
	call	print_template
	mov	ax,140h
	mov	bx,offset bad_system_actions
	call	dispatch_menu
bad_system_cylinder_at_0ab1:
	jmp	fatal_error
retry_start_cylinder:
	mov	ax,partition_start
	cmp	ax,create_cylinder
	jz	retry_start_cylinder_at_0abe
	inc	ax
retry_start_cylinder_at_0abe:
	inc	ax
	mov	partition_start,ax
	sub	ax,partition_end
	neg	ax
	inc	ax
	cmp	ax,0ah
	jl	retry_start_cylinder_at_0ad7
	mov	partition_end,ax
retry_start_cylinder_at_0ad1:
	call	clear_work_area
	jmp	edit_start_cylinder
retry_start_cylinder_at_0ad7:
	call	default_partition
	jmps	retry_start_cylinder_at_0ad1

;-----------------------------------------------------------------------------
; Delete a CP/M volume only through the existing confirmation menu.
;-----------------------------------------------------------------------------
delete_volume:
	mov	sp,offset stack_top
	call	warn_delete
	mov	ax,140h
	mov	bx,offset delete_actions
	call	dispatch_menu
	jmp	request_reboot
cancel_delete:
	jmp	main_menu
confirm_delete:
	mov	si,offset delete_message
	call	print_template

;-----------------------------------------------------------------------------
; Find the type-DBh partition entry, zero its 16 bytes, and write the MBR.
;-----------------------------------------------------------------------------
delete_cpm_entry:
	mov	bx,offset partition_table
delete_cpm_entry_at_0afa:
	mov	al,4h[bx]
	cmp	al,0dbh
	jz	delete_cpm_entry_at_0b06
	add	bx,10h
	jmps	delete_cpm_entry_at_0afa
delete_cpm_entry_at_0b06:
	mov	si,0h
	mov	cx,10h
delete_cpm_entry_at_0b0c:
	mov	byte ptr [bx+si],0h
	inc	si
	loop	delete_cpm_entry_at_0b0c
	call	write_mbr
	or	al,al
	jz	delete_cpm_entry_at_0b21
	mov	byte ptr error_number,2h
	jmp	fatal_error
delete_cpm_entry_at_0b21:
	ret
warn_delete:
	call	clear_partition_display
	mov	si,offset delete_warning
	call	print_template
	ret

;-----------------------------------------------------------------------------
; Show the boot selection menu and write the selected active partition.
;-----------------------------------------------------------------------------
boot_partition_menu:
	call	clear_partition_display
	mov	si,offset boot_screen
	call	print_template
boot_partition_menu_at_0b35:
	mov	sp,offset stack_top
	call	display_partitions
	mov	ax,202h
	mov	bx,offset boot_actions
	call	dispatch_menu
boot_partition_menu_at_0b44:
	call	write_mbr
	or	al,al
	jz	boot_partition_menu_at_0b53
	mov	byte ptr error_number,2h
	jmp	fatal_error
boot_partition_menu_at_0b53:
	jmp	main_menu

;-----------------------------------------------------------------------------
; Cycle the active (80h) marker among occupied partition entries.
;-----------------------------------------------------------------------------
cycle_boot_partition:
	mov	bx,offset partition_table
	mov	cx,4h
cycle_boot_partition_at_0b5c:
	cmp	byte ptr [bx],80h
	jz	cycle_boot_partition_at_0b6f
	add	bx,10h
	loop	cycle_boot_partition_at_0b5c
