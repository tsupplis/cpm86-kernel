verify_volume_at_0c79:
	call	verify_block
	or	al,al
	jnz	verify_volume_at_0c8f
	mov	ax,last_directory_block
	cmp	ax,verify_block_number
	jz	verify_volume_at_0c95
	inc	word ptr verify_block_number
	jmps	verify_volume_at_0c79
verify_volume_at_0c8f:
	mov	si,offset verify_system_error
	call	print_template
verify_volume_at_0c95:
	mov	word ptr verify_bad_count,0h
	mov	ax,partition_start
	inc	ax
	mov	verify_cylinder_number,ax
verify_volume_at_0ca2:
	mov	si,offset verify_cylinder_progress
	call	print_template
	call	verify_cylinder
	mov	ax,partition_end
	cmp	ax,verify_cylinder_number
	jz	verify_volume_at_0cbb
	inc	word ptr verify_cylinder_number
	jmp	verify_volume_at_0ca2
verify_volume_at_0cbb:
	mov	si,offset verify_complete
	call	print_template
	mov	bx,offset verify_done_actions
	mov	ax,280h
	call	dispatch_menu
	ret

;-----------------------------------------------------------------------------
; Verify each logical block in the current cylinder and count read failures.
;-----------------------------------------------------------------------------
verify_cylinder:
	call	poll_verify_abort
	mov	ax,verify_cylinder_number
	call	cylinder_to_blocks
	mov	verify_block_number,ax
verify_cylinder_at_0cd7:
	push	cx
	call	verify_block
	inc	word ptr verify_block_number
	pop	cx
	loop	verify_cylinder_at_0cd7
	ret
verify_block:
	mov	ax,dma_segment
	mov	es,ax
	mov	ax,verify_block_number
	mov	dl,selected_disk
	xor	dh,dh
	mov	cx,offset volume_label
	mov	bx,0h
	call	read_block
	or	al,al
	jz	verify_block_at_0d0a
	inc	word ptr verify_bad_count
	mov	si,offset verify_error_progress
	call	print_template
	mov	al,0ffh
verify_block_at_0d0a:
	ret

;-----------------------------------------------------------------------------
; During verification, key E invokes the continue/stop menu.
;-----------------------------------------------------------------------------
poll_verify_abort:
	mov	cl,6h
	mov	dl,0ffh
	int	i_bdos
	or	al,al
	jz	poll_verify_abort_at_0d1c
	cmp	al,45h
	jnz	poll_verify_abort_at_0d1e
	call	confirm_verify_abort
poll_verify_abort_at_0d1c:
	cld
	ret
poll_verify_abort_at_0d1e:
	mov	al,7h
	call	console_out
	jmps	poll_verify_abort
confirm_verify_abort:
	mov	si,offset verify_abort_screen
	call	print_template
	mov	ax,280h
	mov	bx,offset verify_abort_actions
	call	dispatch_menu
	ret
resume_verify:
	mov	si,offset verify_resume_screen
	call	print_template
	ret
stop_verify:
	jmp	main_menu

;-----------------------------------------------------------------------------
; Choose the CP/M volume whose options will be edited.
;-----------------------------------------------------------------------------
select_options_disk:
	mov	al,cpm_volume_count
	cmp	al,2h
	jnz	select_options_disk_at_0d55
	call	clear_work_area
	mov	si,offset options_title
	call	print_template
	call	choose_disk
	jmp	change_options
select_options_disk_at_0d55:
	mov	al,disk1_has_cpm
	or	al,al
	jz	select_options_disk_at_0d62
	call	select_first_disk
	jmp	change_options
select_options_disk_at_0d62:
	call	select_second_disk

;-----------------------------------------------------------------------------
; Edit options, recompute the label checksum and write the label sector.
;-----------------------------------------------------------------------------
change_options:
	mov	byte ptr creating_volume,0h
	mov	bx,offset options_actions
	call	options_menu
	mov	bx,offset selected_disk
	call	label_checksum
	mov	volume_label,ax
	call	write_label
	or	al,al
	jz	change_options_at_0d88
	mov	byte ptr error_number,4h
	jmp	fatal_error
change_options_at_0d88:
	jmp	main_menu

;-----------------------------------------------------------------------------
; Creation-time options share the editor, with a different menu vector.
;-----------------------------------------------------------------------------
create_options:
	mov	byte ptr creating_volume,1h
	mov	bx,offset create_options_actions
	mov	byte ptr directory_expanded,0h

;-----------------------------------------------------------------------------
; Show directory-size and write-verify options. Directory expansion is
; one-way; the confirmation updates DRM and the volume flag byte.
;-----------------------------------------------------------------------------
options_menu:
	push	bx
	call	clear_work_area
	pop	bx
	mov	al,volume_flags
	ror	al,1
	sbb	al,al
	mov	verify_writes,al
	mov	byte ptr keep_directory_size,0ffh
	push	bx
	mov	si,offset options_screen
	call	print_template
options_menu_at_0db3:
	mov	al,directory_expanded
	or	al,al
	mov	ax,0h
	jnz	options_menu_at_0dc0
	mov	ax,2h
options_menu_at_0dc0:
	add	ax,208h
	pop	bx
	push	bx
	call	dispatch_menu
	jmp	options_menu_at_0db3
accept_options:
	pop	bx
	pop	bx
	mov	al,verify_writes
	and	al,1h
	mov	ah,volume_flags
	and	ah,0feh
	or	al,ah
	mov	volume_flags,al
	mov	al,keep_directory_size
	or	al,al
	jnz	accept_options_at_0df9
	mov	ax,maximum_directory_entries
	mov	directory_entries,ax
	mov	byte ptr directory_expanded,0ffh
	mov	ax,dpb_drm
	add	ax,ax
	inc	ax
	mov	dpb_drm,ax
accept_options_at_0df9:
	ret

;-----------------------------------------------------------------------------
; Toggle the requested directory-size option and redraw its field.
;-----------------------------------------------------------------------------
toggle_directory:
	not	byte ptr keep_directory_size
	mov	si,offset directory_option
	call	print_template
	ret

;-----------------------------------------------------------------------------
; Toggle write verification and redraw its field.
;-----------------------------------------------------------------------------
toggle_write_verify:
	not	byte ptr verify_writes
	mov	si,offset write_verify_option
	call	print_template
	ret

;-----------------------------------------------------------------------------
; Fatal error: show status, wait for D for details, then require reboot.
;-----------------------------------------------------------------------------
fatal_error:
	mov	si,offset error_console_mode
	call	print_template
	mov	si,offset error_status
	call	show_status_message
fatal_error_at_0e1c:
	call	read_key
	and	al,5fh
	cmp	al,44h
	jnz	fatal_error_at_0e1c
	call	clear_status_message
	call	clear_work_area
	mov	si,offset error_details
	jmp	request_reboot_at_0e37

;-----------------------------------------------------------------------------
; Request a system diskette and confirmation before rebooting.
;-----------------------------------------------------------------------------
request_reboot:
	call	clear_work_area
	mov	si,offset reboot_screen
request_reboot_at_0e37:
	call	print_template
	mov	ax,100h
	mov	bx,offset reboot_actions
	call	dispatch_menu

;-----------------------------------------------------------------------------
; Restore disk state, set the BIOS warm-boot flag and jump to FFFF:0000.
;-----------------------------------------------------------------------------
reboot:
	call	restore_disk_gateway
	mov	ax,40h
	mov	ds,ax
	mov	word ptr .bios_warm_boot,1234h
	jmpf	bios_reset

;-----------------------------------------------------------------------------
; Normal exit restores BIOS disk state and the saved function-key definitions.
; Concurrent additionally restores CCB state, polling and both mutex queues.
;-----------------------------------------------------------------------------
exit_program:
	mov	si,offset exit_console_mode
	call	print_template
restore_and_exit:
	call	restore_disk_gateway
	les	di,dword ptr key_table_offset
	mov	si,offset saved_key_definitions
	mov	cx,64h
	rep	movsw
	mov	al,concurrent_os
	or	al,al
	jz	restore_and_exit_at_0e75
	jmp	release_concurrent
restore_and_exit_at_0e75:
	jmp	restore_cpm_console
release_concurrent:
	call	restore_console
	call	enable_disk_polling
	mov	cl,8bh
	mov	dx,offset disk_queue
	int	i_bdos
	mov	cl,8bh
	mov	dx,offset console_queue
	int	i_bdos
reset_process:
	mov	cl,f_reset
	int	i_bdos
	jmps	reset_process
restore_console:
	mov	si,offset restore_concurrent_mode
	call	print_template
	les	si,dword ptr console_status_offset
	mov	ax,saved_console_status
	mov	es:[si],ax
	ret
restore_cpm_console:
	mov	si,offset restore_cpm_mode
	call	print_template
	jmp	reset_process

;-----------------------------------------------------------------------------
; AX is a ten-bit key-enable mask; BX points to ten near CODE targets.
; Populate enabled_keys, read an accepted F-key and jump to its vector entry.
;-----------------------------------------------------------------------------
dispatch_menu:
	push	bx
	mov	bx,offset disk_actions
	mov	cx,0ah
dispatch_menu_at_0eb3:
	ror	ax,1
	sbb	dl,dl
	dec	bx
	mov	[bx],dl
	loop	dispatch_menu_at_0eb3
	call	read_menu_key
	pop	bx
	shl	cx,1
	mov	ax,bx
	add	ax,cx
	mov	bx,ax
	jmp	word ptr [bx]

;-----------------------------------------------------------------------------
; Common physical-disk chooser; its callbacks select a saved disk record.
;-----------------------------------------------------------------------------
choose_disk:
	mov	si,offset disk_screen
	call	print_template
	mov	ax,20ah
	mov	bx,offset disk_actions
	call	dispatch_menu
	ret
cancel_disk:
	pop	ax
	jmp	main_menu
select_first_disk:
	mov	si,offset first_disk
	jmps	copy_selected_disk
select_second_disk:
	mov	si,offset second_disk

;-----------------------------------------------------------------------------
; Copy the selected 4A7h-byte descriptor into the working record.
;-----------------------------------------------------------------------------
copy_selected_disk:
	mov	cx,4a7h
	mov	di,offset selected_disk
	mov	ax,ds
	mov	es,ax
	cld
	rep	movsb
	ret

;-----------------------------------------------------------------------------
; Convert a cylinder to its first logical block and number of blocks.
;-----------------------------------------------------------------------------
cylinder_to_blocks:
	sub	ax,partition_start
	dec	ax
	mov	cx,sectors_per_cylinder
	xor	dx,dx
	mul	cx
	shr	ax,1
	shr	ax,1
	mov	cx,sectors_per_cylinder
	shr	cx,1
	shr	cx,1
	ret

;-----------------------------------------------------------------------------
; Decode an existing volume label into directory and allocation metadata.
;-----------------------------------------------------------------------------
decode_label:
	mov	al,2d3h[bx]
	inc	al
	xor	ah,ah
	push	ax
	mov	dh,2d9h[bx]
	mov	dl,2dah[bx]
	mov	cx,10h
	mov	ax,0h
decode_label_at_0f25:
	rol	dx,1
	adc	al,0h
	loop	decode_label_at_0f25
	pop	cx
	push	cx
	mul	cl
	mov	cx,4h
	mul	cx
	mov	6h[bx],ax
	mov	cx,2d7h[bx]
	inc	cx
	mov	8h[bx],cx
	mov	byte ptr 0bh[bx],0h
	cmp	cx,ax
	jnz	decode_label_at_0f4b
	mov	byte ptr 0bh[bx],0ffh
decode_label_at_0f4b:
	mov	ax,6h[bx]
	mov	cl,6h
	shr	ax,cl
	dec	ax
	mov	0a3h[bx],ax
	mov	ax,2d5h[bx]
	inc	ax
	pop	cx
	shr	cx,1
	shr	cx,1
	shr	cx,1
	mul	cx
	mov	13h[bx],ax
	ret

;-----------------------------------------------------------------------------
; Label checksum is the negative sum of the 255 words after its first word.
;-----------------------------------------------------------------------------
label_checksum:
	mov	si,2a9h
	mov	cx,0ffh
	mov	ax,0h
label_checksum_at_0f72:
	add	ax,[bx+si]
	add	si,2h
	loop	label_checksum_at_0f72
	neg	ax
	ret

;-----------------------------------------------------------------------------
; Sort occupied partition entries by their relative starting-sector fields.
;-----------------------------------------------------------------------------
sort_partitions:
	mov	si,265h
	mov	cx,3h
sort_partitions_at_0f82:
	mov	di,si
	add	di,10h
sort_partitions_at_0f87:
	mov	al,4h[bx+si]
	mov	ah,4h[bx+di]
	cmp	ah,0h
	jz	sort_partitions_at_0fbd
	cmp	al,0h
	jnz	sort_partitions_at_0f98
	jmps	sort_partitions_at_0fa8
sort_partitions_at_0f98:
	mov	ax,0ah[bx+si]
	cmp	ax,0ah[bx+di]
	jg	sort_partitions_at_0fa8
	mov	ax,8h[bx+si]
	cmp	ax,8h[bx+di]
	jl	sort_partitions_at_0fbd
sort_partitions_at_0fa8:
	push	cx
	push	si
	push	di
	mov	cx,10h
sort_partitions_at_0fae:
	mov	al,[bx+si]
	mov	ah,[bx+di]
	mov	[bx+si],ah
	mov	[bx+di],al
	inc	si
	inc	di
	loop	sort_partitions_at_0fae
	pop	di
	pop	si
	pop	cx
sort_partitions_at_0fbd:
	add	di,10h
	cmp	di,2a5h
	jnz	sort_partitions_at_0f87
	add	si,10h
	loop	sort_partitions_at_0f82
	ret

;-----------------------------------------------------------------------------
; Read the MBR through the aligned EXTRA buffer, then copy its 512 bytes
; into the caller's DATA buffer, preserving the disk result flags.
;-----------------------------------------------------------------------------
read_mbr:
	push	es
	push	bx
	mov	es,word ptr dma_segment
	mov	bx,0h
	call	read_mbr_sectors
	pop	bx
	pop	es
	push	si
	push	di
	push	ds
	pushf
	mov	ds,word ptr dma_segment
	mov	di,bx
	mov	si,0h
	mov	cx,100h
	cld
	rep	movsw
	popf
	pop	ds
	pop	di
	pop	si
	ret

;-----------------------------------------------------------------------------
; Install the default MBR bootstrap while retaining the selected partition
; table, copy the sector to EXTRA, and perform a verified write.
;-----------------------------------------------------------------------------
write_mbr:
	cld
	mov	si,offset default_mbr
	mov	ax,ds
	mov	es,ax
	mov	di,offset mbr_buffer
	mov	cx,1beh
	rep	movsb
	mov	si,offset mbr_buffer
	mov	ax,dma_segment
	mov	es,ax
	mov	di,0h
	mov	cx,200h
	rep	movsb
	mov	bx,0h
	mov	dl,selected_disk
	xor	dh,dh
	jmp	write_mbr_sectors

;-----------------------------------------------------------------------------
; Read a CP/M label sector through EXTRA offset 600h into DATA.
;-----------------------------------------------------------------------------
read_label:
	push	es
	push	bx
	mov	es,word ptr dma_segment
	mov	bx,600h
	call	read_label_sector
	pop	bx
	pop	es
	push	si
	push	di
	push	ds
	pushf
	mov	ds,word ptr dma_segment
	mov	di,bx
	mov	si,600h
	mov	cx,100h
	cld
	rep	movsw
	popf
	pop	ds
	pop	di
	pop	si
	ret

;-----------------------------------------------------------------------------
; Copy the selected label to EXTRA offset 600h and write it with comparison.
;-----------------------------------------------------------------------------
write_label:
	cld
	mov	ax,dma_segment
	mov	es,ax
	mov	si,offset volume_label
	mov	di,600h
	mov	cx,200h
	rep	movsb
	mov	bx,600h
	mov	dl,selected_disk
	xor	dh,dh
	mov	cx,partition_start
	jmp	write_label_sector

;-----------------------------------------------------------------------------
; Copy the 8K system-track payload to EXTRA, overlay the selected label at
; 600h, then write the boot area (skipping sector one on cylinder zero).
;-----------------------------------------------------------------------------
write_system_track:
	cld
	mov	ax,dma_segment
	mov	es,ax
	mov	si,offset default_boot_copy1
	mov	di,0h
	push	di
	mov	cx,2000h
	rep	movsb
	mov	si,offset volume_label
	mov	di,600h
	mov	cx,200h
	rep	movsb
	pop	bx
	mov	cx,partition_start
	mov	dl,selected_disk
	xor	dh,dh
	jmp	write_boot_sectors
unused_return:
	ret

;-----------------------------------------------------------------------------
; Display stream interpreter. NUL ends a stream; ordinary bytes go to the
; console; FFh consumes a near CODE callback that may also consume operands.
;-----------------------------------------------------------------------------
print_template:
	push	cx
	push	dx
template_next:
	lodsb
	or	al,al
	jz	template_next_at_10a1
	cmp	al,0ffh
	jz	template_callback
	call	console_out
	jmps	template_next
template_next_at_10a1:
	pop	dx
	pop	cx
	ret
template_callback:
	lodsw
	mov	bx,ax
	cs_prefix	cs:byte ptr [bx]
	call	bx
	jmp	template_next

;-----------------------------------------------------------------------------
; Select OS-specific cursor visibility escape sequences.
;-----------------------------------------------------------------------------
cursor_on:
	push	si
	mov	al,concurrent_os
	or	al,al
	jz	cursor_on_at_10ba
	mov	si,offset concurrent_cursor_on
	jmps	cursor_on_at_10bd
cursor_on_at_10ba:
	mov	si,offset cpm_cursor_on
cursor_on_at_10bd:
	call	print_template
	pop	si
	ret
cursor_off:
	push	si
	mov	al,concurrent_os
	or	al,al
	jz	cursor_off_at_10cf
	mov	si,offset concurrent_cursor_off
	jmps	cursor_on_at_10bd
cursor_off_at_10cf:
	mov	si,offset cpm_cursor_off
	jmps	cursor_on_at_10bd

;-----------------------------------------------------------------------------
; Display callback: fetch a DATA word pointer and print three decimal digits.
;-----------------------------------------------------------------------------
template_number3:
	lodsw
	mov	bx,ax
	mov	ax,[bx]
	call	print_number3
	ret

;-----------------------------------------------------------------------------
; Display callback: fetch a DATA byte pointer and print its character.
;-----------------------------------------------------------------------------
template_character:
	lodsw
	mov	bx,ax
	mov	al,[bx]
	call	console_out
	ret

;-----------------------------------------------------------------------------
; Display callback: consume row/column bytes and emit VT52 ESC Y coordinates.
;-----------------------------------------------------------------------------
template_position:
	mov	al,1bh
	call	console_out
	mov	al,59h
	call	console_out
	lodsb
	add	al,20h
	call	console_out
	lodsb
	add	al,20h
	call	console_out
	ret

;-----------------------------------------------------------------------------
; Display callback: position and render the requested function-key caption.
;-----------------------------------------------------------------------------
template_key_caption:
	call	template_position
	xor	ax,ax
	lodsb
	mov	bx,ax
	dec	bx
	shl	bx,1
	mov	ax,word ptr key_captions[bx]
	mov	key_caption_value,ax
	push	si
	mov	si,offset key_caption_template
	call	print_template
	pop	si
	ret

;-----------------------------------------------------------------------------
; Display callbacks for blink and reverse-video modes.
;-----------------------------------------------------------------------------
blink_on:
	mov	al,1bh
	call	console_out
	mov	al,72h
	call	console_out
	ret
blink_off:
	mov	al,1bh
	call	console_out
	mov	al,75h
	call	console_out
	ret
reverse_on:
	mov	al,1bh
	call	console_out
	mov	al,73h
	call	console_out
	ret
reverse_off:
	mov	al,1bh
	call	console_out
	mov	al,74h
	call	console_out
	ret

;-----------------------------------------------------------------------------
; Conditional callbacks consume a DATA byte pointer and comparison byte.
; A nested NUL-terminated stream is parsed even when output is suppressed.
;-----------------------------------------------------------------------------
template_if_equal:
	lodsw
	mov	bx,ax
	lodsb
	cmp	al,[bx]
	jz	emit_nested_template
	jmp	suppress_template
template_if_not_equal:
	lodsw
	mov	bx,ax
	lodsb
	cmp	al,[bx]
	jnz	emit_nested_template
suppress_template:
	mov	al,output_enabled
	push	ax
	mov	byte ptr output_enabled,0h
	call	print_template
	pop	ax
	mov	output_enabled,al
	ret
emit_nested_template:
	call	print_template
	ret

;-----------------------------------------------------------------------------
; Output AL through BDOS raw console I/O only when output_enabled is set.
;-----------------------------------------------------------------------------
console_out:
	mov	ah,output_enabled
	or	ah,ah
	jz	console_out_at_117e
	push	si
	push	cx
	mov	dl,al
	mov	cl,f_rawio
	int	i_bdos
	pop	cx
	pop	si
console_out_at_117e:
	ret

;-----------------------------------------------------------------------------
; Display callback: print an unsigned DATA word in decimal.
;-----------------------------------------------------------------------------
template_decimal:
	lodsw
	mov	bx,ax
	mov	ax,[bx]
	mov	cx,0h
template_decimal_at_1187:
	sub	dx,dx
	mov	bx,0ah
	div	bx
	add	dl,30h
	push	dx
	inc	cx
	test	ax,ax
	jnz	template_decimal_at_1187
template_decimal_at_1197:
	pop	dx
	push	cx
	mov	al,dl
	call	console_out
	pop	cx
	loop	template_decimal_at_1197
	ret

;-----------------------------------------------------------------------------
; Print the low three decimal digits, including leading zeroes.
;-----------------------------------------------------------------------------
print_number3:
	mov	byte ptr decimal_width,3h
	mov	cx,0h
print_number3_at_11aa:
	sub	dx,dx
	mov	bx,0ah
	div	bx
	add	dl,30h
	push	dx
	inc	cx
	dec	byte ptr decimal_width
	jnz	print_number3_at_11aa
print_number3_at_11bc:
	pop	dx
	push	cx
	mov	al,dl
	call	console_out
	pop	cx
	loop	print_number3_at_11bc
	ret

;-----------------------------------------------------------------------------
; Unused shared hexadecimal display helpers.
;-----------------------------------------------------------------------------
print_hex_word:
	push	ax
	mov	al,ah
	call	print_hex_byte
	pop	ax
print_hex_byte:
	push	ax
	ror	ax,1
	ror	ax,1
	ror	ax,1
	ror	ax,1
	call	print_hex_digit
	pop	ax
print_hex_digit:
	and	ax,0fh
	add	al,30h
	cmp	al,39h
	jng	print_hex_digit_at_11e6
	add	al,7h
print_hex_digit_at_11e6:
	mov	dx,ax
	mov	al,dl
	call	console_out
	ret

;-----------------------------------------------------------------------------
; Display callback: clear rows from the supplied row through row 22.
;-----------------------------------------------------------------------------
template_clear_rows:
	lodsb
	add	al,20h
template_clear_rows_at_11f1:
	mov	clear_row,al
	mov	al,1bh
	call	console_out
	mov	al,59h
	call	console_out
	mov	al,clear_row
	call	console_out
	mov	al,20h
	call	console_out
	call	clear_line
	mov	al,clear_row
	inc	al
	cmp	al,37h
	jnz	template_clear_rows_at_11f1
	ret
clear_work_area:
	mov	cx,14h
	mov	si,offset work_area_position
	call	print_template
clear_work_area_at_121f:
	call	clear_line
	mov	si,offset next_row_escape
	call	print_template
	loop	clear_work_area_at_121f
	ret
clear_line:
	push	si
	mov	si,offset clear_line_escape
	call	print_template
	pop	si
	ret

;-----------------------------------------------------------------------------
; Raw console input polls BDOS 6; flush_keys discards pending bytes.
;-----------------------------------------------------------------------------
read_key:
	mov	dl,0ffh
	mov	cl,f_rawio
	int	i_bdos
	or	al,al
	jz	read_key
	ret
flush_keys:
	mov	dl,0ffh
	mov	cl,f_rawio
	int	i_bdos
	or	al,al
	jnz	flush_keys
	ret

;-----------------------------------------------------------------------------
; Accept only one of the ten installed function-key codes enabled by the
; current mask. Invalid or disabled keys ring the bell.
;-----------------------------------------------------------------------------
read_menu_key:
	push	bx
	call	flush_keys
	call	read_key
	mov	di,offset menu_keycodes
	mov	dx,ds
	mov	es,dx
	mov	cx,0ah
	repne	scasb
	jnz	read_menu_key_at_1273
	pop	bx
	push	bx
	add	bx,cx
	mov	al,[bx]
	or	al,al
	jz	read_menu_key_at_1273
	mov	ax,0ah
	sub	ax,cx
	mov	cx,ax
	dec	cx
	pop	bx
	ret
read_menu_key_at_1273:
	mov	si,offset bell
	call	print_template
	pop	bx
	jmp	read_menu_key

;-----------------------------------------------------------------------------
; Read three decimal digits; E before any digits returns FFFFh. The installed
; F10 definition emits E. Other invalid input rings the bell.
;-----------------------------------------------------------------------------
read_number:
