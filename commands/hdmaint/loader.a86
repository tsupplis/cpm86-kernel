; ----------------------------------------------------------------------
; Hard-disk loader BIOS jump table, with the standard CP/M-86 entry order.
; ----------------------------------------------------------------------
bios_cold_vector:
	jmp	bios_initialize
bios_warm_vector:
	jmp	bios_warm_boot
bios_status_vector:
	jmp	bios_console_status
bios_input_vector:
	jmp	bios_console_input
bios_output_vector:
	jmp	bios_console_output
bios_list_vector:
	jmp	bios_no_operation
bios_punch_vector:
	jmp	bios_no_operation
bios_reader_vector:
	jmp	bios_no_operation
bios_home_vector:
	jmp	bios_home
bios_select_vector:
	jmp	bios_select_disk
bios_track_vector:
	jmp	bios_set_track
bios_sector_vector:
	jmp	bios_set_sector
bios_dma_vector:
	jmp	bios_set_dma
bios_read_vector:
	jmp	bios_read
bios_write_vector:
	jmp	bios_write_stub
bios_list_status_vector:
	jmp	bios_no_operation
bios_translate_vector:
	jmp	bios_translate
bios_dma_segment_vector:
	jmp	bios_set_dma_segment
bios_memory_vector:
	jmp	bios_memory
bios_iobyte_vector:
	jmp	bios_no_operation
bios_set_iobyte_vector:
	jmp	bios_no_operation

; ----------------------------------------------------------------------
; Initialize the BIOS stack/video state and install the embedded BDOS at
; INT E0h. Copy the preceding on-disk label sector into runtime storage.
; ----------------------------------------------------------------------
bios_initialize:
	pushf
	pop	bp
	cli
	mov	ax,cs
	mov	ss,ax
	mov	sp,offset bios_stack_top
	push	bp
	popf
	cld
	mov	ds,ax
	mov	es,ax
	push	ds
	mov	ax,0h
	mov	ds,ax
	mov	ah,0fh
	int	10h
	mov	ah,0h
	int	10h
	mov	word ptr bdos_vectors,406h
	mov	word ptr state_0382,cs
copy_disk_label:
	mov	ax,cs
	sub	ax,20h
	mov	ds,ax
	mov	si,0h
	mov	di,disk_label
	mov	cx,200h
	rep	movsb
	pop	ds

; ----------------------------------------------------------------------
; The 256-word label checksum must sum to zero. Disable directory checksum
; storage and invalidate the cached physical block before loading the OS.
; ----------------------------------------------------------------------
check_disk_label:
	mov	si,disk_label
	lodsw
	push	ax
	mov	dx,0h
	mov	cx,0ffh
loc_1286:
	lodsw
	add	dx,ax
	loop	loc_1286
	pop	ax
	add	dx,ax
	jz	initialize_cache
	mov	bx,offset bad_label_message
	call	bios_print
halt_bad_label:
	jmps	halt_bad_label
initialize_cache:
	mov	word ptr .label_checksum_size,0h
	mov	word ptr .cached_block,0ffffh
	jmp	load_system
unused_return:
	ret
bios_warm_boot:
	jmp	load_system

; ----------------------------------------------------------------------
; Console services use ROM BIOS INT 16h / INT 10h.
; ----------------------------------------------------------------------
bios_console_status:
	mov	ah,1h
	int	16h
	mov	al,0h
	jz	loc_12b5
	mov	al,0ffh
loc_12b5:
	ret
bios_console_input:
	mov	ah,0h
	int	16h
	and	al,7fh
	ret
bios_console_output:
	mov	ah,0eh
	mov	bx,7h
	mov	al,cl
	and	al,7fh
	int	10h
	ret
bios_no_operation:
	and	al,0h
	ret
bios_print:
