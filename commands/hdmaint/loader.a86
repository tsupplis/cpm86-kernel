; HDMAINT 1.1 embedded loader - reconstructed from base/hdmaint.cmd.
; Real instructions retain the original layout; make check verifies every byte.
; Later OEM boot sources explain the design but are not substituted here.

	cseg
	org	0

; Preserve a short indexed CS override without widening its displacement.
	codemacro cs_prefix operand:mb
	segfix operand
	endm

cached_block	equ	184ch
physical_buffer	equ	184eh
disk_label	equ	204eh
label_heads	equ	2073h
label_sectors	equ	2074h
label_records_per_sector	equ	2076h
label_dpb	equ	2077h
label_checksum_size	equ	2082h
label_reserved_tracks	equ	2084h
label_block_records	equ	208eh
label_bad_count	equ	2092h
label_last_spare	equ	2094h
label_bad_blocks	equ	2096h

loader_entry:
	jmp	bios_cold_vector

; ----------------------------------------------------------------------
; Load CPM.SYS, falling back to CCPM.SYS. Establish the private stack and
; use the embedded BDOS for directory lookup and 128-byte sequential reads.
; ----------------------------------------------------------------------
load_system:
	pushf
	pop	bp
	cli
	mov	ax,cs
	mov	ss,ax
	mov	ds,ax
	mov	es,ax
	mov	sp,offset load_stack_top
	push	bp
	popf
	cld
	mov	dx,cs
	call	set_dma_segment
	mov	dx,offset command_header
	call	set_dma_offset
	call	select_drive
	call	open_file
try_system_file:
	mov	byte ptr concurrent_flag,0h
	cmp	al,0ffh
	jnz	announce_system
	mov	si,offset concurrent_name
	mov	di,offset system_name
	mov	cx,4h
	rep	movsw
	call	open_file
	mov	byte ptr concurrent_flag,0ffh
	cmp	al,0ffh
	jnz	announce_system
	mov	dx,offset missing_message
	call	print_string
	jmp	fatal_error
announce_system:
	mov	dx,offset loading_message
	call	print_string
	call	print_filename

; ----------------------------------------------------------------------
; Validate the CMD header: CODE must have an absolute load segment; if DATA
; is present, it must immediately follow CODE. The header is not loaded.
; ----------------------------------------------------------------------
read_header:
	call	read_sequential
	or	al,al
	jnz	bad_format
	cmp	byte ptr command_header,1h
	jnz	bad_format
	mov	ax,word ptr code_base
	mov	cs:word ptr system_segment,ax
	cmp	ax,0h
	jz	bad_format
	cmp	byte ptr data_descriptor,2h
	jnz	prepare_load
	add	ax,word ptr code_paragraphs
	cmp	ax,word ptr data_base
	jz	prepare_load
bad_format:
	mov	dx,offset format_message
	call	print_string
	jmp	fatal_error
prepare_load:
	mov	dx,word ptr code_base
	call	set_dma_segment
start_progress:
	mov	byte ptr progress_count,1h

; ----------------------------------------------------------------------
; Read the system image, advancing the DMA segment at each 64 KB boundary.
; Print a progress dot every 64 records (8 KB).
; ----------------------------------------------------------------------
read_system:
	mov	dx,0ff80h
advance_dma:
	add	dx,80h
	mov	ax,dx
	add	ax,80h
	jnc	set_record_dma
	push	dx
	mov	cl,4h
	shr	dx,cl
	add	word ptr code_base,dx
	mov	dx,word ptr code_base
	call	set_dma_segment
	pop	dx
	and	dx,0fh
set_record_dma:
	push	dx
	call	set_dma_offset
show_progress:
	dec	byte ptr progress_count
	jnz	read_record
	mov	dl,2eh
	call	console_output
	mov	byte ptr progress_count,40h
read_record:
	call	read_sequential
	pop	dx
	cmp	al,1h
	jz	enter_system
	cmp	al,0h
	jz	advance_dma
	mov	dx,offset read_error_message
	call	print_string
	call	print_filename
	jmp	fatal_error

; ----------------------------------------------------------------------
; Enter CP/M at offset 2500h, or Concurrent CP/M at offset zero. DL=80h
; identifies the hard disk. Set DS from the optional DATA descriptor.
; ----------------------------------------------------------------------
enter_system:
	mov	dl,80h
	cmp	byte ptr concurrent_flag,0h
	jz	set_system_data
	mov	cs:word ptr system_entry,0h
set_system_data:
	cmp	byte ptr data_descriptor,2h
	jnz	loc_0101
	mov	ds,word ptr data_base
loc_0101:
	jmpf	cs:dword ptr system_entry
system_entry	dw	2500h
system_segment	dw	0

; ----------------------------------------------------------------------
; Print the FCB name and extension, suppressing padding spaces.
; ----------------------------------------------------------------------
print_filename:
	mov	si,offset system_name
	mov	cx,8h
	call	loc_011e
	mov	dl,2eh
	call	console_output
	mov	si,offset system_extension
	mov	cx,3h
loc_011e:
	lodsb
	cmp	al,20h
	jz	loc_012e
	push	si
	push	cx
	mov	dl,al
	call	console_output
	pop	cx
	pop	si
	loop	loc_011e
loc_012e:
	ret

; ----------------------------------------------------------------------
; Small wrappers for the embedded BDOS interrupt E0h interface.
; ----------------------------------------------------------------------
console_output:
	mov	cl,2h
	jmps	bdos_call
select_drive:
	mov	cl,0eh
	mov	dx,0h
	jmps	bdos_call
open_file:
	mov	cl,0fh
	mov	dx,offset system_fcb
	jmps	bdos_call
set_dma_offset:
	mov	cl,1ah
	jmps	bdos_call
set_dma_segment:
	mov	cl,33h
	jmps	bdos_call
print_string:
	mov	cl,9h
	jmps	bdos_call
read_sequential:
	mov	dx,offset system_fcb
	mov	cl,14h
bdos_call:
	int	0e0h
	ret

; ----------------------------------------------------------------------
; Fatal boot errors wait for a hardware reset after printing the prompt.
; ----------------------------------------------------------------------
fatal_error:
	mov	dx,offset reboot_message
	call	print_string
halt_loader:
	jmps	halt_loader

	dseg
	org	15dh

loading_message	db	0dh,0ah,4ch,6fh,61h,64h,69h,6eh,67h,20h,24h ; ..Loading $
missing_message	db	0dh,0ah,4eh,6fh,20h,43h,50h,4dh,2eh,53h,59h,53h,20h,6fh,72h,20h ; ..No CPM.SYS or 
	db	43h,43h,50h,4dh,2eh,53h,59h,53h,20h,66h,69h,6ch,65h,20h,6fh,6eh ; CCPM.SYS file on
	db	20h,74h,68h,65h,20h,68h,61h,72h,64h,20h,64h,69h,73h,6bh,24h ;  the hard disk$
read_error_message	db	0dh,0ah,0ah,48h,61h,72h,64h,20h,64h,69h,73h,6bh,20h,65h,72h,72h ; ...Hard disk err
	db	6fh,72h,20h,69h,6eh,20h,72h,65h,61h,64h,69h,6eh,67h,20h,24h ; or in reading $
format_message	db	0dh,0ah,0ah,55h,6eh,61h,62h,6ch,65h,20h,74h,6fh,20h,6ch,6fh,61h ; ...Unable to loa
	db	64h,20h,66h,69h,6ch,65h,20h,61h,73h,20h,67h,65h,6eh,65h,72h,61h ; d file as genera
	db	74h,65h,64h,24h ; ted$
reboot_message	db	0dh,0ah,20h,20h,20h,20h,49h,6eh,73h,65h,72h,74h,20h,53h,59h,53h ; ..    Insert SYS
	db	54h,45h,4dh,20h,64h,69h,73h,6bh,65h,74h,74h,65h,20h,69h,6eh,20h ; TEM diskette in 
	db	41h,3ah,0dh,0ah,20h,20h,20h,20h,74h,68h,65h,6eh,20h,50h,52h,45h ; A:..    then PRE
	db	53h,53h,20h,43h,74h,72h,6ch,2fh,41h,6ch,74h,2fh,44h,65h,6ch,2eh ; SS Ctrl/Alt/Del.
	db	2eh,2eh,24h ; ..$
concurrent_flag	db	0h
system_fcb	db	0h
system_name	db	43h,50h,4dh,20h,20h,20h,20h,20h ; CPM     
system_extension	db	53h,59h,53h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h ; SYS.............
	db	0h,0h,0h,0h,0h,0h,0h,0h
concurrent_name	db	43h,43h,50h,4dh,20h,20h,20h,20h ; CCPM    
progress_count	db	0h
command_header	db	0h
code_paragraphs	dw	0h
code_base	dw	0h
	db	0h,0h,0h,0h
data_descriptor	db	0h,0h,0h
data_base	dw	0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h
load_stack	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
load_stack_top	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h

; ----------------------------------------------------------------------
; Reduced BDOS dispatch table: functions 0..40, then 47..59. Unsupported
; operations share return stubs; this loader only needs file reading.
; ----------------------------------------------------------------------
bdos_vectors	dw	offset bd_function_0
state_0382	dw	offset bd_mconin
	dw	offset bd_conout
	dw	offset bd_mreder
	dw	offset bios_punch_vector
	dw	offset bd_blist
	dw	offset bd_mdcnio
	dw	offset bd_mgtiob
	dw	offset bd_mstiob
	dw	offset bd_mbufpr
	dw	offset bd_mrdcbf
	dw	offset bd_mconst
	dw	offset bd_function_12
	dw	offset bd_mrsdsy
	dw	offset bd_mseldk
	dw	offset bd_mopen
	dw	offset bd_mclose
	dw	offset bd_msrchf
	dw	offset bd_function_18
	dw	offset bd_function_19
	dw	offset bd_function_20
	dw	offset bd_function_21
	dw	offset bd_function_22
	dw	offset bd_function_23
	dw	offset bd_mrtliv
	dw	offset bd_mrtcdk
	dw	offset bd_mstdmo
	dw	offset bd_mgtalm
	dw	offset bd_mwpdsk
	dw	offset bd_mgtrov
	dw	offset bd_function_30
	dw	offset bd_function_31
	dw	offset bd_function_32
	dw	offset bd_function_33
	dw	offset bd_function_34
	dw	offset bd_function_35
	dw	offset bd_function_36
	dw	offset bd_function_37
	dw	offset bd_noproc
	dw	offset bd_noproc
	dw	offset bd_function_40
	dw	offset bd_function_41
	dw	offset bd_function_42
	dw	offset bd_function_43
	dw	offset bd_function_44
	dw	offset bd_function_45
	dw	offset bd_function_46
	dw	offset bd_function_47
	dw	offset bd_function_47
	dw	offset bd_function_47
	dw	offset bd_function_47
	dw	offset bd_function_47
	dw	offset bd_function_47
	dw	offset bd_function_53

	cseg
	org	3ech

bd_function_12:
	mov	al,22h
	jmp	bd_btprst
bd_function_43:
	mov	bx,offset bd_dmaadd
	jmp	loc_0f41

	dseg
	org	3f7h

bdos_reserved	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h

	cseg
	org	406h


; ----------------------------------------------------------------------
; Embedded CP/M-86 BDOS entry. Save the caller context and dispatch through
; bdos_vectors. Internal bd_ names follow the matching CP/M BDOS source.
; ----------------------------------------------------------------------
bd_bdosen:
	push	ds
	mov	ax,cs
	mov	ds,ax
	pop	word ptr bd_indseg
	cmp	cl,5h
	jz	bd_bdosec
	cmp	cl,0dh
	jc	bd_bdoses
bd_bdosec:
	mov	byte ptr bd_mdconf,0ffh
bd_bdoses:
	mov	word ptr bd_instsg,ss
	mov	word ptr bd_instof,sp
	cmp	byte ptr bd_flinsd,1h
	jz	bd_bdosei
	mov	ax,cs
	mov	ss,ax
bd_setup_stack:
	mov	sp,1159h
bd_bdosei:
	mov	bx,word ptr bd_instof
	mov	es,word ptr bd_instsg
	mov	bx,es:word ptr 4h[bx]
	and	bx,200h
	jz	loc_0447
	sti
loc_0447:
	mov	ax,ds
	push	bp
	push	di
	push	si
	push	cs
	pop	es
	mov	word ptr bd_curseg,es
	call	bd_bdosb
	pop	si
	pop	di
	pop	bp
	mov	es,word ptr bd_curseg
	cli
	mov	ss,word ptr bd_instsg
	mov	sp,word ptr bd_instof
	mov	byte ptr bd_mdconf,0h
	mov	ds,word ptr bd_indseg
	iret
bd_bdosb:
	mov	word ptr bd_inpara,dx
	mov	byte ptr bd_inparb,dl
	xor	al,al
	mov	word ptr bd_otpara,ax
	mov	byte ptr bd_afwfcb,al
	mov	byte ptr bd_enttyp,al
	mov	byte ptr bd_flomod,al
	mov	bx,0f4ch
	push	bx
	cmp	cl,29h
	jc	bd_bdosbs
	sub	cl,6h
	cmp	cl,36h
	jc	bd_bdosbs
	ret
bd_bdosbs:
	mov	bl,cl
	mov	bh,0h
	mov	cl,dl
	add	bx,bx
	jmp	cs:word ptr bdos_vectors[bx]
bd_ebadsc:
	mov	bx,1076h
	call	bd_erproc
	cmp	al,3h
	jnz	bd_stwfce
	jmps	bd_erofie
bd_eselct:
	mov	bx,1081h
	jmps	bd_erofis
bd_erodsk:
	mov	bx,108dh
	jmps	bd_erofis
bd_erofil:
	mov	bx,1088h
bd_erofis:
	call	bd_erproc
bd_erofie:
	jmp	loc_0533
bd_erproc:
	push	bx
	call	bd_crlf
	mov	al,byte ptr bd_curdsk
	add	al,41h
	mov	byte ptr bd_cerrdk,al
	mov	cx,1066h
	call	bd_bufprn
	pop	cx
	call	bd_bufprn
	jmp	bd_coninc
; Save the caller FCB fields before internal directory operations.
bd_stwfcb:
	push	ds
	push	ax
	push	cx
	mov	byte ptr bd_afwfcb,0ffh
	mov	byte ptr bd_cnfcbc,cl
	xor	ch,ch
	mov	si,word ptr bd_inpara
	mov	word ptr bd_ptufcb,si
	mov	di,1091h
	mov	word ptr bd_inpara,di
	mov	ds,word ptr bd_indseg
	cld
	rep	movsb
	pop	cx
	pop	ax
	pop	ds
bd_stwfce:
	ret
bd_stwfcs:
	push	cx
	mov	cl,21h
	jmps	bd_stwfcc
bd_stwfcr:
	push	cx
	mov	cl,24h
bd_stwfcc:
	call	bd_stwfcb
	pop	cx
	ret
; Restore the caller FCB and complete the BDOS return.
bd_rstfcb:
	push	es
	push	ax
	push	cx
	mov	cl,byte ptr bd_cnfcbc
	xor	ch,ch
	mov	es,word ptr bd_indseg
	mov	si,1091h
	mov	di,word ptr bd_ptufcb
	mov	word ptr bd_inpara,di
	cld
	rep	movsb
	pop	cx
	pop	ax
	pop	es
	ret
bd_function_53:
	ret
bd_function_0:
	ret
bd_function_44:
	ret
loc_0533:
	mov	byte ptr bd_flinsd,0h
	jmp	bios_warm_vector
bd_function_45:
	mov	word ptr bd_dma_segment,dx
	mov	cx,dx
	call	bios_dma_segment_vector
	ret
bd_function_46:
	ret
bd_function_47:
	ret
; Console input with echo and control-character handling.
bd_coninc:
	mov	bx,offset bd_bfconc
	mov	al,byte ptr [bx]
	mov	byte ptr [bx],0h
	or	al,al
	jnz	bd_conche
	jmp	bd_bconin
bd_coninp:
	call	bd_coninc
	call	bd_conchk
	jc	bd_conche
	push	ax
	mov	cl,al
	call	bd_conout
	pop	ax
	ret
bd_conchk:
	cmp	al,0dh
	jz	bd_conche
	cmp	al,0ah
	jz	bd_conche
	cmp	al,9h
	jz	bd_conche
	cmp	al,8h
	jz	bd_conche
	cmp	al,20h
bd_conche:
	ret
; Check console readiness, including the saved look-ahead character.
bd_consts:
	mov	al,byte ptr bd_bfconc
	or	al,al
	jnz	bd_constd
	call	bd_bconst
	and	al,1h
	jz	bd_conche
	call	bd_bconin
	cmp	al,13h
	jnz	bd_constg
	call	bd_bconin
	cmp	al,3h
	jz	bd_conste
	xor	al,al
	ret
bd_conste:
	jmp	loc_0533
bd_constg:
	mov	byte ptr bd_bfconc,al
bd_constd:
	mov	al,1h
	ret
bd_conots:
	mov	al,byte ptr bd_echkil
	or	al,al
	jnz	bd_conott
	push	cx
	call	bd_consts
	pop	cx
	push	cx
	call	bd_bconot
	pop	cx
	push	cx
	cmp	byte ptr bd_lsttgl,0h
	jz	loc_05bd
	call	bd_blist
loc_05bd:
	pop	cx
bd_conott:
	mov	al,cl
	mov	bx,offset bd_pcarig
	cmp	al,7fh
	jz	bd_conote
	inc	byte ptr [bx]
	cmp	al,20h
	jnc	bd_conote
	dec	byte ptr [bx]
	mov	al,byte ptr [bx]
	or	al,al
	jz	bd_conote
	mov	al,cl
	cmp	al,8h
	jnz	bd_conotl
	dec	byte ptr [bx]
bd_conote:
	ret
bd_conotl:
	cmp	al,0ah
	jnz	bd_conote
	mov	byte ptr [bx],0h
	ret
bd_conotc:
	mov	al,cl
	call	bd_conchk
	jnc	bd_conout
	push	ax
	mov	cl,5eh
	call	bd_conots
	pop	cx
	or	cl,40h
; Console output with tab expansion and column tracking.
bd_conout:
	cmp	cl,9h
	jnz	bd_conots
bd_conoul:
	mov	cl,20h
	call	bd_conots
	mov	al,byte ptr bd_pcarig
	and	al,7h
	jnz	bd_conoul
bd_conoue:
	ret
bd_backs:
	call	bd_back
	mov	cl,20h
	call	bd_bconot
bd_back:
	mov	cl,8h
	jmp	bd_bconot
bd_ncrlf:
	mov	cl,23h
	call	bd_conots
	call	bd_crlf
bd_ncrlfl:
	mov	al,byte ptr bd_pcarig
	cmp	al,byte ptr bd_ppromp
	jnc	bd_conoue
	mov	cl,20h
	call	bd_conots
	jmps	bd_ncrlfl
bd_crlf:
	mov	cl,0dh
	call	bd_conots
	mov	cl,0ah
	jmp	bd_conots
; Print the dollar-terminated string addressed by BX.
bd_bufprn:
	mov	si,cx
	lodsb
	cmp	al,24h
	jz	bd_conoue
	inc	cx
	push	cx
	mov	cl,al
	push	ds
	push	ss
	pop	ds
	call	bd_conout
	pop	ds
	pop	cx
	jmps	bd_bufprn
; Buffered console input, including line editing and control keys.
bd_rdcnbf:
	mov	al,byte ptr bd_pcarig
	mov	byte ptr bd_ppromp,al
	mov	bx,word ptr bd_inpara
	mov	cl,es:byte ptr [bx]
	inc	bx
	push	bx
	mov	ch,0h
bd_rdcnbl:
	push	cx
	push	bx
bd_rdcnbd:
	call	bd_coninc
	pop	bx
	pop	cx
	cmp	al,0dh
	jnz	loc_066c
bd_rdcnbq:
	jmp	bd_rdcnbe
loc_066c:
	cmp	al,0ah
	jz	bd_rdcnbq
	cmp	al,8h
	jnz	bd_rdcnbk
	or	ch,ch
	jz	bd_rdcnbl
	dec	ch
	mov	al,byte ptr bd_pcarig
	mov	byte ptr bd_echkil,al
	jmps	bd_rdcnbi
bd_rdcnbk:
	cmp	al,7fh
	jnz	bd_rdcnba
	or	ch,ch
	jz	bd_rdcnbl
	mov	al,es:byte ptr [bx]
	dec	ch
	dec	bx
	jmps	bd_rdcnbs
bd_rdcnba:
	cmp	al,5h
	jnz	bd_rdcnbp
	push	cx
