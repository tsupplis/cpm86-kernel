	jz	copy_record
	mov	word ptr .cached_block,ax
	mul	word ptr .label_block_records
	mov	cl,byte ptr .label_records_per_sector
	xor	ch,ch
	div	cx
	xor	dx,dx
	mov	cl,byte ptr .label_sectors
	div	cx
	inc	dl
	mov	byte ptr request_sector,dl
	add	ax,word ptr .label_reserved_tracks
	xor	dx,dx
	mov	cl,byte ptr .label_heads
	div	cx
	mov	word ptr request_cylinder,ax
	mov	byte ptr request_head,dl
	mov	byte ptr request_function,2h
	mov	word ptr request_offset,184eh
	mov	word ptr request_segment,cs
	mov	ax,word ptr .label_block_records
