	ret
bios_set_dma:
	mov	word ptr dma_offset,cx
	ret
bios_set_dma_segment:
	mov	word ptr dma_segment,cx
	ret
bios_memory:
	mov	bx,offset memory_regions
	ret

; ----------------------------------------------------------------------
; Map the logical record to a physical block. Refill the cache only when
; the block changes, then copy one 128-byte record into the BDOS DMA area.
; ----------------------------------------------------------------------
bios_read:
