	mov	word ptr .cached_block,0ffffh
	mov	al,1h
	jmps	loc_13aa
copy_record:
	mov	si,physical_buffer
	add	si,word ptr byte_in_block
	mov	di,word ptr dma_offset
	mov	es,word ptr dma_segment
	mov	cx,40h
	rep	movsw
	mov	al,0h
loc_13aa:
	pop	es
	ret
bios_write_stub:
	mov	al,0h
	ret

; ----------------------------------------------------------------------
; Convert track/record to a block and byte offset. Search the label bad-block
; table and substitute a spare block when necessary.
; ----------------------------------------------------------------------
map_block:
	mov	ax,word ptr current_track
	sub	ax,word ptr .label_reserved_tracks
	mul	word ptr .label_dpb
	mov	cl,byte ptr current_sector
	xor	ch,ch
	add	ax,cx
