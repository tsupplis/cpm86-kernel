;	CP/M 8080 ASSEMBLER FOR CP/M-86
;
;	COPYRIGHT (C) 1976, 1977, 1978 DIGITAL RESEARCH
;	CONVERTED AND UNIFIED FOR CP/M-86 (8080 MODEL)
;
M	EQU	Byte Ptr 0[BX]
;
;	DOS ENTRY POINTS AND FUNCTIONS
BPGLEN	EQU	6H			;BASE PAGE: 24-BIT GROUP LENGTH (8080 MODEL)
SYLIM	EQU	0FF00H			;SYMAX CAP, LEAVES ROOM FOR ENTER'S OVERFLOW TEST
READC	EQU	1			;READ CONSOLE DEVICE
WRITC	EQU	2			;WRITE CONSOLE DEVICE
REDYC	EQU	11			;CONSOLE CHARACTER READY
SELECT	EQU	14			;SELECT DISK SPECIFIED BY REGISTER E
OPENF	EQU	15			;OPEN FILE
CLOSF	EQU	16			;CLOSE FILE
DELEF	EQU	19			;DELETE FILE
READF	EQU	20			;READ FILE
WRITF	EQU	21			;WRITE FILE
MAKEF	EQU	22			;MAKE A FILE
CSEL	EQU	25			;RETURN CURRENTLY SELECTED DISK
SETDM	EQU	26			;SET DMA ADDRESS
;
FCB	EQU	5CH			;DEFAULT FILE CONTROL BLOCK ADDRESS
BUFF	EQU	80H			;INPUT DISK BUFFER ADDRESS
FLN	EQU	9			;FILE NAME LENGTH
;
;	GLOBAL CONSTANTS
CR	EQU	0DH
LF	EQU	0AH
EOF	EQU	1AH
TAB	EQU	09H
;
;	TOKEN TYPES
IDEN	EQU	1			;IDENTIFIER
NUMB	EQU	2			;NUMBER
STRNG	EQU	3			;STRING
SPECL	EQU	4			;SPECIAL CHARACTER
;
;	SYMBOL TYPES
PLABT	EQU	0001B			;PROGRAM LABEL
DLABT	EQU	0010B			;DATA LABEL
EQUT	EQU	0100B			;EQUATE
SETT	EQU	0101B			;SET
MACT	EQU	0110B			;MACRO
;
EXTT	EQU	1000B			;EXTERNAL
REFT	EQU	1011B			;REFER
GLBT	EQU	1100B			;GLOBAL
;
;	RADICES
BINV	EQU	2
OCTV	EQU	8
DECV	EQU	10
HEXV	EQU	16
;
;	BUFFER AND TABLE CONSTANTS
PBMAX	EQU	120			;MAX PRINT SIZE
ACMAX	EQU	64			;MAX ACCUMULATOR LENGTH
NBMAX	EQU	16			;STARTING POSITION OF PRINT LINE
NSB	EQU	8			;NUMBER OF SOURCE BUFFERS (8*128 = 1024)
NPB	EQU	6			;NUMBER OF PRINT BUFFERS (6*128 = 768)
NHB	EQU	6			;NUMBER OF HEX BUFFERS (6*128 = 768)
SSIZE	EQU	NSB*128
PSIZE	EQU	NPB*128
HSIZE	EQU	NHB*128
;
;	SYMBOL TABLE CONSTANTS
FIXD	EQU	5			;OVERHEAD PER SYMBOL ENTRY
SYMHSIZE EQU	128			;HASH TABLE SIZE
HMASK	EQU	SYMHSIZE-1		;HASH MASK
;
;	OPCODE / OPERATOR CONSTANTS
RT	EQU	16			;REGISTER TYPE
PT	EQU	RT+1			;PSEUDO OPERATION
PENDIF	EQU	5			;PSEUDO OPERATOR 'ENDIF'
OBASE	EQU	PT+1
O1	EQU	OBASE+1			;FIRST OPERATOR
O2	EQU	OBASE+2
O3	EQU	OBASE+3
O4	EQU	OBASE+4
O5	EQU	OBASE+5
O6	EQU	OBASE+6
O7	EQU	OBASE+7
O8	EQU	OBASE+8
O9	EQU	OBASE+9
O10	EQU	OBASE+10
O11	EQU	OBASE+11
O12	EQU	OBASE+12
O13	EQU	OBASE+13
O14	EQU	OBASE+14
O15	EQU	OBASE+15		;LAST OPERATOR
;
XBASE	EQU	0			;START OF EXPRESSION OPERATORS
OPER	EQU	15			;LAST OPERATOR
PLUS	EQU	5
MINUS	EQU	6
NOTF	EQU	8
LPAR	EQU	12
RPAR	EQU	13
OSMAX	EQU	10
VSMAX	EQU	8*2
;
X1	EQU	XBASE			;*
X2	EQU	XBASE+1			;/
X3	EQU	XBASE+2			;MOD
X4	EQU	XBASE+3			;SHL
X5	EQU	XBASE+4			;SHR
X6	EQU	XBASE+5			;+
X7	EQU	XBASE+6			;-
X8	EQU	XBASE+7			;UNARY -
X9	EQU	XBASE+8			;NOT
X10	EQU	XBASE+9			;AND
X11	EQU	XBASE+10		;OR
X12	EQU	XBASE+11		;XOR
X13	EQU	XBASE+12		;(
X14	EQU	XBASE+13		;)
X15	EQU	XBASE+14		;,
X16	EQU	XBASE+15		;CR
;
; =========================================================================
; ENTRY POINT (ORG 100H)
; =========================================================================
	ORG	100H
STARTUP:
;	THE CCP ENTERS WITH ITS OWN SS:SP, SO MOVE THE STACK INTO OUR GROUP
	MOV	AX,CS
	CLI
	MOV	SS,AX
	MOV	SP,(Offset STACKTOP)
	STI
;	GROUP LENGTH IS A 24-BIT VALUE AT BASE PAGE 6..8: CAP IT AT SYLIM
	MOV	BX,SYLIM
	CMP	Byte Ptr .BPGLEN+2,0
	JNZ	STSYMX			;64K OR MORE
	CMP	Word Ptr .BPGLEN,BX
	JNB	STSYMX
	MOV	BX,Word Ptr .BPGLEN
STSYMX:	MOV	Word Ptr SYMAX,BX	;STORE END OF MEMORY
	MOV	BX,(Offset ENDA)	;SYMBOL TABLE STARTS AFTER CODE/DATA
	MOV	Word Ptr SYTOP,BX
	MOV	Word Ptr SYBAS,BX
;	INITIAL VALUES THAT THE 8080 VERSION LOADED FROM THE .COM IMAGE
	MOV	Byte Ptr PBUFF,' '	;NO ERROR FLAG BEFORE THE FIRST LINE
	XOR	AX,AX
	MOV	Word Ptr OBP,AX
	MOV	Word Ptr HBP,AX
	MOV	Byte Ptr ASMERR,AL
;
	CALL	INIT			;PRINT BANNER, SETUP DISKS AND FCBS
;
; =========================================================================
; MAIN STATEMENT PROCESSING LOOP
; =========================================================================
MAIN:
	XOR	AL,AL
	MOV	Byte Ptr PASS,AL	;SET TO PASS 0 INITIALLY
	CALL	INISY			;INITIALIZE THE SYMBOL TABLE
RESTART:				;PASS LOOP GOES FROM 0 TO 1
	CALL	INITS			;INITIALIZE THE SCANNER
	CALL	SETUP			;SET UP THE INPUT FILE
	MOV	BX,0
	MOV	Word Ptr SYLAB,BX	;ASSUME NO STARTING LABEL
	MOV	Word Ptr FPC,BX
	MOV	Word Ptr ASPC,BX
	MOV	Word Ptr EPC,BX		;END PC
;
SCNEXT:					;SCAN THE NEXT INPUT ITEM
	CALL	SCAN
SCN0:	MOV	AL,Byte Ptr TOKEN
	CMP	AL,NUMB			;SKIP LEADING NUMBERS FROM LINE EDITORS
	JZ	SCNEXT
	CMP	AL,SPECL		;MAY BE PROCESSOR TECH'S COMMENT
	JNZ	SCN1
;	SPECIAL CHARACTER, CHECK FOR *
	MOV	AL,Byte Ptr ACCUM
	CMP	AL,'*'
	JZ	L_M2
	JMP	CHEND			;END OF LINE IF NOT *
L_M2:
;	* FOUND, NO PRECEDING LABEL ALLOWED
	CALL	SETLA
	JZ	L_M3
	JMP	STERR			;ERROR IF LABEL
L_M3:
	JMP	CHEN1			;SCAN THE COMMENT OTHERWISE
;
SCN1:					;NOT NUMBER OR SPECIAL CHARACTER, CHECK FOR IDENTIFIER
	CMP	AL,IDEN
	JZ	L_M4
	JMP	STERR			;ERROR IF NOT
L_M4:
;
;	IDENTIFIER FOUND, MAY BE LABEL, OPCODE, OR MACRO
	CALL	BGET			;BINARY SEARCH FIXED DATA
	JZ	CHKPT			;CHECK FOR PSEUDO OR REAL OPERATOR
;
;	BINARY SEARCH WAS UNSUCCESSFUL, CHECK FOR MACRO
	CALL	LOOKUP
	CALL	FOUND
	JNZ	LFOUN			;NZ FLAG SET IF FOUND
;
;	NOT FOUND, ENTER IT
	CALL	ENTER			;THIS MUST BE PASS 0
	MOV	AL,Byte Ptr PASS
	OR	AL,AL
	JZ	L_M5
	CALL	ERRP			;PHASE ERROR IF NOT
L_M5:
	JMPS	SETSY			;SET SYLAB
;
;	ITEM WAS FOUND, CHECK FOR MACRO
LFOUN:	CALL	GETTY
	CMP	AL,MACT
	JNZ	SETSY
;
;	MACRO DEFINITION FOUND, EXPAND MACRO
	CALL	ERRN			;NOT CURRENTLY IMPLEMENTED
	JMP	CHEN1			;SCANS TO END OF CURRENT LINE
;
SETSY:					;LABEL FOUND - IS IT THE ONLY ONE?
	MOV	BX,Word Ptr SYLAB
	MOV	AL,BL
	OR	AL,BH
	JZ	L_M6
	CALL	ERRL			;LABEL ERROR IF NOT
L_M6:
	MOV	BX,Word Ptr SYADR	;ADDRESS OF SYMBOL
	MOV	Word Ptr SYLAB,BX	;MARK AS LABEL FOUND
;
;	LABEL FOUND, SCAN OPTIONAL ':'
	CALL	SCAN
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,SPECL
	JNZ	SCN0			;SKIP NEXT SCAN IF NOT SPECIAL
	MOV	AL,Byte Ptr ACCUM
	CMP	AL,':'
	JZ	L_MSCN
	JMP	SCN0
L_MSCN:
	JMP	SCNEXT			;TO IGNORE ':'
;
;	BINARY SEARCH FOUND SYMBOL, CHECK FOR PSEUDO OR REAL OP
CHKPT:	CMP	AL,PT			;PSEUDO OPCODE?
	JZ	L_M7
	JMP	CHKOT
L_M7:
;
;	PSEUDO OPCODE FOUND, BRANCH TO CASES
	MOV	DL,CH			;B HAS PARTICULAR OPERATOR NUMBER
	MOV	DH,0			;DOUBLE PRECISION VALUE TO D,E
	DEC	DX			;BIASED BY +1
	MOV	BX,(Offset PTTAB)	;BASE OF JUMP TABLE
	ADD	BX,DX
	ADD	BX,DX
	MOV	DL,M
	INC	BX
	MOV	BH,M
	MOV	BL,DL
	JMP	BX			;JUMP INTO TABLE
;
PTTAB:					;PSEUDO OPCODE JUMP TABLE
	DW	(Offset SDB)		;DB
	DW	(Offset SDS)		;DS
	DW	(Offset SDW)		;DW
	DW	(Offset SEND)		;END
	DW	(Offset SENDIF)		;ENDIF
	DW	(Offset SENDM)		;ENDM
	DW	(Offset SEQU)		;EQU
	DW	(Offset SIF)		;IF
	DW	(Offset SMACRO)		;MACRO
	DW	(Offset SORG)		;ORG
	DW	(Offset SSET)		;SET
	DW	(Offset STITLE)		;TITLE
;
SDB:
	CALL	FILAB			;SET LABEL FOR THIS LINE TO ASPC
SDB0:
	CALL	SCAN			;PAST DB TO NEXT ITEM
	MOV	AL,Byte Ptr TOKEN	;LOOK FOR LONG STRING
	CMP	AL,STRNG
	JNZ	SDBC			;SKIP IF NOT STRING
	MOV	AL,Byte Ptr ACCLEN
	DEC	AL			;LENGTH 1 STRING?
	JZ	SDBC
;	LENGTH 0,2,... STRING
	MOV	CH,AL
	INC	CH
	INC	CH			;BECOMES 1,3,... FOR 0,2,... LENGTHS
	MOV	BX,(Offset ACCUM)	;ADDRESS CHARACTERS IN STRING
SDB1:	DEC	CH			;COUNT DOWN TO ZERO
	JZ	SDB2			;SCAN DELIMITER AT END OF STRING
	PUSH	CX			;SAVE COUNT
	MOV	CH,M			;GET CHARACTER
	INC	BX
	PUSH	BX			;SAVE ACCUM POINTER
	CALL	FILHB			;SEND TO HEX FILE
	POP	BX
	POP	CX
	JMPS	SDB1
SDB2:	CALL	SCAN			;TO THE DELIMITER
	JMPS	SDB3
;
;	NOT A LONG STRING
SDBC:	CALL	OPAND			;COMPUTE OPERAND
	MOV	BX,Word Ptr EVALUE	;VALUE TO H,L
	MOV	AL,BH
	OR	AL,AL			;HIGH ORDER MUST BE ZERO
	JZ	L_M10
	CALL	ERRD			;DATA ERROR
L_M10:
	MOV	CH,BL			;GET LOW BYTE
	CALL	FILHB
SDB3:					;END OF ITEM - UPDATE ASPC
	CALL	SETAS			;SET ASPC TO FPC
	CALL	DELIM
	CMP	AL,','
	JZ	SDB0			;FOR ANOTHER ITEM
	JMP	CHEND			;CHECK END OF LINE SYNTAX
;
SDS:
	CALL	FILAB			;HANDLE LABEL IF IT OCCURRED
	CALL	PADD			;PRINT ADDRESS
	CALL	EXP16			;SCAN AND GET 16BIT OPERAND
	XCHG	BX,DX			;TO D,E
	MOV	BX,Word Ptr ASPC	;CURRENT PSEUDO PC
	ADD	BX,DX
	MOV	Word Ptr ASPC,BX
	MOV	Word Ptr FPC,BX		;NEXT TO FILL
	JMP	CHEND
;
SDW:
	CALL	FILAB			;HANDLE OPTIONAL LABEL
SDW0:
	CALL	EXP16			;GET 16BIT OPERAND
	PUSH	BX			;SAVE A COPY
	MOV	CH,BL			;LOW BYTE FIRST
	CALL	FILHB			;SEND LOW BYTE
	POP	BX			;RECLAIM A COPY
	MOV	CH,BH			;HIGH BYTE NEXT
	CALL	FILHB			;SEND HIGH BYTE
	CALL	SETAS			;SET ASPC=FPC
	CALL	DELIM			;CHECK DELIMITER SYNTAX
	CMP	AL,','
	JZ	SDW0			;GET MORE DATA
	JMP	CHEND
;
SEND:
	CALL	FILAB
	CALL	PADD			;WRITE LAST LOC
	MOV	AL,Byte Ptr PBUFF
	CMP	AL,' '
	JZ	L_M11
	JMP	CHEND
L_M11:
	CALL	EXP16			;GET EXPRESSION IF IT'S THERE
	MOV	AL,Byte Ptr PBUFF
	CMP	AL,' '
	JNZ	SEND0
	MOV	Word Ptr EPC,BX		;EXPRESSION FOUND, STORE IT FOR LATER
SEND0:	MOV	AL,' '
	MOV	Byte Ptr PBUFF,AL	;CLEAR ERROR, IF IT OCCURRED
	CALL	SCAN			;CLEAR CR
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,SPECL
	JZ	L_M12
	JMP	STERR
L_M12:
	MOV	AL,Byte Ptr ACCUM
	CMP	AL,LF
	JZ	L_M13
	JMP	STERR
L_M13:
	JMP	ENDAS			;END OF ASSEMBLER
;
SENDIF:
	JMP	POEND
;
SENDM:
	CALL	ERRN
	JMP	POEND
;
SEQU:
	CALL	SETLA
	JNZ	L_M14
	JMP	STERR			;MUST BE A LABEL
L_M14:
	MOV	BX,Word Ptr ASPC	;HOLD TEMP ASPC
	PUSH	BX			;IN STACK
	CALL	EXP16			;GET 16BIT OPERAND
	MOV	Word Ptr ASPC,BX	;VALUE OF EXPRESSION
	CALL	FILAB
	CALL	PADDR			;COMPUTED VALUE
	MOV	BX,(Offset PBUFF)+6	;SPACE AFTER VALUE
	MOV	M,'='
	POP	BX			;REAL ASPC
	MOV	Word Ptr ASPC,BX	;CHANGE BACK
	JMP	CHEND
;
SIF:
	CALL	FILAB			;IN CASE OF LABEL
	CALL	EXP16			;GET IF EXPRESSION
	MOV	AL,Byte Ptr PBUFF
	CMP	AL,' '
	JZ	L_M15
	JMP	CHEND			;SKIP IF ERROR
L_M15:
	MOV	AL,BL			;GET LSB
	RCR	AL,1
	JNB	L_M16
	JMP	CHEND			;TRUE IF CARRY BIT SET
L_M16:
;
;	SKIP TO EOF OR ENDIF
SIF0:	CALL	SCAN
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,SPECL
	JNZ	SIF1
	MOV	AL,Byte Ptr ACCUM
	CMP	AL,EOF
	MOV	AL,'B'			;BALANCE ERROR
	JNZ	L_M17
	CALL	PERR
L_M17:
	JNZ	L_M18
	JMP	ENDAS
L_M18:
	JMPS	SIF0			;FOR ANOTHER
SIF1:					;NOT A SPECIAL CHARACTER
	CMP	AL,IDEN
	JNZ	SIF0			;NOT AN IDENTIFIER
	CALL	BGET			;LOOK FOR ENDIF
	JNZ	SIF0			;NOT FOUND
	CMP	AL,PT			;PSEUDO OP?
	JNZ	SIF0
	MOV	AL,CH			;GET OPERATOR NUMBER
	CMP	AL,PENDIF		;ENDIF?
	JNZ	SIF0			;GET ANOTHER TOKEN
	JMPS	POEND			;OK, CHECK END OF LINE
;
SMACRO:
	CALL	ERRN
	JMP	CHEND
;
SORG:
	CALL	EXP16
	MOV	AL,Byte Ptr PBUFF
	CMP	AL,' '
	JZ	L_M19
	JMP	CHEND			;SKIP ORG IF ERROR
L_M19:
	MOV	Word Ptr ASPC,BX	;CHANGE PC
	MOV	Word Ptr FPC,BX		;CHANGE NEXT TO FILL
	CALL	FILAB			;IN CASE OF LABEL
	CALL	PADD
	JMP	CHEND
;
SSET:
	CALL	SETLA
	JNZ	L_M20
	JMP	STERR			;MUST BE LABELLED
L_M20:
;
	CALL	GETTY
	CMP	AL,SETT
	JZ	L_M21
	CALL	ERRL			;LABEL ERROR
L_M21:
	MOV	AL,SETT
	CALL	SETTY			;REPLACE TYPE WITH 'SET'
	CALL	EXP16			;GET THE EXPRESSION
	PUSH	BX			;SAVE IT
	CALL	SETLA			;RE-ADDRESS LABEL
	POP	BX			;RECLAIM IT
	CALL	SETVAL
	MOV	BX,0
	MOV	Word Ptr SYLAB,BX	;PREVENT LABEL PROCESSING
	JMP	CHEND
;
STITLE:
	CALL	ERRN			;NOT IMPLEMENTED
;
POEND:					;PSEUDO OPERATOR END - SCAN TO NEXT TOKEN
	CALL	SCAN
	JMP	CHEND
;
;	NOT A PSEUDO OPCODE, CHECK FOR REAL OPCODE
CHKOT:	SUB	AL,O1			;BASE OF OPCODES
	CMP	AL,O15
	JNAE	L_M22
	JMP	STERR			;STATEMENT ERROR IF SO
L_M22:
;
;	FOUND OPCODE, COMPUTE INDEX INTO TABLE AND JUMP TO CASE
	MOV	DL,AL
	MOV	DH,0
	MOV	BX,(Offset OPTAB)
	ADD	BX,DX
	ADD	BX,DX
	MOV	DL,M
	INC	BX
	MOV	BH,M
	MOV	BL,DL
	JMP	BX			;JUMP TO CASE
;
OPTAB:					;OPCODE CATEGORIES
	DW	(Offset SSIMP)		;SIMPLE
	DW	(Offset SLXI)		;LXI
	DW	(Offset SDAD)		;DAD
	DW	(Offset SPUSH)		;PUSH/POP
	DW	(Offset SJMP)		;JMP/CALL
	DW	(Offset SMOV)		;MOV
	DW	(Offset SMVI)		;MVI
	DW	(Offset SACCI)		;ACCUM IMMEDIATE
	DW	(Offset SLDAX)		;LDAX/STAX
	DW	(Offset SLHLD)		;LHLD/SHLD/LDA/STA
	DW	(Offset SACCR)		;ACCUM-REGISTER
	DW	(Offset SINC)		;INC/DCR
	DW	(Offset SINX)		;INX/DCX
	DW	(Offset SRST)		;RESTART
	DW	(Offset SINP)		;IN/OUT
;
SSIMP:					;SIMPLE OPERATION CODES
	CALL	FILHB			;SEND HEX VALUE TO MACHINE CODE FILE
	CALL	SCAN			;TO NEXT TOKEN
	JMP	INCPC
;
SLXI:					;LXI H,16B
	CALL	SHDREG			;SCAN DOUBLE PRECISION REGISTER
	CALL	CHCOM			;CHECK FOR COMMA FOLLOWING REGISTER
	CALL	SETADR			;SCAN AND EMIT DOUBLE PRECISION OPERAND
	JMP	INCPC
;
SDAD:					;DAD B
	CALL	SHDREG			;SCAN AND EMIT DOUBLE PRECISION REGISTER
	JMP	INCPC
;
SPUSH:					;PUSH B POP D
	CALL	SHREG			;SCAN SINGLE PRECISION REGISTER TO A
	CMP	AL,111000B		;MAY BE PSW
	JZ	SPU0
;	NOT PSW, MUST BE B,D, OR H
	AND	AL,001000B		;LOW BIT MUST BE 0
	JZ	L_M25
	CALL	ERRR			;REGISTER ERROR IF NOT
L_M25:
SPU0:	MOV	AL,CL			;RECALL REGISTER AND MASK IN CASE OF ERROR
	AND	AL,110000B
	OR	AL,CH			;MASK IN OPCODE FOR PUSH OR POP
	JMP	FILINC			;FILL HEX VALUE AND INCREMENT PC
;
SJMP:					;JMP 16B/ CALL 16B
	CALL	FILHB			;EMIT JMP OR CALL OPCODE
	CALL	SETADR			;EMIT 16BIT OPERAND
	JMPS	INCPC
;
SMOV:					;MOV A,B
	CALL	SHREG
	OR	AL,CH			;MASK IN OPCODE
	MOV	CH,AL			;SAVE IN B TEMPORARILY
	CALL	CHCOM			;MUST BE COMMA SEPARATOR
	CALL	EXP3			;VALUE MUST BE 0-7
	OR	AL,CH			;MASK IN OPCODE
	JMPS	FILINC
;
SMVI:					;MVI A,8B
	CALL	SHREG
	OR	AL,CH			;MASK IN OPCODE
	CALL	FILHEX			;EMIT OPCODE
	CALL	CHCOM			;SCAN COMMA
	CALL	SETBYTE			;EMIT 8BIT VALUE
	JMPS	INCPC
;
SACCI:					;ADI 8B
	CALL	FILHB			;EMIT IMMEDIATE OPCODE
	CALL	SETBYTE			;EMIT 8BIT OPERAND
	JMPS	INCPC
;
SLDAX:					;LDAX B/STAX D
	CALL	SHREG
	AND	AL,101000B		;MUST BE B OR D
	JZ	L_M26
	CALL	ERRR			;REGISTER ERROR IF NOT
L_M26:
	MOV	AL,CL			;RECOVER REGISTER NUMBER
	AND	AL,010000B		;CHANGE TO B OR D IF ERROR
	OR	AL,CH			;MASK IN OPCODE
	JMPS	FILINC			;EMIT OPCODE
;
SLHLD:					;LHLD 16B/ SHLD 16B/ LDA 16B/ STA 16B
	CALL	FILHB			;EMIT OPCODE
	CALL	SETADR			;EMIT OPERAND
	JMPS	INCPC
;
SACCR:					;ADD B
	CALL	EXP3			;RIGHT ADJUSTED 3BIT VALUE FOR REGISTER
	OR	AL,CH			;MASK IN OPCODE
	JMPS	FILINC
;
SINC:					;INR B/DCR D
	CALL	SHREG			;GET REGISTER
	OR	AL,CH
	JMPS	FILINC
;
SINX:					;INX H/DCX B
	CALL	SHREG
	AND	AL,001000B		;MUST BE B D M OR SP
	JZ	L_M27
	CALL	ERRR			;REGISTER ERROR IF NOT
L_M27:
	MOV	AL,CL			;RECOVER REGISTER
	AND	AL,110000B		;IN CASE OF ERROR
	OR	AL,CH			;MASK IN OPCODE
	JMPS	FILINC
;
SRST:					;RESTART 4
	CALL	SHREG			;VALUE IS 0-7
	OR	AL,CH			;OPCODE MASKED
	JMPS	FILINC
;
SINP:					;IN 8B/OUT 8B
	CALL	FILHB			;EMIT OPCODE
	CALL	SETBYTE			;EMIT 8BIT OPERAND
	JMPS	INCPC
;
FILINC:					;FILL HEX VALUE FROM A BEFORE INCREMENTING PC
	CALL	FILHEX
;
INCPC:					;CHANGE ASSEMBLER'S PSEUDO PROGRAM COUNTER
	CALL	FILAB			;SET ANY LABELS WHICH OCCUR ON THE LINE
	CALL	SETAS			;ASPC=FPC
	JMP	CHEND			;END OF LINE SCAN
;
; =========================================================================
; UTILITY SUBROUTINES FOR MAIN
; =========================================================================
DELIM:					;CHECK DELIMITER SYNTAX FOR DATA STATEMENTS
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,SPECL
	JZ	L_M28
	CALL	ERRD
L_M28:
	MOV	AL,Byte Ptr ACCUM
	CMP	AL,','
	JNZ	L_M29
	RET
L_M29:
	CMP	AL,';'
	JNZ	L_M30
	RET
L_M30:
	CMP	AL,CR
	JZ	L_M31
	CALL	ERRD
L_M31:
	RET
;
EXP16:					;GET 16BIT VALUE TO H,L
	PUSH	CX
	CALL	SCAN			;START SCANNING OPERAND FIELD
	CALL	OPAND
	MOV	BX,Word Ptr EVALUE	;VALUE TO H,L
	POP	CX
	RET
;
EXP8:					;GET 8BIT VALUE TO REG A
	CALL	EXP16
	MOV	AL,BH
	OR	AL,AL
	JZ	L_M32
	CALL	ERRV			;VALUE ERROR IF HIGH BYTE NOT ZERO
L_M32:
	MOV	AL,BL
	RET
;
EXP3:					;GET 3BIT VALUE TO REG A
	CALL	EXP8
	CMP	AL,8
	JNAE	L_M33
	CALL	ERRV			;VALUE ERROR IF >=8
L_M33:
	AND	AL,111B			;REDUCE IF ERROR OCCURS
	RET
;
SHREG:					;GET 3BIT VALUE AND SHIFT LEFT BY 3
	CALL	EXP3
	RCL	AL,1
	RCL	AL,1
	RCL	AL,1
	AND	AL,111000B
	MOV	CL,AL			;COPY TO C
	RET
;
SHDREG:					;GET DOUBLE REGISTER TO A
	CALL	SHREG
	AND	AL,001000B		;CHECK FOR A,C,E, OR L
	JZ	L_M34
	CALL	ERRR			;REGISTER ERROR
L_M34:
	MOV	AL,CL			;RECOVER REGISTER
	AND	AL,110000B		;FIX IT IF ERROR OCCURRED
	OR	AL,CH			;MASK OPCODE
	JMP	FILHEX			;EMIT IT
;
SETBYTE:				;EMIT 8BIT OPERAND
	CALL	EXP8
	JMP	FILHEX
;
SETADR:					;EMIT 16BIT OPERAND
	CALL	EXP16
	JMP	FILADR
;
CHCOM:					;CHECK FOR COMMA FOLLOWING EXPRESSION
	LAHF
	XCHG	AL,AH
	PUSH	AX
	PUSH	CX
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,SPECL
	JNZ	COMER
;	SPECIAL CHARACTER, CHECK FOR COMMA
	MOV	AL,Byte Ptr ACCUM
	CMP	AL,','
	JZ	COMRET			;RETURN IF COMMA FOUND
COMER:					;COMMA ERROR
	MOV	AL,'C'
	CALL	PERR
COMRET:
	POP	CX
	POP	AX
	XCHG	AL,AH
	SAHF
	RET
;
CHEND:					;END OF LINE CHECK
	CALL	FILAB			;IN CASE OF A LABEL
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,SPECL
	JNZ	STERR			;MUST BE A SPECIAL CHARACTER
	MOV	AL,Byte Ptr ACCUM
	CMP	AL,CR			;CARRIAGE RETURN
	JNZ	CHEN0
;	CARRIAGE RETURN FOUND, SCAN PICKS UP LF AND PUSHES LINE
	CALL	SCAN
	JMP	SCNEXT
;
CHEN0:					;NOT CR, CHECK FOR COMMENT
	CMP	AL,';'
	JNZ	CHEN2
	CALL	FILAB			;IN CASE LABELLED EMPTY LINE
;	CLEAR COMMENT TO END OF LINE
CHEN1:	CALL	SCAN
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,SPECL
	JNZ	CHEN1
	MOV	AL,Byte Ptr ACCUM
	CMP	AL,LF
	JNZ	L_M35
	JMP	SCNEXT
L_M35:
	CMP	AL,EOF
	JZ	ENDAS			;END OF ASSEMBLY IF EOF
	CMP	AL,'!'
	JNZ	L_M36
	JMP	SCNEXT			;LOGICAL END OF LINE
L_M36:
	JMPS	CHEN1			;NONE OF THE ABOVE
;
;	NOT CR OR LF, MAY BE LOGICAL END OF LINE
CHEN2:	CMP	AL,'!'
	JNZ	L_M37
	JMP	SCNEXT
L_M37:
	CMP	AL,EOF
	JZ	ENDAS
;
;	STATEMENT ERROR IN OPERAND FIELD
STERR:	MOV	AL,'S'
	CALL	PERR
	JMPS	CHEN1			;TO DUMP LINE
;
DIFF:					;COMPUTE DE-HL TO HL
	MOV	AL,DL
	SUB	AL,BL
	MOV	BL,AL
	MOV	AL,DH
	SBB	AL,BH
	MOV	BH,AL
	RET
;
ENDAS:					;END OF ASSEMBLY FOR THIS PASS
	MOV	BX,(Offset PASS)
	MOV	AL,M
	INC	M			;PASS NUMBER INCREMENTED
	OR	AL,AL
	JNZ	L_M38
	JMP	RESTART
L_M38:
	CALL	SCAN			;TO CLEAR LAST LINE FEED
	CALL	PADD			;WRITE LAST ADDRESS
	MOV	BX,(Offset PBUFF)+5
	MOV	M,CR			;SET TO CR FOR END OF MESSAGE
	MOV	BX,(Offset PBUFF)+1
	CALL	PCON			;PRINT LAST ADDRESS
;
;	COMPUTE REMAINING SPACE
	MOV	BX,Word Ptr SYTOP
	XCHG	BX,DX
	MOV	BX,Word Ptr SYBAS
	CALL	DIFF			;DIFFERENCE TO H,L
	PUSH	BX			;SYTOP-SYBAS TO STACK
	MOV	BX,Word Ptr SYMAX
	XCHG	BX,DX
	MOV	BX,Word Ptr SYBAS
	CALL	DIFF			;SYMAX-SYBAS TO H,L
	MOV	DL,BH
	MOV	DH,0			;DIVIDED BY 256
	POP	BX			;SYTOP-SYBAS TO H,L
	CALL	DIVE			;RESULT TO DE (OPMOD+9 IS DIVE)
	XCHG	BX,DX
	CALL	PADDR			;PRINT H,L TO PBUFF
	MOV	BX,(Offset PBUFF)+5	;MESSAGE
	MOV	DX,(Offset EMSG)	;END MESSAGE
ENDA0:	MOV	SI,DX
	MOV	AL,[SI]
	OR	AL,AL			;ZERO?
	JZ	ENDA1
	MOV	M,AL
	INC	BX
	INC	DX
	JMPS	ENDA0
;
EMSG	DB	'H USE FACTOR',CR,0
;
ENDA1:	MOV	BX,(Offset PBUFF)+2	;BEGINNING OF RATIO
	CALL	PCON
	MOV	BX,Word Ptr EPC
	MOV	Word Ptr FPC,BX		;END PROGRAM COUNTER
	JMP	EOR
;
COMDH:					;COMPARE D,E WITH H,L FOR EQUALITY (NZ FLAG IF NOT EQUAL)
	MOV	AL,DH
	CMP	AL,BH
	JZ	L_M41
	RET
L_M41:
	MOV	AL,DL
	CMP	AL,BL
	RET
;
SETAS:					;ASPC=FPC
	MOV	BX,Word Ptr FPC
	MOV	Word Ptr ASPC,BX
	RET
;
SETLA:					;SYADR=SYLAB, FOLLOWED BY CHECK FOR ZERO
	MOV	BX,Word Ptr SYLAB
	MOV	Word Ptr SYADR,BX
	CALL	FOUND
	RET
;
FILAB:					;FILL LABEL VALUE WITH CURRENT ASPC, IF LABEL FOUND
	CALL	SETLA
	JNZ	L_M42
	RET				;RETURN IF NO LABEL DETECTED
L_M42:
;
;	LABEL FOUND, MUST BE DEFINED ON PASS-1
	MOV	BX,0
	MOV	Word Ptr SYLAB,BX	;TO MARK NEXT STATEMENT WITH NO LABEL
	MOV	AL,Byte Ptr PASS
	OR	AL,AL
	JNZ	FIL1
;
;	PASS 0
	CALL	GETTY
	LAHF				;SAVE A COPY OF TYPE
	XCHG	AL,AH
	PUSH	AX
	XCHG	AL,AH
	AND	AL,111B			;CHECK FOR UNDEFINED
	JZ	L_M43
	CALL	ERRL			;LABEL ERROR
L_M43:
	POP	AX			;RESTORE TYPE
	XCHG	AL,AH
	OR	AL,PLABT		;SET TO LABEL TYPE
	CALL	SETTY			;SET TYPE FIELD
	MOV	BX,Word Ptr ASPC	;GET CURRENT PC
	CALL	SETVAL			;PLACE INTO VALUE FIELD
	RET
;
FIL1:					;CHECK FOR DEFINED VALUE
	CALL	GETTY
	AND	AL,111B
	JNZ	L_M44
	CALL	ERRP			;PHASE ERROR
L_M44:
;	GET VALUE AND COMPARE WITH ASPC
	CALL	GETVAL			;TO H,L
	XCHG	BX,DX
	MOV	BX,Word Ptr ASPC
	CALL	COMDH
	JZ	L_M45
	CALL	ERRP			;PHASE ERROR IF NOT THE SAME
L_M45:
	RET
;
FILHEX:					;WRITE HEX BYTE IN REGISTER A TO MACHINE CODE FILE IF PASS-1
	MOV	CH,AL
FILHB:	MOV	AL,Byte Ptr PASS
	OR	AL,AL
	MOV	AL,CH
	JZ	FILHI
;
;	PASS - 1, WRITE HEX AND PRINT DATA
	PUSH	CX			;SAVE A COPY
	CALL	DHEX			;INTO MACHINE CODE FILE
;	MAY BE COMPLETELY EMPTY LINE, SO CHECK ADDRESS
	MOV	AL,Byte Ptr PBUFF+1
	CMP	AL,' '
	MOV	BX,Word Ptr ASPC
	JNZ	L_M46
	CALL	PADDR			;PRINT ADDRESS FIELD
L_M46:
;
	MOV	AL,Byte Ptr NBP
	CMP	AL,NBMAX		;TRUNCATE CODE IF TOO MUCH ON THIS LINE
	POP	CX			;RECALL HEX DIGIT
	JNB	FILHI
;	ROOM FOR DIGIT ON THIS LINE
	MOV	AL,CH
	CALL	WHEXB			;WRITE HEX BYTE TO PRINT LINE
FILHI:	MOV	BX,Word Ptr FPC
	INC	BX
	MOV	Word Ptr FPC,BX		;READY FOR NEXT BYTE
	RET
;
FILADR:					;EMIT DOUBLE PRECISION VALUE FROM H,L
	PUSH	BX			;SAVE A COPY
	MOV	CH,BL
	CALL	FILHB			;LOW BYTE EMITTED
	POP	BX			;RECOVER A COPY OF H,L
	MOV	CH,BH
	JMPS	FILHB			;EMIT HIGH BYTE AND RETURN
;
CHEX:					;CONVERT TO HEX
	ADD	AL,'0'
	CMP	AL,'0'+10
	JNB	L_M47
	RET
L_M47:
	ADD	AL,'A'-'0'-10
	RET
;
WHEXN:					;WRITE HEX NIBBLE
	CALL	CHEX			;CONVERT TO ASCII FROM HEX
	MOV	BX,(Offset NBP)
	MOV	DL,M			;NEXT POSITION TO PRINT
	MOV	DH,0			;DOUBLE PRECISION
	INC	M			;NBP=NBP+1
	MOV	BX,(Offset PBUFF)
	ADD	BX,DX
	MOV	M,AL			;STORE IN PRINT BUFFER
	RET
;
WHEXB:					;WRITE HEX BYTE TO PRINT BUFFER
	LAHF
	XCHG	AL,AH
	PUSH	AX
	XCHG	AL,AH
	RCR	AL,1
	RCR	AL,1
	RCR	AL,1
	RCR	AL,1
	AND	AL,0FH			;HIGH ORDER NIBBLE NORMALIZE IN A
	CALL	WHEXN			;WRITE IT
	POP	AX
	XCHG	AL,AH
	AND	AL,0FH
	JMPS	WHEXN			;WRITE AND RETURN
;
PADD:	MOV	BX,Word Ptr ASPC
PADDR:					;PRINT ADDRESS FIELD OF PRINT LINE FROM H,L
	XCHG	BX,DX
	MOV	BX,(Offset NBP)		;INITIALIZE NEXT TO FILL
	PUSH	BX			;SAVE A COPY OF NBP'S ADDRESS
	MOV	M,1
	MOV	AL,DH			;PRINT HIGH BYTE
	PUSH	DX			;SAVE A COPY
	CALL	WHEXB
	POP	DX
	MOV	AL,DL
	CALL	WHEXB
	POP	BX			;ADDRESSING NBP
	INC	M			;SKIP A SPACE AFTER ADDRESS FIELD
	RET
;
ERRR:					;EMIT REGISTER ERROR
	LAHF
	XCHG	AL,AH
	PUSH	AX
	PUSH	CX
	MOV	AL,'R'
	CALL	PERR
	POP	CX
	POP	AX
	XCHG	AL,AH
	SAHF
	RET
;
ERRV:					;EMIT VALUE ERROR
	LAHF
	XCHG	AL,AH
	PUSH	AX
	PUSH	BX
	MOV	AL,'V'
	CALL	PERR
	POP	BX
	POP	AX
	XCHG	AL,AH
	SAHF
	RET
;
ERRD:	LAHF
	XCHG	AL,AH
	PUSH	AX
	MOV	AL,'D'			;DATA ERROR
	JMPS	ERR
;
ERRP:	LAHF
	XCHG	AL,AH
	PUSH	AX
	MOV	AL,'P'
	JMPS	ERR
;
ERRL:	LAHF
	XCHG	AL,AH
	PUSH	AX
	MOV	AL,'L'			;LABEL ERROR
	JMPS	ERR
;
ERRN:	LAHF
	XCHG	AL,AH
	PUSH	AX
	MOV	AL,'N'			;NOT IMPLEMENTED
;
ERR:
	CALL	PERR
	POP	AX
	XCHG	AL,AH
	SAHF
	RET
;
; =========================================================================
; I/O MODULE ROUTINES
; =========================================================================
BDOSF:					;BDOS CALL; KERNEL RETURNS ES=BDOS SEGMENT
	PUSH	ES			;KEEP THE 8080 MODEL INVARIANT ES=DS=CS
	INT	224
	POP	ES
	RET
;
SEL:					;SELECT DISK IN REG-A
	MOV	BX,(Offset CDISK)
	CMP	AL,M			;SAME?
	JNZ	L_IO3
	RET
L_IO3:
	MOV	M,AL			;CHANGE CURRENT DISK
	MOV	DL,AL
	MOV	CL,SELECT
	CALL	BDOSF
	RET
;
SCNP:					;SCAN THE NEXT PARAMETER
	INC	BX
	MOV	AL,M
	CMP	AL,' '
	JZ	SCNP0
	SBB	AL,'A'			;NORMALIZE
	RET
SCNP0:	MOV	AL,Byte Ptr CDISK
	RET
;
PCON:					;PRINT MESSAGE AT H,L TO CONSOLE DEVICE
	MOV	AL,M
	CALL	PCHAR
	MOV	AL,M
	INC	BX
	CMP	AL,CR
	JNZ	PCON
	MOV	AL,LF
	CALL	PCHAR
	RET
;
FNAME:					;FILL NAME FROM DEFAULT FILE CONTROL BLOCK
	MOV	DX,FCB
	MOV	CH,FLN
FNAM0:	MOV	SI,DX			;GET NEXT FILE CHARACTER
	MOV	AL,[SI]
	CMP	AL,'?'
	JNZ	L_IO4
	JMP	FNERR			;FILE NAME ERROR
L_IO4:
	MOV	M,AL			;STORE TO FILE CNTRL BLOCK
	INC	BX
	INC	DX
	DEC	CH
	JNZ	FNAM0			;FOR NEXT CHARACTER
	RET
;
INIT:					;SET UP STACK AND FILES, START ASSEMBLER
	MOV	BX,(Offset TITL)
	CALL	PCON
	JMPS	SET0
;
OPEN:					;OPEN FILE ADDRESSED BY D,E
	MOV	CL,OPENF
	CALL	BDOSF
	CMP	AL,255
	JZ	L_IO5
	RET
L_IO5:
;	OPEN ERROR
	MOV	BX,(Offset ERROP)
	CALL	PCON
	MOV	CL,0
	MOV	DL,0
	CALL	BDOSF
;
CLOSE:					;CLOSE FILE ADDRESSED BY D,E
	MOV	CL,CLOSF
	CALL	BDOSF
	CMP	AL,255
	JZ	L_IO6
	RET				;CLOSE OK
L_IO6:
	MOV	BX,(Offset ERRCL)
	CALL	PCON
	MOV	CL,0
	MOV	DL,0
	CALL	BDOSF
;
DELETE:					;DELETE FILE ADDRESSED BY D,E
	MOV	CL,DELEF
	CALL	BDOSF
	RET
;
MAKE:					;MAKE FILE ADDRESSED BY D,E
	MOV	CL,MAKEF
	CALL	BDOSF
	CMP	AL,255
	JZ	L_IO7
	RET
L_IO7:
;	MAKE ERROR
	MOV	BX,(Offset ERRMA)
	CALL	PCON
	MOV	CL,0
	MOV	DL,0
	CALL	BDOSF
;
SELA:	MOV	AL,Byte Ptr ADISK
	CALL	SEL
	RET
;
NPR:					;RETURN ZERO FLAG IF NO PRINT FILE
	MOV	AL,Byte Ptr PDISK
	CMP	AL,'Z'-'A'
	JNZ	L_IO8
	RET
L_IO8:
	CMP	AL,'X'-'A'		;CONSOLE
	RET
;
SELP:	MOV	AL,Byte Ptr PDISK
	CALL	SEL
	RET
;
SELH:	MOV	AL,Byte Ptr HDISK
	CALL	SEL
	RET
;
SET0:					;SET UP FILES FOR INPUT AND OUTPUT
	MOV	AL,Byte Ptr .FCB+1	;CHECK 1ST CHAR OF FILE NAME
	CMP	AL,' '			;MAY HAVE FORGOTTEN NAME
	JNZ	L_IO9
	JMP	FNERR			;FILE NAME ERROR
L_IO9:
	MOV	CL,CSEL			;CURRENT DISK?
	CALL	BDOSF			;GET IT TO REG-A
	MOV	Byte Ptr CDISK,AL
;
;	SCAN PARAMETERS
	MOV	BX,FCB+FLN-1
	CALL	SCNP
	MOV	Byte Ptr ADISK,AL
	CALL	SCNP
	MOV	Byte Ptr HDISK,AL
	CALL	SCNP
	MOV	Byte Ptr PDISK,AL
;
	MOV	BX,(Offset SCB)		;ADDRESS SOURCE FILE CONTROL BLOCK
	CALL	FNAME			;FILE NAME OBTAINED FROM DEFAULT FCB
;
;	VERIFY SOURCE FILE CAN BE OPENED BEFORE CREATING OUTPUT FILES
	CALL	SELA
	MOV	DX,(Offset SCB)
	MOV	CL,OPENF
	CALL	BDOSF
	CMP	AL,255
	JNZ	SRC_OK
;	SOURCE FILE NOT PRESENT - EXIT WITHOUT CREATING .HEX OR .PRN
	MOV	BX,(Offset ERROP)
	CALL	PCON
	MOV	CL,0
	MOV	DL,0
	CALL	BDOSF
;
SRC_OK:
	CALL	NPR			;Z OR X?
	JZ	NOPR
	MOV	BX,(Offset PCB)		;ADDRESS PRINT FILE CONTROL BLOCK
	PUSH	BX			;SAVE A COPY FOR OPEN
	PUSH	BX			;SAVE A COPY FOR DELETE
	CALL	FNAME			;FILL PCB
	CALL	SELP
	POP	DX			;FCB ADDRESS
	CALL	DELETE
	POP	DX			;FCB ADDRESS
	CALL	MAKE
;
NOPR:					;TEST FOR HEX FILE
	MOV	AL,Byte Ptr HDISK
	CMP	AL,'Z'-'A'
	JZ	NOHEX
	MOV	BX,(Offset HCB)
	PUSH	BX
	PUSH	BX
	CALL	FNAME
	CALL	SELH
	POP	DX
	CALL	DELETE
	POP	DX
	CALL	MAKE
;
NOHEX:	RET
;
SETUP:					;SETUP INPUT FILE FOR SOURCE PROGRAM
	MOV	BX,SSIZE
	MOV	Word Ptr SBP,BX		;CAUSE IMMEDIATE READ
	XOR	AL,AL			;ZERO VALUE
	MOV	Byte Ptr SCBR,AL	;CLEAR REEL NUMBER
	MOV	Byte Ptr SCBCR,AL	;CLEAR CURRENT RECORD
	MOV	Byte Ptr DBL,AL		;CLEAR HEX BUFFER LENGTH
	CALL	SELA
	MOV	DX,(Offset SCB)
	CALL	OPEN
	RET
;
FNERR:					;FILE NAME ERROR
	MOV	BX,(Offset ERRFN)
	CALL	PCON
	MOV	CL,0
	MOV	DL,0
	CALL	BDOSF
;
GCOMP:					;COMPARE D,E AGAINST H,L
	MOV	AL,DH
	CMP	AL,BH
	JZ	L_IO11
	RET
L_IO11:
	MOV	AL,DL
	CMP	AL,BL
	RET
;
GNC:					;GET NEXT CHARACTER FROM SOURCE BUFFER
	PUSH	CX
	PUSH	DX
	PUSH	BX			;ENVIRONMENT SAVED
	MOV	BX,Word Ptr SBP
	MOV	DX,SSIZE
	CALL	GCOMP
	JNZ	GNC2
;
;	READ ANOTHER BUFFER
	CALL	SELA
	MOV	BX,0
	MOV	Word Ptr SBP,BX
	MOV	CH,NSB			;NUMBER OF SOURCE BUFFERS
	MOV	BX,(Offset SBUFF)
GNC0:					;READ 128 BYTES
	PUSH	CX			;SAVE COUNT
	PUSH	BX			;SAVE BUFFER ADDRESS
	MOV	CL,SETDM
	MOV	DX,BUFF
	CALL	BDOSF
	MOV	CL,READF
	MOV	DX,(Offset SCB)
	CALL	BDOSF			;PERFORM THE READ
	POP	BX			;RESTORE BUFFER ADDRESS
	POP	CX			;RESTORE BUFFER COUNT
	OR	AL,AL			;SET FLAGS
	MOV	CL,128
	JNZ	GNC1
;	NORMAL READ OCCURRED
	MOV	DX,BUFF			;SOURCE BUFFER ADDRESS
	MOV	CL,128
MOV0:	MOV	SI,DX			;GET CHARACTER
	MOV	AL,[SI]
	MOV	M,AL			;STORE CHARACTER
	INC	DX
	INC	BX
	DEC	CL
	JNZ	MOV0
;	BUFFER LOADED, TRY NEXT BUFFER
	DEC	CH
	JNZ	GNC0
	JMPS	GNC2
;
GNC1:					;EOF OR ERROR
	CMP	AL,3			;ALLOW 0,1,2
	JNB	FRERR			;FILE READ ERROR
GNCE:	MOV	M,EOF			;STORE END OF FILE CHARACTER
	INC	BX
	DEC	CL
	JNZ	GNCE			;FILL CURRENT BUFFER WITH EOF'S
;
GNC2:					;GET CHARACTER TO ACCUMULATOR AND RETURN
	MOV	DX,(Offset SBUFF)
	MOV	BX,Word Ptr SBP
	PUSH	BX			;SAVE CURRENT SBP
	INC	BX
	MOV	Word Ptr SBP,BX
	POP	BX			;RESTORE PREVIOUS SBP
	ADD	BX,DX
	MOV	AL,M			;GET IT
	POP	BX
	POP	DX
	POP	CX
	RET
;
FRERR:	MOV	BX,(Offset ERRFR)
	CALL	PCON			;PRINT READ ERROR MESSAGE
	MOV	CL,0
	MOV	DL,0
	CALL	BDOSF
;
PNC:					;SAME AS PNCF, BUT ENVIRONMENT IS SAVED FIRST
	PUSH	CX
;	CHECK FOR CONSOLE OUTPUT / NO OUTPUT
	MOV	CH,AL			;SAVE CHARACTER
	MOV	AL,Byte Ptr PDISK	;Z OR X?
	CMP	AL,'Z'-'A'		;Z NO OUTPUT
	JZ	PNRET
;
	CMP	AL,'X'-'A'
	MOV	AL,CH			;RECOVER CHAR FOR CON OUT
	JNZ	PNGO
	CALL	PCHAR
	JMPS	PNRET
;
;	NOT X OR Z, SO PRINT IT
PNGO:	PUSH	DX
	PUSH	BX
	CALL	PNCF
	POP	BX
	POP	DX
PNRET:	POP	CX
	RET
;
PNCF:					;PRINT NEXT CHARACTER
	MOV	BX,Word Ptr OBP
	XCHG	BX,DX
	MOV	BX,(Offset OBUFF)
	ADD	BX,DX
	MOV	M,AL			;CHARACTER STORED AT OBP IN OBUFF
	XCHG	BX,DX			;OBP TO H,L
	INC	BX
	MOV	Word Ptr OBP,BX		;REPLACE IT
	XCHG	BX,DX
	MOV	BX,PSIZE
	CALL	GCOMP			;AT END OF BUFFER?
	JZ	L_IO12
	RET				;RETURN IF NOT
L_IO12:
;
;	OVERFLOW, WRITE BUFFER
	CALL	SELP
	MOV	BX,0
	MOV	Word Ptr OBP,BX
	MOV	BX,(Offset OBUFF)
	MOV	DX,(Offset PCB)		;D,E ADDRESS FILE CONTROL BLOCK
	MOV	CH,NPB			;NUMBER OF BUFFERS TO B
;
WBUFF:					;WRITE BUFFERS STARTING AT H,L FOR B BUFFERS
;	CHECK FOR EOF'S
	MOV	AL,M
	CMP	AL,EOF
	JNZ	L_IO13
	RET				;DON'T DO THE WRITE
L_IO13:
;
	PUSH	CX			;SAVE NUMBER OF BUFFERS
	PUSH	DX			;SAVE FCB ADDRESS
	MOV	CL,128			;READY FOR MOVE
	MOV	DX,BUFF
WBUF0:					;MOVE TO BUFFER
	MOV	AL,M			;GET CHARACTER
	MOV	SI,DX			;PUT CHARACTER
	MOV	[SI],AL
	INC	BX
	INC	DX
	DEC	CL
	JNZ	WBUF0
;
;	WRITE BUFFER
	POP	DX			;RECOVER FCB ADDRESS
	PUSH	DX			;SAVE IT AGAIN FOR LATER
	PUSH	BX			;SAVE BUFFER ADDRESS
	MOV	CL,SETDM
	MOV	DX,BUFF
	CALL	BDOSF
	POP	BX
	POP	DX
	PUSH	DX
	PUSH	BX
	MOV	CL,WRITF		;DOS WRITE FUNCTION
	CALL	BDOSF
	POP	BX			;RECOVER BUFFER ADDRESS
	POP	DX			;RECOVER FCB ADDRESS
	POP	CX			;RECOVER BUFFER COUNT
	OR	AL,AL			;SET ERROR RETURN FLAGS
	JNZ	FWERR
;
;	WRITE OK
	DEC	CH
	JNZ	L_IO14
	RET				;RETURN IF NO MORE BUFFERS TO WRITE
L_IO14:
	JMPS	WBUFF
;
FWERR:					;ERROR IN WRITE
	MOV	Byte Ptr ASMERR,1
	MOV	BX,(Offset ERRFW)
	CALL	PCON			;ERROR MESSAGE OUT
	JMP	EORC			;TO CLOSE AND REBOOT
;
PNB:					;PUT NEXT HEX BYTE
	PUSH	CX
	PUSH	DX
	PUSH	BX
	CALL	PNBF
	POP	BX
	POP	DX
	POP	CX
	RET
;
PNBF:					;PUT NEXT BYTE
	MOV	BX,Word Ptr HBP
	XCHG	BX,DX
	MOV	BX,(Offset HBUFF)
	ADD	BX,DX
	MOV	M,AL			;CHARACTER STORED AT HBP IN HBUFF
	XCHG	BX,DX
	INC	BX
	MOV	Word Ptr HBP,BX
	XCHG	BX,DX			;BACK TO D,E
	MOV	BX,HSIZE
	CALL	GCOMP			;EQUAL?
	JZ	L_IO15
	RET
L_IO15:
;
;	OVERFLOW, WRITE BUFFERS
	CALL	SELH
	MOV	BX,0
	MOV	Word Ptr HBP,BX
	MOV	BX,(Offset HBUFF)
	MOV	DX,(Offset HCB)		;FILE CONTROL BLOCK FOR HEX FILE
	MOV	CH,NHB
	JMP	WBUFF			;WRITE BUFFERS
;
PCHAR:					;PRINT CHARACTER IN REGISTER A
	PUSH	CX
	PUSH	DX
	PUSH	BX
	MOV	CL,WRITC
	MOV	DL,AL
	CALL	BDOSF
	POP	BX
	POP	DX
	POP	CX
	RET
;
WOCHAR:					;WRITE CHARACTER IN REG-A WITH REFLECT AT CONSOLE IF ERROR
	MOV	CL,AL			;SAVE THE CHAR
	CALL	PNC			;PRINT CHAR
	MOV	AL,Byte Ptr PBUFF
	CMP	AL,' '
	JNZ	L_IO16
	RET
L_IO16:
;	ERROR IN LINE
	MOV	AL,Byte Ptr PDISK
	CMP	AL,'X'-'A'
	JNZ	L_IO17
	RET				;ALREADY PRINTED IF 'X'
L_IO17:
	MOV	AL,CL			;RECOVER CHARACTER
	CALL	PCHAR			;PRINT IT
	RET
;
WOBUFF:					;WRITE THE OUTPUT BUFFER TO THE PRINT FILE
	MOV	AL,Byte Ptr PBP		;GET CHARACTER COUNT
	MOV	BX,(Offset PBUFF)	;BASE OF BUFFER
WOB0:	OR	AL,AL			;ZERO COUNT?
	JZ	WOBE
;	NOT END, SAVE COUNT AND GET CHARACTER
	MOV	CH,AL			;SAVE COUNT
	MOV	AL,M
	CALL	WOCHAR			;WRITE CHARACTER
	INC	BX			;ADDRESS NEXT CHARACTER OF BUFFER
	MOV	AL,CH			;GET COUNT
	DEC	AL
	JMPS	WOB0
;
WOBE:					;END OF PRINT - ZERO PBP
	MOV	Byte Ptr PBP,AL
;	FOLLOW BY CR LF
	MOV	AL,CR
	CALL	WOCHAR
	MOV	AL,LF
	CALL	WOCHAR
	MOV	BX,(Offset PBUFF)
	MOV	AL,PBMAX		;READY TO BLANK OUT
WOB2:	MOV	M,' '
	INC	BX
	DEC	AL
	JNZ	WOB2
	RET
;
PERR:					;FILL PBUFF ERROR MESSAGE POSITION
	MOV	CH,AL			;SAVE CHARACTER
	MOV	BX,(Offset PBUFF)
	MOV	AL,M
	CMP	AL,' '
	JZ	L_IO18
	RET				;DON'T CHANGE IT IF ALREADY SET
L_IO18:
	MOV	M,CH			;STORE ERROR CHARACTER
	RET
;
EOR:					;END OF ASSEMBLER
	CALL	NPR			;Z OR A?
	JZ	EOPR
;	FILL OUTPUT FILES WITH EOF'S
EOR2:	MOV	BX,Word Ptr OBP
	MOV	AL,BL
	OR	AL,BH			;VALUE ZERO?
	JZ	EOPR
	MOV	AL,EOF			;CTL-Z IS END OF FILE
	CALL	PNC			;PUT ENDFILES IN PRINT BUFFER
	JMPS	EOR2			;EVENTUALLY BUFFER IS WRITTEN
;
EOPR:					;END OF PRINT FILE, CHECK HEX
	MOV	AL,Byte Ptr HDISK
	CMP	AL,'Z'-'A'
	JZ	EORC
EOR0:					;WRITE TERMINATING RECORD INTO HEX FILE
	MOV	AL,Byte Ptr DBL		;MAY BE ZERO ALREADY
	OR	AL,AL
	JZ	L_IO19
	CALL	WHEX			;WRITE HEX BUFFER IF NOT ZERO
L_IO19:
	MOV	BX,Word Ptr FPC		;GET CURRENT FPC AS LAST ADDRESS
	MOV	Word Ptr BPC,BX		;RECORD LENGTH ZERO, BASE ADDRESS
	CALL	WHEX			;WRITE HEX BUFFER
;
;	NOW CLEAR OUTPUT BUFFER FOR HEX FILE
EOR1:	MOV	BX,Word Ptr HBP
	MOV	AL,BL
	OR	AL,BH
	JZ	EORC
	MOV	AL,EOF
	CALL	PNB
	JMPS	EOR1
;
;	CLOSE FILES AND TERMINATE
EORC:
	CALL	NPR
	JZ	EORPC
	CALL	SELP
	MOV	DX,(Offset PCB)
	CALL	CLOSE
EORPC:
	MOV	AL,Byte Ptr HDISK
	CMP	AL,'Z'-'A'
	JZ	EORHC
	CALL	SELH
	MOV	DX,(Offset HCB)
	CALL	CLOSE
	CMP	Byte Ptr ASMERR,0
	JZ	EORHC
;	ASSEMBLY HAD ERRORS: DON'T LEAVE A HEX FILE BEHIND
	MOV	Byte Ptr HCB+12,0	;EXTENT 0
	MOV	DX,(Offset HCB)
	CALL	DELETE
;
EORHC:
	MOV	BX,(Offset MSG_ENDA)
	CALL	PCON
	MOV	CL,0
	MOV	DL,0
	CALL	BDOSF
;
TITL	DB	'CP/M 8080 ASSEMBLER VER 2.0N',CR
ERROP	DB	'NO SOURCE FILE PRESENT',CR
ERRMA	DB	'NO DIRECTORY SPACE',CR
ERRFN	DB	'SOURCE FILE NAME ERROR',CR
ERRFR	DB	'SOURCE FILE READ ERROR',CR
ERRFW	DB	'OUTPUT FILE WRITE ERROR',CR
ERRCL	DB	'CANNOT CLOSE FILES',CR
MSG_ENDA DB	'END OF ASSEMBLY',CR
;
DHEX:					;DATA TO HEX BUFFER (BYTE IN REG-A)
	PUSH	CX
	MOV	CH,AL			;HOLD CHARACTER FOR 'Z' TEST
	MOV	AL,Byte Ptr HDISK
	CMP	AL,'Z'-'A'
	MOV	AL,CH			;RECOVER CHARACTER
	JZ	DHRET
	PUSH	DX			;ENVIRONMENT SAVED
	LAHF				;SAVE DATA BYTE
	XCHG	AL,AH
	PUSH	AX
	MOV	BX,(Offset DBL)		;CURRENT LENGTH
	MOV	AL,M			;TO ACCUM
	OR	AL,AL			;ZERO?
	JZ	DHEX3
;
;	LENGTH NOT ZERO, MAY BE FULL BUFFER
	CMP	AL,16
	JB	DHEX1			;BR IF LESS THAN 16 BYTES
;	BUFFER FULL, DUMP IT
	CALL	WHEX			;DBL = 0 UPON RETURN
	JMPS	DHEX3			;SET BPC AND DATA BYTE
;
DHEX1:					;PARTIAL BUFFER IN PROGRESS, CHECK FOR SEQUENTIAL BYTE LOAD
	MOV	BX,Word Ptr FPC
	XCHG	BX,DX
	MOV	BX,Word Ptr BPC		;BASE PC IN H,L
	MOV	CL,AL			;CURRENT LENGTH OF BUFFER
	MOV	CH,0			;IS IN B,C
	ADD	BX,CX			;BPC+DBL TO H,L
	MOV	AL,DL			;READY FOR COMPARE
	CMP	AL,BL			;EQUAL?
	JNZ	DHEX2			;BR IF NOT
	MOV	AL,DH			;CHECK HO BYTE
	CMP	AL,BH
	JZ	DHEX4			;BR IF SAME ADDRESS
;
DHEX2:					;NON SEQUENTIAL ADDRESS, DUMP AND CHANGE BASE ADDRESS
	CALL	WHEX
DHEX3:					;SET NEW BASE
	MOV	BX,Word Ptr FPC
	MOV	Word Ptr BPC,BX
;
DHEX4:					;STORE DATA BYTE AND INC DBL
	MOV	BX,(Offset DBL)
	MOV	DL,M			;LENGTH TO REG-E
	INC	M			;DBL=DBL+1
	MOV	DH,0			;HIGH ORDER ZERO FOR DOUBLE ADD
	MOV	BX,(Offset DBUFF)
	ADD	BX,DX			;DBUFF+DBL TO H,L
	POP	AX			;RESTORE DATA BYTE
	XCHG	AL,AH
	SAHF
	MOV	M,AL			;INTO DATA BUFFER
	POP	DX
DHRET:	POP	CX			;ENVIRONMENT RESTORED
	RET
;
WRC:					;WRITE CHARACTER WITH CHECK SUM IN D
	LAHF
	XCHG	AL,AH
	PUSH	AX
	XCHG	AL,AH
	ROR	AL,1
	ROR	AL,1
	ROR	AL,1
	ROR	AL,1
	AND	AL,0FH
	CALL	HEXC			;OUTPUT HEX CHARACTER
	POP	AX			;RESTORE BYTE
	XCHG	AL,AH
	SAHF
	LAHF				;SAVE A VERSION
	XCHG	AL,AH
	PUSH	AX
	XCHG	AL,AH
	AND	AL,0FH
	CALL	HEXC			;WRITE LOW NIBBLE
	POP	AX			;RESTORE BYTE
	XCHG	AL,AH
	ADD	AL,DH			;COMPUTE CHECKSUM
	MOV	DH,AL			;SAVE CS
	RET
;
HEXC:					;WRITE CHARACTER
	ADD	AL,90H
	DAA
	ADC	AL,40H
	DAA
	JMP	PNB			;PUT BYTE
;
WHEX:					;WRITE CURRENT HEX BUFFER
	MOV	AL,':'			;RECORD HEADER
	CALL	PNB			;PUT BYTE
	MOV	BX,(Offset DBL)		;RECORD LENGTH ADDRESS
	MOV	DL,M			;LENGTH TO REG-E
	XOR	AL,AL			;ZERO TO REG-A
	MOV	DH,AL			;CLEAR CHECKSUM
	MOV	M,AL			;LENGTH IS ZEROED FOR NEXT WRITE
	MOV	BX,Word Ptr BPC		;BASE ADDRESS FOR RECORD
	MOV	AL,DL			;LENGTH TO A
	CALL	WRC			;WRITE HEX VALUE
	MOV	AL,BH			;HIGH ORDER BASE ADDR
	CALL	WRC			;WRITE HO BYTE
	MOV	AL,BL			;LOW ORDER BASE ADDR
	CALL	WRC			;WRITE LO BYTE
	XOR	AL,AL			;ZERO TO A
	CALL	WRC			;WRITE RECORD TYPE 00
	MOV	AL,DL			;CHECK FOR LENGTH 0
	OR	AL,AL
	JZ	WHEX1
;
;	NON - ZERO, WRITE DATA BYTES
	MOV	BX,(Offset DBUFF)
WHEX0:	MOV	AL,M			;GET BYTE
	INC	BX
	CALL	WRC			;WRITE DATA BYTE
	DEC	DL			;END OF BUFFER?
	JNZ	WHEX0
;
;	END OF DATA BYTES, WRITE CHECK SUM
WHEX1:	XOR	AL,AL
	SUB	AL,DH			;COMPUTE CHECKSUM
	CALL	WRC
;
;	SEND CRLF AT END OF RECORD
	MOV	AL,CR
	CALL	PNB
	MOV	AL,LF
	CALL	PNB
	RET
;
; =========================================================================
; SCANNER MODULE ROUTINES
; =========================================================================
GNCECHO:				;GET NEXT CHARACTER AND ECHO TO PRINT FILE
	CALL	GNC
	LAHF
	XCHG	AL,AH
	PUSH	AX
	XCHG	AL,AH
	CMP	AL,CR
	JZ	GNC0E
	CMP	AL,LF			;IF LF THEN DUMP CURRENT BUFFER
	JZ	GNC0E
;
;NOT A CR OR LF, PLACE INTO BUFFER IF THERE IS ENOUGH ROOM
	MOV	AL,Byte Ptr PBP
	CMP	AL,PBMAX
	JNB	GNC0E
;	ENOUGH ROOM, PLACE INTO BUFFER
	MOV	DL,AL
	MOV	DH,0			;DOUBLE PRECISION PBP IN D,E
	INC	AL
	MOV	Byte Ptr PBP,AL		;INCREMENTED PBP IN MEMORY
	MOV	BX,(Offset PBUFF)
	ADD	BX,DX			;PBUFF(PBP)
	POP	AX
	XCHG	AL,AH
	SAHF
	MOV	M,AL			;PBUFF(PBP) = CHAR
	RET
GNC0E:					;CHAR NOT PLACED INTO BUFFER
	POP	AX
	XCHG	AL,AH
	SAHF
	RET
;
INITS:					;INITIALIZE THE SCANNER
	CALL	ZERO
	MOV	Byte Ptr NEXTC,AL	;CLEAR NEXT CHARACTER
	MOV	Byte Ptr PBP,AL
	MOV	AL,LF			;SET LAST CHAR TO LF
	MOV	Byte Ptr LASTC,AL
	CALL	WOBUFF			;CLEAR BUFFER
	MOV	AL,16			;START OF PRINT LINE
	MOV	Byte Ptr PBP,AL
	RET
;
ZERO:	XOR	AL,AL
	MOV	Byte Ptr ACCLEN,AL
	MOV	Byte Ptr STYPE,AL
	RET
;
SAVER:					;STORE NEXT CHARACTER INTO ACCUMULATOR AND UPDATE ACCLEN
	MOV	BX,(Offset ACCLEN)
	MOV	AL,M
	CMP	AL,ACMAX
	JB	SAV1			;JUMP IF NOT UP TO LAST POSITION
	MOV	M,0
	CALL	ERRO
SAV1:	MOV	DL,M			;D,E WILL HOLD INDEX
	MOV	DH,0
	INC	M			;ACCLEN INCREMENTED
	INC	BX			;ADDRESS ACCUMULATOR
	ADD	BX,DX
	MOV	AL,Byte Ptr NEXTC	;GET CHARACTER
	MOV	M,AL			;INTO ACCUMULATOR
	RET
;
TDOLL:					;TEST FOR DOLLAR SIGN, ASSUMING H,L ADDRESS NEXTC
	MOV	AL,M
	CMP	AL,'$'
	JZ	L_SCN3
	RET
L_SCN3:
	XOR	AL,AL			;TO GET A ZERO
	MOV	M,AL			;CLEARS NEXTC
	RET				;WITH ZERO FLAG SET
;
NUMERIC:				;CHECK NEXTC FOR NUMERIC, RETURN ZERO FLAG IF NOT NUMERIC
	MOV	AL,Byte Ptr NEXTC
	SUB	AL,'0'
	CMP	AL,10
	RCL	AL,1
	AND	AL,1B			;ZERO IF NOT NUMERIC
	RET
;
HEX:					;RETURN ZERO FLAG IF NEXTC IS NOT HEXADECIMAL
	CALL	NUMERIC
	JZ	L_SCN4
	RET				;RETURNS IF 0-9
L_SCN4:
	MOV	AL,Byte Ptr NEXTC
	SUB	AL,'A'
	CMP	AL,6
	RCL	AL,1
	AND	AL,1B
	RET
;
LETTER:					;RETURN ZERO FLAG IF NEXTC IS NOT A LETTER
	MOV	AL,Byte Ptr NEXTC
	SUB	AL,'A'
	CMP	AL,26
	RCL	AL,1
	AND	AL,1B
	RET
;
ALNUM:					;RETURN ZERO FLAG IF NOT ALPHANUMERIC
	CALL	LETTER
	JZ	L_SCN5
	RET
L_SCN5:
	CALL	NUMERIC
	RET
;
TRANS:					;TRANSLATE TO UPPER CASE
	MOV	AL,Byte Ptr NEXTC
	CMP	AL,'A' OR 1100000B	;LOWER CASE A
	JNB	L_SCN6
	RET				;CARRY IF LESS THAN LOWER A
L_SCN6:
	CMP	AL,('Z' OR 1100000B)+1	;LOWER CASE Z
	JNAE	L_SCN7
	RET				;NO CARRY IF GREATER THAN LOWER Z
L_SCN7:
	AND	AL,1011111B		;CONVERT TO UPPER CASE
	MOV	Byte Ptr NEXTC,AL
	RET
;
GNCN:					;GET CHARACTER AND STORE TO NEXTC
	CALL	GNCECHO
	MOV	Byte Ptr NEXTC,AL
	JMP	X132D			;TRANSLATE TO UPPER CASE
;
EOLT:					;END OF LINE TEST FOR COMMENT SCAN
	CMP	AL,CR
	JNZ	L_SCN8
	RET
L_SCN8:
	CMP	AL,EOF
	JNZ	L_SCN9
	RET
L_SCN9:
	CMP	AL,'!'
	RET
;
SCAN:					;FIND NEXT TOKEN IN INPUT STREAM
	XOR	AL,AL
	MOV	Byte Ptr TOKEN,AL
	CALL	ZERO
;
;	DEBLANK
DEBL:	MOV	AL,Byte Ptr NEXTC
	CMP	AL,TAB			;TAB CHARACTER TREATED AS BLANK OUTSIDE STRING
	JZ	DEB0
	CMP	AL,';'			;MAY BE A COMMENT
	JZ	DEB1			;DEBLANK THROUGH COMMENT
	CMP	AL,'*'			;PROCESSOR TECH COMMENT
	JNZ	DEB2			;NOT *
	MOV	AL,Byte Ptr LASTC
	CMP	AL,LF			;LAST LINE FEED?
	JNZ	DEB2			;NOT LF*
;	COMMENT FOUND, REMOVE IT
DEB1:	CALL	GNCN
	CALL	EOLT			;CR, EOF, OR !
	JZ	FINDL			;HANDLE END OF LINE
	JMPS	DEB1			;OTHERWISE CONTINUE SCAN
DEB2:	OR	AL,' '			;MAY BE ZERO
	CMP	AL,' '
	JNZ	FINDL
DEB0:	CALL	GNCN			;GET NEXT AND STORE TO NEXTC
	JMPS	DEBL
;
;	LINE DEBLANKED, FIND TOKEN TYPE
FINDL:					;LOOK FOR LETTER, DECIMAL DIGIT, OR STRING QUOTE
	CALL	LETTER
	JZ	FIND0
	MOV	AL,IDEN
	JMPS	STOKEN
;
FIND0:	CALL	NUMERIC
	JZ	FIND1
	MOV	AL,NUMB
	JMPS	STOKEN
;
FIND1:	MOV	AL,Byte Ptr NEXTC
	CMP	AL,''''
	JNZ	FIND2
	XOR	AL,AL
	MOV	Byte Ptr NEXTC,AL	;DON'T STORE THE QUOTE
	MOV	AL,STRNG
	JMPS	STOKEN
;
FIND2:					;ASSUME IT IS A SPECIAL CHARACTER
	CMP	AL,LF			;IF LF THEN DUMP THE BUFFER
	JNZ	FIND3
;	LF FOUND
	MOV	AL,Byte Ptr PASS
	OR	AL,AL
	JZ	L_SCN10
	MOV	AL,Byte Ptr PBUFF	;ERROR FLAGGED ON THIS LISTING LINE?
	CMP	AL,' '
	JZ	FINDLF
	CMP	AL,'N'			;'NOT IMPLEMENTED' (TITLE...) IS HARMLESS
	JZ	FINDLF
	MOV	Byte Ptr ASMERR,1	;HEX FILE WILL BE DELETED AT THE END
FINDLF:	CALL	WOBUFF
L_SCN10:
	MOV	BX,(Offset PBUFF)	;CLEAR ERROR CHAR ON BOTH PASSES
	MOV	M,' '
	MOV	AL,16
	MOV	Byte Ptr PBP,AL		;START NEW LINE
FIND3:	MOV	AL,SPECL
;
STOKEN:	MOV	Byte Ptr TOKEN,AL
;
;	LOOP WHILE CURRENT ITEM IS ACCUMULATING
SCTOK:	MOV	AL,Byte Ptr NEXTC
	MOV	Byte Ptr LASTC,AL	;SAVE LAST CHARACTER
	OR	AL,AL
	JZ	L_SCN11
	CALL	SAVER			;STORE CHARACTER INTO ACCUM IF NOT ZERO
L_SCN11:
	CALL	GNCN			;GET NEXT TO NEXTC
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,SPECL
	JNZ	L_SCN12
	RET				;RETURN IF SPECIAL CHARACTER
L_SCN12:
	CMP	AL,STRNG
	JZ	L_SCN13
	CALL	TRANS			;TRANSLATE TO UPPER CASE IF NOT IN STRING
L_SCN13:
	MOV	BX,(Offset NEXTC)
	MOV	AL,Byte Ptr TOKEN
;
	CMP	AL,IDEN
	JNZ	SCT2
;
;	ACCUMULATING AN IDENTIFIER
	CALL	TDOLL			;$?
	JZ	SCTOK			;IF SO, SKIP IT
	CALL	ALNUM			;ALPHA NUMERIC?
	JNZ	L_SCN14
	RET				;RETURN IF END
L_SCN14:
	JMPS	SCTOK
;
SCT2:					;NOT SPECIAL OR IDENT, CHECK NUMBER
	CMP	AL,NUMB
	JZ	L_SCN15
	JMP	SCT3
L_SCN15:
;
;	ACCUMULATING A NUMBER, CHECK FOR $
	CALL	TDOLL
	JZ	SCTOK			;SKIP IF FOUND
	CALL	HEX			;HEX CHARACTER?
	JNZ	SCTOK			;STORE IT IF FOUND
;	END OF NUMBER, LOOK FOR RADIX INDICATOR
;
	MOV	AL,Byte Ptr NEXTC
	CMP	AL,'O'			;OCTAL INDICATOR
	JZ	NOCT
	CMP	AL,'Q'			;OCTAL INDICATOR
	JNZ	NUM2
;
NOCT:					;OCTAL
	MOV	AL,OCTV
	JMPS	SSTYP
;
NUM2:	CMP	AL,'H'
	JNZ	NUM3
	MOV	AL,HEXV
SSTYP:	MOV	Byte Ptr STYPE,AL
	XOR	AL,AL
	MOV	Byte Ptr NEXTC,AL	;CLEARS THE LOOKAHEAD CHARACTER
	JMPS	NCON
;
;	RADIX MUST COME FROM ACCUM
NUM3:	MOV	AL,Byte Ptr LASTC
	CMP	AL,'B'
	JNZ	NUM4
	MOV	AL,BINV
	JMPS	SSTY1
;
NUM4:	CMP	AL,'D'
	MOV	AL,DECV
	JNZ	SSTY2
SSTY1:	MOV	BX,(Offset ACCLEN)
	DEC	M			;ACCLEN DECREMENTED TO REMOVE RADIX INDICATOR
SSTY2:	MOV	Byte Ptr STYPE,AL
;
NCON:					;NUMERIC CONVERSION OCCURS HERE
	MOV	BX,0
	MOV	Word Ptr VALUE,BX	;VALUE ACCUMULATES BINARY EQUIVALENT
	MOV	BX,(Offset ACCLEN)
	MOV	CL,M			;C=ACCLEN
	INC	BX			;ADDRESSES ACCUM
CLOP:					;NEXT DIGIT IS PROCESSED HERE
	MOV	AL,M
	INC	BX			;READY FOR NEXT LOOP
	CMP	AL,'A'
	JNB	CLOP1			;NOT HEX A-F
	SUB	AL,'0'			;NORMALIZE
	JMPS	CLOP2
;
CLOP1:					;HEX A-F
	SUB	AL,'A'-10
CLOP2:					;CHECK SIZE AGAINST RADIX
	PUSH	BX			;SAVE ACCUM ADDR
	PUSH	CX			;SAVE CURRENT POSITION
	MOV	CL,AL
	MOV	BX,(Offset STYPE)
	CMP	AL,M
	JNAE	L_SCN16
	CALL	ERRV			;VALUE ERROR IF DIGIT>=RADIX
L_SCN16:
	MOV	CH,0			;DOUBLE PRECISION DIGIT
	MOV	AL,M			;RADIX TO ACCUMULATOR
	MOV	BX,Word Ptr VALUE
	XCHG	BX,DX			;VALUE TO D,E - ACCUMULATE RESULT IN H,L
	MOV	BX,0			;ZERO ACCUMULATOR
CLOP3:					;LOOP UNTIL RADIX GOES TO ZERO
	OR	AL,AL
	JZ	CLOP4
	RCR	AL,1			;TEST LSB
	JNB	TTWO			;SKIP SUMMING OPERATION IF LSB=0
	ADD	BX,DX			;ADD IN VALUE
TTWO:					;MULTIPLY VALUE * 2 FOR SHL OPERATION
	XCHG	BX,DX
	SHL	BX,1
	XCHG	BX,DX
	JMPS	CLOP3
;
CLOP4:					;END OF NUMBER CONVERSION
	ADD	BX,CX
	MOV	Word Ptr VALUE,BX
	POP	CX
	POP	BX
	DEC	CL			;MORE DIGITS?
	JNZ	CLOP
	RET				;DONE WITH THE NUMBER
;
SCT3:					;MUST BE A STRING
	MOV	AL,Byte Ptr NEXTC
	CMP	AL,CR			;END OF LINE?
	JZ	ERRO			;AND RETURN
	CMP	AL,''''
	JZ	L_SCN17
	JMP	SCTOK
L_SCN17:
	CALL	GNCN
	CMP	AL,''''
	JZ	L_SCN18
	RET				;RETURN IF SINGLE QUOTE ENCOUNTERED
L_SCN18:
	JMP	SCTOK			;OTHERWISE TREAT AS ONE QUOTE
;
ERRO:					;'O' OVERFLOW ERROR
	LAHF
	XCHG	AL,AH
	PUSH	AX
	MOV	AL,'O'
	JMPS	ERR_S
;
ERR_S:					;PRINT ERROR MESSAGE
	PUSH	CX
	PUSH	BX
	CALL	PERR
	POP	BX
	POP	CX
	POP	AX
	XCHG	AL,AH
	SAHF
	RET
;
X132D:	LAHF
	XCHG	AL,AH
	PUSH	AX
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,3			;Don't translate Control-C?
	JZ	L_SCN19
	CALL	TRANS
L_SCN19:
	POP	AX
	XCHG	AL,AH
	SAHF
	RET
;
; =========================================================================
; SYMBOL TABLE MODULE ROUTINES
; =========================================================================
INISY:					;INITIALIZE THE SYMBOL TABLE
	MOV	BX,(Offset HASHT)	;ZERO THE HASH TABLE
	MOV	CH,SYMHSIZE
	XOR	AL,AL			;CLEAR ACCUM
INI0:
	MOV	M,AL
	INC	BX
	MOV	M,AL			;CLEAR DOUBLE WORD
	INC	BX
	DEC	CH
	JNZ	INI0
;
;	SET SYMBOL TABLE POINTERS
	MOV	BX,0
	MOV	Word Ptr SYADR,BX
	RET
;
CHASH:					;COMPUTE HASH CODE FOR CURRENT ACCUMULATOR
	MOV	BX,(Offset ACCLEN)
	MOV	CH,M			;GET ACCUM LENGTH
	XOR	AL,AL			;CLEAR ACCUMULATOR
CH0:	INC	BX			;MOVE TO FIRST/NEXT CHARACTER POSITION
	ADD	AL,M			;ADD WITH OVERFLOW
	DEC	CH
	JNZ	CH0
	AND	AL,HMASK		;MASK BITS FOR MODULO HSIZE
	MOV	Byte Ptr HASHC,AL	;FILL HASHC WITH RESULT
	RET
;
SETLN:					;SET THE LENGTH FIELD OF THE CURRENT SYMBOL
	MOV	CH,AL			;SAVE LENGTH IN B
	MOV	BX,Word Ptr SYADR
	INC	BX
	INC	BX
	MOV	AL,M			;GET TYPE/LENGTH FIELD
	AND	AL,0F0H			;MASK OUT TYPE FIELD
	OR	AL,CH			;MASK IN LENGTH
	MOV	M,AL
	RET
;
GETLN:					;GET THE LENGTH FIELD TO REG-A
	MOV	BX,Word Ptr SYADR
	INC	BX
	INC	BX
	MOV	AL,M
	AND	AL,0FH
	INC	AL			;LENGTH IS STORED AS VALUE - 1
	RET
;
FOUND:					;FOUND RETURNS TRUE IF SYADR IS NOT ZERO (NZ FLAG)
	MOV	BX,Word Ptr SYADR
	MOV	AL,BL
	OR	AL,BH
	RET
;
LOOKUP:					;LOOK FOR SYMBOL IN ACCUMULATOR
	CALL	CHASH			;COMPUTE HASH CODE
;	NORMALIZE IDENTIFIER TO 16 CHARACTERS
	MOV	BX,(Offset ACCLEN)
	MOV	AL,M
	CMP	AL,17
	JB	LENOK
	MOV	M,16
LENOK:
;	LOOK FOR SYMBOL THROUGH HASH TABLE
	MOV	BX,(Offset HASHC)
	MOV	DL,M
	MOV	DH,0			;DOUBLE HASH CODE IN D,E
	MOV	BX,(Offset HASHT)	;BASE OF HASH TABLE
	ADD	BX,DX
	ADD	BX,DX
	MOV	DL,M			;LOW ORDER ADDRESS
	INC	BX
	MOV	BH,M
	MOV	BL,DL			;HEADER TO LIST OF SYMBOLS IS IN H,L
LOOK0:	MOV	Word Ptr SYADR,BX
	CALL	FOUND
	JNZ	L_SYM2
	RET				;RETURN IF SYADR BECOMES ZERO
L_SYM2:
;	OTHERWISE EXAMINE CHARACTER STRING FOR MATCH
	CALL	GETLN			;GET LENGTH TO REG-A
	MOV	BX,(Offset ACCLEN)
	CMP	AL,M
	JNZ	LCOMP
;	LENGTH MATCH, TRY TO MATCH CHARACTERS
	MOV	CH,AL			;STRING LENGTH IN B
	INC	BX			;HL ADDRESSES ACCUM
	XCHG	BX,DX			;TO D,E
	MOV	BX,Word Ptr SYADR
	INC	BX
	INC	BX
	INC	BX			;ADDRESSES CHARACTERS
LOOK1:	MOV	SI,DX			;NEXT CHARACTER FROM ACCUM
	MOV	AL,[SI]
	CMP	AL,M			;NEXT CHARACTER IN SYMBOL TABLE
	JNZ	LCOMP
;	CHARACTER MATCHED, INCREMENT TO NEXT
	INC	DX
	INC	BX
	DEC	CH
	JNZ	LOOK1
;	COMPLETE MATCH AT CURRENT SYMBOL, SYADR IS SET
	RET
;
LCOMP:					;NOT FOUND, MOVE SYADR DOWN ONE COLLISION ADDRESS
	MOV	BX,Word Ptr SYADR
	MOV	DL,M
	INC	BX
	MOV	DH,M			;COLLISION ADDRESS IN D,E
	XCHG	BX,DX
	JMPS	LOOK0
;
ENTER:					;ENTER SYMBOL IN ACCUMULATOR
;	ENSURE THERE IS ENOUGH SPACE IN THE TABLE
	MOV	BX,(Offset ACCLEN)
	MOV	DL,M
	MOV	DH,0			;DOUBLE PRECISION ACCLEN IN D,E
	MOV	BX,Word Ptr SYTOP
	MOV	Word Ptr SYADR,BX	;NEXT SYMBOL LOCATION
	ADD	BX,DX			;SYTOP+ACCLEN
	MOV	DX,FIXD			;FIXED DATA/SYMBOL
	ADD	BX,DX			;HL HAS NEXT TABLE LOCATION FOR SYMBOL
	XCHG	BX,DX			;NEW SYTOP IN D,E
	MOV	BX,Word Ptr SYMAX	;MAXIMUM SYMTOP VALUE
	MOV	AL,DL
	SUB	AL,BL			;COMPUTE 16-BIT DIFFERENCE
	MOV	AL,DH
	SBB	AL,BH
	XCHG	BX,DX			;NEW SYTOP IN H,L
	JNB	OVERER			;OVERFLOW IN TABLE
;
;	OTHERWISE NO ERROR
	MOV	Word Ptr SYTOP,BX	;SET NEW TABLE TOP
	MOV	BX,Word Ptr SYADR	;SET COLLISION FIELD
	XCHG	BX,DX			;CURRENT SYMBOL ADDRESS TO D,E
	MOV	BX,(Offset HASHC)	;HASH CODE FOR CURRENT SYMBOL TO H,L
	MOV	CL,M			;LOW BYTE
	MOV	CH,0			;DOUBLE PRECISION VALUE IN B,C
	MOV	BX,(Offset HASHT)	;BASE OF HASH TABLE
	ADD	BX,CX
	ADD	BX,CX			;HASHT(HASHC) IN H,L
;	D,E ADDRESSES CURRENT SYMBOL - CHANGE LINKS
	MOV	CL,M			;LOW ORDER OLD HEADER
	INC	BX
	MOV	CH,M			;HIGH ORDER OLD HEADER
	MOV	M,DH			;HIGH ORDER NEW HEADER TO HASH TABLE
	DEC	BX
	MOV	M,DL			;LOW ORDER NEW HEADER TO HASH TABLE
	XCHG	BX,DX			;H,L HOLDS SYMBOL TABLE ADDRESS
	MOV	M,CL			;LOW ORDER OLD HEADER TO COLLISION FIELD
	INC	BX
	MOV	M,CH			;HIGH ORDER OLD HEADER TO COLLISION FIELD
;
;	HASH CHAIN NOW REPAIRED FOR THIS ENTRY, COPY THE PRINTNAME
	MOV	DX,(Offset ACCLEN)
	MOV	SI,DX			;GET SYMBOL LENGTH
	MOV	AL,[SI]
	CMP	AL,17			;LARGER THAN 16 SYMBOLS?
	JB	ENT1
	MOV	AL,16			;TRUNCATE TO 16 CHARACTERS
;	COPY LENGTH FIELD, FOLLOWED BY PRINTNAME CHARACTERS
ENT1:	MOV	CH,AL			;COPY LENGTH TO B
	DEC	AL			;1-16 CHANGED TO 0-15
	INC	BX			;FOLLOWING COLLISION FIELD
	MOV	M,AL			;STORE LENGTH WITH UNDEFINED TYPE (0000)
ENT2:	INC	BX
	INC	DX
	MOV	SI,DX
	MOV	AL,[SI]
	MOV	M,AL			;STORE NEXT CHARACTER OF PRINTNAME
	DEC	CH			;LENGTH=LENGTH-1
	JNZ	ENT2			;FOR ANOTHER CHARACTER
;
;	PRINTNAME COPIED, ZERO THE VALUE FIELD
	XOR	AL,AL			;ZERO A
	INC	BX
	MOV	M,AL
	INC	BX
	MOV	M,AL			;HIGH ORDER VALUE
	RET
;
OVERER:					;OVERFLOW IN SYMBOL TABLE
	MOV	Byte Ptr ASMERR,1
	MOV	BX,(Offset MSG_ERRO)
	CALL	PCON
	JMP	EOR			;END OF EXECUTION
MSG_ERRO DB	'SYMBOL TABLE OVERFLOW',CR
;
SETTY:					;SET CURRENT SYMBOL TYPE TO VALUE IN REG-A
	RCL	AL,1
	RCL	AL,1
	RCL	AL,1
	RCL	AL,1
	AND	AL,0F0H			;TYPE MOVED TO HIGH ORDER 4-BITS
	MOV	CH,AL			;SAVE IT IN B
	MOV	BX,Word Ptr SYADR	;BASE OF SYMBOL TO ACCESS
	INC	BX
	INC	BX			;ADDRESS OF TYPE/LENGTH FIELD
	MOV	AL,M			;GET IT AND MASK
	AND	AL,0FH			;LEAVE LENGTH
	OR	AL,CH			;MASK IN TYPE
	MOV	M,AL			;STORE IT
	RET
;
GETTY:					;RETURN THE TYPE OF THE VALUE IN CURRENT SYMBOL
	MOV	BX,Word Ptr SYADR
	INC	BX
	INC	BX
	MOV	AL,M
	RCR	AL,1
	RCR	AL,1
	RCR	AL,1
	RCR	AL,1
	AND	AL,0FH			;TYPE MOVED TO LOW 4-BITS OF REG-A
	RET
;
VALADR:					;GET VALUE FIELD ADDRESS FOR CURRENT SYMBOL
	CALL	GETLN			;PRINTNAME LENGTH TO ACCUM
	MOV	BX,Word Ptr SYADR	;BASE ADDRESS
	MOV	DL,AL
	MOV	DH,0
	ADD	BX,DX
	INC	BX
	INC	BX
	INC	BX
	RET				;WITH H,L ADDRESSING VALUE FIELD
;
SETVAL:					;SET THE VALUE FIELD OF THE CURRENT SYMBOL
	PUSH	BX			;SAVE VALUE TO SET
	CALL	VALADR
	POP	DX			;POP VALUE TO SET, HL HAS ADDRESS TO FILL
	MOV	M,DL
	INC	BX
	MOV	M,DH			;FIELD SET
	RET
;
GETVAL:					;GET THE VALUE FIELD OF THE CURRENT SYMBOL TO H,L
	CALL	VALADR			;ADDRESS OF VALUE FIELD TO H,L
	MOV	DL,M
	INC	BX
	MOV	DH,M
	XCHG	BX,DX
	RET
;
; =========================================================================
; TABLE SEARCH MODULE ROUTINES & TABLES
; =========================================================================
CINX	DW	(Offset CHAR1)		;LENGTH 1 BASE
	DW	(Offset CHAR2)		;LENGTH 2 BASE
	DW	(Offset CHAR3)		;LENGTH 3 BASE
	DW	(Offset CHAR4)		;LENGTH 4 BASE
	DW	(Offset CHAR5)		;LENGTH 5 BASE
	DW	(Offset CHAR6)		;LENGTH 6 BASE
;
CMAX	EQU	((Offset $)-(Offset CINX))/2-1	;LARGEST STRING TO MATCH
;
CLEN:
	DB	(Offset CHAR2)-(Offset CHAR1)
	DB	((Offset CHAR3)-(Offset CHAR2))/2
	DB	((Offset CHAR4)-(Offset CHAR3))/3
	DB	((Offset CHAR5)-(Offset CHAR4))/4
	DB	((Offset CHAR6)-(Offset CHAR5))/5
;
TVINX:
	DW	(Offset TV1)
	DW	(Offset TV2)
	DW	(Offset TV3)
	DW	(Offset TV4)
	DW	(Offset TV5)
;
CHAR1	DB	CR,'()*'
	DB	'+'
	DB	',-/A'
	DB	'BCDE'
	DB	'HLM'
;
CHAR2	DB	'DBDIDSDW'
	DB	'EIIFINOR'
	DB	'SP'
;
CHAR3	DB	'ACIADCADDADI'
	DB	'ANAANDANICMA'
	DB	'CMCCMPCPIDAA'
	DB	'DADDCRDCXEND'
	DB	'EQUHLTINRINX'
	DB	'JMPLDALXIMOD'
	DB	'MOVMVINOPNOT'
	DB	'ORAORGORIOUT'
	DB	'POPPSWRALRAR'
	DB	'RETRLCRRCRST'
	DB	'SBBSBISETSHL'
	DB	'SHRSTASTCSUB'
	DB	'SUIXORXRAXRI'
;
CHAR4	DB	'CALLENDMLDAXLHLDPCHL'
	DB	'PUSHSHLDSPHLSTAX'
	DB	'XCHGXTHL'
;
CHAR5	DB	'ENDIFMACROTITLE'
;
CHAR6:
;
TV1:
	DB	X16,10,X13,20		;CR (
	DB	X14,30,X1,80		;) *
	DB	X6,70			;+
	DB	X15,10,X7,70		;, -
	DB	X2,80,RT,7		;/ A
	DB	RT,0,RT,1		;B C
	DB	RT,2,RT,3		;D E
	DB	RT,4,RT,5		;H L
	DB	RT,6			;M
;
TV2:
	DB	PT,1,O1,0F3H		;DB DI
	DB	PT,2,PT,3		;DS DW
	DB	O1,0FBH,PT,8		;EI IF
	DB	O15,0DBH,X11,40		;IN OR
	DB	RT,6			;SP
;
TV3:
	DB	O8,0CEH,O11,88H		;ACI ADC
	DB	O11,80H,O8,0C6H		;ADD ADI
	DB	O11,0A0H,X10,50		;ANA AND
	DB	O8,0E6H,O1,2FH		;ANI CMA
	DB	O1,3FH,O11,0B8H		;CMC CMP
	DB	O8,0FEH,O1,27H		;CPI DAA
	DB	O3,09H,O12,05H		;DAD DCR
	DB	O13,0BH,PT,4		;DCX END
	DB	PT,7,O1,76H		;EQU HLT
	DB	O12,04H,O13,03H		;INR INX
	DB	O5,0C3H,O10,3AH		;JMP LDA
	DB	O2,01H,X3,80		;LXI MOD
	DB	O6,40H,O7,06H		;MOV MVI
	DB	O1,00H,X9,60		;NOP NOT
	DB	O11,0B0H,PT,10		;ORA ORG
	DB	O8,0F6H,O15,0D3H	;ORI OUT
	DB	O4,0C1H,RT,6		;POP PSW
	DB	O1,17H,O1,1FH		;RAL RAR
	DB	O1,0C9H,O1,07H		;RET RLC
	DB	O1,0FH,O14,0C7H		;RRC RST
	DB	O11,098H,O8,0DEH	;SBB SBI
	DB	PT,11,X4,80		;SET SHL
	DB	X5,80,O10,32H		;STA STC
	DB	O1,37H,O11,90H		;STC SUB
	DB	O8,0D6H,X12,40		;SUI XOR
	DB	O11,0A8H,O8,0EEH	;XRA XRI
;
TV4:
	DB	O5,0CDH			;CALL
	DB	PT,6,O9,0AH		;ENDM LDAX
	DB	O10,02AH,O1,0E9H	;LHLD PCHL
	DB	O4,0C5H,O10,22H		;PUSH SHLD
	DB	O1,0F9H,O9,02H		;SPHL STAX
	DB	O1,0EBH,O1,0E3H		;XCHG XTHL
;
TV5:
	DB	PT,5,PT,9		;ENDIF MACRO
	DB	PT,12			;TITLE
;
SUFTAB:
	DB	'NZZ NCC POPEP M '
;
BSEAR:					;BINARY SEARCH MNEMONIC TABLE
	MOV	DL,255			;MARK M <> OLD M
	INC	CH			;U=U+1
	MOV	CL,0			;L = 0
;
NEXT_BS:
	XOR	AL,AL
	MOV	AL,CH			;CY=0, A=U
	ADD	AL,CL			;(U+L)
	RCR	AL,1			;(U+L)/2
	CMP	AL,DL			;SAME AS LAST TIME THROUGH?
	JNZ	L_BS4
	JMP	NMATCH			;JUMP IF = TO NO MATCH
L_BS4:
;
;	MORE ELEMENTS TO SCAN
	MOV	DL,AL			;NEW MIDDLE VALUE
	PUSH	BX			;SAVE A COPY OF THE BASE ADDRESS
	PUSH	DX			;SAVE S,M
	PUSH	CX			;SAVE U,L
	PUSH	BX			;SAVE ANOTHER COPY OF THE BASE ADDRESS
	MOV	CH,DH			;S' = S
	MOV	CL,CH			;S'' = S'
	MOV	DH,0			;FOR DOUBLE ADD OPERATION BELOW (DOUBLE M)
;
	MOV	BX,0			;K=0
SUMK:	ADD	BX,DX			;K = K + M
	DEC	CH			;S' = S' - 1
	JNZ	SUMK			;DECREMENT IF SP1 <> 0
;
;	K IS NOW RELATIVE BYTE POSITION
	POP	DX			;TABLE BASE ADDRESS
	ADD	BX,DX			;H,L CONTAINS ABSOLUTE ADDRESS OF BYTE TO COMPARE
	MOV	DX,(Offset ACCUM)	;D,E ADDRESS CHARACTERS TO COMPARE
;
COMK:					;COMPARE NEXT CHARACTER
	MOV	SI,DX			;ACCUM CHARACTER TO REG A
	MOV	AL,[SI]
	CMP	AL,M			;SAME AS TABLE ENTRY?
	JNZ	NCOM			;JUMP IF NOT THE SAME
	INC	DX
	INC	BX
	DEC	CL			;MORE CHARACTERS?
	JNZ	COMK
;
;	COMPLETE MATCH AT M
	POP	CX
	POP	DX			;M RESTORED
	POP	BX
	MOV	AL,DL			;VALUE OF M COPIED IN A
	CMP	AL,AL			;SET ZERO FLAG (MATCH)
	RET
;
NCOM:					;NO MATCH, DETERMINE IF LESS OR GREATER
	POP	CX			;U,L
	POP	DX			;S,M
	POP	BX			;TABLE ADDRESS
	JB	NCOML
;	ACCUM IS HIGHER
	MOV	CL,DL			;L = M
	JMP	NEXT_BS
;
NCOML:					;ACCUMULATOR IS LOW
	MOV	CH,DL			;U = M
	JMP	NEXT_BS
;
NMATCH:					;NO MATCH
	XOR	AL,AL
	INC	AL			;SETS NOT ZERO FLAG
	RET
;
PREFIX:					;J C OR R PREFIX?
	MOV	AL,Byte Ptr ACCUM
	MOV	CX,(0C2H SHL 8) OR O5	;JNZ OPCODE TO B, TYPE TO C
	CMP	AL,'J'
	JNZ	L_BS5
	RET				;RETURN WITH ZERO FLAG SET IF J
L_BS5:
	MOV	CH,0C4H			;CNZ OPCODE TO B, TYPE IS IN C
	CMP	AL,'C'
	JNZ	L_BS6
	RET
L_BS6:
	MOV	CX,(0C0H SHL 8) OR O1	;RNZ OPCODE
	CMP	AL,'R'
	RET
;
SUFFIX:					;J R OR C RECOGNIZED, LOOK FOR SUFFIX
	MOV	AL,Byte Ptr ACCLEN
	CMP	AL,4			;CHECK LENGTH
	JNB	NSUFF			;CARRY IF 0,1,2,3 IN LENGTH
	CMP	AL,3
	JZ	SUF0			;ASSUME 1 OR 2 IF NO BRANCH
	CMP	AL,2
	JNZ	NSUFF			;RETURNS IF 0 OR 1
	MOV	BX,(Offset ACCUM)+2
	MOV	M,' '			;BLANK-OUT FOR MATCH ATTEMPT
SUF0:					;SEARCH 'TIL END OF TABLE
	MOV	CX,8			;B=0, C=8 COUNTS TABLE DOWN TO ZERO OR MATCH
	MOV	DX,(Offset SUFTAB)
NEXTS:					;LOOK AT NEXT SUFFIX
	MOV	BX,(Offset ACCUM)+1	;SUFFIX POSITION
	MOV	SI,DX			;CHARACTER TO ACCUM
	MOV	AL,[SI]
	INC	DX			;READY FOR NEXT CHARACTER (BEFORE CMP: INC SETS ZF)
	CMP	AL,M
	JNZ	NEXT0			;JMP IF NO MATCH
	MOV	SI,DX			;GET NEXT CHARACTER
	MOV	AL,[SI]
	INC	BX			;READY FOR COMPARE WITH ACCUM
	CMP	AL,M			;SAME?
	JNZ	L_BS7
	RET				;RETURN WITH ZERO FLAG SET, B IS SUFFIX
L_BS7:
NEXT0:	INC	DX
	INC	CH			;COUNT SUFFIX UP
	DEC	CL			;COUNT TABLE LENGTH DOWN
	JNZ	NEXTS
;	END OF TABLE, MARK WITH NON ZERO FLAG
	INC	CL
	RET
;
NSUFF:					;NOT PROPER SUFFIX - SET NON ZERO FLAG
	XOR	AL,AL
	INC	AL
	RET
;
BGET:					;PERFORM BINARY SEARCH, AND EXTRACT TYPE AND VAL FIELDS
	MOV	AL,Byte Ptr ACCLEN	;ITEM LENGTH
	MOV	CL,AL			;SAVE A COPY
	DEC	AL			;ACCLEN-1
	MOV	DL,AL
	MOV	DH,0			;DOUBLE ACCLEN-1 TO D,E
	PUSH	DX			;SAVE A COPY FOR LATER
	CMP	AL,CMAX			;TOO LONG?
	JNB	NGET			;NOT IN RANGE IF NO CARRY
L_BS8:
	MOV	BX,(Offset CLEN)	;LENGTH VECTOR
	ADD	BX,DX
	MOV	CH,M			;FILL UPPER BOUND FROM MEMORY
	MOV	BX,(Offset CINX)
	ADD	BX,DX
	ADD	BX,DX
	MOV	DH,M
	INC	BX
	MOV	BH,M
	MOV	BL,DH			;NOW IN H,L
	MOV	DH,CL			;FILL THE SIZE REGISTER
	CALL	BSEAR			;PERFORM THE BINARY SEARCH
	JNZ	SCASE			;ZERO IF FOUND
	POP	DX			;RESTORE INDEX
	MOV	BX,(Offset TVINX)
	ADD	BX,DX
	ADD	BX,DX
	MOV	DL,M
	INC	BX
	MOV	DH,M
;	D,E IS BASE ADDRESS OF TYPE/VALUE VECTOR, ADD DISPLACEMENT
	MOV	BL,AL
	MOV	BH,0
	SHL	BX,1			;DOUBLED
	ADD	BX,DX
	MOV	AL,M			;TYPE TO ACC
	INC	BX
	MOV	CH,M			;VALUE TO B
	CMP	AL,AL			;8080 DAD/INX KEPT BSEAR'S ZERO FLAG
	RET				;TYPE IN ACC, VALUE IN B
;
SCASE:					;NAME NOT TOO LONG, BUT NOT FOUND IN TABLES, MAY BE J C OR R
	POP	DX			;RESTORE INDEX
	CALL	PREFIX
	JZ	L_BS9
	RET				;NOT FOUND AS PREFIX J C OR R IF NOT ZERO FLAG
L_BS9:
	PUSH	CX			;SAVE VALUE AND TYPE
	CALL	SUFFIX			;ZERO IF SUFFIX MATCHED
	MOV	AL,CH			;READY FOR MASK IF ZERO FLAG
	POP	CX			;RECALL VALUE AND TYPE
	JZ	L_BS10
	RET				;RETURN IF NOT ZERO FLAG SET
L_BS10:
;	MASK IN THE PROPER BITS AND RETURN
	OR	AL,AL			;CLEAR CARRY
	RCL	AL,1
	RCL	AL,1
	RCL	AL,1
	OR	AL,CH			;VALUE SET TO JNZ ...
	MOV	CH,AL			;REPLACE
	MOV	AL,CL			;RETURN WITH TYPE IN REGISTER A
	CMP	AL,AL			;CLEAR THE ZERO FLAG
	RET
;
NGET:					;CAN'T FIND THE ENTRY, RETURN WITH ZERO FLAG RESET
	POP	DX			;GET THE ELEMENT BACK
	XOR	AL,AL			;CLEAR
	INC	AL			;ZERO FLAG RESET
	RET
;
; =========================================================================
; EXPRESSION EVALUATOR MODULE ROUTINES & TABLES
; =========================================================================
STKV:					;PLACE CURRENT H,L VALUE AT TOP OF VSTACK
	XCHG	BX,DX			;HOLD VALUE IN D,E
	MOV	BX,(Offset VSP)
	MOV	AL,M
	CMP	AL,VSMAX
	JB	STKV0
	CALL	ERREX			;OVERFLOW IN EXPRESSION
	MOV	M,0			;VSP=0
STKV0:	MOV	AL,M			;GET VSP
	INC	M			;VSP=VSP+1
	INC	M			;VSP=VSP+2
	MOV	CL,AL			;SAVE VSP
	MOV	CH,0			;DOUBLE VSP
	MOV	BX,(Offset VSTACK)
	ADD	BX,CX
	MOV	M,DL			;LOW BYTE
	INC	BX
	MOV	M,DH			;HIGH BYTE
	RET
;
STKO:					;STACK OPERATOR (REG-A) AND PRIORITY (REG-B)
	LAHF				;SAVE IT
	XCHG	AL,AH
	PUSH	AX
	MOV	BX,(Offset OSP)
	MOV	AL,M
	CMP	AL,OSMAX
	JB	STKO1
	MOV	M,0
	CALL	ERREX			;OPERATOR STACK OVERFLOW
STKO1:	MOV	DL,M			;GET OSP
	MOV	DH,0
	INC	M			;OSP=OSP+1
	POP	AX			;RECALL OPERATOR
	XCHG	AL,AH
	SAHF
	MOV	BX,(Offset OPERV)
	ADD	BX,DX
	MOV	M,AL			;OPERV(OSP)=OPERATOR
	MOV	BX,(Offset HIERV)
	ADD	BX,DX
	MOV	M,CH			;HIERV(OSP)=PRIORITY
	RET
;
LODV1:					;LOAD TOP ELEMENT FROM VSTACK TO H,L
	MOV	BX,(Offset VSP)
	MOV	AL,M
	OR	AL,AL
	JNZ	LODOK
	CALL	ERREX			;UNDERFLOW
	MOV	BX,0
	RET
;
LODOK:	DEC	M
	DEC	M			;VSP=VSP-2
	MOV	CL,M			;LOW BYTE
	MOV	CH,0
	MOV	BX,(Offset VSTACK)
	ADD	BX,CX
	MOV	CL,M			;GET LOW BYTE
	INC	BX
	MOV	BH,M
	MOV	BL,CL
	RET
;
LODV2:					;LOAD TOP TWO ELEMENTS: DE HOLDS TOP, HL HOLDS TOP-1
	CALL	LODV1
	XCHG	BX,DX
	CALL	LODV1
	RET
;
APPLY:					;APPLY OPERATOR IN REG-A TO TOP OF STACK
	MOV	BL,AL
	MOV	BH,0
	SHL	BX,1			;OPERATOR NUMBER*2
	MOV	DX,(Offset EXPOPTAB)
	ADD	BX,DX
	MOV	DL,M			;LOW ADDRESS
	INC	BX
	MOV	BH,M			;HIGH ADDRESS
	MOV	BL,DL
	JMP	BX			;SET PC AND GO TO SUBROUTINE
;
EXPOPTAB:
	DW	(Offset MULOP)
	DW	(Offset DIVOP)
	DW	(Offset MODOP)
	DW	(Offset SHLOP)
	DW	(Offset SHROP)
	DW	(Offset ADDOP)
	DW	(Offset SUBOP)
	DW	(Offset NEGOP)
	DW	(Offset NOTOP)
	DW	(Offset ANDOP)
	DW	(Offset OROP)
	DW	(Offset XOROP)
	DW	(Offset ERREX)		;(
;
SHFT:					;SET UP OPERANDS FOR SHIFT L AND R
	CALL	LODV2
	MOV	AL,DH			;ENSURE 0-15
	OR	AL,AL
	JNZ	SHERR
	MOV	AL,DL
	CMP	AL,17
	JNB	L_EV4
	RET				;RETURN IF 0-16 SHIFT
L_EV4:
SHERR:	CALL	ERREX
	MOV	AL,16
	RET
;
NEGF:					;COMPUTE 0-H,L TO H,L
	XOR	AL,AL
	SUB	AL,BL
	MOV	BL,AL
	MOV	AL,0
	SBB	AL,BH
	MOV	BH,AL
	RET
;
DIVF:	CALL	LODV2
DIVE:					;COMPUTE X/Y WHERE X IS IN D,E AND Y IS IN H,L
;					VALUE OF X/Y APPEARS IN D,E AND X MOD Y IS IN H,L
	XCHG	BX,DX			;SWAP D,E WITH H,L FOR DIVIDE FUNCTION
	MOV	Word Ptr DTEMP,BX	;SAVE X IN TEMPORARY
	MOV	BX,(Offset BNUM)	;STORE BIT COUNT
	MOV	M,11H
	MOV	CX,0			;INITIALIZE RESULT
	PUSH	CX
	XOR	AL,AL			;CLEAR FLAGS
DLOOP:
	MOV	AL,DL			;GET LOW Y BYTE
	RCL	AL,1
	MOV	DL,AL
	MOV	AL,DH
	RCL	AL,1
	MOV	DH,AL
	DEC	M			;DECREMENT BIT COUNT
	POP	BX			;RESTORE TEMP RESULT
	JNZ	L_EV5
	RET				;ZERO BIT COUNT MEANS ALL DONE
L_EV5:
	MOV	AL,0			;ADD IN CARRY
	ADC	AL,0			;CARRY
	SHL	BX,1			;SHIFT TEMP RESULT LEFT ONE BIT
	MOV	CH,BH			;COPY H AND L TO A AND C
	ADD	AL,BL
	MOV	BX,Word Ptr DTEMP	;GET ADDRESS OF X
	SUB	AL,BL			;SUBTRACT FROM TEMPORARY RESULT
	MOV	CL,AL
	MOV	AL,CH
	SBB	AL,BH
	MOV	CH,AL
	PUSH	CX			;SAVE TEMP RESULT IN STACK
	JNB	DSKIP			;NO BORROW FROM SUBTRACT
	ADD	BX,CX			;ADD X BACK IN
	MOV	BP,SP			;REPLACE TEMP RESULT ON STACK
	XCHG	BX,[BP]
DSKIP:	MOV	BX,(Offset BNUM)	;RESTORE H,L
	CMC
	JMPS	DLOOP			;REPEAT LOOP STEPS
;
MULF:					;MULTIPLY D,E BY H,L AND REPLACE H,L WITH RESULT
	MOV	CH,BH
	MOV	CL,BL			;COPY OF 1ST VALUE TO B,C FOR SHIFT AND ADD
	MOV	BX,0			;H,L IS THE ACCUMULATOR
MUL0:	XOR	AL,AL
	MOV	AL,CH			;CARRY IS CLEARED
	RCR	AL,1
	MOV	CH,AL
	MOV	AL,CL
	RCR	AL,1
	MOV	CL,AL
	JB	MUL1			;SKIP THIS ADD IF LSB IS ZERO
	OR	AL,CH
	JNZ	L_EV8
	RET				;RETURN WITH H,L
L_EV8:
	JMPS	MUL2			;SKIP ADD
MUL1:	ADD	BX,DX			;ADD CURRENT VALUE OF D
MUL2:	XCHG	BX,DX			;READY FOR *2
	SHL	BX,1
	XCHG	BX,DX
	JMPS	MUL0
;
MULOP:					;MULTIPLY D,E BY H,L
	CALL	LODV2
	CALL	MULF
	JMP	ENDOP
;
DIVOP:					;DIVIDE H,L BY D,E
	CALL	DIVF
	XCHG	BX,DX			;RESULT TO H,L
	JMP	ENDOP
;
MODOP:	CALL	DIVF
	JMP	ENDOP
;
SHLOP:	CALL	SHFT			;CHECK VALUES
SHL0:	OR	AL,AL			;DONE?
	JNZ	L_EV9
	JMP	ENDOP
L_EV9:
	SHL	BX,1			;HL=HL*2
	DEC	AL
	JMPS	SHL0
;
SHROP:	CALL	SHFT
SHR0:	OR	AL,AL			;DONE?
	JZ	ENDOP
	LAHF				;SAVE CURRENT COUNT
	XCHG	AL,AH
	PUSH	AX
	XCHG	AL,AH
	XOR	AL,AL
	MOV	AL,BH
	RCR	AL,1
	MOV	BH,AL
	MOV	AL,BL
	RCR	AL,1
	MOV	BL,AL
	POP	AX
	XCHG	AL,AH
	DEC	AL
	JMPS	SHR0
;
ADDOP:	CALL	LODV2
ADD0:	ADD	BX,DX
	JMPS	ENDOP
;
SUBOP:	CALL	LODV2
	XCHG	BX,DX			;TREAT AS HL+(-DE)
	CALL	NEGF			;0-HL
	JMPS	ADD0
;
NEGOP:	CALL	LODV1
NEG0:	CALL	NEGF			;COMPUTE 0-HL
	JMPS	ENDOP
;
NOTOP:	CALL	LODV1
	INC	BX			;65536-HL = 65535-(HL+1)
	JMPS	NEG0
;
ANDOP:	CALL	LODV2
	MOV	AL,DH
	AND	AL,BH
	MOV	BH,AL
	MOV	AL,DL
	AND	AL,BL
	MOV	BL,AL
	JMPS	ENDOP
;
OROP:	CALL	LODV2
	MOV	AL,DH
	OR	AL,BH
	MOV	BH,AL
	MOV	AL,DL
	OR	AL,BL
	MOV	BL,AL
	JMPS	ENDOP
;
XOROP:	CALL	LODV2
	MOV	AL,DH
	XOR	AL,BH
	MOV	BH,AL
	MOV	AL,DL
	XOR	AL,BL
	MOV	BL,AL
;
ENDOP:	JMP	STKV
;
ENDEXP:					;RETURNS ZERO FLAG IF SYMBOL IS CR, ;, OR ,
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,SPECL
	JZ	L_EV10
	RET				;NOT END IF NOT SPECIAL
L_EV10:
	MOV	AL,Byte Ptr ACCUM
	CMP	AL,CR
	JNZ	L_EV11
	RET
L_EV11:
	CMP	AL,';'
	JNZ	L_EV12
	RET
L_EV12:
	CMP	AL,','
	JNZ	L_EV13
	RET
L_EV13:
	CMP	AL,'!'
	RET
;
OPAND:					;SCAN THE OPERAND FIELD OF AN INSTRUCTION
	XOR	AL,AL
	MOV	Byte Ptr OSP,AL		;ZERO OPERATOR STACK POINTER
	MOV	Byte Ptr VSP,AL
	DEC	AL			;255
	MOV	Byte Ptr UNARY,AL
	MOV	BX,0
	MOV	Word Ptr EVALUE,BX
;
OP0:					;ARRIVE HERE WITH NEXT ITEM ALREADY SCANNED
	CALL	ENDEXP			;DONE?
	JNZ	OP1
;	EMPTY THE OPERATOR STACK
EMPOP:	MOV	BX,(Offset OSP)
	MOV	AL,M			;GET THE OSP AND CHECK FOR EMPTY
	OR	AL,AL
	JZ	CHKVAL			;JUMP IF EMPTY
	DEC	M			;POP ELEMENT
	MOV	DL,AL			;COPY FOR DOUBLE ADD
	DEC	DL
	MOV	DH,0
	MOV	BX,(Offset OPERV)
	ADD	BX,DX
	MOV	AL,M			;GET OPERATOR
	CALL	APPLY			;APPLY OPERATOR
	JMPS	EMPOP
;
CHKVAL:
	MOV	AL,Byte Ptr VSP		;MUST HAVE ONE ELEMENT IN THE STACK
	CMP	AL,2
	JZ	L_EV14
	CALL	ERREX
L_EV14:
	MOV	AL,Byte Ptr PBUFF
	CMP	AL,' '
	JZ	L_EV15
	RET				;EVALUE REMAINS AT ZERO
L_EV15:
	MOV	BX,Word Ptr VSTACK	;GET DOUBLE BYTE IN STACK
	MOV	Word Ptr EVALUE,BX
	RET
;
OP1:					;MORE TO SCAN
	MOV	AL,Byte Ptr PBUFF
	CMP	AL,' '
	JZ	L_EV16
	JMP	GETOP
L_EV16:
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,STRNG		;IS THIS A STRING?
	JNZ	OP3
;
;	STRING - CONVERT TO DOUBLE PRECISION
	MOV	AL,Byte Ptr ACCLEN
	OR	AL,AL
	JNZ	L_EV17
	CALL	ERREX			;ERROR IF LENGTH=0
L_EV17:
	CMP	AL,3
	JNAE	L_EV18
	CALL	ERREX			;ERROR IF LENGTH>2
L_EV18:
	MOV	DH,0
	MOV	BX,(Offset ACCUM)
	MOV	DL,M			;LSBYTE
	INC	BX
	DEC	AL			;A HAS THE LENGTH
	JZ	OP2			;ONE OR TWO BYTES
	MOV	DH,M			;FILL HIGH ORDER
OP2:	XCHG	BX,DX			;VALUE TO H,L
	JMP	STNUM			;STORE TO STACK
;
OP3:					;NOT A STRING, CHECK FOR NUMBER
	CMP	AL,NUMB
	JNZ	OP4
	MOV	BX,Word Ptr VALUE	;NUMERIC VALUE
	JMP	STNUM
;
OP4:					;NOT STRING OR NUMBER, MUST BE ID OR SPECL
	CALL	BGET			;BINARY SEARCH, GET ATTRIBUTES
	JZ	L_EV19
	JMP	OP6			;MATCH?
L_EV19:
;	YES, MAY BE OPERATOR
	CMP	AL,OPER+1
	JNAE	L_EV20
	JMP	OP5
L_EV20:
	CMP	AL,LPAR			;(?
	MOV	CL,AL			;SAVE COPY OF OPERATOR NUMBER
	MOV	AL,Byte Ptr UNARY
	JNZ	OPER1			;JUMP IF NOT A (
;	( ENCOUNTERED, UNARY MUST BE TRUE
	OR	AL,AL
	JNZ	L_EV21
	CALL	ERREX
L_EV21:
	MOV	AL,0FFH
	MOV	Byte Ptr UNARY,AL	;UNARY IS SET TRUE
	MOV	AL,CL			;RECOVER OPERATOR
	JMP	OPER4			;CALLS STKO AND SETS UNARY TO TRUE
;
OPER1:					;NOT A LEFT PAREN
	OR	AL,AL
	JZ	L_EV22
	JMP	OPER6			;MUST BE + OR - SINCE UNARY IS SET
L_EV22:
;	UNARY NOT SET, MUST BE BINARY OPERATOR
OPER2:					;COMPARE HIERARCHY OF TOS
	PUSH	CX			;SAVE PRIORITY AND OPERATOR NUMBER
	MOV	AL,Byte Ptr OSP
	OR	AL,AL
	JZ	OPER3			;NO MORE OPERATORS IN STACK
	MOV	DL,AL			;OSP TO E
	DEC	DL			;OSP-1
	MOV	DH,0
	MOV	BX,(Offset HIERV)
	ADD	BX,DX			;HL ADDRESSES TOP OF OPERATOR STACK
	MOV	AL,M			;PRIORITY OF TOP OPERATOR
	CMP	AL,CH			;CURRENT GREATER?
	JB	OPER3			;JUMP IF SO
;	APPLY TOP OPERATOR TO VALUE STACK
	MOV	BX,(Offset OSP)
	MOV	M,DL			;OSP=OSP-1
	MOV	BX,(Offset OPERV)
	ADD	BX,DX
	MOV	AL,M			;OPERATOR NUMBER TO ACC
	CALL	APPLY
	POP	CX			;RESTORE OPERATOR NUMBER AND PRIORITY
	JMPS	OPER2			;FOR ANOTHER TEST
;
OPER3:					;ARRIVE HERE WHEN OPERATOR IS STACKED
;	CHECK FOR RIGHT PAREN BALANCE
	POP	CX			;OPERATOR NUMBER IN C, PRIORITY IN B
	MOV	AL,CL
	CMP	AL,RPAR
	JNZ	OPER4			;JUMP IF NOT A RIGHT PAREN
;
;	RIGHT PAREN FOUND, STACK MUST CONTAIN LEFT PAREN TO DELETE
	MOV	BX,(Offset OSP)
	MOV	AL,M
	OR	AL,AL			;ZERO?
	JZ	LPERR			;PAREN ERROR IF SO
	DEC	AL			;OSP-1
	MOV	M,AL			;STORED TO MEMORY
	MOV	DL,AL
	MOV	DH,0
	MOV	BX,(Offset OPERV)
	ADD	BX,DX
	MOV	AL,M			;TOP OPERATOR IN REG-A
	CMP	AL,LPAR
	JZ	NLERR			;JMP IF NO ERROR - PARENS BALANCE
LPERR:	CALL	ERREX
NLERR:					;ERROR REPORTING COMPLETE
	XOR	AL,AL
	JMPS	OPER5			;TO CLEAR UNARY FLAG
;
OPER4:					;ORDINARY OPERATOR
	CALL	STKO
	MOV	AL,0FFH			;TO SET UNARY FLAG
OPER5:	MOV	Byte Ptr UNARY,AL
	JMP	GETOP			;FOR ANOTHER ELEMENT
;
OPER6:					;UNARY SET, MUST BE + OR -
	MOV	AL,CL			;RECALL OPERATOR
	CMP	AL,PLUS
	JNZ	L_EPLUS
	JMP	GETOP			;IGNORE UNARY PLUS
L_EPLUS:
	CMP	AL,MINUS
	JNZ	CHKNOT
	INC	AL			;CHANGE TO UNARY MINUS
	MOV	CL,AL
	JMP	OPER2
CHKNOT:					;UNARY NOT SYMBOL?
	CMP	AL,NOTF
	JZ	L_EV23
	CALL	ERREX
L_EV23:
	JMP	OPER2
;
OP5:					;ELEMENT FOUND IN TABLE, NOT AN OPERATOR
	CMP	AL,PT			;PSEUDO OPERATOR?
	JNZ	L_EV24
	CALL	ERREX			;ERROR IF SO
L_EV24:
	MOV	BL,CH			;GET LOW VALUE TO L
	MOV	BH,0			;ZERO HIGH ORDER BYTE
	JMPS	STNUM			;STORE IT
;
OP6:					;NOT FOUND IN TABLE SCAN, $?
	MOV	AL,Byte Ptr TOKEN
	CMP	AL,SPECL
	JNZ	OP7
	MOV	AL,Byte Ptr ACCUM
	CMP	AL,'$'
	JZ	CURPC			;USE CURRENT PC
	CALL	ERREX
	MOV	BX,0
	JMPS	STNUM
CURPC:	MOV	BX,Word Ptr ASPC	;GET CURRENT PC
	JMPS	STNUM
;
OP7:					;NOT $, LOOK IT UP
	CALL	LOOKUP
	CALL	FOUND
	JNZ	FIDENT
;	NOT FOUND IN SYMBOL TABLE, ENTER IF PASS 1
	MOV	AL,'P'
	CALL	PERR
	CALL	ENTER			;ENTER SYMBOL WITH ZERO TYPE FIELD
	JMPS	FIDE0
FIDENT:	CALL	GETTY			;TYPE TO H,L
	AND	AL,111B
	MOV	AL,'U'
	JNZ	L_EV26
	CALL	PERR
L_EV26:
;
FIDE0:
	CALL	GETVAL			;VALUE TO H,L
;
STNUM:					;STORE H,L TO VALUE STACK
	MOV	AL,Byte Ptr UNARY
	OR	AL,AL			;UNARY OPERATION SET
	JNZ	L_EV27
	CALL	ERREX			;OPERAND ENCOUNTERED WITH UNARY OFF
L_EV27:
	XOR	AL,AL
	MOV	Byte Ptr UNARY,AL	;SET TO OFF
	CALL	STKV			;STACK THE VALUE
;
GETOP:	CALL	SCAN
	JMP	OP0
;
ERREX:					;PUT 'E' ERROR IN OUTPUT BUFFER
	PUSH	BX
	MOV	AL,'E'
	CALL	PERR
	POP	BX
	RET
;
; =========================================================================
; DATA AREA
; =========================================================================
;
;	PRINT BUFFER
PBUFF	RS	PBMAX			;PRINT LINE IMAGE (QBUFF IN THE 8080 I/O MODULE)
PBP	RS	1			;PRINT LINE POINTER (QBP IN THE 8080 I/O MODULE)
;
;	SCANNER PARAMETERS
TOKEN	RS	1			;CURRENT TOKEN
VALUE	RS	2			;BINARY VALUE FOR NUMBERS
ACCLEN	RS	1			;ACCUMULATOR LENGTH
ACCUM	RS	ACMAX			;ACCUMULATOR (MUST FOLLOW ACCLEN)
LASTC	RS	1			;LAST CHAR SCANNED
NEXTC	RS	1			;LOOK AHEAD CHAR
STYPE	RS	1			;RADIX INDICATOR
;
;	EXPRESSION EVALUATOR PARAMETERS
EVALUE	RS	2			;VALUE OF EXPRESSION AFTER EVALUATION
UNARY	RS	1			;TRUE IF NEXT OPERATOR IS UNARY
OPERV	RS	OSMAX			;OPERATOR STACK
HIERV	RS	OSMAX			;OPERATOR PRIORITY
VSTACK	RS	VSMAX			;VALUE STACK
OSP	RS	1			;OPERATOR STACK POINTER
VSP	RS	1			;VALUE STACK POINTER
DTEMP	RS	2			;DIVIDE TEMP
BNUM	RS	1			;DIVIDE BIT COUNT
;
;	SYMBOL TABLE PARAMETERS
SYTOP	RS	2			;FIRST LOCATION AVAILABLE FOR SYMBOL TABLE
SYMAX	RS	2			;LAST AVAILABLE LOCATION FOR SYMBOL TABLE
SYBAS	RS	2			;SYMBOL TABLE BASE
SYADR	RS	2			;CURRENT SYMBOL BASE
HASHT	RS	SYMHSIZE*2		;HASH TABLE
HASHC	RS	1			;HASH CODE
;
;	MAIN AND CODE GENERATION PARAMETERS
PASS	RS	1			;PASS # 0,1
FPC	RS	2			;FILL ADDRESS FOR NEXT HEX RECORD
ASPC	RS	2			;ASSEMBLER'S PSEUDO PC
SYLAB	RS	2			;ADDRESS OF LINE LABEL
EPC	RS	2			;END PC VALUE
NBP	RS	1			;NEXT BYTE POSITION TO WRITE FOR MACHINE CODE
;
;	I/O DATA & BUFFERS
BPC	RS	2			;BASE PC FOR CURRENT HEX RECORD
DBL	RS	1			;HEX BUFFER LENGTH
DBUFF	RS	16			;HEX BUFFER
CDISK	RS	1			;CURRENTLY SELECTED DISK
ADISK	RS	1			;.ASM DISK
PDISK	RS	1			;.PRN DISK
HDISK	RS	1			;.HEX DISK
;
SCB	RS	9			;SOURCE FILE NAME
	DB	'ASM'			;FILE TYPE
SCBR	RS	1			;REEL NUMBER
	RS	19			;MISC AND DISK MAP
SCBCR	RS	1			;CURRENT RECORD
;
PCB	RS	9			;PRINT FILE NAME
	DB	'PRN',0
	RS	19
	DB	0
;
HCB	RS	9			;HEX FILE NAME
	DB	'HEX',0
	RS	19
	DB	0
;
SBP	RS	2			;SOURCE BUFFER POINTER
SBUFF	RS	SSIZE			;SOURCE BUFFER (1024 BYTES)
;
OBP	RS	2			;PRINT FILE BUFFER POINTER (PBP IN THE 8080 I/O MODULE)
OBUFF	RS	PSIZE			;PRINT FILE BUFFER (768 BYTES)
;
HBP	RS	2			;HEX BUFFER POINTER
ASMERR	RS	1			;NON-ZERO: ERRORS SEEN, DELETE HEX AT END
HBUFF	RS	HSIZE			;HEX BUFFER (768 BYTES)
;
;	STACK AREA
	RS	200H			;512 BYTE INTERNAL STACK
STACKTOP:
;
ENDA:					;DYNAMIC SYMBOL TABLE STARTS HERE
	END
