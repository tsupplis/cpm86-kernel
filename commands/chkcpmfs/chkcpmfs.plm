$TITLE('CHKCPMFS 1.1 - CP/M filesystem check')
$COMPACT

chkcpmfs:
do;

/* The loader command tail resides in the SCD base-page BUFF symbol. */
declare buff(128) byte external;

/* BDOS search copies 33 FCB bytes back to the caller. */
declare
    media$fcb (36) byte,
    search$fcb (36) byte,
    dirbuf (128) byte,
    alloc$map (8192) byte,
    extent$table (32768) byte,
    repair$plan (2048) byte,
    before$record (128) byte,
    after$record (128) byte,
    compare$record (128) byte,
    dpb$pointer pointer,
    DPB based dpb$pointer structure
        (spt address, bls byte, bms byte, exm byte, mxa address,
         dmx address, dbl address, cks address, ofs address),
    blkshf literally 'dpb.bls',
    extmsk literally 'dpb.exm',
    maxall literally 'dpb.mxa',
    maxdir literally 'dpb.dmx',
    dirblk literally 'dpb.dbl',
    extent$table$capacity literally '2048',
    cpm3 literally '30h',
    cdos literally '41h',
    (dir$offset, map$index, block$number,
     records$per$block, needed$blocks, entry$count, block$count,
     error$count, original$dma, drive$mask, ro$vector,
     extent$count, extent$key, table$offset, original$user,
     physical$entry, first$entry, raw$record, norm$count, dup$count) address,
    (verbose, original$disk, disk, dcnt, entry$user, rc, system$version,
     slots, slot, map$bit, protect$status, changed$ro,
     restore$failed, user$changed, scan$user,
     name$match, duplicate, repair$requested, raw$active, raw$scan,
     safe$finding, repair$blockers, special$metadata, changes$written) byte;

mon1: procedure (func,info) external;
    declare func byte, info address;
end mon1;

mon2: procedure (func,info) byte external;
    declare func byte, info address;
end mon2;

mon3: procedure (func,info) address external;
    declare func byte, info address;
end mon3;

mon4: procedure (func,info) pointer external;
    declare func byte, info address;
end mon4;

rawopen: procedure (drive,spt,ofs) byte external;
    declare (drive,spt,ofs) address;
end rawopen;
rawclose: procedure external;
end rawclose;
rawread: procedure (record,buffer) byte external;
    declare (record,buffer) address;
end rawread;
rawwrite: procedure (record,before,after) byte external;
    declare (record,before,after) address;
end rawwrite;
rawarm: procedure byte external;
end rawarm;

put: procedure (char);
    declare char byte;
    call mon1(2,char);
end put;

print$string: procedure (text$address);
    declare text$address address,
            character based text$address byte;
    do while character <> '$';
        call put(character);
        text$address = text$address + 1;
    end;
end print$string;

newline: procedure;
    call put(13);
    call put(10);
end newline;

decimal: procedure (number);
    declare number address,
            digits (5) byte,
            used byte;
    used = 0;
    do while number >= 10;
        digits(used) = low(number mod 10) + '0';
        used = used + 1;
        number = number / 10;
    end;
    digits(used) = low(number) + '0';
    used = used + 1;
    do while used <> 0;
        used = used - 1;
        call put(digits(used));
    end;
end decimal;

print$file: procedure;
    declare i byte;
    do i = 1 to 8;
        call put(dirbuf(dir$offset + i) and 7fh);
    end;
    call put('.');
    do i = 9 to 11;
        call put(dirbuf(dir$offset + i) and 7fh);
    end;
end print$file;

entry$prefix: procedure;
    call print$string(.('ERROR: USER $'));
    call decimal(entry$user);
    call print$string(.(' FILE $'));
    call print$file;
    call print$string(.(': $'));
end entry$prefix;

/* Keep severe damage from wrapping the error count back to zero. */
count$error: procedure;
    if error$count <> 0ffffh then error$count = error$count + 1;
    if safe$finding = 0 then repair$blockers = 1;
end count$error;

report$block: procedure (reason);
    declare reason address,
            character based reason byte;
    call entry$prefix;
    call print$string(.('BLOCK $'));
    call decimal(block$number);
    call print$string(.(' $'));
    call print$string(reason);
    call newline;
    call count$error;
end report$block;

report$extent: procedure;
    call entry$prefix;
    call print$string(.('DUPLICATE EXTENT GROUP $'));
    call decimal(extent$key);
    call newline;
    call count$error;
end report$extent;

check$extent: procedure;
    declare (i, j) address;

    extent$key =
        ((dirbuf(dir$offset + 14) and 3fh) * 32) +
        (dirbuf(dir$offset + 12) and (not extmsk) and 1fh);
    duplicate = 0;
    if extent$count <> 0 then do;
        do i = 0 to extent$count - 1;
            table$offset = i * 16;
            if extent$table(table$offset) = entry$user and
               extent$table(table$offset + 12) = low(extent$key) and
               extent$table(table$offset + 13) = high(extent$key) then do;
                name$match = 1;
                do j = 0 to 10;
                    if extent$table(table$offset + j + 1) <>
                       (dirbuf(dir$offset + j + 1) and 7fh) then
                        name$match = 0;
                end;
                if name$match <> 0 then do;
                    duplicate = 1;
                    first$entry = extent$table(table$offset+14) +
                        shl(double(extent$table(table$offset+15)),8);
                end;
            end;
        end;
    end;

    if duplicate <> 0 then do;
        if raw$scan <> 0 then do;
            if rawread(first$entry/4,.compare$record) <> 0 then do;
                repair$blockers = 1;
                return;
            end;
            name$match = 1;
            do j = 0 to 31;
                if compare$record((first$entry mod 4)*32+j) <>
                   dirbuf(dir$offset+j) then name$match = 0;
            end;
            /* A timestamp SFCB describes the first three slots of its
             * 128-byte record. Keep the survivor's timestamps untouched and
             * require the duplicate's complete timestamp tuple to match. */
            if compare$record(96) = 21h or dirbuf(96) = 21h then do;
                if compare$record(96) <> 21h or dirbuf(96) <> 21h or
                   (first$entry mod 4) = 3 or (physical$entry mod 4) = 3 then
                    name$match = 0;
                else do j = 0 to 9;
                    if compare$record(97+(first$entry mod 4)*10+j) <>
                       dirbuf(97+(physical$entry mod 4)*10+j) then name$match = 0;
                end;
            end;
            if name$match <> 0 then do;
                repair$plan(physical$entry) = repair$plan(physical$entry) or 2;
                dup$count = dup$count + 1;
                safe$finding = 1;
            end;
        end;
        call report$extent;
        safe$finding = 0;
    end;
    else do;
        table$offset = extent$count * 16;
        extent$table(table$offset) = entry$user;
        do j = 0 to 10;
            extent$table(table$offset + j + 1) =
                dirbuf(dir$offset + j + 1) and 7fh;
        end;
        extent$table(table$offset + 12) = low(extent$key);
        extent$table(table$offset + 13) = high(extent$key);
        extent$table(table$offset+14) = low(physical$entry);
        extent$table(table$offset+15) = high(physical$entry);
        extent$count = extent$count + 1;
    end;
end check$extent;

/* Repair may normalize only records with an unambiguous 8.3 identity.
 * Refusing an unusual name is a safety limit, not a declaration of data loss. */
safe$filename: procedure byte;
    declare (i,j,c,padding) byte;
    declare forbidden(*) byte data('<>.,;:=?*[]/');
    if (dirbuf(dir$offset+1) and 7fh) <= ' ' then return 0;
    padding = 0;
    do i = 1 to 11;
        if i = 9 then padding = 0;
        c = dirbuf(dir$offset+i) and 7fh;
        if c = ' ' then padding = 1;
        else do;
            if padding <> 0 or c < 21h or c = 7fh then return 0;
            do j = 0 to 11;
                if c = forbidden(j) then return 0;
            end;
        end;
    end;
    return 1;
end safe$filename;

check$entry: procedure;
    declare (i, effective$rc) address;

    entry$user = dirbuf(dir$offset);
    if raw$scan <> 0 then do;
        if safe$filename = 0 then do;
            call entry$prefix;
            call print$string(.('UNCERTAIN FILENAME; REPAIR REFUSED$'));
            call newline;
            call count$error;
        end;
    end;
    rc = dirbuf(dir$offset + 15);
    if rc > 128 then do;
        call entry$prefix;
        call print$string(.('RECORD COUNT EXCEEDS 128$'));
        call newline;
        call count$error;
        effective$rc = 128;
    end;
    else effective$rc = rc;
    effective$rc = effective$rc +
                   ((dirbuf(dir$offset + 12) and extmsk) * 128);

    if (dirbuf(dir$offset + 12) and 0e0h) <> 0 or
       (dirbuf(dir$offset + 14) and 0c0h) <> 0 then do;
        call entry$prefix;
        call print$string(.('RESERVED EXTENT BITS ARE SET$'));
        call newline;
        if raw$scan <> 0 then do;
            repair$plan(physical$entry) = repair$plan(physical$entry) or 1;
            norm$count = norm$count + 1;
            safe$finding = 1;
        end;
        call count$error;
        safe$finding = 0;
    end;

    call check$extent;
    /* Exact duplicates contribute no new ownership after their removal. */
    if raw$scan <> 0 and (repair$plan(physical$entry) and 2) <> 0 then return;

    if maxall > 255 then slots = 8;
    else slots = 16;
    records$per$block = shl(1,blkshf);
    needed$blocks = (effective$rc + records$per$block - 1) /
                    records$per$block;
    if needed$blocks > slots then do;
        call entry$prefix;
        call print$string(.('RECORD COUNT EXCEEDS EXTENT ALLOCATION CAPACITY$'));
        call newline;
        call count$error;
    end;

    /* BDOS allocates every nonzero slot; zero may be a sparse-file hole. */
    do slot = 0 to slots - 1;
        if maxall > 255 then do;
            i = dir$offset + 16 + (slot * 2);
            block$number = dirbuf(i) +
                           shl(double(dirbuf(i + 1)),8);
        end;
        else block$number = dirbuf(dir$offset + 16 + slot);
        if block$number <> 0 then do;
            block$count = block$count + 1;

            if block$number > maxall then
                call report$block(.('IS OUTSIDE THE DISK$'));
            else do;
                if block$number < 8 then do;
                    if (low(dirblk) and shl(1,7 - block$number)) <> 0 then
                        call report$block(.('IS RESERVED FOR THE DIRECTORY$'));
                end;
                else if block$number < 16 then do;
                    if (high(dirblk) and
                        shl(1,15 - block$number)) <> 0 then
                        call report$block(.('IS RESERVED FOR THE DIRECTORY$'));
                end;

                map$index = shr(block$number,3);
                map$bit = shl(1,block$number and 7);
                if (alloc$map(map$index) and map$bit) <> 0 then
                    call report$block(.('IS REFERENCED MORE THAN ONCE$'));
                else alloc$map(map$index) =
                     alloc$map(map$index) or map$bit;
            end;
        end;
    end;
end check$entry;

dos$media: procedure byte;
    declare (old$dma,junk) address,
            i byte;
    old$dma = mon3(52,0);
    do i = 0 to 127;
        dirbuf(i) = 0;
    end;
    media$fcb(0) = '?';
    do i = 1 to 11;
        media$fcb(i) = '?';
    end;
    do i = 12 to 35;
        media$fcb(i) = 0;
    end;
    call mon1(26,.dirbuf);
    junk = mon2(17,.media$fcb);
    call mon1(26,old$dma);
    return dirbuf(0) = 20h and dirbuf(15) = 80h;
end dos$media;

/* Validate the layout before interpreting any allocation slot. EXM must
 * describe a supported extent grouping for BSH and DSM.
 * Extra reserved blocks are legal, but every directory block must be reserved. */
valid$dpb: procedure byte;
    declare (capacity, expected, blocks, i, reserved, mask) address;
    if dpb.spt = 0 or blkshf < 3 or blkshf > 7 then return 0;
    if dpb.bms <> shl(1,blkshf)-1 then return 0;
    capacity = shl(1,blkshf);
    if maxall > 255 then capacity = capacity * 8;
    else capacity = capacity * 16;
    if capacity < 128 then return 0;
    expected = capacity / 128 - 1;
    /* CDOS HDMAINT uses 32K extent groups with 8K blocks (four of
     * eight wide allocation slots). Older kernels honour that EXM too. */
    if extmsk <> expected then
        if not (blkshf = 6 and maxall > 255 and extmsk = 1) then return 0;
    blocks = (maxdir / 4 + 1 + shl(1,blkshf)-1) / shl(1,blkshf);
    if blocks = 0 or blocks > 16 then return 0;
    reserved = 0;
    do i = 0 to 15;
        if i < 8 then mask = low(dirblk) and shl(1,7-i);
        else mask = high(dirblk) and shl(1,15-i);
        if mask <> 0 then do;
            if i > maxall then return 0;
            reserved = reserved + 1;
        end;
        if i < blocks and mask = 0 then return 0;
    end;
    return reserved >= blocks;
end valid$dpb;

protect$drive: procedure byte;
    drive$mask = shl(1,disk);
    ro$vector = mon3(29,0);
    if (ro$vector and drive$mask) <> 0 then do;
        call print$string(.('Drive was already read-only; preserving its RO state.$'));
        call newline;
        return 0;
    end;

    protect$status = mon2(28,0);
    ro$vector = mon3(29,0);
    if (ro$vector and drive$mask) = 0 then return 0ffh;
    changed$ro = 1;
    return 0;
end protect$drive;

restore$drive: procedure;
    if changed$ro <> 0 then do;
        protect$status = mon2(37,drive$mask);
        ro$vector = mon3(29,0);
        changed$ro = 0;
        if (ro$vector and drive$mask) <> 0 then do;
            restore$failed = 1;
            if system$version < cpm3 then
                call print$string(.('ERROR: drive write protection could not be restored; use Ctrl-C.$'));
            else do;
                call print$string(.('ERROR: drive write protection could not be restored; use SET $'));
                call put(disk + 'A');
                call print$string(.(': [RW].$'));
            end;
            call newline;
        end;
    end;
end restore$drive;

restore$user: procedure;
    if user$changed <> 0 then do;
        call mon1(32,original$user);
        user$changed = 0;
        if mon2(32,0ffh) <> original$user then do;
            restore$failed = 1;
            call print$string(.('ERROR: original user area could not be restored.$'));
            call newline;
        end;
    end;
end restore$user;

terminate: procedure;
    if raw$active <> 0 then do;
        call rawclose; raw$active = 0;
        if changes$written <> 0 then do;
            protect$status = mon2(37,shl(1,disk));
            if protect$status <> 0 then do;
                restore$failed = 1;
                call print$string(.('ERROR: post-repair drive reset failed; re-login before further access.$'));
                call newline;
            end;
        end;
    end;
    call restore$drive;
    call restore$user;
    if disk <> original$disk then call mon1(14,original$disk);
    call mon1(26,original$dma);
    call mon1(0,0);
end terminate;

/* Validate the complete tail before selecting the requested drive. */
show$usage: procedure;
    call print$string(.('USAGE: CHKCPMFS drive: [FV]$'));
    call newline;
    call print$string(.('  drive: A:..P:$'));
    call newline;
    call print$string(.('  F      confirmed metadata repair$'));
    call newline;
    call print$string(.('  V      verbose$'));
    call newline;
end show$usage;

options$requested: procedure byte;
    declare (first,last,i) address;
    declare (c,valid,repair) byte;
    first = 1;
    last = buff(0);
    if last > 127 then last = 127;
    do while first <= last and (buff(first) = ' ' or buff(first) = 9);
        first = first + 1;
    end;
    do while last >= first and (buff(last) = ' ' or buff(last) = 9);
        last = last - 1;
    end;
    if first > last then do;
        call show$usage;
        return 1;
    end;
    c = buff(first);
    if c >= 'a' and c <= 'z' then c = c - 20h;
    if first + 1 > last or c < 'A' or c > 'P' or
       buff(first+1) <> ':' then do;
        call print$string(.('ERROR: Invalid command line.$'));
        call newline;
        call show$usage;
        return 1;
    end;
    disk = c - 'A';
    first = first + 2;
    if first <= last then do;
        if buff(first) <> ' ' and buff(first) <> 9 then do;
            call show$usage;
            return 1;
        end;
    end;
    do while first <= last and (buff(first) = ' ' or buff(first) = 9);
        first = first + 1;
    end;
    if first > last then return 0;
    valid, repair = 0;
    if buff(first) = '[' or buff(first) = '/' then do;
        if buff(first) = '[' and buff(last) = ']' then last = last - 1;
        first = first + 1;
        if first <= last then valid = 1;
        do i = first to last;
            c = buff(i);
            if c >= 'a' and c <= 'z' then c = c - 20h;
            if c = 'F' then repair = 1;
            if c = 'V' then verbose = 1;
            if c <> 'F' and c <> 'V' then valid = 0;
        end;
    end;
    if valid <> 0 then do;
        repair$requested = repair;
        return 0;
    end;
    call print$string(.('ERROR: Invalid command option.$'));
    call newline;
    call show$usage;
    return 1;
end options$requested;

/* Complete raw directory pass while the native disk lock is held. */
scan$raw: procedure byte;
    declare (i,j) address;
    entry$count, block$count, error$count, extent$count = 0;
    norm$count, dup$count = 0;
    repair$blockers, special$metadata, safe$finding = 0;
    do i = 0 to 8191; alloc$map(i) = 0; end;
    do i = 0 to 2047; repair$plan(i) = 0; end;
    raw$scan = 1;
    do raw$record = 0 to maxdir/4;
        if rawread(raw$record,.dirbuf) <> 0 then do;
            call print$string(.('ERROR: directory read failed; repair stopped.$'));
            call newline;
            raw$scan = 0;
            return 0;
        end;
        do j = 0 to 3;
            physical$entry = raw$record*4+j;
            if physical$entry <= maxdir then do;
                dir$offset = j*32;
                entry$user = dirbuf(dir$offset);
                if entry$user <= 15 then do;
                    entry$count = entry$count + 1;
                    call check$entry;
                end;
                else if entry$user <> 0e5h and entry$user <> 20h then do;
                    if entry$user <> 21h or j <> 3 then special$metadata = 1;
                end;
            end;
        end;
    end;
    raw$scan = 0;
    if special$metadata <> 0 and dup$count <> 0 then do;
        call print$string(.('ERROR: associated metadata prevents duplicate removal.$'));
        call newline;
        repair$blockers = 1;
    end;
    return 1;
end scan$raw;

/* Poll without Ctrl-C's immediate abort so lock/process cleanup always runs. */
confirm$repair: procedure byte;
    declare c byte;
    c = 0;
    do while c = 0;
        c = mon2(6,0ffh);
        if c = 0 and system$version >= cpm3 then call mon1(142,0);
    end;
    call put(c);
    call newline;
    return c = 'Y' or c = 'y';
end confirm$repair;

repair$directory: procedure;
    declare (i,j,k,planned,phase) address;
    if (ro$vector and drive$mask) <> 0 then do;
        call print$string(.('ERROR: drive is read-only; repair refused.$'));
        call newline;
        return;
    end;
    if rawopen(double(disk),dpb.spt,dpb.ofs) <> 0 then do;
        call print$string(.('ERROR: cannot acquire supported directory I/O; repair refused.$'));
        call newline;
        return;
    end;
    raw$active = 1;
    if scan$raw = 0 then return;
    if repair$blockers <> 0 then do;
        call print$string(.('ERROR: ambiguous or unsafe findings prevent all repairs.$'));
        call newline;
        return;
    end;
    planned = norm$count+dup$count;
    if planned = 0 then do;
        call print$string(.('No metadata repairs needed.$'));
        call newline;
        return;
    end;
    call print$string(.('Clear reserved extent bits: $')); call decimal(norm$count);
    call print$string(.('; remove identical duplicate extents: $')); call decimal(dup$count);
    call newline;
    call print$string(.('Apply these metadata repairs (Y/N)? $'));
    if confirm$repair = 0 then do;
        call print$string(.('Repair cancelled; no changes written.$'));
        call newline;
        return;
    end;
    if rawarm <> 0 then do;
        call print$string(.('ERROR: repair could not be armed; no changes written.$'));
        call newline;
        return;
    end;
    /* Delete redundant records first. An interrupted operation must not
     * normalize the survivor while leaving an otherwise identical duplicate
     * with different reserved bits, making a safe retry ambiguous. */
    do phase = 0 to 1;
    do i = 0 to maxdir/4;
        planned = 0;
        do j = 0 to 3;
            k = i*4+j;
            if k <= maxdir then do;
                if phase = 0 then planned = planned or (repair$plan(k) and 2);
                else if (repair$plan(k) and 2) = 0 then
                    planned = planned or (repair$plan(k) and 1);
            end;
        end;
        if planned <> 0 then do;
            if rawread(i,.before$record) <> 0 then do;
                call print$string(.('ERROR: repair read failed; disk may contain partial changes.$'));
                call newline;
                return;
            end;
            do j = 0 to 127; after$record(j) = before$record(j); end;
            do j = 0 to 3;
                k = i*4+j;
                if k <= maxdir then do;
                    if phase = 0 then do;
                        if (repair$plan(k) and 2) <> 0 then after$record(j*32) = 0e5h;
                    end;
                    else if (repair$plan(k) and 2) = 0 and
                            (repair$plan(k) and 1) <> 0 then do;
                        after$record(j*32+12) = after$record(j*32+12) and 1fh;
                        after$record(j*32+14) = after$record(j*32+14) and 3fh;
                    end;
                end;
            end;
            changes$written = 1;
            if rawwrite(i,.before$record,.after$record) <> 0 then do;
                call print$string(.('ERROR: repair write/verification failed; disk may contain partial changes.$'));
                call newline;
                return;
            end;
        end;
    end;
    end;
    if scan$raw = 0 then return;
    if error$count <> 0 then call print$string(.('ERROR: metadata repair verification found errors.$'));
    else call print$string(.('Metadata repairs written and verified.$'));
    call newline;
end repair$directory;

plmstart: procedure public;
    declare i address;

    verbose, changed$ro, restore$failed, user$changed = 0;
    repair$requested, raw$active, raw$scan, safe$finding = 0;
    repair$blockers, special$metadata, changes$written = 0;
    system$version = mon2(12,0);
    original$dma = mon3(52,0);
    original$user = mon2(32,0ffh);
    original$disk = mon2(25,0);
    call print$string(.('CHKCPMFS 1.1 - CP/M FILESYSTEM CHECK$'));
    call newline;
    if options$requested then do;
        call mon1(0,0);
        return;
    end;
    if disk <> original$disk then call mon1(14,disk);
    if mon2(25,0) <> disk then do;
        call print$string(.('ERROR: Cannot select drive.$'));
        call newline;
        call terminate;
        return;
    end;
    call print$string(.('Scans ordinary file entries through BDOS on the selected drive.$'));
    call newline;
    if repair$requested = 0 then
        call print$string(.('Temporarily write-protects the drive and preserves its prior RO state.$'));
    else call print$string(.('Repairs only reserved extent bits and identical duplicate extents.$'));
    call newline;
    if repair$requested = 0 then
        call print$string(.('Keep the drive idle; the scan has no exclusive lock.$'));
    else call print$string(.('Keep the drive idle; concurrent repairs hold MXdisk.$'));
    call newline;

    if system$version >= cdos then do;
        if dos$media then do;
            call print$string(.('DOS media detected; no CP/M filesystem scan performed.$'));
            call newline;
            call terminate;
        end;
    end;

    dpb$pointer = mon4(31,0);
    disk = mon2(25,0);
    call print$string(.('Drive $'));
    call put(disk + 'A');
    call print$string(.('  DPB block shift $'));
    call decimal(blkshf);
    call print$string(.('  max block $'));
    call decimal(maxall);
    call newline;

    if maxdir >= extent$table$capacity then do;
        call print$string(.('ERROR: directory exceeds duplicate-check capacity; scan stopped.$'));
        call newline;
        call terminate;
    end;

    if valid$dpb = 0 then do;
        call print$string(.('ERROR: inconsistent or unsupported DPB; scan stopped.$'));
        call newline;
        call terminate;
    end;
    do i = 0 to 8191;
        alloc$map(i) = 0;
    end;
    entry$count, block$count, error$count, extent$count = 0;

    if repair$requested <> 0 then do;
        drive$mask = shl(1,disk);
        ro$vector = mon3(29,0);
        call repair$directory;
        call terminate;
        return;
    end;

    if protect$drive <> 0 then do;
        call print$string(.('ERROR: could not establish drive write protection; scan stopped.$'));
        call newline;
        if system$version < cpm3 then
            call print$string(.('Check drive status with STAT; use Ctrl-C if needed.$'));
        else do;
            call print$string(.('Check drive status with SHOW; use SET $'));
            call put(disk + 'A');
            call print$string(.(': [RW] if needed.$'));
        end;
        call newline;
        call terminate;
    end;

    call mon1(26,.dirbuf);

    do scan$user = 0 to 15;
        call mon1(32,scan$user);
        user$changed = 1;
        search$fcb(0) = 0;
        do i = 1 to 11;
            search$fcb(i) = '?';
        end;
        do i = 12 to 35;
            search$fcb(i) = 0;
        end;
        search$fcb(12) = '?';
        dcnt = mon2(17,.search$fcb);
        do while dcnt <> 0ffh;
            dir$offset = shl(double(dcnt),5);
            entry$user = dirbuf(dir$offset);
            if entry$user <= 15 then do;
                entry$count = entry$count + 1;
                if verbose then do;
                    call print$string(.('USER $'));
                    call decimal(entry$user);
                    call print$string(.(' FILE $'));
                    call print$file;
                    call newline;
                end;
                call check$entry;
            end;
            dcnt = mon2(18,0);
        end;
    end;
    call restore$drive;
    call restore$user;

    call print$string(.('Directory entries scanned: $'));
    call decimal(entry$count);
    call print$string(.('  block references checked: $'));
    call decimal(block$count);
    call newline;
    call print$string(.('Consistency errors: $'));
    call decimal(error$count);
    call newline;
    if error$count = 0 and restore$failed = 0 then
        call print$string(.('No inconsistencies found in checked entries.$'));
    else if restore$failed <> 0 then
        call print$string(.('Scan completed with a state restoration error.$'));
    else
        call print$string(.('Review the reported directory-entry errors.$'));
    call newline;
    call print$string(.('Not checked: deleted slots, timestamps, data sectors, or unreferenced blocks.$'));
    call newline;
    call terminate;
end plmstart;

end chkcpmfs;
