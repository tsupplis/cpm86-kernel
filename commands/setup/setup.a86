;*****************************************************************************
;
;	SETUP - CP/M-86 BIOS customization for the IBM PC and XT, version 1.2
;	Copyright (C) 1983, Digital Research
;
;	Reconstructed from base/setup.cmd; assembles byte-identical.
;
;	Build: make setup.cmd
;	Check: cmp setup.cmd ../../base/setup.cmd
;
;	Interactive BIOS options are stored in a 512-byte configuration sector
;	and take effect at the next power-on or reset.  The sector begins with
;	DDB2h and includes memory disk, startup command, FIDDS, disk timing,
;	verification, sound and optional snapshots of live BIOS settings.
;
;	The XIOS pointer slots below belong to the shipped IBM PC BIOS ABI.
;	The display uses its VT52 escapes; BIOS calls handle keyboard input,
;	window clearing and direct hard disk access.
;
;*****************************************************************************

; Single CODE group (8080 model), with DS-relative symbols in the data segment.
cgroup	group	code,data

	cseg
	org	100h

; ---- BDOS / BIOS numbers -----------------------------------
f_reset		equ	0
f_conin		equ	1
f_conout	equ	6
f_constat	equ	11
f_seldisk	equ	14
f_dma		equ	26
f_sysdata	equ	49
f_bios		equ	50		; direct XIOS call through a parameter block
f_dmaseg	equ	51

i_bdos		equ	0e0h
i_video		equ	10h
i_disk		equ	13h
i_keyb		equ	16h

; Offsets of pointers inside the system data segment returned by BDOS 49.
keytblptr	equ	0254eh		; two sets of ten 20-byte definitions
serialptr	equ	02552h		; two serial-port parameter bytes
iovecptr	equ	02554h		; five logical character-I/O assignment words

; Absolute aliases for code-resident dispatch tables (fixed image addresses).  RASM otherwise adds
; a CS override to a label operand, changing the original instruction bytes.
cmdactsoff	equ	001bfh
saveactsoff	equ	002b2h
memactsoff	equ	00316h
verifyactsoff	equ	0041ch
stepactsoff	equ	00470h
soundactsoff	equ	004e7h
fiddsactsoff	equ	0053bh
diskactsoff	equ	005efh

; Bounds for tools/a86tool.py.
data_org	equ	093ch
image_end	equ	1e90h

start:
	jmps	begin

	db	'Copyright (C) 1983, Digital Research'

;-----------------------------------------------------------------------------
; Entry: discard type-ahead, obtain the XIOS segment and load saved options.
;-----------------------------------------------------------------------------
begin:
	mov	ax,cs
	mov	ds,ax
	call	flushkb
	mov	cl,f_sysdata
	int	i_bdos
	mov	word ptr xiossg,es
	call	drawframe
	call	loadsettings

;-----------------------------------------------------------------------------
; The key list and action table change together when the page changes.
; getchoice returns a word-table displacement in BX.
;-----------------------------------------------------------------------------
mainloop:
	call	showpage
	mov	di,pagekeys
	call	getchoice
	add	bx,pageactions
	call	word ptr [bx]
	call	clrbody
	jmps	mainloop

;-----------------------------------------------------------------------------
; Main page: F1..F6, F9 update, F10 exit.  Second page: F1..F4, F9, F10.
;-----------------------------------------------------------------------------
mainacts	dw	commandmenu,savemenu,memorymenu,stepmenu,fiddsmenu,secondpage,update,exitprog
pageacts	dw	verifymenu,soundmenu,diskmenu,mainpage,update,exitprog

;-----------------------------------------------------------------------------
; Install the four descriptors for the main menu.
;-----------------------------------------------------------------------------
mainpage:
	mov	word ptr pagetitle,offset maintitle
	mov	word ptr pageactions,offset mainacts
	mov	word ptr pagekeys,offset mainkeys
	mov	word ptr pagebuttons,offset mainbuttons
	ret

;-----------------------------------------------------------------------------
; Install the descriptors for the second page.
;-----------------------------------------------------------------------------
secondpage:
	mov	word ptr pagetitle,offset secondtitle
	mov	word ptr pageactions,offset pageacts
	mov	word ptr pagekeys,offset secondkeys
	mov	word ptr pagebuttons,offset secondbuttons
	ret

;-----------------------------------------------------------------------------
; Power-on command line: enter, cancel, or return to the main menu.
;-----------------------------------------------------------------------------
commandmenu:
	mov	si,offset cmdtitle
	mov	ax,offset cmdhelp
	call	showhelp
	call	showcommand
	mov	si,offset cmdbuttons
	call	showoptions
	mov	dh,0dh
	call	selectprompt
	mov	di,offset cmdkeys
	call	getchoice
	jmp	word ptr cmdactsoff[bx]

cmdacts	dw	newcommand,cancelcommand,mainpage

newcommand:
	mov	cx,0b01h
	call	clrwindow
	mov	si,offset cmdentryhelp
	mov	dx,0d05h
	call	putlines
	mov	dh,12h
	mov	si,offset msgnewcommand
	call	revcent
	mov	dx,141dh
	mov	cx,14h
	mov	di,offset bootcommand
	call	editcommand
	jmp	commandmenu

cancelcommand:
	mov	byte ptr bootcommand,00h
	jmp	commandmenu

;-----------------------------------------------------------------------------
; Display at most 20 bytes; embedded CR is shown as the vertical bar glyph.
;-----------------------------------------------------------------------------
showcommand:
	mov	si,offset msgcommand
	mov	dx,0a0eh
	call	putat
	call	reverseon
	mov	cx,14h
	mov	si,offset bootcommand
	cld
	lodsb
	test	al,al
	jnz	cmdshow
	mov	si,offset msgnone
	call	puts
	jmps	cmdshown

cmdshow:
	cmp	al,0dh
	jnz	cmdput
	mov	al,0b3h

cmdput:
	call	conout
	lodsb
	test	al,al
	loopne	cmdshow

cmdshown:
	jmp	reverseoff

;-----------------------------------------------------------------------------
; Edit at ES:DI, up to CX bytes, at position DX.  Ctrl-E inserts a CR;
; Return stores CR,NUL, Backspace removes a byte.  A full buffer is left
; unterminated, as in the shipped program; the display is length-limited.
;-----------------------------------------------------------------------------
editcommand:
	call	gotoxy
	mov	bx,cx

editfill:
	mov	al,5fh
	call	conout
	loop	editfill
	mov	cx,bx
	call	gotoxy
	mov	al,6dh
	call	escout

editkey:
	mov	al,20h
	call	conout
	mov	al,08h
	call	conout
	call	getraw
	and	al,7fh
	cmp	al,0dh
	jz	editdone
	cmp	al,05h
	jz	editcr
	cmp	al,08h
	jz	editback
	cmp	al,20h
	jc	editbeep
	stosb
	jmps	editecho

editbeep:
	mov	al,07h
	call	conout
	jmps	editkey

editcr:
	mov	al,0dh
	stosb
	mov	al,0b3h

editecho:
	call	conout
	loop	editkey
	jmps	editexit

editdone:
	stosb
	mov	al,00h
	stosb
	jmps	editexit

editback:
	cmp	cx,bx
	jz	editbeep
	inc	cx
	dec	di
	mov	al,5fh
	call	conout
	mov	al,08h
	call	conout
	mov	al,08h
	call	conout
	jmps	editkey

editexit:
	mov	al,6eh
	jmp	escout

;-----------------------------------------------------------------------------
; Toggle which live BIOS settings are copied into the configuration sector.
; The flags here are separate from the persistent validity flags in that sector.
;-----------------------------------------------------------------------------
savemenu:
	mov	si,offset savetitle
	mov	ax,offset savehelp
	call	showhelp
	mov	si,offset savebuttons
	call	showoptions

saveloop:
	call	showsaves
	mov	dh,0ah
	call	selectprompt
	mov	di,offset savekeylist
	call	getchoice
	jmp	word ptr saveactsoff[bx]

saveacts	dw	togglekeys,toggleio,toggleserial,mainpage

togglekeys:
	xor	byte ptr savekeys,0ffh
	jmp	saveloop

toggleio:
	xor	byte ptr saveio,0ffh
	jmp	saveloop

toggleserial:
	xor	byte ptr saveserial,0ffh
	jmp	saveloop

;-----------------------------------------------------------------------------
; Display function-key, I/O and serial save requests at rows 12, 15 and 18.
;-----------------------------------------------------------------------------
showsaves:
	mov	dx,0c0ch
	mov	cx,03h
	mov	bx,offset savekeys
	call	reverseon

saveshow:
	mov	si,offset msgsaved
	test	byte ptr [bx],0ffh
	jnz	saveput
	mov	si,offset msgblank

saveput:
	call	putat
	inc	bx
	add	dh,03h
	loop	saveshow
	jmp	reverseoff

;-----------------------------------------------------------------------------
; Memory disk starting segment.  Only the high byte is entered; low byte is zero.
;-----------------------------------------------------------------------------
memorymenu:
	mov	si,offset memtitle
	mov	ax,offset memhelp
	call	showhelp
	call	showmemory
	mov	si,offset membuttons
	call	showoptions
	mov	dh,0fh
	call	selectprompt
	mov	di,offset memkeys
	call	getchoice
	jmp	word ptr memactsoff[bx]

memacts	dw	newmemory,mainpage

;-----------------------------------------------------------------------------
; Accept 0000, 0800..9000 or C000..E000, in steps of 0100h.
;-----------------------------------------------------------------------------
newmemory:
	mov	cx,0f01h
	call	clrwindow
	mov	si,offset mementryhelp
	mov	dx,0f05h
	call	putlines
	mov	si,offset msgnewmemory
	mov	dh,13h
	call	revcent
	mov	si,offset inputcursor
	mov	dx,1526h
	call	putat
	call	gethex
	mov	cl,04h
	shl	al,cl
	mov	dh,al
	call	gethex
	or	dh,al
	mov	al,6eh
	call	escout
	mov	al,dh
	cmp	al,00h
	jz	storememory
	cmp	al,08h
	jc	badmemory
	cmp	al,90h
	jna	storememory
	cmp	al,0c0h
	jc	badmemory
	cmp	al,0e0h
	jna	storememory

badmemory:
	call	memoryerror
	jmp	memorymenu

storememory:
	mov	dl,00h
	mov	memsegment,dx
	jmp	memorymenu

showmemory:
	mov	si,offset msgmemory
	mov	dx,0c12h
	call	putat
	call	reverseon
	mov	dx,memsegment
	call	puthexbyte
	xchg	dh,dl
	call	puthexbyte
	mov	si,offset msgsegment
	call	puts
	jmp	reverseoff

;-----------------------------------------------------------------------------
; Print DH as two hex digits.  puthexdigit accepts its low nibble in AL.
;-----------------------------------------------------------------------------
puthexbyte:
	mov	al,dh
	mov	cl,04h
	shr	al,cl
	call	puthexdigit
	mov	al,dh
	and	al,0fh

puthexdigit:
	mov	bx,offset hexdigits
	xlat	bx
	jmp	conout

;-----------------------------------------------------------------------------
; Read and echo a hex digit; return its value in AL.  The original case fold
; subtracts 20h from every character at or above 60h before validation.
;-----------------------------------------------------------------------------
gethex:
	call	getraw
	cmp	al,60h
	jc	hexscan
	sub	al,20h

hexscan:
	mov	di,offset hexdigits
	mov	cx,10h
	cld
	repne	scasb
	jz	hexecho
	mov	al,07h
	call	conout
	jmps	gethex

hexecho:
	call	conout
	mov	al,20h
	call	conout
	mov	al,08h
	call	conout
	mov	al,0fh
	sub	al,cl
	ret

;-----------------------------------------------------------------------------
; Highlight the error, beep three times and wait for acknowledgement.
;-----------------------------------------------------------------------------
memoryerror:
	mov	al,70h
	call	escout
	mov	si,offset msgbadmemory
	mov	dh,15h
	call	putcent
	mov	al,71h
	call	escout
	mov	cx,03h

errorbeep:
	mov	al,07h
	call	conout
	loop	errorbeep
	mov	si,offset msganykey
	mov	dh,13h
	call	revcent
	jmp	getraw

;-----------------------------------------------------------------------------
; Enable or disable BIOS verification after disk writes.
;-----------------------------------------------------------------------------
verifymenu:
	mov	si,offset verifytitle
	mov	ax,offset verifyhelp
	call	showhelp
	mov	si,offset verifybuttons
	call	showoptions
	mov	dh,0dh
	call	selectprompt

verifyloop:
	call	showverify
	mov	di,offset verifykeys
	call	getchoice
	jmp	word ptr verifyactsoff[bx]

verifyacts	dw	verifyon,verifyoff,secondpage

verifyon:
	mov	byte ptr verifyflag,0ffh
	jmps	verifyloop

verifyoff:
	mov	byte ptr verifyflag,00h
	jmps	verifyloop

showverify:
	mov	si,offset msgverify
	mov	dx,0b11h
	call	putat
	call	reverseon
	mov	si,offset msgenabled
	test	byte ptr verifyflag,0ffh
	jnz	verifyput
	mov	si,offset msgdisabled

verifyput:
	call	puts
	jmp	reverseoff

;-----------------------------------------------------------------------------
; Head step time is the high nibble of the diskette parameter byte.
; Increasing that nibble shortens the delay; carry prevents wrapping.
;-----------------------------------------------------------------------------
stepmenu:
	mov	si,offset steptitle
	mov	ax,offset stephelp
	call	showhelp
	mov	si,offset stepbuttons
	call	showoptions
	mov	dh,0dh
	call	selectprompt

steploop:
	call	showstep
	mov	di,offset stepkeys
	call	getchoice
	jmp	word ptr stepactsoff[bx]

stepacts	dw	stepfaster,stepslower,mainpage

stepfaster:
	mov	al,steprate
	add	al,10h
	jmps	storestep

stepslower:
	mov	al,steprate
	sub	al,10h

storestep:
	jc	stepbeep
	mov	steprate,al
	jmps	steploop

stepbeep:
	mov	al,07h
	call	conout
	jmps	steploop

;-----------------------------------------------------------------------------
; Display 2 * (16 - high nibble), in milliseconds.  AAM splits decimal digits.
;-----------------------------------------------------------------------------
showstep:
	mov	si,offset msgstep
	mov	dx,0b12h
	call	putat
	call	reverseon
	mov	al,steprate
	mov	cl,04h
	shr	al,cl
	or	al,0f0h
	neg	al
	shl	al,1
	aam
	test	ah,ah
	jz	stepunits
	push	ax
	mov	al,ah
	or	al,30h
	call	conout
	pop	ax

stepunits:
	or	al,30h
	call	conout
	mov	si,offset msgmsec
	call	puts
	jmp	reverseoff

;-----------------------------------------------------------------------------
; Enable the four-tone status melodies or replace them with the simple beep.
;-----------------------------------------------------------------------------
soundmenu:
	mov	si,offset soundtitle
	mov	ax,offset soundhelp
	call	showhelp
	mov	si,offset soundbuttons
	call	showoptions
	mov	dh,0dh
	call	selectprompt

soundloop:
	call	showsound
	mov	di,offset soundkeys
	call	getchoice
	jmp	word ptr soundactsoff[bx]

soundacts	dw	soundon,soundoff,secondpage

soundon:
	mov	byte ptr soundflag,0ffh
	jmps	soundloop

soundoff:
	mov	byte ptr soundflag,00h
	jmps	soundloop

showsound:
	mov	si,offset msgsound
	mov	dx,0b10h
	call	putat
	call	reverseon
	mov	si,offset msgenabled
	test	byte ptr soundflag,0ffh
	jnz	soundput
	mov	si,offset msgdisabled

soundput:
	call	puts
	jmp	reverseoff

;-----------------------------------------------------------------------------
; Reserve 00..99 kilobytes for Field Installable Device Driver Software.
;-----------------------------------------------------------------------------
fiddsmenu:
	mov	si,offset fiddstitle
	mov	ax,offset fiddshelp
	call	showhelp
	call	showfidds
	mov	si,offset fiddsbuttons
	call	showoptions
	mov	dh,0fh
	call	selectprompt
	mov	di,offset fiddskeys
	call	getchoice
	jmp	word ptr fiddsactsoff[bx]

fiddsacts	dw	newfidds,mainpage

newfidds:
	mov	cx,0f01h
	call	clrwindow
	mov	si,offset fiddsentryhelp
	mov	dx,0f05h
	call	putlines
	mov	si,offset msgnewfidds
	mov	dh,13h
	call	revcent
	mov	si,offset inputcursor
	mov	dx,1526h
	call	putat
	call	getdecimal
	mov	cl,0ah
	mul	cl
	mov	cx,ax
	call	getdecimal
	mov	ah,00h
	add	ax,cx
	mov	fiddsmem,ax
	mov	al,6eh
	call	escout
	jmp	fiddsmenu

showfidds:
	mov	si,offset msgfidds
	mov	dx,0c13h
	call	putat
	call	reverseon
	mov	ax,fiddsmem
	aam
	test	ah,ah
	jz	fiddsunits
	call	puttens

fiddsunits:
	xchg	ah,al
	call	puttens
	mov	si,offset msgkb
	call	puts
	jmp	reverseoff

;-----------------------------------------------------------------------------
; Print the decimal digit in AH, preserving AX.
;-----------------------------------------------------------------------------
puttens:
	push	ax
	mov	al,ah
	or	al,30h
	call	conout
	pop	ax
	ret

;-----------------------------------------------------------------------------
; Read a decimal digit, echo it and return 0..9 in AL.
;-----------------------------------------------------------------------------
getdecimal:
	call	getraw
	cmp	al,30h
	jc	decimalbeep
	cmp	al,39h
	ja	decimalbeep
	push	ax
	call	conout
	mov	al,20h
	call	conout
	mov	al,08h
	call	conout
	pop	ax
	sub	al,30h
	ret

decimalbeep:
	mov	al,07h
	call	conout
	jmps	getdecimal

;-----------------------------------------------------------------------------
; Select the disk holding the persistent configuration sector.  Hard disk
; choice is exposed only after finding a type DBh partition in the MBR.
;-----------------------------------------------------------------------------
diskmenu:
	mov	si,offset disktitle
	mov	ax,offset diskhelp
	call	showhelp
	mov	si,offset diskbuttons
	call	showoptions
	mov	dh,0dh
	call	selectprompt

diskloop:
	call	showdisk
	mov	di,offset diskkeys
	call	getchoice
	jmp	word ptr diskactsoff[bx]

diskacts	dw	usefloppy,secondpage,usehard

usefloppy:
	mov	byte ptr diskdrive,00h
	mov	word ptr diskchs,02h
	mov	si,offset msgfloppy
	call	diskcaption
	jmps	diskloop

usehard:
	mov	byte ptr diskdrive,80h
	mov	ax,hardchs
	mov	diskchs,ax
	mov	si,offset msghard
	call	diskcaption
	jmps	diskloop

;-----------------------------------------------------------------------------
; Copy the 11-character disk name into the shared update-and-exit caption.
;-----------------------------------------------------------------------------
diskcaption:
	push	ds
	pop	es
	mov	di,offset updatedisk
	mov	cx,0bh
	cld
	rep	movsb
	ret

showdisk:
	mov	si,offset msgdisk
	mov	dx,0b12h
	call	putat
	call	reverseon
	mov	si,offset msgfloppy
	cmp	byte ptr diskdrive,00h
	jz	diskput
	mov	si,offset msghard

diskput:
	call	puts
	jmp	reverseoff

;-----------------------------------------------------------------------------
; Merge requested live settings, write the configuration sector, then exit.
; Hard disk uses BIOS INT 13h directly.  Floppy uses BDOS 50 to write four
; 128-byte records through the XIOS.  Original code does not check write errors.
;-----------------------------------------------------------------------------
update:
	call	savesettings
	mov	al,diskdrive
	test	al,80h
	jz	writefloppy
	call	diskparams
	mov	bx,offset cfgsector
	mov	ah,03h
	int	i_disk
	jmp	exitprog

;-----------------------------------------------------------------------------
; Select A:, set the DMA segment, and select track zero.  XIOS sectors 4..7
; cover physical sector 2; the last write uses deblocking flag 1.
;-----------------------------------------------------------------------------
writefloppy:
	mov	cl,f_seldisk
	mov	dl,al
	int	i_bdos
	mov	cl,f_dmaseg
	mov	dx,ds
	int	i_bdos
	mov	cl,f_bios
	mov	dx,offset seltrack
	int	i_bdos
	mov	word ptr dmaaddr,offset cfgsector
	mov	word ptr sectorarg,04h
	mov	word ptr writearg,00h
	mov	cx,04h

writerecord:
	push	cx
	mov	cl,f_dma
	mov	dx,dmaaddr
	int	i_bdos
	mov	cl,f_bios
	mov	dx,offset selsector
	int	i_bdos
	cmp	word ptr sectorarg,07h
	jnz	writedata
	mov	word ptr writearg,01h

writedata:
	mov	cl,f_bios
	mov	dx,offset bioswrite
	int	i_bdos
	add	word ptr dmaaddr,80h
	inc	word ptr sectorarg
	pop	cx
	loop	writerecord

;-----------------------------------------------------------------------------
; Restore the console and warm boot through BDOS.
;-----------------------------------------------------------------------------
exitprog:
	mov	si,offset scroff
	call	puts
	mov	cl,f_reset
	mov	dl,00h
	int	i_bdos

;-----------------------------------------------------------------------------
; Copy serial parameters (2 bytes), I/O assignments (10 bytes), and both
; function-key sets (400 bytes) from the current BIOS when requested.
;-----------------------------------------------------------------------------
savesettings:
	mov	di,offset serialdata
	mov	si,offset cfgserial
	mov	cx,02h
	mov	bx,serialptr
	mov	al,saveserial
	call	copysetting
	mov	di,offset iodata
	mov	si,offset cfgio
	mov	cx,0ah
	mov	bx,iovecptr
	mov	al,saveio
	call	copysetting
	mov	di,offset keydata
	mov	si,offset cfgkeys
	mov	cx,0190h
	mov	bx,keytblptr
	mov	al,savekeys

;-----------------------------------------------------------------------------
; AL is the request flag, DS:SI the saved validity byte, DI the destination,
; CX the byte count, BX the XIOS pointer slot.  Zero leaves saved data intact;
; a request sets the validity flag and copies from the system data segment.
;-----------------------------------------------------------------------------
copysetting:
	test	al,al
	jz	copyret
	mov	[si],al
	push	ds
	pop	es
	push	es
	mov	ds,word ptr xiossg
	mov	si,[bx]
	cld
	rep	movsb
	pop	ds

copyret:
	ret

;-----------------------------------------------------------------------------
; Draw the current page, common exit buttons, reset notice and prompt.
;-----------------------------------------------------------------------------
showpage:
	mov	si,pagetitle
	mov	dh,03h
	call	putcent
	mov	si,pagebuttons
	call	drawbuttons
	mov	si,offset exitbuttons
	call	drawbuttons
	mov	si,offset msgreset
	mov	dx,1605h
	call	putat
	mov	si,offset msgselect
	mov	dh,05h
	jmp	revcent

;-----------------------------------------------------------------------------
; Frame: three horizontal rules, two sides, six individual corners and title.
;-----------------------------------------------------------------------------
drawframe:
	mov	si,offset scron
	call	puts
	mov	cx,4eh
	mov	dx,01h
	mov	bl,0c4h
	call	hline
	mov	dx,0201h
	mov	bl,0cdh
	call	hline
	mov	dx,1701h
	mov	bl,0c4h
	call	hline
	mov	cx,16h
	mov	dx,0100h
	mov	bl,0b3h
	call	vline
	mov	dx,014fh
	mov	bl,0b3h
	call	vline
	mov	si,offset corners
	mov	cx,06h

cornloop:
	mov	al,59h
	call	escout
	lodsb
	add	al,20h
	call	conout
	lodsb
	add	al,20h
	call	conout
	lodsb
	call	conout
	loop	cornloop
	mov	si,offset banner
	mov	dh,01h
	jmp	putcent

;-----------------------------------------------------------------------------
; Draw BL across CX columns at DX, preserving CX.
;-----------------------------------------------------------------------------
hline:
	push	cx
	call	gotoxy

hlloop:
	mov	al,bl
	call	conout
	loop	hlloop
	pop	cx
	ret

;-----------------------------------------------------------------------------
; Draw BL down CX rows at DX, preserving CX and DX.
;-----------------------------------------------------------------------------
vline:
	push	cx
	push	dx

vlloop:
	call	gotoxy
	mov	al,bl
	call	conout
	inc	dh
	loop	vlloop
	pop	dx
	pop	cx
	ret

;-----------------------------------------------------------------------------
; Read hard disk 80h MBR into the shared 512-byte buffer.  A valid AA55h
; signature permits scanning four entries for the first CP/M type DBh.
; Derive the configuration sector from its start CHS, replacing the sector
; bits with 3 while preserving the cylinder high bits.  The head stays zero.
; Then try floppy sector 2 first, hard disk configuration sector second; a
; DDB2h signature accepts the sector, otherwise compiled defaults survive.
;-----------------------------------------------------------------------------
loadsettings:
	push	ds
	pop	es
	mov	dx,80h
	mov	cx,01h
	mov	bx,offset sectorbuf
	mov	ax,0201h
	int	i_disk
	jc	readfloppy
	cmp	word ptr bootsig,0aa55h
	jnz	readfloppy
	mov	cx,04h
	mov	si,offset partitions

partscan:
	cmp	byte ptr 04h[si],0dbh
	jz	foundpart
	add	si,10h
	loop	partscan
	jmps	readfloppy

foundpart:
	mov	ax,02h[si]
	and	al,0c0h
	or	al,03h
	mov	hardchs,ax
	mov	byte ptr diskkeys,03h
	mov	byte ptr diskbuttons,02h

readfloppy:
	mov	dx,00h
	mov	cx,02h
	mov	bx,offset sectorbuf
	mov	ax,0201h
	int	i_disk
	jc	readhard
	cmp	word ptr sectorbuf,0ddb2h
	jz	copysector

readhard:
	mov	dl,80h
	mov	cx,hardchs
	mov	ax,0201h
	int	i_disk
	jc	loadret
	cmp	word ptr sectorbuf,0ddb2h
	jnz	loadret
	mov	diskdrive,dl
	mov	diskchs,cx
	mov	si,offset msghard
	call	diskcaption

copysector:
	mov	si,offset sectorbuf
	mov	di,offset cfgsector
	mov	cx,0100h
	cld
	rep	movsw

loadret:
	ret

;-----------------------------------------------------------------------------
; Prepare ES:BX externally; return DX=drive/head, CX=CHS and AL=one sector.
; Retained helper for the direct BIOS write path.
;-----------------------------------------------------------------------------
diskparams:
	push	ds
	pop	es
	mov	dx,word ptr diskdrive
	mov	cx,diskchs
	mov	al,01h
	ret

;-----------------------------------------------------------------------------
; Draw this option's buttons and the shared return-to-page button and caption.
;-----------------------------------------------------------------------------
showoptions:
	call	drawbuttons
	mov	si,offset backbutton
	call	drawbuttons
	mov	si,pagetitle
	jmp	puts

;-----------------------------------------------------------------------------
; SI addresses a count byte then records: row, column, two key-caption bytes,
; NUL-terminated text.  Draw the key box and text for each record.
;-----------------------------------------------------------------------------
drawbuttons:
	lodsb
	cbw
	xchg	ax,cx

buttonloop:
	lodsw
	xchg	al,ah
	mov	dx,ax
	lodsw
	mov	bx,ax
	push	si
	mov	si,offset buttonbox
	call	putat
	mov	al,bl
	call	conout
	mov	al,bh
	call	conout
	mov	si,offset buttonend
	call	puts
	pop	si
	call	puts
	loop	buttonloop
	ret

;-----------------------------------------------------------------------------
; SI is the option title; AX points to help lines.  Clear the body, centre
; the title on row 4, then print NUL-terminated lines from row 6, column 5.
; An extra NUL ends the line list.
;-----------------------------------------------------------------------------
showhelp:
	push	ax
	call	clrbody
	mov	dh,04h
	call	putcent
	pop	si
	mov	dx,0605h

putlines:
	call	putat
	inc	dh
	test	byte ptr [si],0ffh
	jnz	putlines
	ret

;-----------------------------------------------------------------------------
; Centre the shared function-selection prompt in reverse video on row DH.
;-----------------------------------------------------------------------------
selectprompt:
	mov	si,offset msgfunction

revcent:
	call	reverseon
	call	putcent
	jmp	reverseoff

;-----------------------------------------------------------------------------
; Centre the NUL-terminated string at SI on row DH, then print it.
; ES is set to DS for the length scan.
;-----------------------------------------------------------------------------
putcent:
	push	ds
	pop	es
	mov	di,si
	mov	al,00h
	mov	cx,50h
	repne	scasb
	shr	cx,1
	mov	dl,cl

putat:
	call	gotoxy

puts:
	lodsb

putsloop:
	call	conout
	lodsb
	test	al,al
	jnz	putsloop
	ret

;-----------------------------------------------------------------------------
; VT52 ESC Y: output row DH and column DL, each biased by 20h.
;-----------------------------------------------------------------------------
gotoxy:
	mov	al,59h
	call	escout
	mov	al,dh
	add	al,20h
	call	conout
	mov	al,dl
	add	al,20h
	jmp	conout

;-----------------------------------------------------------------------------
; DI points to count, then accepted function-key numbers (scan code minus
; 3Ah).  Reject other keys with a beep.  Return BX = 2 * matched index.
;-----------------------------------------------------------------------------
getchoice:
	mov	cl,[di]
	mov	ch,00h
	inc	di

choicekey:
	push	cx
	push	di
	push	ds
	pop	es
	mov	bx,cx
	call	getraw
	mov	al,ah
	sub	al,3ah
	repne	scasb
	mov	dx,cx
	pop	di
	pop	cx
	jz	choicefound
	mov	al,07h
	call	conout
	jmps	choicekey

choicefound:
	sub	bx,dx
	dec	bx
	add	bx,bx
	mov	ah,00h
	ret

;-----------------------------------------------------------------------------
; Discard pending BDOS console input.
;-----------------------------------------------------------------------------
flushkb:
	mov	cl,f_constat
	int	i_bdos
	test	al,al
	jz	flushret
	mov	cl,f_conin
	int	i_bdos
	jmps	flushkb

flushret:
	ret

;-----------------------------------------------------------------------------
; Clear rows 3..22 inside the frame.  clrwindow takes its top left in CX.
;-----------------------------------------------------------------------------
clrbody:
	mov	cx,0301h

clrwindow:
	mov	dx,164eh
	mov	bx,07h
	mov	ax,0700h
	int	i_video
	ret

;-----------------------------------------------------------------------------
; VT52 ESC r / ESC u toggle reverse video.
;-----------------------------------------------------------------------------
reverseon:
	mov	al,72h
	jmps	escout

reverseoff:
	mov	al,75h

;-----------------------------------------------------------------------------
; Send ESC followed by AL; falls through to conout.
;-----------------------------------------------------------------------------
escout:
	push	ax
	mov	al,1bh
	call	conout
	pop	ax

;-----------------------------------------------------------------------------
; Raw BDOS console output.  Preserve the registers used by string/table
; loops and restore forward string direction after the BDOS call.
;-----------------------------------------------------------------------------
conout:
	push	bx
	push	cx
	push	dx
	push	si
	push	di
	push	es
	mov	dl,al
	mov	cl,f_conout
	int	i_bdos
	cld
	pop	es
	pop	di
	pop	si
	pop	dx
	pop	cx
	pop	bx
	ret

;-----------------------------------------------------------------------------
; Unreachable BIOS keyboard-status helper retained in the shipped image.
;-----------------------------------------------------------------------------
keystatus:
	mov	ah,01h
	int	i_keyb
	ret

;-----------------------------------------------------------------------------
; Wait for a BIOS key: AL is the character and AH is the scan code.
;-----------------------------------------------------------------------------
getraw:
	mov	ah,00h
	int	i_keyb
	ret


; ---- data ----
; LINK86 aligns DSEG on a word boundary.  The signature starts at odd
; address 093Bh, so its low byte must remain at the end of CSEG.
; Persistent configuration sector, exactly 512 bytes (093Bh..0B3Ah).
; Layout matches pcbios.a86 LOAD_CFGSEC / APPLY_CFG.  Reserved areas are
; stored bytes, not uninitialised space, so defaults reproduce the original.
cfgsector	db	0b2h
	dseg
	db	0ddh
memsegment	dw	0d000h		; memory disk starts at segment D000h
verifyflag	db	00h		; verify after write disabled
steprate	db	0cfh		; high nibble C = 8 msec step time
cfgreserved	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h

; Startup command: 32 bytes reserved, editor/display limit 20 bytes.
bootcommand	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h

; FIDDS reservation in KiB, followed by 14 reserved bytes.
fiddsmem	dw	00h
fiddsreserve	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h

; FFh enables musical status messages; 31 reserved bytes follow.
soundflag	db	0ffh
soundreserve	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h

; Persistent validity flags: serial, character I/O, key definitions; then spare.
cfgserial	db	00h
cfgio	db	00h
cfgkeys	db	00h
cfgspare	db	00h

; Saved serial parameters, five I/O assignment words and 400 key bytes.
serialdata	dw	00h
iodata	dw	0,0,0,0,0
keydata	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h

; Runtime state, outside the saved sector.  Save requests start clear.
; Drive/head is also read as a word for BIOS INT 13h (DL/DH).
xiossg	dw	00h
savekeys	db	00h
saveio	db	00h
saveserial	db	00h
diskdrive	db	00h
diskhead	db	00h
diskchs	dw	02h		; CH=0, CL=2: floppy configuration sector
hardchs	dw	00h
dmaaddr	dw	00h

; BDOS 50 parameter blocks: function byte, CX word, DX word.
; SETTRK=10, SETSEC=11, WRITE=14.  The code changes their arguments in place.
seltrack	db	0ah
	dw	00h
	dw	00h
selsector	db	0bh
sectorarg	dw	04h		; CX: 128-byte record number
	dw	00h
bioswrite	db	0eh
writearg	dw	00h		; CX: write/deblocking type
	dw	00h

; VT52 console setup and restore sequences.
scron	db	1bh,45h,1bh,77h,1bh,6eh,1bh,71h,1bh,74h,1bh,75h
	db	00h
scroff	db	1bh,45h,1bh,76h,1bh,6dh,00h

; Frame corners: six row, column, glyph triples.
corners	db	00h,00h,0dah
	db	00h,4fh,0bfh
	db	02h,00h,0c6h
	db	02h,4fh,0b5h
	db	17h,00h,0c0h
	db	17h,4fh,0d9h
banner	db	'CP/M-86 BIOS Customization Program for t'
	db	'he IBM PC and XT   version 1.2',00h

; Function-key button outline, with relative cursor motion and reverse video.
buttonbox	db	0dah,0c4h,0c4h,0c4h,0c4h,0bfh,0ah,08h,0b3h,08h
	db	08h,08h,08h,08h,08h,0b3h,0ah,08h,0c0h,0c4h,0c4h
	db	0c4h,0c4h,0d9h,1bh,41h,08h,08h,08h,08h,1bh
	db	72h,46h,00h
buttonend	db	1bh,75h,1bh,43h,20h,20h,00h

; Current page descriptors: title, key list, action table and button list.
pagetitle	dw	maintitle
pagekeys	dw	mainkeys
pageactions	dw	mainacts
pagebuttons	dw	mainbuttons
maintitle	db	'Main Menu',00h
secondtitle	db	'Second Page',00h
msgselect	db	' SELECT BIOS CUSTOMIZATION OPTION',00h

; Key lists: count, then BIOS scan codes minus 3Ah (F1=1, F9=9, F10=10).
mainkeys	db	08h,01h,02h,03h,04h,05h,06h,09h,0ah
secondkeys	db	06h,01h,02h,03h,04h,09h,0ah

; Button lists: count, then row, column, two key-caption bytes, text, NUL.
; Captions are also reused as option titles.  Help blocks are NUL-terminated
; lines followed by an additional NUL; all coordinates are zero-based.
mainbuttons	db	06h,07h,04h,'1 '
cmdtitle	db	'Power-On Command Line',00h
	db	07h,2ch,'2 '
savetitle	db	'Save BIOS Parameters',00h
	db	0ah,04h,'3 '
memtitle	db	'Memory Disk',00h
	db	0ah,2ch,'4 '
steptitle	db	'Disk Head Step Time',00h
	db	0dh,04h,'5 '
	db	'Field Inst. Device Driver',00h
	db	0dh,2ch,'6 '
	db	'Second Page of Options',00h
secondbuttons	db	04h,07h,04h,'1 '
verifytitle	db	'Verify After Disk Write',00h
	db	07h,2ch,'2 '
soundtitle	db	'Musical Error Messages',00h
	db	0ah,04h,'3 '
disktitle	db	'Select Storage Disk',00h
	db	0ah,2ch,'4 '
	db	'Return to Main Menu',00h
exitbuttons	db	02h,12h,04h,'9 '
	db	'Update '

; First 11 bytes are replaced when the storage disk selection changes.
updatedisk	db	'Floppy Disk and Exit',00h
	db	12h,2ch,'10'
	db	'Exit without Updating',00h
msgreset	db	'All modified options will take effect at the next Power-On or Reset.',00h
msgfunction	db	'SELECT FUNCTION',00h
backbutton	db	01h,14h,14h,'9 '
	db	'Return to ',00h
cmdhelp	db	'      This option allows a single Command Line of up to 20 characters',00h
	db	'to be executed at Power-On, or following a System Reset.   The ',27h,0b3h,27h,' is',00h
	db	'used to show a Carriage Return (0DH).',00h
	db	00h
msgcommand	db	'The current Command Line is:  ',00h
cmdbuttons	db	02h,0eh,14h,'1 '
	db	'Enter a New Command Line',00h
	db	11h,14h,'3 '
	db	'Cancel the Current Command Line',00h
cmdkeys	db	03h,01h,03h,09h
msgnone	db	'  < none >',00h
cmdentryhelp	db	'      Terminate the new Command Line with a Carriage Return.   To put',00h
	db	'a Carriage Return within the command, type a Control-E.  To erase one',00h
	db	'character, type a Back Space (',11h,'--).',00h
	db	00h
msgnewcommand	db	'ENTER A NEW COMMAND LINE',00h
savehelp	db	'      This option allows the current state of certain BIOS parameters',00h
	db	'to be saved, and reinstated at the next Power-On or System Reset.  To',00h
	db	'cancel the Save command, retype the appropriate function key.',00h
	db	00h
savebuttons	db	03h,0bh,14h,'1 '
	db	'Save Programmable Function Keys',00h
	db	0eh,14h,'3 '
	db	'Save Character I/O Assignments',00h
	db	11h,14h,'5 '
	db	'Save Serial Port Configurations',00h
msgsaved	db	'Saved',00h
msgblank	db	'     ',00h
savekeylist	db	04h,01h,03h,05h,09h
memhelp	db	'      This option reserves a portion of memory to be used as a Logical',00h
	db	'Disk Drive, referred to as M:.  The user selects the starting address,',00h
	db	'and the BIOS allocates all of the contiguous memory above that address',00h
	db	'to Memory Disk.   If no memory is found at the starting address, or if',00h
	db	'the starting address is zero, then no Memory Disk will be created.',00h
	db	00h
msgmemory	db	'The current Starting Address is:  ',00h
msgsegment	db	':0000',00h

; Hex conversion alphabet, immediately followed by the memory option buttons.
hexdigits	db	'0123456789ABCDEF'
membuttons	db	01h,11h,14h,'1 '
	db	'Enter a new Starting Address',00h
memkeys	db	02h,01h,09h
mementryhelp	db	'      Type the two most significant hexadecimal digits (0-9 or A-F) of',00h
	db	'the Starting Address segment.  The address must be within the range of',00h
	db	'0800-9000 or C000-E000, or equal to 0000.',00h
	db	00h
msgnewmemory	db	'ENTER STARTING ADDRESS',00h
inputcursor	db	' _',08h,08h,1bh,'m',00h
msgbadmemory	db	' Invalid Starting Address ',00h
msganykey	db	'TYPE ANY KEY TO CONTINUE',00h
verifyhelp	db	'      This option controls the Verify After Write feature of the BIOS',00h
	db	'Disk Drive software.   When enabled, the Disk is verified after every',00h
	db	'write operation, with automatic retries for verification errors.  The',00h
	db	'Verify feature results in greater data security at the cost of speed.',00h
	db	00h
verifybuttons	db	02h,0eh,14h,'1 '
	db	'Enable Verify After Write',00h
	db	11h,14h,'3 '
	db	'Disable Verify After Write',00h
msgverify	db	'The Verify After Write feature is:  ',00h
msgenabled	db	'Enabled ',00h
msgdisabled	db	'Disabled',00h
verifykeys	db	03h,01h,03h,09h
stephelp	db	'      This option sets a Head Step Time of 2 to 32 mSec for the Floppy',00h
	db	'Disk Controller.  The smaller the time, the faster the Disk Head moves',00h
	db	'from track to track.   The default time is set to 8 mSec, but times of',00h
	db	'6 mSec or 4 mSec work with some Disk Drives.  Caution is advised.',00h
	db	00h
stepbuttons	db	02h,0eh,14h,'1 '
	db	'Decrease Head Step Time',00h
	db	11h,14h,'3 '
	db	'Increase Head Step Time',00h
msgstep	db	'The current Disk Head Step Time is:  ',00h
msgmsec	db	' mSec ',00h
stepkeys	db	03h,01h,03h,09h
soundhelp	db	'      This option controls the Musical Messages which come with status',00h
	db	'line errors.   When enabled, all status line errors are accompanied by',00h
	db	'a distinctive four toned melody.  If disabled, this melody is replaced',00h
	db	'by a simple beep.',00h
	db	00h
soundbuttons	db	02h,0eh,14h,'1 '
	db	'Enable the Musical Error Messages',00h
	db	11h,14h,'3 '
	db	'Disable the Musical Error Messages',00h
soundkeys	db	03h,01h,03h,09h
msgsound	db	'Musical Error Messages are currently:  ',00h
fiddstitle	db	'Field Installable Device Driver',00h
fiddshelp	db	'      This option reserves a block of memory at the top of the BIOS to',00h
	db	'be used by Field Installable Device Driver Software (FIDDS).   The use',00h
	db	'of this feature requires a separate FIDDS program capable of attaching',00h
	db	'itself to the BIOS.  For further information, refer to the application',00h
	db	'note:  "CP/M-86 FIDDS for the IBM PC".',00h
	db	00h
msgfidds	db	'Current FIDDS Memory Allocation is:  ',00h
msgkb	db	' Kb ',00h
fiddsbuttons	db	01h,11h,14h,'1 '
	db	'Change the FIDDS Memory Allocation',00h
fiddskeys	db	02h,01h,09h
fiddsentryhelp	db	'      Type a two digit decimal number equal to the number of kilobytes',00h
	db	'you want to reserve for FIDDS.  To enter a number less than 10, type a',00h
	db	'leading zero.  To disable the FIDDS feature, type 00.',00h
	db	00h
msgnewfidds	db	'ENTER FIDDS MEMORY SIZE',00h
diskhelp	db	'      This option controls which disk is used to store the information',00h
	db	'which is created by the SETUP program.  Selecting the Floppy Disk will',00h
	db	'send this information to drive A:.   Selecting the Hard Disk will send',00h
	db	'it to the Hard Disk with the lowest drive letter (usually B:).',00h
	db	00h

; Only the floppy button is initially drawn; finding a CP/M partition changes
; the count to two.  diskkeys similarly changes from two to three choices.
diskbuttons	db	01h,0eh,14h,'1 '
	db	'Store SETUP data on Floppy Disk',00h
	db	11h,14h,'3 '
	db	'Store SETUP data on Hard Disk',00h
msgdisk	db	'The current Storage Disk is the:  ',00h
msgfloppy	db	'Floppy Disk',00h
msghard	db	' Hard Disk ',00h
diskkeys	db	02h,01h,09h,03h

; Shared disk buffer: 512 bytes.  First holds the hard disk MBR, then a
; candidate configuration sector.  These sublabels describe the MBR view.
sectorbuf	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
	db	00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h,00h
