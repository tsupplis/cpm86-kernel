; ----------------------------------------------------------------------
; Install a far hook in the BDOS BIOS gateway at 2200h:2202h, preserving the
; original pointer. Restore it when the resident spooler is removed.
; ----------------------------------------------------------------------
install_bios_hook:
	mov	cl,f_system_data
	call	bdos_call
	mov	ax,es:word ptr .bdos_bios_offset
	mov	cs:word ptr saved_bios_offset,ax
	mov	ax,es:word ptr .bdos_bios_segment
	mov	cs:word ptr saved_bios_segment,ax
	pushf
	cli
	mov	es:word ptr .bdos_bios_segment,cs
	mov	ax,offset bios_hook
	mov	es:word ptr .bdos_bios_offset,ax
	popf
	ret
restore_bios_hook:
	pushf
	cli
	mov	cl,f_system_data
	call	protected_bdos_call
	mov	ax,cs:word ptr saved_bios_offset
	mov	es:word ptr .bdos_bios_offset,ax
	mov	ax,cs:word ptr saved_bios_segment
	mov	es:word ptr .bdos_bios_segment,ax
	popf
	ret

; ----------------------------------------------------------------------
