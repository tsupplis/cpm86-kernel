; ----------------------------------------------------------------------
; Find the active resident through its INT E2h vector and the fixed
; resident_data_segment slot in that copy of CODE.
; ----------------------------------------------------------------------
locate_resident:
	push	es
	mov	ax,0h
	mov	es,ax
	mov	ax,es:word ptr .int_e2_segment
	mov	word ptr active_code_segment,ax
	mov	es,ax
	mov	ax,es:word ptr .resident_ds_slot
	mov	word ptr active_data_segment,ax
	pop	es
	ret

