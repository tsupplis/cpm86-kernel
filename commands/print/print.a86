
; ----------------------------------------------------------------------
; PRINT V1.1 - CP/M-86 V1.1 resident printer/spooler.
; Copyright (C) 1980 Digital Research.
;
; Reconstructed from ../../base/print.cmd. printorg.a86 is the frozen
; invariant; print.a86 is the maintained source. Both initially reproduce
; the entire original CMD, including its 16-byte record padding.
;
; Command line (shipped explicit-file mode):
;
;   PRINT [d:]filename[.ext] [[d:]filename[.ext] ...]
;   PRINT OFF
;
; Separate filenames with spaces. Each name uses CP/M 8.3 syntax; an
; omitted drive uses the current drive. Wildcards (* and ?) are rejected
; by the file-opening path. Use explicit extensions; none is supplied.
; Files print in queue order, with a form feed before each new file.
; A later PRINT invocation appends names to the resident queue, provided
; it belongs to the same CP/M user and has sufficient command-tail space.
; OFF requests shutdown of an existing resident spooler.
;
; Examples:
;   A>PRINT REPORT.TXT B:NOTES.LST
;   A>PRINT MORE.TXT
;   A>PRINT OFF
;
; Directory-spool mode and scheduling options are CODE configuration
; bytes, not command-line switches. The shipped directory mode is off.
;
; Build from this directory (host tools):
;   cpm86_asm86 print.a86
;   cpm86_gencmd print.h86
; Or, from the repository root:
;   make -C commands/print check
; Native CP/M equivalents: ASM86 PRINT, then GENCMD PRINT.
; GENCMD uses its default separate CODE/DATA layout; no switches required.
;
; The program queues command-tail filenames, expands printer tabs, hooks
; INT E2h/E3h and optionally the BDOS BIOS gateway, then stays resident.
; Later invocations append names or request OFF. Optional directory mode
; searches for configured spool files and deletes completed output files.
;
; This is the CP/M-86-specific binary, not a Concurrent CP/M port. It checks
; BDOS version 0022h and accesses fixed kernel offsets. Unknown kernel fields
; are named by address rather than assigned speculative meanings.
;
; CODE and DATA are separate, each with origin zero. Executable bytes use
; mnemonics; configuration, saved state, patch space and padding use DB/DW.
; make check verifies every byte and therefore every original displacement.
; ----------------------------------------------------------------------

int_e2_offset	equ	388h
int_e2_segment	equ	38ah
int_e3_offset	equ	38ch
int_e3_segment	equ	38eh
bdos_bios_offset	equ	2200h
bdos_bios_segment	equ	2202h
bdos_byte_2310	equ	2310h
bdos_byte_2313	equ	2313h
bdos_word_2321	equ	2321h
bdos_byte_2327	equ	2327h
bdos_byte_2393	equ	2393h
bdos_abort_mode	equ	24afh
resident_ds_slot	equ	0bb1h
resident_lock_slot	equ	0bc5h
bios_console_status	equ	2506h
bios_console_input	equ	2509h
f_reset	equ	0h
f_console_output	equ	2h
f_list_output	equ	5h
f_print_string	equ	9h
f_version	equ	0ch
f_select_disk	equ	0eh
f_open	equ	0fh
f_search_first	equ	11h
f_delete	equ	13h
f_read_sequential	equ	14h
f_current_disk	equ	19h
f_dma_offset	equ	1ah
f_user	equ	20h
f_system_data	equ	31h
f_direct_bios	equ	32h
f_dma_segment	equ	33h
f_release_resident	equ	3ah

	cseg
	org	0

entry:
	jmp	initialize

; ----------------------------------------------------------------------
; Original copyright and configurable spooler options. Preserve unused
; option bytes and the reserved block; their offsets form the shipped layout.
; ----------------------------------------------------------------------
copyright	db	'COPYRIGHT (C) 1980, DIGITAL RESEARCH  '
debug_breaks	db	0h
directory_mode	db	0h
reserved_option	db	0h
reserved_option2	db	0ffh
console_hook_enabled	db	0ffh
status_poll_enabled	db	0ffh
e3_interval	db	14h
configured_spool_extension	db	'SPL'
directory_poll_interval	dw	5dch
characters_per_slice	db	4h
buffer_records	dw	4h
e2_interval	db	5h
defer_disk_io	db	0ffh
option_padding	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h
	db	0h,0h,0h,0h,0h,0h,0h,0h,0h,0h,0h

; ----------------------------------------------------------------------
; Save/restore the interrupt worker registers while retaining the near return
; address on top of the stack. AX is saved separately by the interrupt entry.
; ----------------------------------------------------------------------
save_registers:
	pop	ax
	push	bx
	push	cx
	push	dx
	push	bp
	push	si
	push	di
	push	es
	push	ax
	ret
restore_registers:
	pop	ax
	pop	es
	pop	di
	pop	si
	pop	bp
	pop	dx
	pop	cx
	pop	bx
	push	ax
	ret

; ----------------------------------------------------------------------
; BDOS 49 returns the system-data pointer in ES:BX. Remember it for later
; context switches and initialize the character budget from CODE options.
; ----------------------------------------------------------------------
locate_bdos:
	mov	cl,f_system_data
	call	bdos_call
	mov	word ptr bdos_segment,es
	mov	word ptr bdos_state_pointer,bx
	mov	al,cs:byte ptr characters_per_slice
	mov	byte ptr slice_remaining,al
	ret
get_bdos_pointer:
	mov	es,word ptr bdos_segment
	mov	bx,word ptr bdos_state_pointer
	ret

; ----------------------------------------------------------------------
; Save CX bytes beginning twelve bytes before the BDOS state pointer.
; Also preserve the separately addressed kernel byte at 2310h.
; ----------------------------------------------------------------------
save_bdos_state:
	push	ds
	pop	es
	push	ds
	mov	si,word ptr bdos_state_pointer
	sub	si,0ch
	mov	ds,word ptr bdos_segment
	mov	di,offset saved_bdos_state
	push	ax
	mov	al,byte ptr .bdos_byte_2310
	mov	es:byte ptr saved_bdos_byte,al
	pop	ax
	cld
	rep	movsb
	pop	ds
	ret
restore_bdos_state:
	call	get_bdos_pointer
	mov	si,offset saved_bdos_state
	mov	di,bx
	sub	di,0ch
	push	ax
	mov	al,byte ptr saved_bdos_byte
	mov	es:byte ptr .bdos_byte_2310,al
	pop	ax
	cld
	rep	movsb
	ret

; ----------------------------------------------------------------------
; Save the larger disk context and the 128-byte directory/DMA record.
; restore_disk_context reverses these transfers after background file I/O.
; ----------------------------------------------------------------------
save_disk_context:
	mov	cx,1bh
	call	save_bdos_state
	push	ds
	mov	ds,word ptr bdos_segment
	push	ax
	mov	ax,word ptr .bdos_word_2321
	mov	es:word ptr saved_bdos_word,ax
	pop	ax
	mov	cx,80h
	mov	si,es:word ptr saved_directory_buffer
	mov	di,offset saved_dma_record
	rep	movsb
	pop	ds
	ret
restore_disk_context:
	mov	cx,1bh
	call	restore_bdos_state
	push	ax
	mov	ax,word ptr saved_bdos_word
	mov	es:word ptr .bdos_word_2321,ax
	pop	ax
	mov	cx,80h
	mov	di,word ptr saved_directory_buffer
	mov	si,offset saved_dma_record
	rep	movsb
	ret

; ----------------------------------------------------------------------
; Protected BDOS call: preserve shared kernel state, mark the temporary
; context, call INT E0h, then restore the foreground fields. Save AX and BX
; results across restoration. Fixed offsets belong to this CP/M revision.
; ----------------------------------------------------------------------
protected_bdos_call:
	push	cx
	mov	cx,0bh
	call	save_bdos_state
	call	get_bdos_pointer
	sub	bx,8h
	mov	es:byte ptr [bx],1h
	pop	cx
	mov	word ptr saved_bdos_ax,ax
	mov	ah,es:byte ptr .bdos_byte_2327
	mov	al,es:byte ptr .bdos_byte_2313
	push	ax
	mov	ax,word ptr saved_bdos_ax
	int	0e0h
	mov	cs:word ptr saved_bdos_bx,bx
	call	get_bdos_pointer
	sub	bx,8h
	mov	es:byte ptr [bx],0h
	mov	word ptr saved_bdos_ax,ax
	pop	ax
	mov	es:byte ptr .bdos_byte_2327,ah
	mov	es:byte ptr .bdos_byte_2313,al
	mov	ax,word ptr saved_bdos_ax
	mov	bp,ds
	mov	es,bp
	mov	cx,0bh
	call	restore_bdos_state
	mov	bx,cs:word ptr saved_bdos_bx
	ret

; ----------------------------------------------------------------------
; Direct BDOS entry and small function-selection wrappers. Function zero
; uses DX=0 to release memory or DX=1 to keep the spooler resident.
; ----------------------------------------------------------------------
bdos_call:
	int	0e0h
	ret
exit_transient:
	xor	dx,dx
reset_or_stay_resident:
	mov	cl,f_reset
	jmps	bdos_call
select_disk:
	mov	dl,al
	mov	cl,f_select_disk
	jmps	dispatch_protected_bdos
open_file:
	mov	cl,f_open
dispatch_protected_bdos:
	jmp	protected_bdos_call
set_dma_segment:
	mov	cl,f_dma_segment
	jmps	dispatch_protected_bdos
set_dma_offset:
	mov	cl,f_dma_offset
	jmps	dispatch_protected_bdos

; ----------------------------------------------------------------------
; Restore both DMA segment and offset from the saved foreground context.
; ----------------------------------------------------------------------
restore_dma:
	mov	bx,offset saved_dma_offset
	mov	dx,word ptr 2h[bx]
	push	bx
	call	set_dma_segment
	pop	bx
	mov	dx,word ptr [bx]
	call	set_dma_offset
	ret
get_default_drive:
	mov	cl,f_current_disk
	int	0e0h
	inc	al
	mov	byte ptr default_drive,al
	ret
set_bdos_byte:
	call	get_bdos_pointer
	add	bx,dx
	mov	es:byte ptr [bx],al
	ret

; ----------------------------------------------------------------------
; Save and replace INT E2h/E3h vectors in segment zero. The caller disables
; interrupts before installation. Symbolic CODE offsets retain the handlers.
; ----------------------------------------------------------------------
install_interrupts:
	mov	ax,0h
	mov	es,ax
	mov	ax,es:word ptr .int_e2_offset
	mov	word ptr saved_e2_offset,ax
	mov	ax,es:word ptr .int_e2_segment
	mov	word ptr saved_e2_segment,ax
	mov	ax,es:word ptr .int_e3_offset
	mov	word ptr saved_e3_offset,ax
	mov	ax,es:word ptr .int_e3_segment
	mov	word ptr saved_e3_segment,ax
	mov	ax,offset int_e2_handler
	mov	es:word ptr .int_e2_offset,ax
	mov	es:word ptr .int_e2_segment,cs
	mov	ax,offset int_e3_handler
	mov	es:word ptr .int_e3_offset,ax
	mov	es:word ptr .int_e3_segment,cs
	ret
check_bdos_busy:
	call	get_bdos_pointer
	test	es:byte ptr 11h[bx],0ffh
	ret

; ----------------------------------------------------------------------
; Console diagnostics use protected BDOS function 2. print_message emits
; a leading CR/LF and then a NUL-terminated string addressed by CX.
; ----------------------------------------------------------------------
console_output:
	mov	dl,al
	mov	cl,f_console_output
	push	cx
	call	protected_bdos_call
	pop	cx
	ret
console_crlf:
	mov	al,0dh
	call	console_output
	mov	al,0ah
	jmps	console_output
print_message:
	push	cx
	call	console_crlf
	pop	bx
print_message_at_0211:
	mov	al,byte ptr [bx]
	or	al,al
	jnz	print_message_at_0218
	ret
print_message_at_0218:
	inc	bx
	push	bx
	call	console_output
	pop	bx
	jmps	print_message_at_0211

; ----------------------------------------------------------------------
; When enabled, BDOS 50 invokes BIOS list-status function 15. FFh means
; ready; a busy printer leaves the character pending for another slice.
; ----------------------------------------------------------------------
printer_status:
	test	cs:byte ptr status_poll_enabled,0ffh
	jnz	printer_status_at_022b
	or	al,0ffh
	ret
printer_status_at_022b:
	mov	cl,32h
	mov	dx,offset bios_request
	mov	byte ptr bios_request,0fh
	jmp	protected_bdos_call

; ----------------------------------------------------------------------
; Track printer column and emit DL through BDOS list output (function 5).
; ----------------------------------------------------------------------
printer_output:
	cmp	dl,0dh
	jnz	printer_output_at_0242
	mov	byte ptr printer_column,0ffh
printer_output_at_0242:
	inc	byte ptr printer_column
	mov	cl,f_list_output
	call	protected_bdos_call
	mov	byte ptr character_pending,0h
	ret

; ----------------------------------------------------------------------
; Expand TAB into spaces up to the next eight-column boundary. Preserve
; a pending character when the printer is not ready.
; ----------------------------------------------------------------------
print_character:
	cmp	al,9h
	jnz	print_character_at_0277
print_character_at_0255:
	call	printer_status
	cmp	al,0ffh
	jz	print_character_at_0268
	mov	byte ptr character_pending,0ffh
	mov	byte ptr pending_character,9h
	jmps	print_character_at_0276
print_character_at_0268:
	mov	dl,20h
	call	printer_output
	mov	dl,byte ptr printer_column
	and	dl,7h
	jnz	print_character_at_0255
print_character_at_0276:
	ret
print_character_at_0277:
	mov	byte ptr pending_character,al
	call	printer_status
	cmp	al,0ffh
	jz	print_character_at_0288
	mov	byte ptr character_pending,0ffh
	jmps	print_character_at_0276
print_character_at_0288:
	mov	dl,byte ptr pending_character
	jmp	printer_output

; ----------------------------------------------------------------------
; Render the current FCB as a fourteen-character status filename in the
; BDOS area. The companion routine blanks the same field.
; ----------------------------------------------------------------------
show_current_filename:
	cld
	call	get_bdos_pointer
	mov	di,bx
	add	di,32h
	mov	bx,offset drive_letters
	mov	al,byte ptr file_fcb
	xlat	byte ptr [bx]
	stosb
	mov	al,3ah
	stosb
	mov	si,offset file_name
	mov	cx,8h
show_current_filename_at_02a9:
	cmp	byte ptr [si],20h
	jz	show_current_filename_at_02b4
	lodsb
	and	al,7fh
	stosb
	loop	show_current_filename_at_02a9
show_current_filename_at_02b4:
	mov	al,2eh
	stosb
	push	cx
	mov	cx,3h
	mov	si,offset file_extension
show_current_filename_at_02be:
	lodsb
	and	al,7fh
	stosb
	loop	show_current_filename_at_02be
	pop	cx
	mov	al,20h
	rep	stosb
	ret
clear_current_filename:
	cld
	call	get_bdos_pointer
	mov	di,bx
	add	di,32h
	mov	cx,0eh
	mov	al,20h
	rep	stosb
	ret

; ----------------------------------------------------------------------
; Reset the current record, select the FCB drive through BIOS function 9,
; then open the file. Return zero if the drive or open operation fails.
; ----------------------------------------------------------------------
open_print_file:
	mov	byte ptr file_current_record,0h
	xor	ax,ax
	mov	al,byte ptr file_fcb
	dec	al
	mov	word ptr bios_request_argument,ax
	mov	word ptr bios_request_value,1h
	mov	byte ptr bios_request,9h
	mov	cl,32h
	mov	dx,offset bios_request
	call	protected_bdos_call
	cmp	bx,0h
	jnz	open_print_file_at_0305
	and	al,0h
	ret
open_print_file_at_0305:
	mov	dx,offset file_fcb
	call	open_file
	inc	al
	ret

; ----------------------------------------------------------------------
; Read up to AX 128-byte records into read_buffer. Return the number read.
; The surrounding caller saves and restores the foreground disk context.
; ----------------------------------------------------------------------
fill_read_buffer:
	mov	word ptr records_remaining,ax
	mov	word ptr records_read,0h
	mov	ax,offset read_buffer
	mov	word ptr read_dma_offset,ax
	mov	dx,ds
	call	set_dma_segment
fill_read_buffer_at_0322:
	mov	dx,word ptr read_dma_offset
	call	set_dma_offset
	mov	dx,offset file_fcb
	mov	cl,f_read_sequential
	call	protected_bdos_call
	cmp	al,0h
	jnz	fill_read_buffer_at_0347
	inc	word ptr records_read
	dec	word ptr records_remaining
	jz	fill_read_buffer_at_0347
	add	word ptr read_dma_offset,80h
	jmps	fill_read_buffer_at_0322
fill_read_buffer_at_0347:
	mov	ax,word ptr records_read
	ret
no_file_exit:
	mov	dx,offset msg_no_file
	mov	cl,f_print_string
	int	0e0h
	jmp	exit_transient

; ----------------------------------------------------------------------
; Retained syntax diagnostic: print the offending token followed by ?.
; ----------------------------------------------------------------------
syntax_error:
	call	console_crlf
	mov	bx,word ptr token_start
syntax_error_at_035c:
	mov	al,byte ptr [bx]
	cmp	al,20h
	jz	syntax_error_at_036e
	or	al,al
	jz	syntax_error_at_036e
	push	bx
	call	console_output
	pop	bx
	inc	bx
	jmps	syntax_error_at_035c
syntax_error_at_036e:
	mov	al,3fh
	call	console_output
	call	console_crlf
	call	exit_transient

; ----------------------------------------------------------------------
; Token parsing helpers: test separators, skip spaces and pad FCB fields.
; A star expands to question marks; the caller counts wildcard characters.
; ----------------------------------------------------------------------
test_delimiter:
	mov	al,byte ptr [si]
	or	al,al
	jnz	test_delimiter_at_0380
	ret
test_delimiter_at_0380:
	cmp	al,20h
	jnc	test_delimiter_at_0387
	or	al,0h
	ret
test_delimiter_at_0387:
	push	di
	push	es
	push	ds
	pop	es
	mov	di,offset delimiters
	mov	cx,9h
	cld
	repne	scasb
	pop	es
	pop	di
	ret
skip_spaces:
	mov	al,byte ptr [si]
	cmp	al,0h
	jnz	skip_spaces_at_039e
	ret
skip_spaces_at_039e:
	cmp	al,20h
	jz	skip_spaces_at_03a3
	ret
skip_spaces_at_03a3:
	inc	si
	jmps	skip_spaces
pad_name_field:
	inc	bx
	mov	byte ptr [bx],20h
	loop	pad_name_field
	ret
parse_name_field:
	push	cx
	call	test_delimiter
	pop	cx
	jnz	parse_name_field_at_03bd
	cmp	si,offset filename_queue
	jnz	parse_name_field_at_03bb
	inc	si
parse_name_field_at_03bb:
	jmps	pad_name_field
parse_name_field_at_03bd:
	inc	bx
	cmp	al,2ah
	jnz	parse_name_field_at_03c6
	mov	al,3fh
	jmps	parse_name_field_at_03c7
parse_name_field_at_03c6:
	inc	si
parse_name_field_at_03c7:
	mov	byte ptr [bx],al
	loop	parse_name_field
parse_name_field_at_03cb:
	call	test_delimiter
	jz	parse_name_field_at_03d3
	inc	si
	jmps	parse_name_field_at_03cb
parse_name_field_at_03d3:
	ret

; ----------------------------------------------------------------------
; Parse optional drive, eight-character name and three-character extension
; into the base-page FCB. Return the wildcard count in AH.
; ----------------------------------------------------------------------
parse_filename:
	mov	ax,0h
	mov	bx,offset file_fcb
	add	bx,ax
	push	bx
	mov	si,word ptr argument_pointer
	call	skip_spaces
	mov	word ptr token_start,si
	jz	parse_filename_at_03f2
	sbb	al,40h
	cmp	byte ptr 1h[si],3ah
	jz	parse_filename_at_03f7
parse_filename_at_03f2:
	mov	al,byte ptr default_drive
	jmps	parse_filename_at_03f9
parse_filename_at_03f7:
	inc	si
	inc	si
parse_filename_at_03f9:
	mov	byte ptr [bx],al
	mov	cx,8h
	call	parse_name_field
	mov	cx,3h
	cmp	al,2eh
	jnz	parse_filename_at_0409
	inc	si
parse_filename_at_0409:
	call	parse_name_field
	inc	bx
	mov	di,bx
	push	es
	push	ds
	pop	es
	cld
	mov	cx,3h
	xor	ax,ax
	rep	stosb
	pop	es
	mov	word ptr argument_pointer,si
	pop	bx
	mov	cx,0bh
parse_filename_at_0423:
	inc	bx
	cmp	byte ptr [bx],3fh
	jnz	parse_filename_at_042b
	inc	ah
parse_filename_at_042b:
	loop	parse_filename_at_0423
	mov	al,byte ptr [si]
	or	ah,ah
	ret
report_read_error:
	mov	cx,offset msg_read_error
	jmp	print_message

; ----------------------------------------------------------------------
; Reject wildcard/empty names; save the foreground disk state while opening
; the next named file. Mark its buffer empty and display its filename.
; ----------------------------------------------------------------------
open_next_argument:
	call	parse_filename
	jz	open_next_argument_at_043f
	jmps	open_next_argument_at_0467
open_next_argument_at_043f:
	cmp	byte ptr file_name,20h
	jnz	open_next_argument_at_0448
	jmps	open_next_argument_at_0467
open_next_argument_at_0448:
	call	save_disk_context
	call	open_print_file
	call	restore_disk_context
	or	al,al
	jz	open_next_argument_at_0467
	call	show_current_filename
	mov	byte ptr printer_column,0h
	mov	word ptr read_position,0ffffh
	or	al,0ffh
	jmps	open_next_argument_at_0469
open_next_argument_at_0467:
	and	al,0h
open_next_argument_at_0469:
	ret

; ----------------------------------------------------------------------
; Remove the consumed filename from the resident command-tail queue by
; compacting the remaining bytes and updating its length.
; ----------------------------------------------------------------------
remove_processed_argument:
	mov	ax,word ptr argument_pointer
	sub	ax,word ptr argument_start
	mov	word ptr argument_length,ax
	mov	ax,word ptr argument_length
	sub	byte ptr queue_length,al
	pushf
	push	es
	cld
	mov	ax,ds
	mov	es,ax
	xor	cx,cx
	mov	cl,byte ptr queue_length
	mov	di,word ptr argument_start
	mov	si,word ptr argument_pointer
	rep	movsb
	pop	es
	popf
	mov	ax,word ptr argument_start
	mov	word ptr argument_pointer,ax
	ret

; ----------------------------------------------------------------------
; Advance through queued filenames until one opens or the queue empties.
; Emit a form feed before starting the next printable file.
; ----------------------------------------------------------------------
next_queued_file:
	xor	ax,ax
	mov	al,byte ptr queue_length
	add	ax,80h
	cmp	word ptr argument_pointer,ax
	jnl	next_queued_file_at_04c4
	mov	ax,word ptr argument_pointer
	mov	word ptr argument_start,ax
	call	open_next_argument
	push	ax
	call	remove_processed_argument
	pop	ax
	or	al,al
	jz	next_queued_file
	mov	al,0ch
	call	print_character
	or	al,0h
	jmps	next_queued_file_at_04c8
next_queued_file_at_04c4:
	mov	al,0ffh
	or	al,al
next_queued_file_at_04c8:
	ret

; ----------------------------------------------------------------------
; Compare the FCB extension with the configured spool-file extension.
; ----------------------------------------------------------------------
is_spool_extension:
	push	es
	cld
	mov	ax,ds
	mov	es,ax
	mov	di,offset spool_extension
	mov	si,offset file_extension
	mov	cx,3h
	repe	cmpsb
	pop	es
	jz	is_spool_extension_at_04e1
	xor	al,al
	jmps	is_spool_extension_at_04e5
is_spool_extension_at_04e1:
	mov	al,0ffh
	or	al,al
is_spool_extension_at_04e5:
	ret

