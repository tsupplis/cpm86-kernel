	test	al,al
	pop	ax
	jz	int_e2_handler_at_09a1
	jmp	interrupt_return
int_e2_handler_at_09a1:
	dec	cs:byte ptr e2_countdown
	jz	int_e2_handler_at_09b1
	mov	cs:byte ptr spooler_lock,0h
	jmp	interrupt_return
int_e2_handler_at_09b1:
	push	ax
	mov	al,cs:byte ptr e2_interval
	mov	cs:byte ptr e2_countdown,al
	pop	ax
	mov	cs:byte ptr interrupt_source,1h

; ----------------------------------------------------------------------
; Save the interrupted SS:SP, DS and AX; switch to the private DATA stack.
; The E3 path restores the interrupted IF state before doing background work.
; ----------------------------------------------------------------------
enter_spooler:
	push	ds
	mov	ds,cs:word ptr resident_data_segment
	mov	word ptr interrupted_ax,ax
	pop	ax
	mov	word ptr interrupted_ds,ax
	mov	word ptr interrupted_ss,ss
	mov	word ptr interrupted_sp,sp
	mov	ax,ds
	mov	ss,ax
	mov	sp,offset interrupt_stack_top
	cmp	cs:byte ptr interrupt_source,2h
	jz	restore_interrupted_if
	sti
	jmps	service_spooler
restore_interrupted_if:
	mov	word ptr interrupted_bx,bx
	mov	word ptr interrupted_es,es
