	cmp	al,0h
	jz	hook_console_input
	mov	bx,2509h
	jmpf	cs:dword ptr saved_bios_offset
poll_console_and_spool:
	mov	bx,2506h
	callf	cs:dword ptr saved_bios_offset
	push	es
	push	ds
	mov	ds,cs:word ptr resident_data_segment
	cmp	al,0ffh
	jz	poll_console_and_spool_at_077e
	call	get_bdos_pointer
	test	es:byte ptr 0fh[bx],0ffh
	jz	poll_console_and_spool_at_077e
