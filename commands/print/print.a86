; ----------------------------------------------------------------------
; INT E3h worker entry: acquire the reentrancy lock and apply its countdown.
; E3 and E2 entries share the stack-switching worker and IRET exit.
; ----------------------------------------------------------------------
int_e3_handler:
	push	ax
	mov	al,0ffh
	xchg	al,cs:byte ptr spooler_lock
	test	al,al
	pop	ax
	jz	int_e3_handler_at_096f
	jmp	interrupt_return
int_e3_handler_at_096f:
	dec	cs:byte ptr e3_countdown
	jz	int_e3_handler_at_097f
	mov	cs:byte ptr spooler_lock,0h
	jmp	interrupt_return
int_e3_handler_at_097f:
