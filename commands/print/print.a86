	mov	ds,cs:word ptr resident_data_segment
	cmp	al,0ffh
	jz	hook_console_status_at_074d
	call	get_bdos_pointer
	test	es:byte ptr 0fh[bx],0ffh
	jz	hook_console_status_at_074d
	int	0e3h
hook_console_status_at_074d:
	pop	ds
	pop	es
	retf
hook_console_input:
