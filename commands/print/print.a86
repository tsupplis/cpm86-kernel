	mov	al,byte ptr queue_length
	inc	al
	mov	byte ptr queue_length,al
	add	ax,80h
	xchg	ax,bx
	mov	word ptr [bx],20h
	call	next_queued_file
	cmp	cs:byte ptr directory_mode,0ffh
	jz	initialize_directory_mode
	or	al,al
	jz	start_printing
	call	next_queued_file
	jz	start_printing
	test	cs:byte ptr console_hook_enabled,0ffh
	jz	initialize_queue_at_0b2d
	call	restore_bios_hook
initialize_queue_at_0b2d:
	jmp	no_file_exit
initialize_directory_mode:
	or	al,al
	jz	start_printing
	call	next_queued_file
	jz	start_printing
	mov	byte ptr spool_phase,2h
	jmps	activate_resident
start_printing:
	mov	byte ptr spool_phase,1h

; ----------------------------------------------------------------------
; Install interrupt handlers, mark the resident active and terminate with
; DX=1 so CP/M retains its memory.
; ----------------------------------------------------------------------
activate_resident:
	cmp	cs:byte ptr debug_breaks,0ffh
	jnz	activate_resident_at_0b4e
	int	3
activate_resident_at_0b4e:
	cli
	call	install_interrupts
	mov	dx,0fh
	mov	al,1h
	call	set_bdos_byte
	mov	dx,1h
	sti
	jmp	reset_or_stay_resident

; ----------------------------------------------------------------------
; Reserved CODE patch area, followed by resident state and paragraph padding.
; The DS slot and lock are accessed by later invocations through the installed
; interrupt vector, so their offsets must match the resident copy.
