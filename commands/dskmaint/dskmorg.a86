;***********************************************************
;  DSKMAINT.A86 - reconstructed from base/dskmaint.cmd
;  Skeleton from `a86tool.py scaffold`: the first instruction is real,
;  the rest of the image is a raw db dump still to be decoded.
;
;  Build:   make
;  Check:   make check
;***********************************************************

; Bounds for tools/a86tool.py: where the data starts and the image ends.
data_org	equ	0734h
image_end	equ	1060h

; One group so the CMD has a single CODE descriptor (the 8080 model),
; but the data keeps its own segment.
cgroup	group	code,data

	cseg
	org	100h

start:
	jmps	main

copyright:
	db	'Copyright (C) 1983, Digital Research'

main:
	mov	ax,cs
	mov	ds,ax
	mov	ss,ax
	mov	sp,1053h
	call	flushkb
	call	allocmem
	jnz	memok
	mov	si,offset nomemmsg
	call	puts
	jmp	terminate

memok:
	call	drawframe
	call	cntdrives
	call	initvec

mainmenu:
	call	clrwin
	mov	si,offset mainhdr
	mov	dh,04h
	call	putcent
	mov	si,offset menuitems
	mov	cx,05h
	call	drawmenu
	mov	si,offset selfunc
	mov	dh,06h
	call	putrev
	mov	di,offset mainkeys
	mov	cx,05h
	call	getchoice
	dec	bx
	mov	menusel,bx
	jmp	word ptr fntable[bx]

restart:
	mov	ax,cs
	mov	ds,ax
	mov	es,ax
	mov	sp,1053h
	call	setoldvec
	jmps	mainmenu

doverify:
	mov	si,offset vfytxt
	mov	word ptr promptptr,08b5h
	call	seldrive
	call	clrwin
	mov	si,offset vfyingmsg
	mov	dx,0516h
	call	drvprompt

vfyall:
	call	getsides
	call	trkhdr
	mov	byte ptr biosfunc,04h

vfyloop:
	call	showtrk
	call	diskio
	inc	byte ptr track
	dec	byte ptr trkcount
	jnz	vfyloop
	call	getsides
	mov	bx,menusel
	jmp	word ptr fntable[bx]

docopy:
	test	byte ptr ntrkbuf,0ffh
	jnz	copypick
	mov	si,offset copymemmsg
	jmp	showerr

copypick:
	mov	si,offset copytxt
	mov	word ptr promptptr,08cfh
	call	seldrive
	mov	srcdrive,bl
	call	getsides
	mov	srcsides,al
	mov	si,offset copytxt
	mov	word ptr promptptr,08e6h
	call	seldrive
	mov	dstdrive,bl
	call	clrwin
	mov	al,srcdrive
	mov	drive,al
	mov	si,offset copyingmsg
	mov	dx,0415h
	call	drvprompt
	mov	al,dstdrive
	mov	drive,al
	mov	si,offset tomsg
	mov	dx,051fh
	call	drvprompt
	call	confirm
	jc	docopy
	mov	al,trkcount
	mov	trktotal,al

copynext:
	mov	al,trktotal
	sub	al,track
	jz	copyend
	cmp	al,ntrkbuf
	jc	copyrd
	mov	al,ntrkbuf

copyrd:
	mov	trkcount,al
	call	askinsrc
	mov	al,02h
	mov	ah,srcdrive
	mov	si,offset readmsg
	call	xfer
	call	askindst
	mov	al,03h
	mov	ah,dstdrive
	mov	si,offset writemsg
	call	xfer
	mov	byte ptr biosfunc,02h
	mov	ax,copyseg
	mov	curseg,ax
	mov	si,offset checkmsg
	call	trkhdr

cmploop:
	call	showtrk
	call	diskio
	call	nextseg
	push	ds
	mov	ds,word ptr trkbuf
	sub	si,si
	sub	di,di
	mov	cx,1000h
	cld
	repe	cmpsb
	pop	ds
	jz	cmpnext
	mov	si,offset mismatmsg
	jmp	showerr

cmpnext:
	inc	byte ptr track
	dec	byte ptr trkcount
	jnz	cmploop
	jmp	copynext

copyend:
	call	getsides
	mov	al,srcdrive
	mov	drive,al
	call	getsides
	jmp	docopy

xfer:
	push	word ptr track
	mov	biosfunc,al
	mov	drive,ah
	mov	ax,copyseg
	mov	curseg,ax
	call	trkhdr

xferloop:
	call	showtrk
	call	nextseg
	call	diskioes
	inc	byte ptr track
	dec	byte ptr trkcount
	jnz	xferloop
	pop	word ptr track
	ret

nextseg:
	mov	es,word ptr curseg
	add	word ptr curseg,0100h
	ret

fmt1:
	mov	byte ptr sides,00h
	mov	byte ptr trkcount,28h
	mov	si,offset fmt1txt
	jmps	fmtcommon

fmt2:
	mov	byte ptr sides,01h
	mov	byte ptr trkcount,50h
	mov	si,offset fmt2txt

fmtcommon:
	mov	word ptr promptptr,0902h
	call	seldrive
	call	clrwin
	mov	si,offset fmtingmsg
	mov	dx,0516h
	call	drvprompt
	call	confirm
	jnc	fmtgo
	mov	bx,menusel
	jmp	word ptr fntable[bx]

fmtgo:
	call	setnewvec
	mov	si,offset fmtingmsg
	mov	byte ptr track,00h
	call	trkhdr
	mov	byte ptr biosfunc,05h

fmtloop:
	call	showtrk
	call	mkidtab
	call	diskio
	inc	byte ptr track
	dec	byte ptr trkcount
	jnz	fmtloop
	call	setoldvec
	mov	es,word ptr trkbuf
	mov	di,00h
	mov	al,0e5h
	mov	cx,1000h
	cld
	rep	stosb
	mov	si,offset writemsg
	mov	byte ptr track,00h
	call	trkhdr
	mov	si,offset bootimg
	mov	es,word ptr trkbuf
	sub	di,di
	mov	al,sides
	mov	es:.01ffh,al
	mov	cx,93h
	rep	movsb
	mov	si,offset ldrimg
	mov	di,0900h
	mov	cx,034eh
	rep	movsb
	mov	byte ptr biosfunc,03h
	call	diskio
	mov	si,offset vfyingmsg
	jmp	vfyall

mkidtab:
	mov	es,word ptr trkbuf
	mov	di,00h
	call	calctrk
	mov	dl,ch
	mov	bx,0201h
	mov	cx,08h
	cld

idloop:
	mov	ax,dx
	stosw
	mov	ax,bx
	stosw
	inc	bx
	loop	idloop
	ret

doexit:
	call	freemem
	mov	si,offset scrnrest
	call	puts

terminate:
	mov	cl,00h
	mov	dl,00h
	int	0e0h

cntdrives:
	int	11h
	mov	cl,06h
	shr	ax,cl
	and	ax,03h
	inc	ax
	mov	ndrives,ax
	ret

drawframe:
	mov	si,offset scrninit
	call	puts
	mov	cx,4eh
	mov	dx,01h
	mov	bl,0c4h
	call	hline
	mov	dx,0201h
	mov	bl,0cdh
	call	hline
	mov	dx,1701h
	mov	bl,0c4h
	call	hline
	mov	cx,16h
	mov	dx,0100h
	mov	bl,0b3h
	call	vline
	mov	dx,014fh
	mov	bl,0b3h
	call	vline
	mov	si,offset corners
	mov	cx,06h

cellloop:
	mov	al,59h
	call	escout
	lodsb
	add	al,20h
	call	conout
	lodsb
	add	al,20h
	call	conout
	lodsb
	call	conout
	loop	cellloop
	mov	si,offset titlestr
	mov	dx,0100h
	jmp	putcent

hline:
	push	cx
	call	gotoxy

hlloop:
	mov	al,bl
	call	conout
	loop	hlloop
	pop	cx
	ret

vline:
	push	cx

vlloop:
	push	dx
	call	gotoxy
	mov	al,bl
	call	conout
	pop	dx
	inc	dh
	loop	vlloop
	pop	cx
	ret

seldrive:
	call	clrwin
	mov	dh,04h
	call	putcent
	mov	cx,ndrives
	inc	cx
	push	cx
	mov	si,offset drvmenu
	call	drawmenu
	mov	si,promptptr
	mov	dh,06h
	call	putrev
	mov	di,offset drvkeys
	pop	cx
	call	getchoice
	cmp	bx,0ah
	jz	selabort
	shr	bx,1
	dec	bx
	mov	drive,bl
	ret

selabort:
	pop	ax
	jmp	mainmenu

drvprompt:
	push	si
	call	putat
	mov	si,offset indrvmsg
	call	puts
	mov	al,drive
	add	al,41h
	call	conout
	mov	al,3ah
	call	conout
	pop	si
	ret

trkhdr:
	mov	dx,091dh
	call	putat
	mov	si,offset trkmsg
	call	puts

showtrk:
	mov	dx,092eh
	call	gotoxy
	mov	al,track
	aam
	or	ax,3030h
	cmp	ah,30h
	jnz	trkdigit
	mov	ah,20h
	xchg	ah,al

trkdigit:
	push	ax
	mov	al,ah
	call	conout
	pop	ax
	jmp	conout

drawmenu:
	lodsb
	mov	dh,al
	lodsb
	mov	dl,al
	call	gotoxy
	push	si
	mov	si,offset itemfrm
	call	puts
	pop	si
	lodsb
	call	conout
	lodsb
	call	conout
	push	si
	mov	si,offset itemend
	call	puts
	pop	si
	call	puts
	loop	drawmenu
	ret

askinsrc:
	mov	si,offset insrcmsg
	jmps	askins

askindst:
	mov	si,offset indstmsg

askins:
	mov	al,srcdrive
	cmp	al,dstdrive
	jz	askbeep
	ret

askbeep:
	mov	al,07h
	call	conout

askwait:
	mov	dh,07h
	call	putrev
	call	getkey
	mov	dh,07h

clrrow:
	mov	dl,01h
	call	gotoxy
	mov	cx,4eh

clrloop:
	mov	al,20h
	call	conout
	loop	clrloop
	ret

putrev:
	mov	al,72h
	call	escout
	call	putcent
	mov	al,75h
	jmp	escout

confirm:
	push	si
	mov	si,offset destroymsg
	mov	dx,0708h
	call	drvprompt
	mov	si,offset askmsg
	mov	dx,0915h
	call	putat

ynkey:
	call	getkey
	and	al,0dfh
	cmp	al,59h
	jz	yesans
	cmp	al,4eh
	jz	noans
	mov	al,07h
	call	conout
	jmps	ynkey

yesans:
	clc
	jmps	ynend

noans:
	stc

ynend:
	pushf
	mov	dh,07h
	call	clrrow
	mov	dh,09h
	call	clrrow
	popf
	pop	si
	ret

putcent:
	push	ds
	pop	es
	mov	di,si
	mov	al,00h
	mov	cx,51h
	cld
	repne	scasb
	shr	cx,1
	mov	dl,cl

putat:
	call	gotoxy

puts:
	cld
	lodsb

putsloop:
	call	conout
	lodsb
	test	al,al
	jnz	putsloop
	ret

gotoxy:
	mov	al,59h
	call	escout
	add	dx,2020h
	mov	al,dh
	call	conout
	mov	al,dl
	jmp	conout

getchoice:
	mov	byte ptr autofmt,0ffh
	push	cx
	push	di
	call	getkey
	push	ds
	pop	es
	mov	al,ah
	sub	al,3ah
	repne	scasb
	pop	di
	pop	cx
	jz	gotchoice
	mov	al,07h
	call	conout
	jmps	getchoice

gotchoice:
	mov	bl,al
	mov	bh,00h
	mov	dh,06h
	jmp	clrrow

flushkb:
	mov	cl,0bh
	int	0e0h
	test	al,al
	jz	flushend
	mov	cl,01h
	int	0e0h
	jmps	flushkb

flushend:
	ret

allocmem:
	mov	word ptr buflen,0ffffh
	mov	cl,35h
	mov	dx,0745h
	int	0e0h
	inc	al
	jz	allocret
	mov	ax,trkbuf
	add	ax,0ffh
	mov	al,00h
	mov	trkbuf,ax
	inc	ah
	mov	copyseg,ax
	mov	ah,buflenhi
	sub	ah,01h
	jna	allocret
	mov	.0747h,ax
	dec	ah
	mov	ntrkbuf,ah
	mov	cl,38h
	mov	dx,0745h
	int	0e0h
	inc	al

allocret:
	ret

freemem:
	mov	byte ptr bufflag,00h
	mov	cl,39h
	mov	dx,0745h
	int	0e0h
	ret

initvec:
	mov	word ptr newvec,0757h
	mov	word ptr newvecseg,ds
	push	ds
	pop	es
	sub	ax,ax
	mov	ds,ax
	mov	si,78h
	mov	di,offset oldvec
	cld
	movsw
	movsw
	push	es
	pop	ds
	ret

setnewvec:
	mov	si,offset newvec
	jmps	setvec

setoldvec:
	mov	si,offset oldvec

setvec:
	sub	ax,ax
	mov	es,ax
	mov	di,78h
	cld
	movsw
	movsw
	mov	ah,00h
	int	13h
	ret

getsides:
	mov	byte ptr track,00h
	mov	byte ptr biosfunc,02h
	call	diskio
	mov	al,es:.01ffh
	mov	byte ptr trkcount,50h
	cmp	al,01h
	jz	gsdone
	mov	byte ptr trkcount,28h
	mov	al,00h

gsdone:
	mov	sides,al
	ret

diskio:
	mov	es,word ptr trkbuf

diskioes:
	mov	byte ptr retries,05h
	call	kbhit
	jz	tryio
	call	getkey
	cmp	al,03h
	jnz	tryio
	jmp	restart

tryio:
	call	iosetup
	cmp	ah,autofmt
	jnz	bios13
	push	es
	call	mkidtab
	call	iosetup
	mov	ah,05h
	int	13h
	call	iosetup
	pop	es

bios13:
	int	13h
	jc	ioerror
	ret

ioerror:
	mov	al,biosfunc
	cmp	ax,0203h
	jnz	retryio
	mov	autofmt,al

retryio:
	dec	byte ptr retries
	jnz	tryio
	mov	si,offset errtab
	mov	cx,0ah

errloop:
	cld
	lodsb
	cmp	al,ah
	jz	errfound
	inc	si
	inc	si
	loop	errloop
	mov	si,offset fatalmsg
	jmps	showerr

errfound:
	mov	si,[si]

showerr:
	mov	ax,ds
	mov	es,ax
	mov	cx,03h

beeploop:
	mov	al,07h
	call	conout
	loop	beeploop
	mov	al,70h
	call	escout
	mov	dh,03h
	call	putcent
	mov	al,71h
	call	escout
	mov	si,offset anykeymsg
	call	askwait
	jmp	restart

iosetup:
	mov	dl,drive
	mov	cl,01h
	sub	bx,bx
	mov	ah,biosfunc
	mov	al,08h

calctrk:
	mov	ch,track
	mov	dh,00h
	cmp	ch,28h
	jc	calcret
	neg	ch
	add	ch,4fh
	mov	dh,01h

calcret:
	ret

clrwin:
	mov	cx,0301h
	mov	dx,164eh
	mov	bx,07h
	mov	ax,0700h
	int	10h
	ret

escout:
	push	ax
	mov	al,1bh
	call	conout
	pop	ax
	jmps	conout

kbhit:
	mov	ah,01h
	int	16h
	ret

getkey:
	mov	ah,00h
	int	16h
	ret

conout:
	push	bx
	push	cx
	push	dx
	push	si
	push	di
	mov	dl,al
	mov	cl,06h
	int	0e0h
	pop	di
	pop	si
	pop	dx
	pop	cx
	pop	bx
	cld
	ret

l0734:

; ---- data ----
	dseg
ndrives	dw	00h
biosfunc	db	00h
drive	db	00h
track	db	00h
trkcount	db	00h
trktotal	db	00h
retries	db	00h
autofmt	db	00h
sides	db	00h
srcsides	db	00h
dstdrive	db	00h
srcdrive	db	00h
menusel	dw	00h
promptptr	dw	00h
trkbuf	dw	00h
buflen	db	00h
buflenhi	db	00h
bufflag	db	00h
copyseg	dw	00h
ntrkbuf	db	00h
curseg	dw	00h
oldvec	db	00h,00h,00h,00h
newvec	dw	00h
newvecseg	dw	00h
	db	0cfh,02h,25h,02h,08h,2ah,0ffh,50h,0e5h,19h,04h
scrninit	db	1bh,45h,1bh,77h,1bh,6eh,1bh,71h,1bh,74h,1bh,75h
	db	00h
scrnrest	db	1bh,45h,1bh,76h,1bh,6dh,00h
corners	db	00h,00h,0dah,00h,4fh,0bfh,02h,00h,0c6h,02h,4fh
	db	0b5h,17h,00h,0c0h,17h,4fh,0d9h
titlestr	db	'CP/M-86 Disk Maintenance Program for the'
	db	' IBM PC   version 1.2',00h
itemfrm	db	0dah,0c4h,0c4h,0c4h,0c4h,0bfh,0ah,08h,0b3h,08h
	db	08h,08h,08h,08h,08h,0b3h,0ah,08h,0c0h,0c4h,0c4h
	db	0c4h,0c4h,0d9h,1bh,41h,08h,08h,08h,08h,1bh
	db	72h,46h,00h
itemend	db	1bh,75h,1bh,43h,20h,20h,0cdh,0cdh,10h,20h,20h,00h
