;*****************************************************************************
;
;	LOADER - second stage boot loader written to track 0 by DSKMAINT
;	Copyright (C) 1983, Digital Research
;
;	Reconstructed from the bytes DSKMAINT carries; assembles byte-identical
;	to them.  Not a CP/M-86 program: BOOTSECT reads it into the top of
;	memory and jumps to offset 100h, which is where its code starts.
;
;	Build:	cpm86_asm86 loader	(writes loader.h86)
;
;	It reads the directory (track 1), looks for CPM.SYS and then for
;	CCPM.SYS, loads the first one it finds and jumps to it.  The files are
;	CMD files: the 128 byte header is skipped and the group descriptor
;	gives the segment to load at and to start in.  Anything missing or
;	unreadable prints a message and stops.
;
;	A key waiting at the end is read; if it is '?' a credit line is shown
;	first.  The line is kept XORed with a counter, see credits.
;
;	Allocation blocks are 1K on a single sided diskette and 2K on a double
;	sided one, which is told by byte 1ffh of the boot sector, still in
;	memory at 0000:7dff.  Tracks are numbered as in DSKMAINT, and track 0
;	is not part of the file system.  The variables are in their own segment
;	so that ASM-86 does not put a CS: override in front of each reference.
;
;*****************************************************************************

dirbuf	equ	044eh			; directory, just past this image
trkbuf	equ	0c4eh			; one track of file data after it

	cseg
	org	100h

start:	mov	ax,cs
	mov	ds,ax
	mov	ss,ax
	mov	sp,100h
	call	getgeom
	call	initdir
	mov	nameptr,offset cpmfile
	mov	msgptr,offset msgcpm
	mov	entry,2500h
	call	trysys
	mov	nameptr,offset ccpmfile
	mov	msgptr,offset msgccpm
	mov	entry,0
	call	trysys
	mov	si,offset msgnone
	jmp	fatal

; Look for the file at nameptr.  Returns if there is none; otherwise it loads
; all the extents it can find and does not return.
trysys:	call	finddir
	jz	found
	ret

found:	call	loadfirst

again:	call	finddir
	jnz	nextno
	mov	gaps,2
	call	loadext

nextno:	call	bumpext
	dec	gaps
	jnz	again
	jmp	go

; Print the message, find the first extent and load it.  The name is then
; compared with its extent number as well; the first extent is 0 or 1.
loadfirst:
	mov	si,msgptr
	call	puts
	inc	cmplen
	call	finddir
	jz	first
	call	bumpext
	call	finddir
	jz	first
	mov	si,offset msgread
	jmp	fatal

first:	call	bumpext
	mov	di,dirent
	mov	al,10h[di]
	call	seekblk
	call	gethdr
	mov	si,80h
	call	copyblk
	sub	loadseg,8
	mov	bx,11h
	mov	cx,0fh
	call	loadblks
	ret

; Load a following extent: all sixteen block numbers.  Block 0 ends the file.
loadext:
	mov	al,'.'
	call	putc
	mov	bx,10h
	mov	cx,10h

loadblks:
	add	bx,dirent

blkloop:
	mov	al,[bx]
	test	al,al
	jnz	doblk
	jmp	go

doblk:	push	bx
	push	cx
	call	seekblk
	sub	si,si
	call	copyblk
	pop	cx
	pop	bx
	inc	bx
	loop	blkloop
	ret

; Read the directory and mask each entry so that it can be compared with a
; plain name: the low nibble of the user byte goes, so any user 0..15 reads as
; 0, and bit 7 of the three type bytes (read-only, system) is cleared.
initdir:
	mov	bufptr,dirbuf
	mov	nsect,4
	mov	al,0
	call	seekblk
	mov	di,dirbuf
	mov	cx,40h
	mov	ax,7f7fh
	cld

maskloop:
	and	byte ptr [di],0f0h
	and	9[di],ax
	and	0bh[di],al
	add	di,20h
	loop	maskloop
	mov	bufptr,trkbuf
	mov	nsect,8
	mov	curtrk,0ffh
	ret

; Find the name at nameptr, cmplen bytes of it, in the 40h directory entries.
; ZF is set and dirent points at the entry if it is there.
finddir:
	push	ds
	pop	es
	mov	dirent,dirbuf
	mov	cx,40h
	cld

dirloop:
	push	cx
	mov	si,nameptr
	mov	di,dirent
	mov	cx,cmplen
	repe	cmpsb
	pop	cx
	jz	dirret
	add	dirent,20h
	loop	dirloop
	or	al,0ffh

dirret:	ret

; Copy the block in the track buffer, less the first si bytes, to loadseg:0
; and step loadseg on by one block.
copyblk:
	mov	cx,blksize
	sub	cx,si
	add	si,blkaddr
	sub	di,di
	mov	es,loadseg
	cld
	rep	movsb
	mov	ax,blkpar
	add	loadseg,ax
	ret

; Block size from the sides flag of the boot sector: bytes, paragraphs and
; sectors.
getgeom:
	sub	ax,ax
	mov	es,ax
	mov	ax,400h
	cmp	es:byte ptr .7dffh,1
	jnz	geomset
	mov	ax,800h

geomset:
	mov	blksize,ax
	mov	cl,4
	shr	ax,cl
	mov	blkpar,ax
	mov	cl,5
	shr	ax,cl
	mov	blksec,al
	ret

; The CMD header of the first block: the group descriptor gives the segment
; the code goes to and starts in.  A second group, if any, gives the data
; segment, else it is the same one.
gethdr:	mov	bx,blkaddr
	mov	ax,3[bx]
	mov	entryseg,ax
	mov	loadseg,ax
	cmp	byte ptr 9[bx],0
	jz	hdrdata
	mov	ax,0ch[bx]

hdrdata:
	mov	datseg,ax
	ret

; Step to the next extent number in the name being looked for.
bumpext:
	mov	si,nameptr
	inc	byte ptr 0ch[si]
	ret

fatal:	call	puts

halt:	sti
	jmps	halt

; Print the NUL terminated string at si.
puts:	lodsb

putsloop:
	call	putc
	lodsb
	test	al,al
	jnz	putsloop
	ret

; Start the program: segments to the data segment, far jump to entry.
go:	call	egg
	mov	ax,datseg
	mov	ds,ax
	mov	es,ax
	mov	dl,0
	jmpf	cs:dword ptr entry

; Make block al addressable: read the track it is on, unless that one is
; already in the buffer, and set blkaddr to the block inside it.  Track 0 is
; skipped.  Tracks 0..39 are head 0, 40..79 are head 1 counted backwards.
seekblk:
	mov	tries,5
	mul	blksec
	div	spt
	mov	ch,ah
	mov	cl,0
	shl	cx,1
	add	cx,trkbuf
	mov	blkaddr,cx
	cmp	al,curtrk
	jnz	readtrk
	ret

readtrk:
	mov	curtrk,al
	mov	dh,0
	add	al,1
	mov	ch,al
	cmp	al,28h
	jc	rd
	mov	ch,4fh
	sub	ch,al
	mov	dh,1

rd:	push	ds
	pop	es
	mov	cl,1
	mov	bx,bufptr

rdretry:
	mov	al,nsect
	mov	ah,2
	int	13h
	jc	rderr
	ret

rderr:	mov	ah,0
	int	13h
	dec	tries
	jnz	rdretry
	mov	si,offset msgread
	jmp	fatal

putc:	mov	bh,0
	mov	ah,0eh
	int	10h
	ret

; If a key is waiting and it is '?', show the credit line.
egg:	mov	ah,1
	int	16h
	jz	eggret
	mov	ah,0
	int	16h
	cmp	al,'?'
	jnz	eggret
	mov	si,offset credits
	mov	cx,40h

eggloop:
	lodsb
	xor	al,cl
	call	putc
	loop	eggloop

eggwait:
	mul	ah
	loop	eggwait

eggret:	ret

	dseg
	org	32eh
blksize	dw	0			; allocation block, in bytes
blkpar	dw	0			; and in paragraphs
blksec	db	0			; and in sectors
spt	db	8			; sectors per track
entry	dw	0			; far pointer to start the program at
entryseg	dw	0
datseg	dw	0			; segment for ds and es at the start
nameptr	dw	0			; name being looked for
msgptr	dw	0			; its 'Loading' message
cmplen	dw	0ch			; bytes of the name to compare
gaps	db	2			; missing extents in a row that end it
dirent	dw	0			; directory entry found
bufptr	dw	0			; where int 13h reads to
loadseg	dw	0			; where the next block goes
blkaddr	dw	0			; block inside the track buffer
curtrk	db	0ffh			; track in the buffer, ff for none
nsect	db	0			; sectors int 13h reads
tries	db	0

; "\r\n\r\nMuch of this code is brought to you by... <bell>Dean Ballard<bell>
; \r\r\r\n", each byte XORed with the loop counter 40h down to 1.
credits	db	'M537qNYQ',18h,58h,50h,15h
	db	'@[[B',10h,'LAII',0bh,43h,5ah,08h,'ETJQDJU',00h
	db	'kq=eto9zn8;:3',15h,'Uun`-Njfeiub',02h,09h,0eh
	db	0fh,0bh

; Name templates: user, name and type, extent number.
cpmfile	db	0,'CPM     SYS',0
ccpmfile	db	0,'CCPM    SYS',0
msgcpm	db	'Loading CPM.SYS.',0
msgccpm	db	'Loading CCPM.SYS.',0
msgnone	db	'*** Cannot find CPM.SYS or CCPM.SYS ***',0dh,0ah
	db	'Try another diskette.',0dh,0ah,0
msgread	db	0dh,0ah,0ah
	db	'*** Error while reading System File ***',0dh,0ah
	db	'Try another diskette.',0dh,0ah,0
	end
