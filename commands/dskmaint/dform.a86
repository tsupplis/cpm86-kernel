;*****************************************************************************
;
;	DFORM - CP/M-86 / Concurrent CP/M-86 command-line floppy formatter
;
;	Formatting algorithm and boot images from DSKMAINT (Digital Research,
;	1983). Uses the same bootsect.inc and loader.inc as the reconstruction.
;
;	Build:	make dform.cmd		Check: make check-dform
;	Usage:	DFORM drive: { [options] ... }
;
;	drive:	Required installed floppy drive, A: or B:.
;	1	Single-sided, 160 KiB (40 cylinders, eight 512-byte sectors).
;	2	Double-sided, 320 KiB; the default if neither 1 nor 2 appears.
;	V	Verify every track (default) after formatting and writing the boot track.
;
;	Combine options or use separate groups. The closing ] is optional;
;	DFORM A:[1V], DFORM A: [1] [V and DFORM A: [1V are equivalent.
;	Letters are case-insensitive. Unknown options and conflicting 1/2
;	selections print usage. An empty command also prints usage and exits.
;	Q skips verification; V and Q conflict.
;	Formatting always requires Y confirmation; N or Ctrl-C cancels.
;
;	A fresh disk contains the DSKMAINT boot sector and loader. The system
;	file (CPM.SYS or CCPM.SYS) must still be copied to it. Tracks follow
;	DSKMAINT's order: head zero cylinders 0..39, then head one
;	cylinders 39..0. No FAT is generated.
;
;	CP/M-86 1.1 uses ROM BIOS; Concurrent CP/M-86 3.1 uses native XIOS.
;	CCP/M uses DSKMAINT 1.5's MXdisk, P_KEEP and console exclusion protocol.
;	The 512-byte stack and separate aligned 4 KiB track buffers stay resident.
;	All exits restore the BIOS vector or release the CCP/M locks.
;	The loader retry byte follows the detected OS: CP/M=2, CCP/M=3.
;	Raw BDOS console I/O avoids an implicit Ctrl-C exit during formatting.
;
;*****************************************************************************
cgroup	group	code,data
	cseg
	org	100h

i_bdos		equ	0e0h
f_reset		equ	0
f_rawio		equ	6
f_version	equ	12
f_resetdrive	equ	37
opt_single	equ	1
opt_double	equ	2
opt_verify	equ	4
opt_quick equ 8
stack_size	equ	512

start:
	push	cs
	pop	ds
	pushf
	pop	bx
	cli
	mov	ax,ds
	mov	ss,ax
	mov	sp,offset stack_top
	push	bx
	popf
	cld
	mov	dx,offset msg_banner
	call	puts
	call detect_return_code
	call	parse_args

 ; Select the OS backend before any disk access.
	mov	cl,f_version
	call	bdos
	cmp	ax,22h
	jz	system_ok
	and	ah,0fh
	cmp	ah,4
	jz	concurrent_version
	cmp	ah,6
	jz	concurrent_version
	jmp	wrong_os
concurrent_version:
	mov	cl,163
	call	bdos
	cmp	ax,1431h
	jz	concurrent_ok
	jmp	wrong_os
concurrent_ok:
	mov	byte ptr os_mode,1
	call	ccpm_init
	jmp	installed_drive
system_ok:
	int	11h
	test	al,1
	jnz	floppy_present
	jmp	bad_drive
floppy_present:
	mov	cl,6
	shr	al,cl
	and	al,3
	inc	al
	cmp	drive,al
	jc	installed_drive
	jmp	bad_drive
installed_drive:

; Align within a 12 KiB reservation; two 4 KiB tracks fit after
; rounding up, and neither straddles a physical 64 KiB BIOS DMA boundary.
	mov	ax,offset buffer_space
	add	ax,15
	mov	cl,4
	shr	ax,cl
	mov	bx,ds
	add	ax,bx
	add	ax,0ffh
	and	ax,0ff00h
	mov	buffer_segment,ax
	add ax,100h
	mov verify_segment,ax
	mov	dx,offset msg_double
	cmp	byte ptr sides,1
	jz	show_capacity
	mov	dx,offset msg_single
show_capacity:
	call	puts
	mov	dx,offset msg_no_verify
	test	byte ptr options,opt_verify
	jz	show_verify_option
	mov	dx,offset msg_with_verify
show_verify_option:
	call	puts
	mov	dx,offset msg_confirm
	call	puts
	call	read_confirm
	cmp	al,'Y'
	jz	format_disk
	jmp	cancelled

;-----------------------------------------------------------------------------
; The replacement table is byte-for-byte DSKMAINT's eight-sector table.
; Keep it installed through format, boot-track write and optional verify.
;-----------------------------------------------------------------------------
format_disk:
	cmp	byte ptr os_mode,0
	jz	format_bios
	call	ccpm_lock
	jmp	format_ready
format_bios:
	call	install_vector
format_ready:
	mov	dx,offset msg_formatting
	call	puts
	mov	byte ptr track,0
format_loop:
	cmp	byte ptr os_mode,0
	jnz	format_ids_ready
	call	make_ids
format_ids_ready:
	mov	byte ptr operation,5
	call	disk_io
	inc	byte ptr track
	mov	al,track
	cmp	al,track_count
	jnz	format_loop

; Build the exact DSKMAINT track-zero image: E5 fill, boot code at zero,
; side flag at 1FFh and loader at 900h (sector five, offset 100h).
	mov	dx,offset msg_writing
	call	puts
	mov	es,word ptr buffer_segment
	xor	di,di
	mov	cx,1000h
	mov	al,0e5h
	cld
	rep	stosb
	xor	di,di
	mov	si,offset bootsect
	mov	cx,boot_end-bootsect
	rep	movsb
	mov	al,sides
	mov	es:byte ptr .1ffh,al
	mov	si,offset loader
	mov	di,900h
	mov	cx,loader_end-loader
	rep	movsb
; Select explicitly: either repository may supply the shared loader image.
	mov	al,2
	cmp	byte ptr os_mode,0
	jz	boot_loader_ready
	inc	al
boot_loader_ready:
	mov	es:byte ptr .951h,al
	mov	byte ptr track,0
	mov	byte ptr operation,3
	call	disk_io
	test	byte ptr options,opt_verify
	jz	format_complete

	mov	dx,offset msg_verifying
	call	puts
	mov	byte ptr track,0
	mov	byte ptr operation,4
verify_loop:
	call	disk_io
	inc	byte ptr track
	mov	al,track
	cmp	al,track_count
	jz format_complete
; All later tracks should retain the formatter's E5 fill.
	mov es,buffer_segment
	xor di,di
	mov ax,0e5e5h
	mov cx,800h
	rep stosw
	jmp verify_loop
format_complete:
	mov exit_status,0
	mov	dx,offset msg_complete
	call puts
	test options,opt_quick
	jz complete_verified
	mov dx,offset msg_unverified
	call puts
complete_verified:
	jmp cleanup

;-----------------------------------------------------------------------------
; Parse the bounded CP/M base-page tail. Drive comes first; options are one
; or more bracket groups, with an optional closing bracket on each group.
; A group may directly follow the drive or another closed group.
;-----------------------------------------------------------------------------
parse_args:
	xor	cx,cx
	mov	cl,byte ptr .80h
	mov	si,81h
	call	skip_spaces
	jnz	have_drive
	jmp	usage
have_drive:
	lodsb
	dec	cx
	and	al,0dfh
	sub	al,'A'
	cmp	al,2
	jc	letter_ok
	jmp	bad_drive
letter_ok:
	mov	drive,al
	add	al,'A'
	mov	prompt_drive,al
	jcxz	bad_syntax
	lodsb
	dec	cx
	cmp	al,':'
	jnz	bad_syntax
next_group:
	call	skip_spaces
	jz	args_done
	lodsb
	dec	cx
	cmp	al,'['
	jnz	bad_syntax
	xor	bl,bl		; a group must contain at least one option
next_option:
	jcxz	group_end
	mov	al,[si]
	cmp	al,']'
	jz	close_group
	cmp	al,' '
	jz	group_end
	cmp	al,9
	jz	group_end
	lodsb
	dec	cx
	inc	bl
	cmp	al,'1'
	jz	option_one
	cmp	al,'2'
	jz	option_two
	and	al,0dfh
	cmp al,'Q'
	je option_quick
	cmp	al,'V'
	jnz	bad_syntax
	or	byte ptr options,opt_verify
	jmp	next_option
option_quick:
	or byte ptr options,opt_quick
	jmp next_option
option_one:
	or	byte ptr options,opt_single
	jmp	next_option
option_two:
	or	byte ptr options,opt_double
	jmp	next_option
close_group:
	inc	si
	dec	cx
group_end:
	or	bl,bl
	jz	bad_syntax
	jmp	next_group
bad_syntax:
	mov	dx,offset msg_bad_syntax
	call	puts
	jmp	usage
args_done:
	mov al,options
	and al,opt_verify+opt_quick
	cmp al,opt_verify+opt_quick
	je bad_syntax
	test options,opt_quick
	jnz verify_option_ready
	or byte ptr options,opt_verify
verify_option_ready:
	mov	al,options
	and	al,3
	cmp	al,3
	jz	bad_syntax
	mov	byte ptr sides,1
	mov	byte ptr track_count,80
	test	al,opt_single
	jz	args_return
	mov	byte ptr sides,0
	mov	byte ptr track_count,40
args_return:
	ret

; Return ZF set at end of tail, clear if SI points at a non-space character.
skip_spaces:
	jcxz	spaces_end
	mov	al,[si]
	cmp	al,' '
	jz	skip_one
	cmp	al,9
	jnz	spaces_return
skip_one:
	inc	si
	dec	cx
	jmp	skip_spaces
spaces_end:
	xor	al,al
spaces_return:
	ret

bad_drive:
	mov	dx,offset msg_bad_drive
	call	puts
usage:
	mov	dx,offset msg_usage
	call	puts
	jmp	cleanup
wrong_os:
	mov	dx,offset msg_wrong_os
	call	puts
	jmp	cleanup
cancelled:
	mov exit_status,3
	mov	dx,offset msg_cancelled
	call	puts
	call partial_warning
	jmp	cleanup

;-----------------------------------------------------------------------------
; Raw console I/O has no automatic Ctrl-C termination. Flush type-ahead,
; then accept Y/N without echoing anything else. Ctrl-C uses normal cleanup.
;-----------------------------------------------------------------------------
read_confirm:
	mov	cl,f_rawio
flush_input:
	mov	dl,0ffh
	call	bdos
	or	al,al
	jnz	flush_input
wait_confirm:
	mov	dl,0ffh
	call	bdos
	or	al,al
	jz	wait_confirm
	cmp	al,3
	jz	cancelled
	and	al,0dfh
	cmp	al,'Y'
	jz	echo_confirm
	cmp	al,'N'
	jnz	wait_confirm
echo_confirm:
	push	ax
	mov	dl,al
	call	bdos
	mov	dx,offset msg_newline
	call	puts
	pop	ax
	ret

; DS:DX dollar string. Use raw function 6 even with the vector installed;
; neither type-ahead nor Ctrl-C can bypass cleanup inside a print call.
puts:
	push	ax
	push	cx
	push	dx
	push	si
	mov	si,dx
	mov	cl,f_rawio
puts_next:
	lodsb
	cmp	al,'$'
	jz	puts_return
	mov	dl,al
	call	bdos
	jmp	puts_next
puts_return:
	pop	si
	pop	dx
	pop	cx
	pop	ax
	ret

; AX carries the BDOS result; preserve ES and every disk/buffer cursor.
bdos:
	push	bx
	push	cx
	push	dx
	push	si
	push	di
	push	bp
	push	ds
	push	es
	int	i_bdos
	mov	result_es,es
	mov	result_bx,bx
	pop	es
	pop	ds
	pop	bp
	pop	di
	pop	si
	pop	dx
	pop	cx
	pop	bx
	cld
	ret

;-----------------------------------------------------------------------------
; BIOS entry saves the request registers, ES and DS; AX/CF return status.
; Rebuild the request on each retry rather than trusting firmware registers.
;-----------------------------------------------------------------------------
bios:
	push	bx
	push	cx
	push	dx
	push	si
	push	di
	push	bp
	push	ds
	push	es
	int	13h
	pop	es
	pop	ds
	pop	bp
	pop	di
	pop	si
	pop	dx
	pop	cx
	pop	bx
	ret

; DSKMAINT's logical track order reverses cylinders on the second head.
track_chs:
	mov	ch,track
	xor	dh,dh
	cmp	ch,40
	jc	chs_return
	neg	ch
	add	ch,79
	mov	dh,1
chs_return:
	ret

make_ids:
	call	track_chs
	mov	dl,ch
	mov	es,word ptr buffer_segment
	xor	di,di
	mov	bx,201h
	mov	cx,8
	cld
id_loop:
	mov	ax,dx
	stosw
	mov	ax,bx
	stosw
	inc	bx
	loop	id_loop
	ret

disk_io:
	mov	byte ptr retries,5
io_attempt:
	mov	cl,f_rawio
	mov	dl,0ffh
	call	bdos
	cmp	al,3
	jnz	io_request
	jmp	cancelled
io_request:
	mov	byte ptr disk_touched,1
	cmp	byte ptr os_mode,0
	jz	io_bios
	call	ccpm_io
	jc	io_failed
	call compare_verify
	jc io_failed
	ret
io_bios:
	call	track_chs
	mov	cl,1
	mov	dl,drive
	xor	bx,bx
	mov	es,word ptr buffer_segment
	mov	ah,operation
	mov al,8
	cmp ah,4
	jne bios_request_ready
	mov ah,2
	mov es,verify_segment
bios_request_ready:
	mov byte ptr disk_touched,1
	call	bios
	jc	io_failed
	cld
	call compare_verify
	jc io_failed
	ret
io_failed:
	mov	last_status,ah
	cmp	byte ptr os_mode,0
	jnz	io_retry_count
	xor	ah,ah
	mov	dl,drive
	call	bios
io_retry_count:
	dec	byte ptr retries
	jnz	io_attempt

; Report the final BIOS status, then restore the parameter vector and exit.
	mov	al,last_status
	mov	ah,al
	mov	cl,4
	shr	al,cl
	call	hex_digit
	mov	status_hi,al
	mov	al,ah
	and	al,0fh
	call	hex_digit
	mov	status_lo,al
	mov	dx,offset msg_io_error
	call	puts
	call report_location
	call partial_warning
	jmp	cleanup
hex_digit:
	add	al,'0'
	cmp	al,'9'
	jbe	hex_return
	add	al,7
hex_return:
	ret

;-----------------------------------------------------------------------------
; Patch the four-byte IVT pointer atomically, preserving interrupt state.
; Never leave our table installed on success, cancellation or disk errors.
;-----------------------------------------------------------------------------
install_vector:
	xor	ax,ax
	mov	es,ax
	mov	ax,es:word ptr .78h
	mov	old_offset,ax
	mov	ax,es:word ptr .7ah
	mov	old_segment,ax
	pushf
	cli
	mov	ax,offset disk_params
	mov	es:word ptr .78h,ax
	mov	ax,ds
	mov	es:word ptr .7ah,ax
	mov	byte ptr vector_active,1
	popf
	xor	ah,ah
	mov	dl,drive
	call	bios
	ret

cleanup:
	cmp	byte ptr os_mode,0
	jz	cleanup_bios
	call	ccpm_finish
	jmp	quit
cleanup_bios:
	cmp	byte ptr vector_active,0
	jz	cleanup_login
	xor	ax,ax
	mov	es,ax
	pushf
	cli
	mov	ax,old_offset
	mov	es:word ptr .78h,ax
	mov	ax,old_segment
	mov	es:word ptr .7ah,ax
	popf
	mov	byte ptr vector_active,0
	xor	ah,ah
	mov	dl,drive
	call	bios
cleanup_login:
	cmp	byte ptr disk_touched,0
	jz	quit
	mov	dx,1
	mov	cl,drive
	shl	dx,cl
	mov	cl,f_resetdrive
	call	bdos
quit:
	cmp return_code_supported,0
	je quit_without_status
	mov dx,exit_status
	mov cl,108
	call bdos
quit_without_status:
	xor	dx,dx
	mov	cl,f_reset
	int	i_bdos

 ; CDOS 4.1 supplies function 108; CP/M 1.1 and CCP/M 3.1 do not.
; Detect independently of formatter support, including early syntax exits.
detect_return_code:
	mov cl,12
	call bdos
	and ah,0fh
	cmp ah,4
	je return_version
	cmp ah,6
	jne return_detection_done
return_version:
	mov cl,163
	call bdos
	cmp ax,1441h
	jne return_detection_done
	mov return_code_supported,1
return_detection_done:
	ret

compare_verify:
	cmp operation,4
	je compare_verify_data
	clc
	ret
compare_verify_data:
	push ds ! push es ! push si ! push di ! push cx
	mov ax,buffer_segment
	mov es,verify_segment
	mov ds,ax
	xor si,si
	xor di,di
	mov cx,800h
	cld
	repe cmpsw
	pop cx ! pop di ! pop si ! pop es ! pop ds
	jne verify_mismatch
	clc
	ret
verify_mismatch:
	mov ah,10h
	stc
	ret

report_location:
	call track_chs
	add dh,'0'
	mov error_head,dh
	xor ax,ax
	mov al,ch
	mov bl,10
	div bl
	add ax,3030h
	mov error_cylinder,al
	mov error_cylinder+1,ah
	mov dx,offset msg_format_op
	cmp operation,5
	je print_operation
	mov dx,offset msg_write_op
	cmp operation,3
	je print_operation
	mov dx,offset msg_verify_op
print_operation:
	call puts
	mov dx,offset msg_location
	call puts
	ret
partial_warning:
	cmp disk_touched,0
	je partial_done
	mov dx,offset msg_partial
	call puts
partial_done:
	ret

; ---- data ----
	dseg
os_mode		db	0
options		db	0
drive		db	0
sides		db	1
track_count	db	80
track		db	0
operation	db	0
retries		db	0
last_status	db	0
vector_active	db	0
disk_touched	db	0
buffer_segment	dw	0
verify_segment dw 0
return_code_supported db 0
exit_status dw 2
old_offset	dw	0
old_segment	dw	0
; Same bytes as the parameter table embedded in DSKMAINT.
disk_params	db	0cfh,02h,25h,02h,08h,2ah,0ffh,50h,0e5h,19h,04h

msg_format_op db 'Format', '$'
msg_write_op db 'Write', '$'
msg_verify_op db 'Verify', '$'
msg_location db ' failed at cylinder '
error_cylinder db '00'
 db ', head '
error_head db '0',13,10,'$'
msg_partial db 'Disk may be partially formatted or unusable.',13,10,'$'
msg_unverified db 'Warning: data was not verified.',13,10,'$'
msg_banner	db	13,10,'CP/M-86 / CCP/M-86 FLOPPY FORMATTER VER 1.0N',13,10,'$'
msg_usage	db	'USAGE: DFORM drive: { [options] ... }',13,10,13,10
	db	'  A: or B:  Target floppy drive (required)',13,10
	db	'  1         Single-sided, 160K',13,10
	db	'  2         Double-sided, 320K (default)',13,10
	db	'  V         Verify after formatting (default)',13,10
	db '  Q         Quick format: skip verification',13,10
	db	'  Combine options: [1V] or [1] [V; closing ] is optional.',13,10
	db	'  Examples: DFORM A:[1V]   DFORM B: [V',13,10,'$'
msg_single	db	'160K, single-sided; $'
msg_double	db	'320K, double-sided; $'
msg_with_verify	db	'verification enabled.',13,10,'$'
msg_no_verify	db	'verification disabled.',13,10,'$'
msg_confirm	db	'Format drive '
prompt_drive	db	'A'
	db	': (all data will be lost). Continue (Y/N)? $'
msg_newline	db	13,10,'$'
msg_formatting	db	'Formatting...',13,10,'$'
msg_writing	db	'Writing boot track...',13,10,'$'
msg_verifying	db	'Verifying...',13,10,'$'
msg_complete	db	'Format complete.',13,10,'$'
msg_cancelled	db	13,10,'Cancelled.',13,10,'$'
msg_bad_syntax	db	'Invalid parameter.',13,10,'$'
msg_bad_drive	db	'Invalid drive specification.',13,10,'$'
msg_wrong_os	db	'DFORM requires CP/M-86 1.1 or Concurrent CP/M-86 3.1.',13,10,'$'
msg_io_error	db	'Disk operation failed; BIOS/XIOS status '
status_hi	db	'0'
status_lo	db	'0'
	db	'.',13,10,'$'

; Shared generated images; lengths follow the source images automatically.
bootsect:
	include	bootsect.inc
boot_end:
loader:
	include	loader.inc
loader_end:

stack_space	rs	stack_size
stack_top:
; Alignment padding plus separate 4096-byte expected/read-back buffers.
buffer_space	rs	3000h
	include	ccpmio.a86
	end
