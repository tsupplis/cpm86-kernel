;***********************************************************
;  MFORM.A86 - CP/M-86 memory drive formatter
;  Derived from the CompuPro "MXdisk" formatter; BIOS path only.
;  Reconstructed from ndisasm output, for RASM-86 (CP/M-86)
;
;  Build:   pcdev_rasm86 mform
;           pcdev_linkcmd mform [$sz, nofill, data[additional[220]]]
;  (220h extra paragraphs past the CMD image; runtime secbuf at 380h,
;   dirbuf at 400h, worst-case directory ends at 2400h)
;
;  Usage:   MFORM drive[option]
;           X         confirmation required
;           X!        LLO present no prompt
;           X-        forced format, quiet banner/messages; confirms Y/N
;***********************************************************

; ---- BDOS / BIOS numbers -----------------------------------
f_conin         equ     1
f_print         equ     9
f_version       equ     12
f_getdpb        equ     31
f_dirbios       equ     50

bio_seldsk      equ     9
bio_settrk      equ     10
bio_setsec      equ     11
bio_setdma      equ     12
bio_read        equ     13
bio_write       equ     14
bio_setdmab     equ     17

;***********************************************************
;  CODE SEGMENT
;***********************************************************
        cseg
        org     0

        jmp     start
cprbanner db    'REV 1.2 2-9-83COPYRIGHT (C) 1982 COMPUPRO div. GODBOUT ELECTRONICS'

; ---- parse command tail at DS:80h --------------------------
start:
; Reject multitasking systems before any drive access or format prompt.
; Their XIOS interface is not the CP/M-86 BDOS 50 BIOS interface.
        mov     cx,f_version
        int     0e0h
        test    bh,0f0h
        jz      plaincpm
        jmp     wrongos
plaincpm:
        mov     quietflag,0
        mov     bx,80h
        mov     cl,[bx]                 ; tail length
skipsp:
        inc     bx
        dec     cl
        jns     havechr
        jmp     nodrive                 ; tail exhausted
havechr:
        mov     al,[bx]
        cmp     al,' '
        jz      skipsp
        cmp     al,'$'
        jnz     gotdrv
        jmp     nodrive
gotdrv:
        and     al,5fh                  ; upper case
        sub     al,'A'
        cmp     al,16
        jc      drvok
        jmp     baddrv                  ; not A..P
drvok:
        mov     drive,al
        inc     bx
        mov     al,[bx]
        cmp     al,'!'
        jz      nocnf
        cmp     al,'-'
        jnz     notquiet
        mov     quietflag,1             ; '-' suffix: quiet mode
        jmps    docnf
notquiet:
        mov     dx,offset msg_banner    ; banner before confirm prompt
        call    print
docnf:
        call    confirm
nocnf:

; ---- plain CP/M-86: DPB via BIOS SELDSK --------------------
        mov     cx,f_getdpb             ; only used to get ES
        int     0e0h
        push    es
        mov     cl,drive
        mov     dx,0
        mov     al,bio_seldsk
        call    bios
        pop     es
        or      bx,bx
        jnz     gotdph
        jmp     done                    ; bad drive, exit quietly
gotdph:
        add     bx,10                   ; DPH+10 -> DPB pointer
        mov     bx,es:[bx]
        jmp     chkmem

; ---- byte before DPB must be >= 80h for a memory drive -----
chkmem:
        dec     bx
        mov     al,es:[bx]
        cmp     al,80h
        jnc     ismem
        jmp     notmem
ismem:
        push    bx
        push    es
        mov     al,confirmed
        or      al,al
        jnz     dofmt                   ; user said Y: force format

; ---- '!' mode: look for signature at trk 3, sec 0 ----------
        mov     cl,0
        mov     al,bio_setsec
        call    bios
        mov     cx,3
        mov     al,bio_settrk
        call    bios
        mov     bx,offset secbuf
        mov     dmaoff,bx
        mov     cx,bx
        mov     al,bio_setdma
        call    bios
        mov     cx,ds
        mov     al,bio_setdmab
        call    bios
        mov     al,bio_read
        call    bios
        mov     bx,dmaoff
        mov     cx,7dh
        add     bx,cx
        mov     dl,3
        mov     cx,offset sig
sigchk:
        mov     si,cx
        mov     al,[si]
        cmp     al,[bx]
        jnz     dofmt
        inc     bx
        inc     cx
        dec     dl
        jnz     sigchk
        jmp     done                    ; already formatted

; ---- do the format -----------------------------------------
dofmt:
        mov     al,quietflag
        or      al,al
        jnz     dofmt1
        mov     dx,offset msgfmt
        call    print
dofmt1:
        pop     es
        pop     bx                      ; BX = DPB-1
        inc     bx
        mov     dx,es:[bx]              ; SPT
        mov     spt,dx
        mov     cx,7
        add     bx,cx
        mov     ax,es:[bx]              ; DRM
        inc     ax
        mov     cl,4
        div     cl                      ; dir sectors = (DRM+1)/4
        mov     dirsecs,ax
        mov     cx,6
        add     bx,cx
        mov     dx,es:[bx]              ; OFF (first dir track)
        inc     bx
        mov     trk0,dx

; pass 1: read all directory sectors into DS:0400h onward
        mov     cx,0
        mov     bx,dirsecs
        mov     loopctr,bx
        mov     bx,offset secbuf
        mov     dmaoff,bx
rdloop:
        push    dx
        push    cx
        mov     cx,dx
        mov     al,bio_settrk
        call    bios
        pop     cx
        push    cx
        mov     al,bio_setsec
        call    bios
        mov     bx,dmaoff
        add     bx,80h
        mov     dmaoff,bx
        mov     cx,bx
        mov     al,bio_setdma
        call    bios
        mov     cx,ds
        mov     al,bio_setdmab
        call    bios
        mov     al,bio_read
        call    bios
        pop     cx
        pop     dx
        inc     cx
        cmp     cx,spt
        jl      rd1
        mov     cx,0
        inc     dx
rd1:
        mov     bx,loopctr
        dec     bx
        mov     loopctr,bx
        or      bx,bx
        jz      rddone
        jmp     rdloop
rddone:

; pass 2: mark every 32-byte entry as deleted (E5h)
        mov     ax,dirsecs
        mov     cx,4
        mul     cx
        mov     cx,ax                   ; total entries
        mov     bx,3e0h                 ; dirbuf - 20h
        mov     dx,20h
mark:
        add     bx,dx
        mov     byte ptr [bx],0e5h
        dec     cx
        or      cx,cx
        jnz     mark

; pass 3: write the sectors back
        mov     dx,trk0
        mov     cx,0
        mov     bx,dirsecs
        mov     loopctr,bx
        mov     bx,offset secbuf
        mov     dmaoff,bx
wrloop:
        push    dx
        push    cx
        mov     cx,dx
        mov     al,bio_settrk
        call    bios
        pop     cx
        push    cx
        mov     al,bio_setsec
        call    bios
        mov     bx,dmaoff
        add     bx,80h
        mov     dmaoff,bx
        mov     cx,bx
        mov     al,bio_setdma
        call    bios
        mov     cx,ds
        mov     al,bio_setdmab
        call    bios
        mov     al,bio_write
        call    bios
        pop     cx
        pop     dx
        inc     cx
        cmp     cx,spt
        jl      wr1
        mov     cx,0
        inc     dx
wr1:
        mov     bx,loopctr
        dec     bx
        mov     loopctr,bx
        or      bx,bx
        jz      wrdone
        jmp     wrloop
wrdone:

; stamp signature 'LLO' at offset 7Dh of trk 3, sec 0
        mov     cl,0
        mov     al,bio_setsec
        call    bios
        mov     cx,3
        mov     al,bio_settrk
        call    bios
        mov     bx,offset secbuf
        mov     dmaoff,bx
        mov     cx,bx
        mov     al,bio_setdma
        call    bios
        mov     cx,ds
        mov     al,bio_setdmab
        call    bios
        mov     al,bio_read
        call    bios
        mov     bx,dmaoff
        mov     cx,7dh
        add     bx,cx
        mov     cx,offset sig
        mov     dl,3
sigcpy:
        mov     si,cx
        mov     al,[si]
        mov     [bx],al
        inc     bx
        inc     cx
        dec     dl
        jnz     sigcpy
        mov     al,bio_write
        call    bios
        jmps    done

;-----------------------------------------------------------
;  BIOS call wrapper.  AL = function, CX/DX = arguments
;-----------------------------------------------------------
bios:
        mov     bx,offset biosblk       ; single-task: BDOS 50
        mov     [bx],al
        mov     1[bx],cx
        mov     3[bx],dx
        mov     cl,f_dirbios
        mov     dx,bx
        int     0e0h
        ret
;-----------------------------------------------------------
;  Ask Y/N.  Anything but Y exits.
;-----------------------------------------------------------
confirm:
        mov     dx,offset msgcnf
        call    print
        mov     cl,f_conin
        int     0e0h
        and     al,0dfh
        cmp     al,'Y'
        jnz     done
        mov     confirmed,0ffh
        ret

;-----------------------------------------------------------
;  Error exits / termination
;-----------------------------------------------------------
baddrv:
        mov     dx,offset msginv
        jmps    pmsg
nodrive:
        mov     dx,offset msg_banner
        call    print
        mov     dx,offset msg_usage
        call    print
        jmps    done
wrongos:
        mov     dx,offset msgwrongos
        jmps    pmsg
notmem:
        mov     dx,offset msgnotmem
pmsg:
        call    print
done:
        mov     cl,0                    ; P_TERMCPM
        mov     dl,0
        int     0e0h
        ret

;-----------------------------------------------------------
;  Print $-terminated string at DS:DX, preserves registers
;-----------------------------------------------------------
print:
        push    ax
        push    cx
        push    dx
        push    bx
        mov     cl,f_print
        int     0e0h
        pop     bx
        pop     dx
        pop     cx
        pop     ax
        ret

;***********************************************************
;  DATA SEGMENT  (offsets 0-0FFh = CP/M-86 base page)
;***********************************************************
        dseg
; LINK-86 already gives DGROUP an origin of 100h (Utilities Guide table 7-5),
; so offsets here are relative to that; the comments give the runtime offset.
        org     0

confirmed db    0
sig       db    'LLO'
msg_banner db   0dh,0ah,'CP/M-86 MFORM VER 1.1N',0dh,0ah,0dh,0ah,'$'
msg_usage  db   'USAGE: MFORM drive[option]',0dh,0ah
           db   '  X         confirmation required',0dh,0ah
           db   '  X!        LLO present no prompt',0dh,0ah
           db   '  X-        quiet format, confirms Y/N',0dh,0ah,'$'
msginv    db    'INVALID DRIVE',0dh,0ah,'$'
msgnodrv  db    'NO DRIVE SPECIFIED',0dh,0ah,'$'
msgnotmem db    'DRIVE SPECIFIED IS NOT A MEMORY DRIVE',0dh,0ah,'$'
msgfmt    db    0dh,0ah,'FORMATTING MEMORY DRIVE',0ah,0dh,'$'
msgcnf    db    'CONFIRM DESTROY ALL FILES ON THE MEMORY DRIVE (Y or N)? $'
msgwrongos db  0dh,0ah,'MFORM requires single-tasking CP/M-86.',0dh,0ah,'$'

quietflag db    0                       ; 0 = normal, 1 = quiet (no banner/msgs)
biosblk   db    0,0,0,0,0               ; func, CX, DX for BDOS 50
drive     db    0
dirsecs   dw    0
loopctr   dw    0
spt       dw    0
trk0      dw    0
dmaoff    dw    0

; NOFILL drops everything from here on out of the CMD image; the loader
; supplies it via the data group's minimum allocation.
        org     280h
secbuf    rs    128                     ; 380h  one sector
dirbuf    rs    1                       ; 400h  directory image grows from here

        end
