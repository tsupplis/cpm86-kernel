# cpmtools disk definitions for this project.
# cpmtools reads ./diskdefs in preference to the system-wide file and does NOT
# merge the two, so every format used from the repo root must be listed here.

# IBM CP/M-86 160K single sided (BIOS DPBK1: SPT=32, BSH=3/BLM=7, DSM=155,
# DRM=63, OFF=1). Single sided, so CP/M track == cylinder == linear image order.
# setfdprm /dev/fd1 sect=8 dtr=1 hd ssize=512 tpi=48 head=1
diskdef ibmpc-514ss
   seclen 512
   tracks 40
   sectrk 8
   blocksize 1024
   maxdir 64
   skew 1
   boottrk 1
   os 2.2
   libdsk:format ibm160
end

# IBM CP/M-86 320K double sided (BIOS DPBK2: SPT=32, BSH=4/BLM=15/EXM=1,
# DSM=157, DRM=63, OFF=1).
# NOTE: this describes the CP/M *logical* track order. On a physical disk the
# BIOS lays side 1 down in reverse cylinder order (pcbios.a86 SETUP_INTREG:
# track<40 -> cyl=track/head 0; else cyl=79-track/head 1), so a raw CHS image
# must be run through tools/cpm86twist.py before and after using cpmtools.
# Replaces the stock ibmpc-514ds, which assumes a linear layout and 156 blocks.
diskdef cpm86-320
  seclen 512
  tracks 80
  sectrk 8
  blocksize 2048
  maxdir 64
  skew 1
  boottrk 1
  os 2.2
end

# CP/M-86 on 1.44MB floppies with the "1.44 MB Feature" (Freek Heite).
# Tracks 0 and 1 are reserved for the boot sector and the DOS/stock-CP/M
# camouflage, so the directory starts on track 2.
diskdef cpm86-144feat
  seclen 512
  tracks 160
  sectrk 18
  blocksize 4096
  maxdir 256
  skew 1
  boottrk 2
  os 2.2
  libdsk:format ibm1440
end

# Same feature on 720K 3.5" floppies (144tech.md, "DPB for 720 KB":
# SPT=36, BSH=4/BLM=15, DSM=354, DRM=255, OFF=2).
# os 2.2 matches the kernel's BDOS level and keeps mkfs.cpm from writing a
# CP/M Plus disk label into the directory.
diskdef cpm86-720feat
  seclen 512
  tracks 160
  sectrk 9
  blocksize 2048
  maxdir 256
  skew 1
  boottrk 2
  os 2.2
  libdsk:format ibm720
end

# CP/M-86 hard disk partition (IBM XT, 16 heads x 63 sectors, 10 MB drive).
#
# Unlike the floppy formats these values are not compiled into the BIOS: they
# are read at boot from a Digital Research hard disk label. CHKHDDPAR in
# pcbios.a86 scans the MBR for a partition of type 0DBh, reads that partition's
# cylinder / head 0 / sector 4, verifies the 256-word checksum is zero, and
# copies the DPB out of the label at offset 41. A different drive will carry a
# different label, so re-read it rather than assuming these numbers.
#
# For this image the label yields:
#   SPT=252 (=63 physical sectors of 512), BSH=5/BLM=31/EXM=1 (4K blocks),
#   DSM=2015, DRM=2047, AL0=AL1=0FFh (16 dir blocks), CKS=8000h, OFF=16.
#
# CP/M tracks are counted from LBA 0 of the *drive*, not from the partition,
# so OFF=16 covers the whole of cylinder 0 (16 heads x 63) and the directory
# starts at LBA 1008. boottrk therefore replaces any offset, and the def is
# applied to the raw disk image rather than to an extracted partition.
#
#   tracks = boottrk + (DSM+1) * blocksize / (seclen * sectrk)
#          = 16 + 2016 * 4096 / 32256 = 16 + 256 = 272
diskdef cpm86-xt-hd
  seclen 512
  tracks 272
  sectrk 63
  blocksize 4096
  maxdir 2048
  skew 1
  boottrk 16
  os 2.2
end
