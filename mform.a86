;***********************************************************
;  MXFORMAT.A86 - CompuPro "MXdisk" memory drive formatter
;  Reconstructed from ndisasm output, for RASM-86 (CP/M-86)
;
;  Build:   RASM86 MXFORMAT
;           GENCMD MXFORMAT DATA[M900]
;  (M = minimum extra paragraphs, hex; the directory image at
;   DS:0400h needs (DRM+1)*32 bytes, adjust as needed)
;
;  Usage:   MXFORMAT X     format drive X after Y/N confirm
;           MXFORMAT X!    format only if signature 'LLO' is
;                          not already present (no prompt)
;***********************************************************

; ---- BDOS / BIOS numbers -----------------------------------
f_conin         equ     1
f_print         equ     9
f_seldsk        equ     14
f_version       equ     12
f_getdpb        equ     31
f_errmode       equ     45
f_dirbios       equ     50
f_openq         equ     135
f_readq         equ     137
f_writeq        equ     139
f_sysdata       equ     154

bio_seldsk      equ     9
bio_settrk      equ     10
bio_setsec      equ     11
bio_setdma      equ     12
bio_read        equ     13
bio_write       equ     14
bio_setdmab     equ     17

;***********************************************************
;  CODE SEGMENT
;***********************************************************
        cseg
        org     0

        jmp     start
banner  db      'REV 1.2 2-9-83COPYRIGHT (C) 1982 COMPUPRO div. GODBOUT ELECTRONICS'

; ---- parse command tail at DS:80h --------------------------
start:
        mov     bx,80h
        mov     cl,[bx]                 ; tail length
skipsp:
        inc     bx
        dec     cl
        jns     havechr
        jmp     nodrive                 ; tail exhausted
havechr:
        mov     al,[bx]
        cmp     al,' '
        jz      skipsp
        cmp     al,'$'
        jnz     gotdrv
        jmp     nodrive
gotdrv:
        and     al,5fh                  ; upper case
        sub     al,'A'
        cmp     al,16
        jc      drvok
        jmp     baddrv                  ; not A..P
drvok:
        mov     drive,al
        inc     bx
        mov     al,[bx]
        cmp     al,'!'
        jz      nocnf
        call    confirm
nocnf:
        mov     mtflag,0

; ---- single-task or multitasking? --------------------------
        mov     cx,f_version
        int     0e0h
        and     bh,0f0h
        or      bh,bh
        jnz     mtdisk

; ---- plain CP/M-86: DPB via BIOS SELDSK --------------------
        mov     cx,f_getdpb             ; only used to get ES
        int     0e0h
        push    es
        mov     cl,drive
        mov     dx,0
        mov     al,bio_seldsk
        call    bios
        pop     es
        or      bx,bx
        jnz     gotdph
        jmp     done                    ; bad drive, exit quietly
gotdph:
        add     bx,10                   ; DPH+10 -> DPB pointer
        mov     bx,es:[bx]
        jmp     chkmem

; ---- multitasking: open queue, select drive, get DPB -------
mtdisk:
        mov     mtflag,1
        mov     cl,f_sysdata
        int     0e0h
        mov     bx,es
        mov     xiosseg,bx
        mov     cl,f_openq
        mov     dx,offset qpb
        int     0e0h
        or      ax,ax
        jz      qopen
        jmp     qerr
qopen:
        mov     cl,f_errmode
        mov     dl,0ffh
        int     0e0h
        mov     cl,f_seldsk
        mov     dl,drive
        int     0e0h
        mov     cl,f_seldsk
        mov     dl,drive
        int     0e0h
        cmp     ah,4
        jnz     getdpb
        jmp     done
getdpb:
        mov     cx,f_getdpb
        int     0e0h

; ---- byte before DPB must be >= 80h for a memory drive -----
chkmem:
        dec     bx
        mov     al,es:[bx]
        cmp     al,80h
        jnc     ismem
        jmp     notmem
ismem:
        push    bx
        push    es
        mov     al,confirmed
        or      al,al
        jnz     dofmt                   ; user said Y: force format

; ---- '!' mode: look for signature at trk 3, sec 0 ----------
        call    qlock
        mov     cl,0
        mov     al,bio_setsec
        call    bios
        mov     cx,3
        mov     al,bio_settrk
        call    bios
        mov     bx,offset secbuf
        mov     dmaoff,bx
        mov     cx,bx
        mov     al,bio_setdma
        call    bios
        mov     cx,ds
        mov     al,bio_setdmab
        call    bios
        mov     al,bio_read
        call    bios
        call    qunlock
        mov     bx,dmaoff
        mov     cx,7dh
        add     bx,cx
        mov     dl,3
        mov     cx,offset sig
sigchk:
        mov     si,cx
        mov     al,[si]
        cmp     al,[bx]
        jnz     dofmt
        inc     bx
        inc     cx
        dec     dl
        jnz     sigchk
        jmp     done                    ; already formatted

; ---- do the format -----------------------------------------
dofmt:
        mov     dx,offset msgfmt
        call    print
        pop     es
        pop     bx                      ; BX = DPB-1
        inc     bx
        mov     dx,es:[bx]              ; SPT
        mov     spt,dx
        mov     cx,7
        add     bx,cx
        mov     ax,es:[bx]              ; DRM
        inc     ax
        mov     cl,4
        div     cl                      ; dir sectors = (DRM+1)/4
        mov     dirsecs,ax
        mov     cx,6
        add     bx,cx
        mov     dx,es:[bx]              ; OFF (first dir track)
        inc     bx
        mov     trk0,dx

; pass 1: read all directory sectors into DS:0400h onward
        mov     cx,0
        mov     bx,dirsecs
        mov     loopctr,bx
        mov     bx,offset secbuf
        mov     dmaoff,bx
rdloop:
        push    dx
        push    cx
        call    qlock
        mov     cx,dx
        mov     al,bio_settrk
        call    bios
        pop     cx
        push    cx
        mov     al,bio_setsec
        call    bios
        mov     bx,dmaoff
        add     bx,80h
        mov     dmaoff,bx
        mov     cx,bx
        mov     al,bio_setdma
        call    bios
        mov     cx,ds
        mov     al,bio_setdmab
        call    bios
        mov     al,bio_read
        call    bios
        call    qunlock
        pop     cx
        pop     dx
        inc     cx
        cmp     cx,spt
        jl      rd1
        mov     cx,0
        inc     dx
rd1:
        mov     bx,loopctr
        dec     bx
        mov     loopctr,bx
        or      bx,bx
        jz      rddone
        jmp     rdloop
rddone:

; pass 2: mark every 32-byte entry as deleted (E5h)
        mov     ax,dirsecs
        mov     cx,4
        mul     cx
        mov     cx,ax                   ; total entries
        mov     bx,3e0h                 ; dirbuf - 20h
        mov     dx,20h
mark:
        add     bx,dx
        mov     byte ptr [bx],0e5h
        dec     cx
        or      cx,cx
        jnz     mark

; pass 3: write the sectors back
        mov     dx,trk0
        mov     cx,0
        mov     bx,dirsecs
        mov     loopctr,bx
        mov     bx,offset secbuf
        mov     dmaoff,bx
wrloop:
        push    dx
        push    cx
        call    qlock
        mov     cx,dx
        mov     al,bio_settrk
        call    bios
        pop     cx
        push    cx
        mov     al,bio_setsec
        call    bios
        mov     bx,dmaoff
        add     bx,80h
        mov     dmaoff,bx
        mov     cx,bx
        mov     al,bio_setdma
        call    bios
        mov     cx,ds
        mov     al,bio_setdmab
        call    bios
        mov     al,bio_write
        call    bios
        call    qunlock
        pop     cx
        pop     dx
        inc     cx
        cmp     cx,spt
        jl      wr1
        mov     cx,0
        inc     dx
wr1:
        mov     bx,loopctr
        dec     bx
        mov     loopctr,bx
        or      bx,bx
        jz      wrdone
        jmp     wrloop
wrdone:

; stamp signature 'LLO' at offset 7Dh of trk 3, sec 0
        call    qlock
        mov     cl,0
        mov     al,bio_setsec
        call    bios
        mov     cx,3
        mov     al,bio_settrk
        call    bios
        mov     bx,offset secbuf
        mov     dmaoff,bx
        mov     cx,bx
        mov     al,bio_setdma
        call    bios
        mov     cx,ds
        mov     al,bio_setdmab
        call    bios
        mov     al,bio_read
        call    bios
        mov     bx,dmaoff
        mov     cx,7dh
        add     bx,cx
        mov     cx,offset sig
        mov     dl,3
sigcpy:
        mov     si,cx
        mov     al,[si]
        mov     [bx],al
        inc     bx
        inc     cx
        dec     dl
        jnz     sigcpy
        mov     al,bio_write
        call    bios
        call    qunlock
        jmps    done

;-----------------------------------------------------------
;  BIOS call wrapper.  AL = function, CX/DX = arguments
;-----------------------------------------------------------
bios:
        mov     bl,mtflag
        or      bl,bl
        jnz     bios_mt
        mov     bx,offset biosblk       ; single-task: BDOS 50
        mov     [bx],al
        mov     1[bx],cx
        mov     3[bx],dx
        mov     cl,f_dirbios
        mov     dx,bx
        int     0e0h
        ret
bios_mt:
        dec     al                      ; multitasking: far call
        dec     al                      ; into XIOS, funcs shifted by 2
        callf   dword ptr xiosoff
        ret

;-----------------------------------------------------------
;  Ask Y/N.  Anything but Y exits.
;-----------------------------------------------------------
confirm:
        mov     dx,offset msgcnf
        call    print
        mov     cl,f_conin
        int     0e0h
        and     al,0dfh
        cmp     al,'Y'
        jnz     done
        mov     confirmed,0ffh
        ret

;-----------------------------------------------------------
;  Error exits / termination
;-----------------------------------------------------------
baddrv:
        mov     dx,offset msginv
        jmps    pmsg
nodrive:
        mov     dx,offset msgnodrv
        jmps    pmsg
qerr:
        mov     dx,offset msgqerr
        jmps    pmsg
notmem:
        mov     dx,offset msgnotmem
pmsg:
        call    print
done:
        mov     cl,0                    ; P_TERMCPM
        mov     dl,0
        int     0e0h
        ret

;-----------------------------------------------------------
;  Print $-terminated string at DS:DX, preserves registers
;-----------------------------------------------------------
print:
        push    ax
        push    cx
        push    dx
        push    bx
        mov     cl,f_print
        int     0e0h
        pop     bx
        pop     dx
        pop     cx
        pop     ax
        ret

;-----------------------------------------------------------
;  Queue "lock" = read queue, "unlock" = write queue.
;  No-ops on single-task systems.
;-----------------------------------------------------------
qlock:
        push    ax
        push    cx
        push    dx
        mov     al,mtflag
        or      al,al
        jz      qlk1
        mov     cl,f_readq
        mov     dx,offset qpb
        int     0e0h
        or      ax,ax
        jz      qlk1
        pop     dx
        pop     cx
        pop     ax
        jmps    qerr
qlk1:
        pop     dx
        pop     cx
        pop     ax
        ret

qunlock:
        push    ax
        push    cx
        push    dx
        mov     al,mtflag
        or      al,al
        jz      qul1
        mov     cx,f_writeq
        mov     dx,offset qpb
        int     0e0h
        or      ax,ax
        jz      qul1
        pop     dx
        pop     cx
        pop     ax
        jmp     qerr
qul1:
        pop     dx
        pop     cx
        pop     ax
        ret

;***********************************************************
;  DATA SEGMENT  (offsets 0-0FFh = CP/M-86 base page)
;***********************************************************
        dseg
; LINK-86 already gives DGROUP an origin of 100h (Utilities Guide table 7-5),
; so offsets here are relative to that; the comments give the runtime offset.
        org     0

confirmed db    0                       ; 100h  FF = user said Y
sig       db    'LLO'                   ; 101h  format signature
mtflag    db    0                       ; 104h  1 = multitasking
qpb       db    0,0,0,0,0,0,15h,01h     ; 105h  queue parameter block
qname     db    'MXdisk  '              ; 10Dh  queue name
          db    0,0,0,0,0               ; 115h  (rest of QPB)
xiosoff   dw    1003h                   ; 11Ah  far ptr: offset
xiosseg   dw    0                       ; 11Ch          segment (runtime)

msginv    db    'INVALID DRIVE',0dh,0ah,'$'                        ; 11Eh
msgnodrv  db    'NO DRIVE SPECIFIED',0dh,0ah,'$'                   ; 12Eh
msgnotmem db    'DRIVE SPECIFIED IS NOT A MEMORY DRIVE',0dh,0ah,'$' ; 143h
msgfmt    db    0dh,0ah,'FORMATTING MEMORY DRIVE',0ah,0dh,'$'      ; 16Bh
msgcnf    db    'CONFIRM DESTROY ALL FILES ON THE MEMORY DRIVE (Y or N)? $' ; 187h
msgqerr   db    0dh,0ah,'ERROR IN GETTING MXdisk QUEUE','$'        ; 1C0h

biosblk   db    0,0,0,0,0               ; 1E0h  func, CX, DX for BDOS 50
drive     db    0                       ; 1E5h
dirsecs   dw    0                       ; 1E6h  directory sector count
loopctr   dw    0                       ; 1E8h
spt       dw    0                       ; 1EAh
trk0      dw    0                       ; 1ECh  DPB OFF
dmaoff    dw    0                       ; 1EEh

; NOFILL drops everything from here on out of the CMD image; the loader
; supplies it via the data group's minimum allocation.
        org     280h
secbuf    rs    128                     ; 380h  one sector
dirbuf    rs    1                       ; 400h  directory image grows from here

        end
